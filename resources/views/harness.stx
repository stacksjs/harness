  const showContextWindow = useLocalStorage('harness.showContextWindow', false)
  const contextUsage = state(initialContextUsage)
  const idleCompactionCandidate = state(initialIdleCompaction)
  const idleCompactionClock = state(Date.now())
  const keepContextTurn = state(0)
  const compactTokenNumber = new Intl.NumberFormat(undefined, { notation: 'compact' })
  const idleCompactionOffer = derived(() => {
    const candidate = idleCompactionCandidate()
    if (!candidate || candidate.availableAt > idleCompactionClock() || uiState() !== 'idle'
      || (accountCompaction()[agentChoice(activeDriverValue()).providerInstanceId]?.idleCompaction
        ?? settings().claudeIdleCompaction) === 'off' || freshSessionArmed() || !sessionOnline() || pendingProviderSwitch() || editingFollowUp()
      || followUps().entries.length || localFollowUps()?.length || threadNavigation().settledAt
      || threadNavigation().snoozedUntil || /^\s*\/compact(?:\s|$)/iu.test(composerText())) return null
    return candidate
  })
  const compactNextPrompt = derived(() => Boolean(idleCompactionOffer() && idleCompactionOffer().afterTurnId !== keepContextTurn()))
  const idleCompactionChip = derived(() => {
    const offer = idleCompactionOffer()
    return offer ? `${compactNextPrompt() ? 'Compact' : 'Keep'} · ${compactTokenNumber.format(offer.usedTokens)}` : ''
  })
  const idleCompactionLabel = derived(() => idleCompactionOffer()
    ? `${compactNextPrompt() ? 'Compact before sending' : 'Keep full context'} (${idleCompactionOffer().usedTokens.toLocaleString()} tokens)`
    : '')
  let idleCompactionTimer
  effect(() => {
    const candidate = idleCompactionCandidate()
    idleCompactionTimer?.stop()
    const now = Date.now()
    idleCompactionClock.set(now)
    if (candidate && candidate.availableAt > now)
      idleCompactionTimer = useTimeout(() => idleCompactionClock.set(Date.now()), candidate.availableAt - now)
  })
  onDestroy(() => idleCompactionTimer?.stop())
  function toggleIdleCompaction() {
    const offer = idleCompactionOffer()
    if (offer) keepContextTurn.set(compactNextPrompt() ? offer.afterTurnId : 0)
  }
  const tokenNumber = new Intl.NumberFormat()
  const contextTokens = derived(() => {
    const usage = contextUsage()
    if (!usage) return ''
    const used = tokenNumber.format(usage.usedTokens)
    return usage.maxTokens ? `${used} / ${tokenNumber.format(usage.maxTokens)} tokens` : `${used} tokens used`
  })
  function updateContextWindowPreference(event) {
    showContextWindow.set(event.currentTarget.checked)
  }
  const wideWorkspace = useMediaQuery('(min-width: 75rem)')
  const browserPreviewOpen = state(false)
  const browserPreviewTools = state(null)
  const storedBrowserPreview = useLocalStorage(`harness.browser-preview.v1:${activeProfile || 0}:${promptScope}`, null, { listenToStorageChanges: false })
  const browserPreview = state(null)
  const browserPreviewTabs = derived(() => browserPreview()?.tabs || [])
  const activePreviewTab = derived(() => browserPreviewTabs().find(tab => tab.id === browserPreview()?.active))
  const activePreviewUrl = derived(() => activePreviewTab()?.history[activePreviewTab().index] || '')
  const previewServers = state(null)
  const previewServerRows = derived(() => previewServers()?.servers || [])
  const browserPreviewReload = useRef('browserPreviewReloadBox')
  let stopPreviewScan = null
  effect(() => {
    const tools = browserPreviewTools()
    const shouldWatch = previewDiscoveryAllowed && sessionId && browserPreviewOpen() && !activePreviewUrl()
    stopPreviewScan?.()
    stopPreviewScan = null
    if (tools && shouldWatch) stopPreviewScan = tools.watchPreviewServers(sessionId, snapshot => previewServers.set(snapshot))
    else previewServers.set(null)
  })
  onDestroy(() => stopPreviewScan?.())
  const previewAddressDraft = state('')
  const previewError = state('')
  const browserPreviewPane = useRef('browserPreviewPaneBox')
  const browserPreviewAddress = useRef('browserPreviewAddressBox')
  const browserPreviewToggle = useRef('browserPreviewToggleBox')
  let browserPreviewTrigger = null
  const diffClose = useRef('diffCloseBox')
  const repositoryCommitDialog = useRef('repositoryCommitDialogBox')
  const repositoryCommitScope = state('staged')
  const repositoryCommitMode = state('')
  const repositoryCommitPublishes = derived(() => Boolean(repositoryCommitMode()))
  const repositoryCommitStacks = derived(() => repositoryCommitMode() === 'pr')
  const stackedPullRequestTitle = state('')
  const stackedPullRequestBody = state('')
  const stackedPullRequestDraft = state(false)
  const repositoryCommitStaged = derived(() => repositoryCommitScope() === 'staged')
  const repositoryCommitPreview = state(null)
  const repositoryCommitTitle = derived(() => {
    if (repositoryCommitStacks()) return 'Commit, push & create PR'
    if (repositoryCommitPublishes())
      return repositoryCommitPreview()?.publish?.current.defaultTarget ? 'Commit & push to default branch?' : 'Commit & push'
    return repositoryCommitStaged() ? 'Commit staged changes' : 'Commit changes'
  })
  const repositoryCommitMessage = state('')
  const repositoryCommitNewBranch = state(false)
  const repositoryCommitLimit = state(40)
  const repositoryCommitEditing = state(false)
  const repositoryCommitExcluded = state(new Set())
  const repositoryCommitFileCount = derived(() => repositoryCommitPreview()?.files.length || 0)
  const repositoryCommitIncludedCount = derived(() => repositoryCommitFileCount() - repositoryCommitExcluded().size)
  const repositoryCommitVisibleFiles = derived(() => {
    const preview = repositoryCommitPreview()
    return (preview?.files || []).slice(0, repositoryCommitLimit())
      .map((path, index) => ({ path, index, key: preview.fileKeys[index], stats: preview.fileStats[index] }))
  })
  const repositoryCommitTotals = derived(() => {
    const stats = repositoryCommitPreview()?.fileStats || []
    const excluded = repositoryCommitExcluded()
    let insertions = 0
    let deletions = 0
    for (const [index, file] of stats.entries()) {
      if (!file || excluded.has(index)) continue
      insertions += file.insertions
      deletions += file.deletions
    }
    return { insertions, deletions }
  })
  const repositoryCommitAllFiles = useRef('repositoryCommitAllFilesBox')
  effect(() => {
    const included = repositoryCommitIncludedCount()
    const mixed = included > 0 && included < repositoryCommitFileCount()
    const checkbox = repositoryCommitAllFiles.current
    if (checkbox) checkbox.indeterminate = mixed
  })
  const repositoryCommitError = state('')
  const repositoryCommitGenerationFailed = state(false)
  const repositoryCommitFeedback = state(null)
  const repositoryCommitResult = derived(() => {
    const feedback = repositoryCommitFeedback()
    return feedback && feedback.repository === diffRepository() ? feedback.message : ''
  })
  const repositoryPublication = state(null)
  const repositoryPublicationReady = derived(() => repositoryPublication()?.repository === diffRepository()
    && repositoryPublication()?.commit === diffGitStatus()?.head)
  const repositoryCommitLoading = state(false)
  const repositoryCommitBusy = state(false)
  const repositoryCommitCanSubmit = derived(() => Boolean(repositoryCommitIncludedCount()
    && (repositoryCommitMessage().trim() || repositoryCommitPreview()?.generation)
    && !repositoryCommitBusy() && !repositoryCommitLoading()
    && (!repositoryCommitError() || repositoryCommitGenerationFailed())))
  const repositoryCommitCurrentAllowed = derived(() => repositoryCommitCanSubmit()
    && (!repositoryCommitPublishes() || (repositoryCommitPreview()?.publish?.current.revision && !repositoryCommitPreview()?.publish?.current.problem))
    && (!repositoryCommitStacks() || (repositoryCommitPreview()?.pullRequest?.revision && !repositoryCommitPreview()?.pullRequest?.problem)))
  const repositoryCommitFeatureAllowed = derived(() => repositoryCommitCanSubmit()
    && (!repositoryCommitPublishes() || (repositoryCommitPreview()?.publish?.feature?.revision && !repositoryCommitPreview()?.publish?.feature?.problem)))
  const repositoryCommitPendingLabel = derived(() => !repositoryCommitMessage().trim() ? 'Generating message…'
    : repositoryCommitStacks() ? 'Publishing and opening PR…' : repositoryCommitPublishes() ? 'Committing and pushing…' : 'Committing…')
  let repositoryCommitTrigger
  let repositoryCommitKey
  const repositorySyncDialog = useRef('repositorySyncDialogBox')
  const repositorySyncAction = state('push')
  const repositorySyncPreview = state(null)
  const repositorySyncError = state('')
  const repositorySyncResult = state(null)
  const repositorySyncLoading = state(false)
  const repositorySyncBusy = state(false)
  const repositorySyncTarget = derived(() => {
    const preview = repositorySyncPreview()
    return preview?.remote ? preview.remote + '/' + preview.ref.replace(/^refs\/heads\//u, '') : ''
  })
  const repositorySyncDescription = derived(() => repositorySyncAction() === 'pull'
    ? 'Fast-forward the checked-out branch from its remote.'
    : repositorySyncPreview()?.firstPush
      ? 'Publish this branch and set its upstream.'
      : repositorySyncPreview()?.defaultTarget ? 'Send local commits directly to the remote’s default branch.'
        : 'Send local commits to the named remote branch.')
  let repositorySyncTrigger
  let repositorySyncKey
  let repositorySyncRequest
  let repositoryCommitRequest
  const repositoryPullRequestDialog = useRef('repositoryPullRequestDialogBox')
  const repositoryPullRequestBase = useRef('repositoryPullRequestBaseBox')
  const repositoryPullRequestTitle = useRef('repositoryPullRequestTitleBox')
  const repositoryPullRequestBody = useRef('repositoryPullRequestBodyBox')
  const repositoryPullRequestDraft = useRef('repositoryPullRequestDraftBox')
  const repositoryPullRequestPreview = state(null)
  const repositoryPullRequestContinuation = state(null)
  const repositoryPullRequestBaseText = state('')
  const repositoryPullRequestTitleText = state('')
  const repositoryPullRequestError = state('')
  const repositoryPullRequestLoading = state(false)
  const repositoryPullRequestBusy = state(false)
  const repositoryPullRequestResult = state(null)
  const linkedRepositoryPullRequests = state(@json(activeSession?.linkedPullRequests || []))
  const pullRequestCheckout = @json(activeSession?.pullRequest?.reference || null)
  const selectedRepositoryPullRequest = derived(() => linkedRepositoryPullRequests().findLast(link => link.repositoryKey === diffRepository())
    || (pullRequestCheckout?.repositoryKey === diffRepository() ? pullRequestCheckout : null))
  const repositoryChecksOpen = state(false)
  const repositoryChecksData = state(null)
  const repositoryChecksError = state('')
  const repositoryChecksLoading = state(false)
  const repositoryChecksShowAll = state(false)
  const checkLabels = { failed: 'Failed', cancelled: 'Cancelled', 'action-required': 'Action required',
    pending: 'Pending', passed: 'Passed', skipped: 'Skipped', neutral: 'Neutral', unknown: 'Unknown' }
  const completedCheckStates = ['passed', 'skipped', 'neutral']
  const repositoryChecksGroups = derived(() => {
    const attention = []
    const pending = []
    const completed = []
    for (const check of repositoryChecksData()?.checks || []) {
      (completedCheckStates.includes(check.status) ? completed : check.status === 'pending' ? pending : attention).push(check)
    }
    return { attention, pending, completed, canCollapse: completed.length > 0 && attention.length + pending.length > 0 }
  })
  const repositoryChecksVisible = derived(() => {
    const { attention, pending, completed, canCollapse } = repositoryChecksGroups()
    return [...attention, ...pending, ...(!canCollapse || repositoryChecksShowAll() ? completed : [])]
  })
  const repositoryChecksSummary = derived(() => {
    const data = repositoryChecksData()
    if (!data || repositoryChecksError()) return ''
    const { attention, pending } = repositoryChecksGroups()
    const count = data.checks.length
    if (!count) return 'No checks reported'
    const countLabel = String(count) + (data.truncated ? '+' : '') + (count === 1 ? ' check' : ' checks')
    const parts = [countLabel]
    if (attention.length) parts.push(attention.length + ' need attention')
    if (pending.length) parts.push(pending.length + ' pending')
    if (!data.truncated && data.checks.every(check => check.status === 'passed')) parts.push('all passed')
    return parts.join(' · ')
  })
  const repositoryChecksStateLabel = derived(() => {
    const data = repositoryChecksData()
    if (!data) return ''
    if (data.state === 'MERGED') return 'Merged'
    if (data.state === 'CLOSED') return 'Closed'
    return data.draft ? 'Draft' : 'Open'
  })
  let repositoryChecksRequest
  effect(() => {
    diffOpen()
    diffRepository()
    selectedRepositoryPullRequest()
    repositoryChecksRequest?.abort()
    batch(() => {
      repositoryChecksOpen.set(false)
      repositoryChecksData.set(null)
      repositoryChecksError.set('')
      repositoryChecksShowAll.set(false)
      repositoryChecksLoading.set(false)
    })
  })
  const repositoryPullRequestBaseChanged = derived(() => Boolean(repositoryPullRequestPreview()
    && repositoryPullRequestBaseText().trim() !== repositoryPullRequestPreview().baseRef))
  const repositoryPullRequestCanSubmit = derived(() => Boolean(repositoryPullRequestPreview()?.revision
    && !repositoryPullRequestBaseChanged() && !repositoryPullRequestLoading() && !repositoryPullRequestBusy() && !repositoryPullRequestError()
    && (repositoryPullRequestPreview().existing || repositoryPullRequestPreview().canGenerate || repositoryPullRequestTitleText().trim())))
  const repositoryPullRequestSubmitLabel = derived(() => repositoryPullRequestBusy() ? 'Working…'
    : repositoryPullRequestPreview()?.existing ? 'Link pull request'
      : repositoryPullRequestPreview()?.publish ? 'Push and create' : 'Create pull request')
  let repositoryPullRequestTrigger
  let repositoryPullRequestKey
  let repositoryPullRequestRequest
  const changesPane = useRef('changesPane')
  const workspaceFilesOpen = state(false)
  const workspaceFileState = state(null)
  const workspaceFilePreview = derived(() => workspaceFileState()?.preview)
  const workspaceFileSelected = derived(() => workspaceFileState()?.selected || '')
  const workspaceFileMode = state('source')
  const workspaceFileLine = state(0)
  const workspaceFileJump = state('')
  const workspaceFileNotice = state('')
  const workspaceFileSearch = useRef('workspaceFileSearchBox')
  const workspaceFileClose = useRef('workspaceFileCloseBox')
  const workspaceFileSource = useRef('workspaceFileSourceBox')
  const workspaceFileHeading = useRef('workspaceFileHeadingBox')
  const workspaceFilesToggle = useRef('workspaceFilesToggle')
  const workspaceEditorHeader = useRef('workspaceEditorHeader')
  const workspaceEditorDialog = useRef('workspaceEditorDialog')
  const preferredEditor = useLocalStorage('harness.workspace-editor.v1', '')
  const editorTarget = state(null)
  const editorChoices = state([])
  const editorBusy = state(false)
  const editorError = state('')
  const editorAnnouncement = state('')
  let editorTrigger = null
  const workspaceActionsToggle = useRef('workspaceActionsToggleBox')
  const sidebarRef = useRef('sidebarBox')
  const sidebarToggleRef = useRef('sidebarToggleBox')
  const promptRef = useRef('promptBox')
  const profileNameRef = useRef('profileNameBox')
  const settingsDriverRef = useRef('settingsDriverBox')
  const settingsDialogRef = useRef('settingsDialogBox')
  const settingsPanel = useRef('settingsPanelBox')
  const settingsSelection = state(initialSettingsSection || 'general')
  const settingsQuery = state('')
  const settingsResults = derived(() => {
    const query = settingsQuery().trim().toLowerCase()
    return settingsSections.filter(section => section.label.toLowerCase().includes(query) || section.id.includes(query)
      || (section.id === 'threads' && ['snooze options', 'auto-settle inactive threads'].some(label => label.includes(query))))
  })
  const settingsSelectionLabel = derived(() => settingsSections.find(section => section.id === settingsSelection())?.label || 'General')

  // What the open project covers, for the Projects section. Asked for when
  // the section opens rather than carried by the render: no event says a
  // repository was cloned into the project folder, so a set baked into the
  // page would be wrong the moment someone clones one, and a person opening
  // this section is usually there because the folder has just changed.
  const projectRepositories = state([])
  const projectRepositoryStatus = state('')
  const projectRepositoryLayout = state(false)
  const projectRepositoryTitle = derived(() => projectSettingsName ? `Repositories in ${projectSettingsName}` : 'No project open')

  async function loadProjectRepositories() {
    if (!projectWorkspaceId) {
      batch(() => {
        projectRepositories.set([])
        projectRepositoryLayout.set(false)
        projectRepositoryStatus.set('Open a project to see the repositories it covers.')
      })
      return
    }

    projectRepositoryStatus.set('Reading the project…')
    const query = activeSessionId
      ? new URLSearchParams({ session: String(activeSessionId) })
      : new URLSearchParams({ workspace: String(projectWorkspaceId) })
    const covered = await fetch(`/workspace-repositories?${query}`)
      .then(response => response.ok ? response.json() : null)
      .catch(() => null)
    if (!covered) {
      batch(() => {
        projectRepositories.set([])
        projectRepositoryLayout.set(false)
        // Trust is the usual reason: reading what is inside a folder is
        // exactly what the host is asked to be trusted for.
        projectRepositoryStatus.set('Could not read this project. Trust it first if you have not.')
      })
      return
    }

    // The project folder is a repository of the project where it is one, and
    // it has no name of its own, so it is shown by the project's name.
    const rows = covered.hasProjectRepository
      ? [{ key: '', label: projectSettingsName || 'This project', note: 'project folder' }]
      : []
    for (const repository of covered.repositories ?? [])
      rows.push({ key: repository.key, label: repository.label, note: repository.key === repository.label ? '' : repository.key })

    batch(() => {
      projectRepositories.set(rows)
      projectRepositoryLayout.set(covered.requiresProjectCommand === true)
      projectRepositoryStatus.set(rows.length ? '' : 'No Git repositories in this project folder yet.')
    })
  }

  effect(() => {
    if (settingsSelection() === 'projects') void loadProjectRepositories()
  })

  // The keyboard registry's live state. `keybindingTable` is null until the
  // shared module loads; the rows fall back to the server-rendered defaults
  // until it does, so the pane never paints a raw `Mod+K`.
  const keybindingTable = state(null)
  const keybindingOverrides = derived(() => keybindingTable()?.overrides || {})
  const keybindingOverridden = derived(() => Object.keys(keybindingOverrides()).length > 0)
  const recordingKeybinding = state('')
  const keybindingStatus = state('')
  const terminalInputFocused = state(false)
  const craftMenuReady = state(typeof desktop()?.menu?.set === 'function')
  desktop.onReady(craft => craftMenuReady.set(typeof craft.menu?.set === 'function'))
  // Which spelling of a chord this keyboard uses. `userAgentData` first — it
  // is the only one of the three that is not deprecated — then the two older
  // fields, because Safari and WebKit still answer only those.
  const appleKeyboard = /mac|iphone|ipad/i.test(navigator.userAgentData?.platform || navigator.platform || navigator.userAgent)
  let keyboard = null
  let keybindingStore = null
  let sidebarJumpHints

  function keybindingRow(id) {
    return keybindings.find(binding => binding.id === id) || null
  }

  function chordLabel(id) {
    const row = keybindingRow(id)
    const bound = keybindingTable()?.bindings?.[id]
    if (keyboard && bound !== undefined) return bound ? keyboard.formatChordText(bound, appleKeyboard) : 'Unassigned'
    return (appleKeyboard ? row?.apple : row?.other) || ''
  }

  const settingsShortcutTitle = derived(() => `Settings (${chordLabel('settings.open')})`)

  function terminalShortcutTitle(id) {
    const label = keybindingRow(id)?.label || ''
    const chord = chordLabel(id)
    return chord ? `${label} (${chord})` : label
  }

  // What a control advertising this chord should put in `aria-keyshortcuts`.
  // Rebinding has to move the announced chord too, or assistive technology
  // keeps reading out a key that no longer does anything.
  function shortcutKeys(id) {
    const row = keybindingRow(id)
    const bound = keybindingTable()?.bindings?.[id]
    if (keyboard && bound !== undefined) {
      const chord = keyboard.parseChord(bound)
      return chord ? keyboard.ariaKeyshortcuts(chord, appleKeyboard && row?.scope === 'terminal') : ''
    }
    return row?.aria || ''
  }

  function composerShortcuts() {
    const sendAndNew = shortcutKeys('composer.sendAndNewThread')
    return sessionId ? sendAndNew : [shortcutKeys('composer.startBackground'), sendAndNew].filter(Boolean).join(' ')
  }

  function composerShortcutTitle() {
    const chord = chordLabel(sessionId ? 'composer.sendAndNewThread' : 'composer.startBackground')
    if (!chord) return null
    return sessionId ? `Send and open a new draft with ${chord}` : `Start in background with ${chord}`
  }

  function matchedCommand(event, terminalFocus = false, composerFocus = false) {
    const table = keybindingTable()
    return keyboard && table ? keyboard.matchCommand(table.bindings, event, {
      terminalFocus, composerFocus, apple: appleKeyboard, craft: craftMenuReady(), modelPickerOpen: draftPickerOpen(),
    }) : null
  }

  function sidebarShortcutBlocked() {
    return draftPickerOpen() || threadUndoBlocked() || arrangementOpen() || stashOpen() || profileModalOpen()
  }

  function updateSidebarJumpHints(event) {
    if (event.repeat || !['Alt', 'Control', 'Meta', 'Shift'].includes(event.key)) return
    const sidebar = sidebarRef.current
    if (sidebar && keyboard && !sidebarJumpHints) {
      sidebarJumpHints = keyboard.createSidebarJumpHints(sidebar, () => ({
        profile: String(visibleProfile()), bindings: keybindingTable()?.bindings, apple: appleKeyboard,
        blocked: sidebarShortcutBlocked() || terminalInputFocused() || Boolean(recordingKeybinding()),
      }))
    }
    sidebarJumpHints?.update(event)
  }

  useEventListener('keyup', updateSidebarJumpHints, { target: window })
  useEventListener('blur', () => sidebarJumpHints?.clear(), { target: window })
  onUnmounted(() => sidebarJumpHints?.clear())

  function readKeyboardStore(craft) {
    keybindingStore = keyboard.createKeybindingStore(localStorage, keyboard.KEYBINDINGS_KEY, { apple: appleKeyboard, craft })
    const resolved = keybindingStore.read()
    keybindingTable.set(resolved)
    if (resolved.rejected.length) {
      const names = resolved.rejected.map(entry => keybindingRow(entry.id)?.label || entry.id)
      keybindingStatus.set(`Restored the default shortcut for ${names.join(', ')}.`)
    }
  }

  effect(() => {
    const craft = craftMenuReady()
    if (keyboard) readKeyboardStore(craft)
  })

  // Load the registry once, and report anything the stored overrides lost. A
  // preference that silently reverts reads as a bug in the setting, so the
  // pane says which binding it could not keep.
  async function loadKeybindings() {
    if (!codecUrl || keybindingStore) return
    try {
      const module = await import(codecUrl)
      keyboard = module
      readKeyboardStore(craftMenuReady())
      // Announced on the document, because "the chords work now" is not
      // visible on screen: a test, or a person watching, otherwise cannot
      // tell a chord that did nothing from one that arrived too early.
      document.documentElement.dataset.harnessKeyboard = 'ready'
    }
    catch {
      // No registry means no rebinding and no window chords; Escape and every
      // on-screen control still work.
    }
  }

  // Started here rather than on mount: the import is the only thing between a
  // painted page and a working chord, so it begins as early as the island can
  // begin anything.
  void loadKeybindings()

  function recordKeybinding(id) {
    if (!keybindingStore) return
    if (recordingKeybinding() === id) {
      recordingKeybinding.set('')
      keybindingStatus.set('')
      return
    }
    recordingKeybinding.set(id)
    keybindingStatus.set(`Press the new shortcut for ${keybindingRow(id)?.label || id}.`)
  }

  // Captured from the window handler, ahead of its dialog guard, so the chord
  // being recorded cannot also trigger the command it is being bound to.
  function captureKeybinding(event) {
    const id = recordingKeybinding()
    if (!id || !keybindingStore || !keyboard) return
    if (event.key === 'Escape') {
      recordingKeybinding.set('')
      keybindingStatus.set('Kept the current shortcut.')
      return
    }
    const chord = keyboard.chordFromEvent(event)
    if (!chord) {
      // A modifier on its own keeps waiting — it is half of a chord. Anything
      // else without a modifier is refused: a bare key would fire while
      // typing in the composer.
      if (!/^(Shift|Meta|Control|Alt|AltGraph|CapsLock|Dead|Unidentified)$/.test(event.key))
        keybindingStatus.set(appleKeyboard ? 'Hold ⌘, ⌃, or ⌥ and press a key.' : 'Hold Ctrl or Alt and press a key.')
      return
    }
    const text = keyboard.chordText(appleKeyboard && keybindingRow(id)?.scope === 'terminal' ? { ...chord, mod: event.metaKey } : chord)
    const result = keybindingStore.save(id, text)
    const shown = keyboard.formatChordText(text, appleKeyboard)
    if (result.ok) {
      keybindingTable.set(result.resolved)
      recordingKeybinding.set('')
      keybindingStatus.set(`${keybindingRow(id)?.label || id} is now ${shown}.`)
      return
    }
    // Recording stays open on a refusal so the next press is another attempt
    // rather than a reopened row, and the command keeps the chord it had.
    if (result.reason === 'conflict') keybindingStatus.set(`${shown} already belongs to ${result.command.label}. Pick another chord.`)
    else keybindingStatus.set(appleKeyboard ? 'Hold ⌘, ⌃, or ⌥ and press a key.' : 'Hold Ctrl or Alt and press a key.')
  }

  function resetKeybinding(id) {
    if (!keybindingStore) return
    keybindingTable.set(keybindingStore.reset(id))
    recordingKeybinding.set('')
    keybindingStatus.set(`${keybindingRow(id)?.label || id} is back to ${chordLabel(id)}.`)
  }

  function resetAllKeybindings() {
    if (!keybindingStore) return
    keybindingTable.set(keybindingStore.resetAll())
    recordingKeybinding.set('')
    keybindingStatus.set('Every shortcut is back to its default.')
  }
  const colorMode = useColorMode()
  const appearancePreference = state(colorMode.preference)
  const unsubscribeAppearance = colorMode.subscribe((_mode, preference) => appearancePreference.set(preference))
  onDestroy(unsubscribeAppearance)
  effect(() => {
    const preference = appearancePreference()
    if (preference !== colorMode.preference) colorMode.set(preference)
    const nativeWindow = desktop()?.window
    if (typeof nativeWindow?.setAppearance === 'function')
      void nativeWindow.setAppearance(preference === 'auto' ? 'system' : preference).catch(() => {})
  })
  const threadSearchDialog = useRef('threadSearchDialogBox')
  const threadSearchInput = useRef('threadSearchInputBox')
  const threadSearchList = useRef('threadSearchListBox')
  const threadSearchResults = state([])
  const threadSearchStatus = state('')
  const threadSearchIndex = state(0)
  const shareSearch = state('')
  const shareRepository = state('')
  const shareClipboardDialog = useRef('shareClipboardDialogBox')
  const shareClipboardBox = useRef('shareClipboardTextBox')
  const shareClipboardText = state('')
  let shareClipboardTrigger = null
  let shareRepositoryRequest
  let linkedPromptRequest
  const promptLinkDialog = useRef('promptLinkDialogBox')
  const linkReview = state(null)
  const linkReviewError = state('')
  const linkOpening = state(false)
  const sharedPromptNotice = state('')
  const missingTurnLink = state(false)
  const selectedThreadSearchId = derived(() => {
    const id = threadSearchResults()[threadSearchIndex()]?.id
    return id === undefined ? undefined : `thread-search-result-${id}`
  })
  const transcriptRef = useRef('transcriptBox')
  const transcriptFindInput = useRef('transcriptFindInputBox')
  const transcriptFindOpen = state(false)
  const transcriptFindQuery = state('')
  const transcriptFindIndex = state(-1)
  const transcriptFindCount = state(0)
  const transcriptFindStatus = derived(() => transcriptFindQuery().trim()
    ? (transcriptFindIndex() + 1) + '/' + transcriptFindCount()
    : '')
  let transcriptFinder = null
  let transcriptFindTrigger = null

  function openTranscriptFind(trigger) {
    if (!sessionId) return
    if (!transcriptFindOpen()) {
      transcriptFindTrigger = trigger?.matches?.('input, textarea, button, a[href], [tabindex]') ? trigger : threadActionsTrigger.current
      transcriptFindOpen.set(true)
    }
    void nextTick(() => {
      transcriptFindInput.current?.focus()
      transcriptFindInput.current?.select()
    })
  }

  function findFromThreadActions() {
    closeThreadActions()
    openTranscriptFind()
  }

  async function findTranscriptText(event) {
    if (event.isComposing) return
    const query = event.currentTarget.value
    transcriptFindQuery.set(query)
    if (!codecUrl || !transcriptRef.current) return
    const { createTranscriptFinder } = await import(codecUrl)
    if (!transcriptFindOpen() || query !== transcriptFindQuery()) return
    transcriptFinder ??= createTranscriptFinder(transcriptRef.current, (index, count) => {
      transcriptFindIndex.set(index)
      transcriptFindCount.set(count)
    })
    transcriptFinder.search(query)
  }

  function stepTranscriptFind(direction) {
    transcriptFinder?.step(direction)
  }

  function closeTranscriptFind() {
    transcriptFinder?.close()
    transcriptFinder = null
    transcriptFindOpen.set(false)
    transcriptFindQuery.set('')
    transcriptFindIndex.set(-1)
    transcriptFindCount.set(0)
    transcriptFindTrigger?.focus()
    transcriptFindTrigger = null
  }

  function transcriptFindKeydown(event) {
    if (event.isComposing || event.keyCode === 229 || event.key !== 'Enter') return
    event.preventDefault()
    stepTranscriptFind(event.shiftKey ? -1 : 1)
  }

  onDestroy(() => transcriptFinder?.close())

  const termSurface = useRef('termSurface')
  const termHeaderToggle = useRef('termHeaderToggle')
  const terminalTabStrip = useRef('terminalTabStrip')
  const terminalKeyboardInput = useRef('terminalKeyboardInput')
  const terminalPasteDialog = useRef('terminalPasteDialog')

  function toggleSidebar() {
    if (desktopSidebar()) {
      sidebarCollapsed.set(!sidebarCollapsed())
      if (sidebarCollapsed()) void nextTick(() => sidebarToggleRef.current?.focus())
      else void nextTick(() => sidebarRef.current?.focus())
      return
    }
    if (sidebarOpen()) closeSidebar()
    else openSidebar()
  }

  function openSidebar() {
    workspaceActionsOpen.set(false)
    sidebarOpen.set(true)
    void nextTick(() => sidebarRef.current?.focus())
  }

  function closeSidebar() {
    sidebarOpen.set(false)
    void nextTick(() => sidebarToggleRef.current?.focus())
  }

  function boundedSidebarWidth(width) {
    return Number.isFinite(width) ? Math.min(416, Math.max(192, Math.round(width))) : 250
  }

  function resizeSidebarByKey(event) {
    const step = event.shiftKey ? 40 : 12
    const widths = {
      ArrowLeft: sidebarWidth() - step,
      ArrowRight: sidebarWidth() + step,
      Home: 192,
      End: 416,
    }
    if (!Object.hasOwn(widths, event.key)) return
    event.preventDefault()
    const width = boundedSidebarWidth(widths[event.key])
    sidebarWidth.set(width)
    storedSidebarWidth.set(width)
  }

  function beginSidebarResize(event) {
    if (event.button !== 0) return
    event.preventDefault()
    event.currentTarget.focus()
    event.currentTarget.setPointerCapture(event.pointerId)
    sidebarDrag = { pointerId: event.pointerId, x: event.clientX, width: sidebarWidth() }
  }

  function moveSidebarResize(event) {
    if (sidebarDrag?.pointerId !== event.pointerId) return
    sidebarWidth.set(boundedSidebarWidth(sidebarDrag.width + event.clientX - sidebarDrag.x))
  }

  function endSidebarResize(event) {
    if (sidebarDrag?.pointerId !== event.pointerId) return
    storedSidebarWidth.set(sidebarWidth())
    sidebarDrag = null
  }

  function cancelSidebarResize(event) {
    if (sidebarDrag?.pointerId !== event.pointerId) return
    sidebarWidth.set(sidebarDrag.width)
    sidebarDrag = null
  }
  function toggleWorkspaceActions() {
    if (browserPreviewOpen()) closeBrowserPreview(false)
    if (!wideWorkspace()) {
      if (workspaceFilesOpen()) closeWorkspaceFiles(false)
      workspaceActionsOpen.update(open => !open)
      return
    }
    if (workspaceFilesOpen()) {
      closeWorkspaceFiles(false)
      workspaceDetailsOpen.set(true)
      return
    }
    if (diffOpen()) {
      diffOpen.set(false)
      diffTrigger = null
      workspaceDetailsOpen.set(true)
      return
    }
    workspaceDetailsOpen.update(open => !open)
  }

  function closeWorkspaceActions() {
    if (!workspaceActionsOpen()) return
    workspaceActionsOpen.set(false)
    workspaceActionsToggle.current?.focus()
  }

  async function toggleBrowserPreview(event) {
    if (browserPreviewOpen()) { closeBrowserPreview(); return }
    await showBrowserPreview(event)
  }

  async function showBrowserPreview(event) {
    if (browserPreviewOpen()) return
    browserPreviewTrigger = workspaceActionsOpen() ? workspaceActionsToggle.current : event?.currentTarget
    workspaceActionsOpen.set(false)
    if (workspaceFilesOpen()) closeWorkspaceFiles(false)
    diffOpen.set(false)
    diffTrigger = null
    browserPreviewOpen.set(true)
    previewError.set('')
    try {
      if (!browserPreviewTools()) browserPreviewTools.set(await import(codecUrl))
      if (!browserPreview()) browserPreview.set(browserPreviewTools().restoreBrowserPreview(storedBrowserPreview(), browserPreviewPane.current?.ownerDocument.location.origin))
      previewAddressDraft.set(activePreviewUrl())
    }
    catch { previewError.set('Could not load the browser pane. Close it and try again.') }
    void nextTick(() => { if (browserPreviewOpen()) browserPreviewAddress.current?.focus() })
  }

  function closeBrowserPreview(restoreFocus = true) {
    browserPreviewOpen.set(false)
    const trigger = browserPreviewTrigger
    browserPreviewTrigger = null
    if (restoreFocus) void nextTick(() => [trigger, browserPreviewToggle.current, workspaceActionsToggle.current].find(element => element?.getClientRects().length)?.focus())
  }

  async function previewProjectScript(url, starting = false) {
    if (!url) return
    closeProjectScripts(false)
    if (!wideWorkspace()) termOpen.set(false)
    await showBrowserPreview()
    if (starting && browserPreviewTools()) {
      const tabId = activePreviewTab()?.id
      const address = activePreviewUrl()
      await browserPreviewTools().waitForProjectPreview(sessionId, url)
      if (!browserPreviewOpen() || activePreviewTab()?.id !== tabId || activePreviewUrl() !== address || previewAddressDraft() !== address) return
    }
    openDiscoveredPreview({ url })
  }

  async function refreshProjectScripts() {
    const read = ++projectScriptsRead
    projectScriptsLoading.set(true)
    try {
      const response = await fetch(`/s/${sessionId}/project-scripts`)
      const body = await response.json()
      if (!response.ok) throw new Error(body.error || 'Could not open project scripts.')
      if (read === projectScriptsRead) projectScripts.set(body)
    }
    catch (error) {
      if (read === projectScriptsRead) projectScriptsError.set(error instanceof Error ? error.message : 'Could not open project scripts.')
    }
    finally { if (read === projectScriptsRead) projectScriptsLoading.set(false) }
  }

  function stopWorkspaceStatusRequests() {
    workspaceStatusPaused = true
    diffGitStatusStop?.()
    repositoryCommitRequest?.abort()
    repositorySyncRequest?.abort()
    repositoryPullRequestRequest?.abort()
    providerCatalogRequest?.abort()
    draftWorktreeRequest?.abort()
    shareRepositoryRequest?.abort()
    linkedPromptRequest?.abort()
    clonePoll?.stop()
    cloneRequest?.abort()
    cloneSuggestionRequest?.abort()
    projectSetupRequest?.abort()
    projectSetupPoll?.stop()
    projectSettlementPending = false
    projectSettlementRequest?.abort()
    projectSettlementPoll?.stop()
  }

  async function refreshProjectSetup() {
    if (workspaceStatusPaused || !sessionId || !workspaceEditorAllowed || !workspaceBranch()) return
    projectSetupPoll?.stop()
    projectSetupRequest?.abort()
    const request = new AbortController()
    projectSetupRequest = request
    try {
      const response = await fetch(`/s/${sessionId}/project-setup`, { mode: 'same-origin', signal: request.signal })
      if (!response.ok || request.signal.aborted) return
      const setup = await response.json()
      if (request.signal.aborted) return
      projectSetup.set(setup)
      if (projectSetupPreview && setup?.status === 'running' && setup.previewUrl && !projectScriptsDialog.current?.open) {
        projectSetupPreview = false
        void previewProjectScript(setup.previewUrl, true)
      }
      if (setup?.status === 'pending' ? (uiBusy() || sessionPullRequest) : setup?.status === 'running')
        projectSetupPoll = useTimeout(refreshProjectSetup, 750)
      else projectSetupPreview = false
    }
    catch {
      if (!request.signal.aborted && sessionOnline() && (uiBusy() || projectSetup()?.status === 'running'))
        projectSetupPoll = useTimeout(refreshProjectSetup, 1500)
    }
  }

  async function refreshProjectSettlement() {
    if (workspaceStatusPaused || !sessionId || !workspaceEditorAllowed || !workspaceBranch()) return
    projectSettlementPoll?.stop()
    if (projectSettlementRequest) {
      projectSettlementPending = true
      return
    }
    const request = new AbortController()
    projectSettlementRequest = request
    try {
      const response = await fetch(`/s/${sessionId}/project-settlement`, { mode: 'same-origin', signal: request.signal })
      if (!response.ok || request.signal.aborted) return
      const job = await response.json()
      if (request.signal.aborted) return
      const changed = job?.status !== projectSettlement()?.status || job?.output !== projectSettlement()?.output
      projectSettlement.set(job)
      if (changed && job) {
        void nextTick(() => {
          const transcript = transcriptRef.current
          if (transcript && followingTranscript()) transcript.scrollTop = transcript.scrollHeight
        })
      }
      if (job?.status === 'completed') finishTerminalClose(job.resumeKey, 'end')
      if (job?.status === 'pending' || job?.status === 'running')
        projectSettlementPoll = useTimeout(refreshProjectSettlement, 750)
    }
    catch {
      if (!request.signal.aborted && sessionOnline() && projectSettlement()?.status === 'running')
        projectSettlementPoll = useTimeout(refreshProjectSettlement, 1500)
    }
    finally {
      projectSettlementRequest = undefined
      if (projectSettlementPending) {
        projectSettlementPending = false
        void refreshProjectSettlement()
      }
    }
  }

  function openProjectScripts(event) {
    const dialog = projectScriptsDialog.current
    if (!dialog || dialog.open) return
    projectScriptsTrigger = workspaceActionsOpen() ? workspaceActionsToggle.current : event.currentTarget
    workspaceActionsOpen.set(false)
    projectScriptDraft.set(null)
    projectScriptsError.set('')
    dialog.showModal()
    void refreshProjectScripts()
    void refreshProjectSetup()
    void refreshProjectSettlement()
  }

  function closeProjectScripts(restore = true) {
    if (!restore) projectScriptsTrigger = null
    projectScriptsRead++
    projectScriptsDialog.current?.close()
  }

  function restoreProjectScriptsFocus() {
    projectScriptsTrigger?.focus()
    projectScriptsTrigger = null
  }

  function editProjectScript(script) {
    projectScriptsError.set('')
    projectScriptDraft.set(script || { name: '', command: '', previewUrl: '', autoOpenPreview: false, stopOnSettle: false })
    void nextTick(() => {
      const name = projectScriptName.current
      if (projectScriptsDialog.current?.open && name?.form && !name.form.contains(name.ownerDocument.activeElement)) name.focus()
    })
  }

  function cancelProjectScriptEdit() {
    projectScriptsError.set('')
    projectScriptDraft.set(null)
    void nextTick(() => projectScriptsDialog.current?.querySelector('[data-project-script-add]')?.focus())
  }

  async function updateProjectScripts(operation) {
    if (projectScriptsBusy()) return
    projectScriptsBusy.set(true)
    projectScriptsError.set('')
    try {
      const response = await fetch(`/s/${sessionId}/project-scripts`, {
        method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(operation),
      })
      if (!response.ok) {
        const body = await response.json()
        throw new Error(body.error || 'Could not update project scripts.')
      }
      if (operation.action === 'retry-setup' || operation.action === 'skip-setup') await refreshProjectSetup()
      if (projectScriptsDialog.current?.open) {
        projectScriptDraft.set(null)
        await refreshProjectScripts()
      }
    }
    catch (error) { projectScriptsError.set(error instanceof Error ? error.message : 'Could not update project scripts.') }
    finally { projectScriptsBusy.set(false) }
  }

  function patchProjectScript(field, value) { projectScriptDraft.update(draft => ({ ...draft, [field]: value })) }

  function importProjectScript(script) { return updateProjectScripts({ action: 'import', key: script.key }) }

  function saveProjectScript() {
    const script = projectScriptDraft()
    if (script) return updateProjectScripts({ action: 'save', id: script.id, script })
  }

  async function removeProjectScript() {
    const id = projectScriptDraft()?.id
    if (id && await stxConfirm('Remove this project script?', { confirmText: 'Remove script', cancelText: 'Keep script' }))
      await updateProjectScripts({ action: 'remove', id })
  }

  function runProjectScript(script) {
    const dock = terminalController()
    if (!dock || !sessionOnline() || projectScriptsBusy()) return
    const { tabs, directions } = terminalTabs()
    const tab = { key: crypto.randomUUID(), number: (tabs.at(-1)?.number ?? 0) + 1, name: script.name, started: true }
    dock.queueProjectScript(tab.key, script.id)
    revealProjectTerminal([...tabs, tab], tab.key, directions)
  }

  function viewProjectSetupTerminal() {
    viewProjectJobTerminal(projectSetup())
  }

  function viewProjectJobTerminal(job) {
    if (!job || job.status === 'pending' || !sessionOnline() || !terminalController()) return
    const { tabs, directions } = terminalTabs()
    const tab = { key: job.resumeKey, number: (tabs.at(-1)?.number ?? 0) + 1, name: job.name, started: true }
    revealProjectTerminal(tabs.some(item => item.key === tab.key) ? tabs : [...tabs, tab], tab.key, directions)
  }

  function revealProjectTerminal(tabs, key, directions) {
    closeProjectScripts(false)
    terminalTrigger = termHeaderToggle.current
    if (!wideWorkspace() && browserPreviewOpen()) closeBrowserPreview(false)
    if (!wideWorkspace() && workspaceFilesOpen()) closeWorkspaceFiles(false)
    if (!wideWorkspace()) diffOpen.set(false)
    termOpen.set(true)
    showSelectedTerminal(tabs, key, directions)
  }

  function previewTabLabel(tab) {
    const address = tab.history[tab.index]
    if (!address) return 'New tab'
    const url = new URL(address)
    return url.pathname === '/' ? url.host : url.host + url.pathname
  }

  function setBrowserPreview(tabs, active) {
    const next = { tabs, active }
    browserPreview.set(next)
    storedBrowserPreview.set(next)
    previewAddressDraft.set(activePreviewUrl())
    previewError.set('')
  }

  function selectPreviewTab(id) {
    setBrowserPreview(browserPreviewTabs(), id)
  }

  function addPreviewTab() {
    const tabs = browserPreviewTabs()
    if (tabs.length >= browserPreviewTools().MAX_PREVIEW_TABS) return
    let id = 1
    while (tabs.some(tab => tab.id === id)) id++
    setBrowserPreview([...tabs, { id, history: [], index: 0 }], id)
    void nextTick(() => browserPreviewAddress.current?.focus())
  }

  function closePreviewTab(id) {
    const tabs = browserPreviewTabs()
    const remaining = tabs.filter(tab => tab.id !== id)
    const closedIndex = tabs.findIndex(tab => tab.id === id)
    const replacement = remaining[Math.min(closedIndex, remaining.length - 1)]?.id
    const active = activePreviewTab()?.id === id ? replacement : activePreviewTab()?.id
    setBrowserPreview(remaining.length ? remaining : [{ id: 1, history: [], index: 0 }], active || 1)
    void nextTick(() => browserPreviewAddress.current?.focus())
  }

  function guardPreviewComposition(event) {
    if (event.key === 'Enter' && (event.isComposing || event.keyCode === 229)) event.preventDefault()
  }

  function openPreviewAddress() {
    const tab = activePreviewTab()
    const origin = browserPreviewPane.current?.ownerDocument.location.origin
    if (!tab || !origin || !browserPreviewTools()) return
    const result = browserPreviewTools().previewAddress(previewAddressDraft(), origin)
    if (result.error) { previewError.set(result.error); return }
    browserPreviewAddress.current?.blur()
    if (result.url === activePreviewUrl()) { reloadBrowserPreview(); return }
    const next = browserPreviewTools().navigatePreviewTab(tab, result.url)
    setBrowserPreview(browserPreviewTabs().map(entry => entry.id === tab.id ? next : entry), tab.id)
  }

  function openDiscoveredPreview(server) {
    previewAddressDraft.set(server.url)
    openPreviewAddress()
    void nextTick(() => { if (activePreviewUrl()) browserPreviewReload.current?.focus() })
  }

  function previewServerAddress(server) {
    return new URL(server.url).host
  }

  function stepPreviewHistory(direction) {
    const tab = activePreviewTab()
    if (!tab || !tab.history[tab.index + direction]) return
    setBrowserPreview(browserPreviewTabs().map(entry => entry.id === tab.id ? { ...tab, index: tab.index + direction } : entry), tab.id)
  }

  function reloadBrowserPreview() {
    previewError.set('')
    previewAddressDraft.set(activePreviewUrl())
    browserPreviewTools()?.reloadPreviewFrame(browserPreviewPane.current, activePreviewTab()?.id)
  }

  // The "name this profile" form. Replaces window.prompt: the name arrives
  // through a small form the page owns, so it can be styled and cancelled
  // like everything else.
  const profileModalOpen = state(false)
  // A freshly minted pairing code, shown beside the button that minted it.
  const pairCode = state('')
  // The checkpoint currently being restored; its button reads this for its
  // label and disabled state.
  const revertingId = state(initialRewind)
  const rewindNotice = state(initialRewindNotice)
  const rewindCheckpoints = state(initialRewindCheckpoints)
  const rewindableTurns = state(initialRewindableTurns)
  const conversationRewind = state(initialConversationRewind)
  const conversationRewindNotice = state(initialConversationRewindNotice)
  const restoredPromptError = state('')
  const isolatedRewind = state(initialIsolatedRewindScope)
  const rewindDialog = useRef('rewindDialogBox')
  const rewindDialogCancel = useRef('rewindDialogCancel')
  const rewindDialogTurn = state(0)
  const rewindDialogScope = derived(() => rewindCheckpoints()[rewindDialogTurn()] ? isolatedRewind() : '')
  let rewindDialogTrigger = null
  const requestedRewind = useSessionStorage(`harness.rewind.requested:${sessionId}`, '')
  const restoredRewind = useLocalStorage(`harness.rewind.restored:${sessionId}`, '')
  const canRestoreEarlierPrompt = derived(() => Boolean(initialRewoundPrompt
    && initialRewoundPrompt.operation !== restoredRewind() && initialRewoundPrompt.operation !== composerDraft()?.rewoundOperation
    && !conversationRewind()))

  function canEditEarlierPrompt(turnId) {
    return !uiBusy() && !revertingId() && !threadNavigation().archivedAt && !followUps().entries.length
      && rewindableTurns().includes(turnId)
  }

  function openRewindDialog(turnId, event) {
    const dialog = rewindDialog.current
    if (!dialog || dialog.open || rewindDialogTurn() || conversationRewind() || !sessionOnline() || !canEditEarlierPrompt(turnId)) return
    rewindDialogTrigger = event?.currentTarget ?? null
    rewindDialogTurn.set(turnId)
    dialog.showModal()
    rewindDialogCancel.current?.focus({ preventScroll: true })
  }

  function closeRewindDialog() {
    rewindDialog.current?.close()
  }

  function finishRewindDialog() {
    rewindDialogTurn.set(0)
    if (rewindDialogTrigger?.isConnected) rewindDialogTrigger.focus({ preventScroll: true })
    rewindDialogTrigger = null
  }

  function confirmConversationRewind(restoreFiles) {
    const turnId = rewindDialogTurn()
    if (!turnId || (restoreFiles && !rewindDialogScope())) return
    closeRewindDialog()
    void submitConversationRewind(turnId, restoreFiles)
  }

  async function submitConversationRewind(turnId, restoreFiles, verifyOnly = false) {
    if (!sessionId || !turnId || !sessionOnline()) return
    const previous = conversationRewind()
    if (verifyOnly ? previous?.status !== 'uncertain' : previous || !canEditEarlierPrompt(turnId)) return
    const operation = newCommandId()
    if (!verifyOnly) requestedRewind.set(operation)
    conversationRewind.set({ turnId, status: 'running' })
    conversationRewindNotice.set('')
    try {
      await sendCommand({ type: 'session.turn.rewind', sessionId, turnId,
        ...(restoreFiles ? { restoreFiles: true } : {}), ...(verifyOnly ? { verifyOnly: true } : {}) }, operation)
    }
    catch (error) {
      if (conversationRewind()?.status === 'running') conversationRewind.set(previous)
      conversationRewindNotice.set(error.message)
    }
  }

  // A global shortcut, so harness is reachable without finding its window.
  //
  // Registered from the page rather than from the Zig host because the handler
  // is page logic — focus, then put the cursor in the composer. In a browser
  // `window.craft` is absent and this is skipped; a browser cannot claim a
  // system-wide key anyway.
  try {
    const shortcuts = window.craft?.shortcuts
    if (shortcuts) {
      // Registration and the handler are separate: the host owns the hotkey and
      // delivers a `craft:shortcut` event carrying the id it was registered
      // under, so the page does not hold a callback the OS knows nothing about.
      shortcuts.register('harness.summon', 'Cmd+Shift+H')
      shortcuts.on?.((event) => {
        if ((event?.id ?? event) !== 'harness.summon') return
        window.craft?.window?.focus?.()
        // Someone who summoned the window deliberately should land ready to
        // type, not hunting for the input.
        promptRef.current?.focus()
      })
    }
  }
  catch { /* a host without the shortcuts bridge is not an error */ }

  // Paint the native window in the active profile's colour.
  //
  // This is the half of the Arc idea AppKit owns: the web sidebar takes its
  // tint through `<Sidebar :spaces>`, but the titlebar and the window behind it
  // do not, so a tinted sidebar used to sit inside grey chrome. In a browser
  // `window.craft` is absent and this is simply skipped.
  //
  // It could not have worked before craft v0.0.62 regardless —
  // `setBackgroundColor` was one of the twenty window actions whose payload the
  // bridge discarded.
  function paintWindow(spaceId) {
    const tint = (spaceTints || {})[spaceId]
    // No tint means the profile never chose one; leaving the window alone is
    // better than inventing a colour it did not ask for.
    if (!tint) return
    try { window.craft?.window?.setBackgroundColor?.(tint) }
    catch { /* a host without the window bridge is not an error */ }
  }

  paintWindow(document.querySelector('[data-space][data-space-active="true"]')?.dataset.spaceId)

  // The sidebar's own controls. `<Sidebar>` renders "New Session" and the
  // space "+" and emits when they are pressed; nothing was listening, so both
  // were buttons that did nothing.
  //
  // These dispatch over the socket like every other command, then reload —
  // the sidebar is server-rendered, and re-rendering it here would be a second
  // implementation of what the server already does.
  async function revertTurn(turnId) {
    const checkpoint = rewindCheckpoints()[turnId]
    if (!checkpoint || !sessionId || revertingId()) return
    const detail = checkpoint.resetsStaging ? ' Git staging will reset in the recorded repositories.' : ''
    const confirmed = await stxConfirm(
      'Restore files from before this turn? Changes made since then, including new files, will be removed.' + detail,
      { type: 'warning', confirmText: 'Revert', cancelText: 'Keep my files' },
    )
    if (!confirmed || revertingId()) return
    revertingId.set(checkpoint.id)
    rewindNotice.set('')
    try { await sendCommand({ type: 'session.checkpoint.revert', sessionId, checkpointId: checkpoint.id }) }
    catch (error) {
      revertingId.set(0)
      rewindNotice.set(error.message)
    }
  }

  // Set by the transcript's socket once it opens, so a sidebar command reuses
  // it rather than opening a second connection to the same server.
  let liveSocket = null
  let watchSidebarOrder = () => {}
  const threadOrderStatus = state('')
  let disconnectLiveSession = () => {}
  let reconnectLiveSession = () => {}
  onUnmounted(() => disconnectLiveSession())
  useEventListener('online', () => reconnectLiveSession())

  /**
   * Dispatch a command that is not about the open session.
   *
   * Reuses the transcript's socket when there is one. On the index page there
   * is no session and therefore no socket, so this opens a short-lived one —
   * the alternative is keeping a connection open on a page that never streams.
   *
   * Resolves on the server's ack so a caller can reload without outrunning the
   * write.
   */
  async function sendCommand(command, commandId) {
    const { sendBrowserCommand } = await import(codecUrl)
    return sendBrowserCommand(serverUrl, {
      id: commandId ?? newCommandId(),
      at: Date.now(),
      command,
    }, liveSocket)
  }

  function newCommandId() {
    return `web_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`
  }

  let projectPickerTrigger = null

  function openProjectPicker(event) {
    const dialog = projectDialog.current
    if (!dialog || dialog.open) return
    projectPickerTrigger = workspaceActionsOpen() ? workspaceActionsToggle.current : event?.currentTarget ?? null
    workspaceActionsOpen.set(false)
    projectError.set('')
    if (projectPath.current) projectPath.current.value = ''
    if (projectTrust.current) projectTrust.current.checked = false
    dialog.showModal()
    projectPath.current?.focus()
  }

  function closeProjectPicker() {
    projectDialog.current?.close()
    projectPickerTrigger?.focus()
    projectPickerTrigger = null
  }

  function cancelProjectPicker(event) {
    event.preventDefault()
    if (!projectBusy()) closeProjectPicker()
  }

  async function browseProject() {
    const craft = desktop()
    if (typeof craft?.dialog?.showOpenDialog !== 'function') return
    try {
      const selection = await craft.dialog.showOpenDialog({
        title: 'Choose a project folder',
        properties: ['openDirectory'],
      })
      const path = selection?.filePaths?.[0]
      if (!selection?.canceled && typeof path === 'string' && projectPath.current)
        projectPath.current.value = path
    }
    catch {
      projectError.set('Could not open the folder picker. You can enter the path above.')
    }
  }


  function openProjectClone(prompt) {
    if (!projectCloneAllowed || cloneDialog.current?.open) return
    cloneReturnToPicker = Boolean(projectDialog.current?.open)
    projectDialog.current?.close()
    promptLinkDialog.current?.close()
    const operation = pendingProjectClone()
    cloneLinkedPrompt = operation?.prompt ?? prompt
    cloneRemoteText.set(operation?.input?.remote || prompt?.repository || '')
    cloneDestinationEdited = false
    if (cloneDestinationInput.current) cloneDestinationInput.current.value = operation?.input?.destination || ''
    cloneSuggestion = ''
    cloneError.set('')
    cloneReceipt.set(null)
    cloneDialog.current?.showModal()
    if (operation?.input?.id) {
      cloneSubmitting.set(true)
      void showCloneProgress(operation)
    }
    else if (prompt) void suggestCloneDestination()
    else cloneRemoteInput.current?.focus()
  }

  function closeProjectClone() {
    if (cloneBusy()) return
    cloneSuggestionRequest?.abort()
    cloneDialog.current?.close()
    if (cloneReturnToPicker) {
      projectDialog.current?.showModal()
      projectPath.current?.focus()
    }
    else if (cloneLinkedPrompt && linkReview()) showLinkedPrompt(linkReview())
    else (projectPickerTrigger || sidebarRef.current)?.focus()
    cloneLinkedPrompt = null
    cloneReturnToPicker = false
  }

  function changeCloneRemote(value) {
    cloneRemoteText.set(value)
    cloneError.set('')
  }

  function changeCloneDestination() {
    cloneDestinationEdited = true
    cloneSuggestionRequest?.abort()
    cloneError.set('')
  }

  function canSuggestCloneDestination(input) {
    return input && !cloneBusy() && !cloneDestinationEdited && (!input.value || input.value === cloneSuggestion)
  }

  async function suggestCloneDestination() {
    const remote = cloneRemoteText().trim()
    const input = cloneDestinationInput.current
    if (!remote || !canSuggestCloneDestination(input)) return
    cloneSuggestionRequest?.abort()
    const request = new AbortController()
    cloneSuggestionRequest = request
    const response = await fetch('/projects/clone?' + new URLSearchParams({ remote }), { signal: request.signal })
      .then(result => result.ok ? result.json() : null).catch(() => null)
    if (request.signal.aborted) return
    cloneSuggestionRequest = undefined
    if (response?.destination && cloneDialog.current?.open && cloneRemoteText().trim() === remote && canSuggestCloneDestination(input)) {
      cloneSuggestion = response.destination
      input.value = cloneSuggestion
      if (cloneLinkedPrompt) input.focus()
    }
  }

  async function browseCloneFolder() {
    const craft = desktop()
    if (typeof craft?.dialog?.showOpenDialog !== 'function') return
    try {
      const { directory } = composerDraftTools.cloneRemote(cloneRemoteText())
      const selection = await craft.dialog.showOpenDialog({ title: 'Choose where to clone', properties: ['openDirectory'] })
      const parent = selection?.filePaths?.[0]
      const input = cloneDestinationInput.current
      if (!selection?.canceled && typeof parent === 'string' && input) {
        const separator = parent.includes('\\') ? '\\' : '/'
        changeCloneDestination()
        input.value = parent.replace(/[\\/]+$/, '') + separator + directory
      }
    }
    catch (error) { cloneError.set(error.message || 'Could not open the folder picker.') }
  }

  async function showCloneProgress(operation, start = false) {
    const request = new AbortController()
    cloneRequest = request
    try {
      const endpoint = '/projects/clone'
      const response = start
        ? await fetch(endpoint, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(operation.input), signal: request.signal })
        : await fetch(endpoint + '?' + new URLSearchParams({ id: operation.input.id }), { signal: request.signal })
      if (!start && response.status === 404 && !request.signal.aborted) return showCloneProgress(operation, true)
      const result = await response.json().catch(() => ({}))
      if (request.signal.aborted) return
      if (!response.ok) {
        pendingProjectClone.set(null)
        throw new Error(result.error || 'Could not start the clone.')
      }
      cloneReceipt.set(result)
      cloneError.set('')
      cloneSubmitting.set(false)
      if (['cloning', 'publishing'].includes(result.phase)) {
        clonePoll = useTimeout(() => void showCloneProgress(operation), 500)
        return
      }
      cloneCancelling.set(false)
      pendingProjectClone.set(null)
      if (result.phase === 'done') {
        const target = cloneDialog.current
        target?.close()
        if (operation.prompt?.pullRequest) {
          const params = new URLSearchParams({ workspace: String(result.workspace), pr: operation.prompt.pullRequest })
          if (operation.prompt.text) params.set('prompt', operation.prompt.text)
          openDraftAddress('/?' + params)
          return
        }
        if (operation.prompt && target) {
          try {
            await openLinkedDraft(operation.prompt, { id: result.workspace, profile: result.profile }, target)
            return
          }
          catch { /* Keep access to the registered checkout if browser storage is unavailable. */ }
        }
        openDraftAddress('/?workspace=' + result.workspace)
      }
      else cloneError.set(result.error || '')
    }
    catch (error) {
      if (request.signal.aborted) return
      cloneSubmitting.set(false)
      cloneCancelling.set(false)
      cloneError.set(error.message || 'Could not read clone progress.')
      if (pendingProjectClone()?.input?.id === operation.input.id)
        clonePoll = useTimeout(() => void showCloneProgress(operation), 1000)
    }
    finally { if (cloneRequest === request) cloneRequest = null }
  }

  function startProjectClone() {
    if (cloneBusy() || !composerDraftTools || !projectCloneAllowed) return
    try {
      const { remote } = composerDraftTools.cloneRemote(cloneRemoteInput.current?.value ?? cloneRemoteText())
      const destination = cloneDestinationInput.current?.value.trim() || ''
      const operation = { input: { id: newCommandId(), remote, destination, profile: Number(visibleProfile()) || null }, prompt: cloneLinkedPrompt }
      cloneSubmitting.set(true)
      cloneError.set('')
      pendingProjectClone.set(operation)
      void showCloneProgress(operation, true)
    }
    catch (error) { cloneError.set(error.message || 'Could not start the clone.') }
  }

  async function cancelProjectClone() {
    const receipt = cloneReceipt()
    if (receipt?.phase !== 'cloning' || cloneCancelling()) return
    cloneCancelling.set(true)
    try {
      const response = await fetch('/projects/clone?' + new URLSearchParams({ id: receipt.id }), { method: 'DELETE' })
      if (!response.ok) throw new Error('The host could not stop the clone.')
    }
    catch (error) {
      cloneCancelling.set(false)
      cloneError.set(error.message)
    }
  }

  function resumeProjectClone() {
    const current = pendingProjectClone()
    if (!projectCloneAllowed || !current?.input?.id || !cloneDialog.current) return false
    openProjectClone(current.prompt)
    return true
  }

  async function registerProject() {
    const path = projectPath.current?.value
    if (!path?.trim() || projectBusy()) return
    const id = newCommandId()
    projectBusy.set(true)
    projectError.set('')
    try {
      const profileId = Number(visibleProfile()) || undefined
      await sendCommand({
        type: 'workspace.register',
        ...(profileId ? { profileId } : {}),
        path,
        trusted: projectTrust.current?.checked === true,
      }, id)
      closeProjectPicker()
      navigate(`/?workspace=${derivedSessionId(id)}`)
    }
    catch (error) {
      projectError.set(error.message || 'Could not add the folder.')
    }
    finally {
      projectBusy.set(false)
    }
  }

  async function trustProject() {
    if (!draftProject || projectBusy()) return
    projectBusy.set(true)
    try {
      await sendCommand({ type: 'workspace.trust', workspaceId: draftProject.id, trusted: true })
      refresh()
    }
    catch (error) {
      stxAlert(error.message || 'Could not trust the folder.')
    }
    finally {
      projectBusy.set(false)
    }
  }

  async function promoteScratchProject() {
    if (!activeScratchSession || projectBusy()) return
    projectBusy.set(true)
    try {
      await sendCommand({ type: 'workspace.promote', workspaceId: Number(activeWorkspaceId) })
      refresh()
    }
    catch (error) {
      stxAlert(error.message || 'Could not turn this folder into a project.')
    }
    finally {
      projectBusy.set(false)
    }
  }

  function chooseProject(event) {
    if (event.currentTarget.value === 'none') {
      startWithoutProject()
      return
    }
    const id = Number(event.currentTarget.value)
    if (id) navigate(`/?workspace=${id}`)
  }

  function openDraftAddress(href) {
    stopWorkspaceStatusRequests()
    navigate(href)
  }

  function openNewDraft(query) {
    openDraftAddress(`/?${query}&draft=${newCommandId()}`)
  }

  function startProjectDraft(id) {
    openNewDraft(`workspace=${id}`)
  }

  function startWithoutProject() {
    const profile = Number(activeProfile)
    openDraftAddress(profile ? `/?profile=${profile}&project=none` : '/?project=none')
  }

  function startScratchDraft() {
    const profile = Number(activeProfile)
    if (profile) openNewDraft(`profile=${profile}&project=none`)
    else startWithoutProject()
  }

  function openDraft(profileId) {
    const project = String(profileId) === String(activeProfile) ? draftProject : profileProjects[String(profileId)]
    if (project) startProjectDraft(project.id)
    else if (draftWithoutProject) openNewDraft(`profile=${Number(profileId) || 0}&project=none`)
    else openProjectPicker()
  }

  useEventListener('spaceAction', (event) => {
    const { spaceId, role } = event.detail || {}
    if (role !== 'action' || !spaceId) return
    visibleProfile.set(spaceId)
    openDraft(spaceId)
  }, { target: document })

  function openProfileModal() {
    profileModalOpen.set(true)
    // Focus after the binding has shown the form.
    void nextTick(() => profileNameRef.current?.focus())
  }

  useEventListener('spaceAdd', openProfileModal, { target: document })

  function closeProfileModal() {
    profileModalOpen.set(false)
  }

  // Settings. The one setting is device-local — which agent this machine
  // starts sessions with — so it lives in localStorage, not the event log:
  // a preference of this keyboard, not a fact about the project.
  const KNOWN_DRIVERS = ['claude', 'codex', 'opencode', 'cursor', 'grok']
  const DRIVER_LABELS = { claude: 'Claude Code', codex: 'Codex', opencode: 'OpenCode', cursor: 'Cursor', grok: 'Grok' }
  const providerAccounts = state([])
  const defaultProviders = state([])
  const providerCatalog = state('loading')
  const modelFavorites = state([])
  let modelFavoritesRevision = 0
  let providerCatalogRequest
  const activeDriverValue = state(sessionProviderInstanceId === null ? sessionDriver : `${sessionDriver}:${sessionProviderInstanceId}`)
  const currentDriver = derived(() => activeDriverValue().split(':')[0])
  const appliedCodexSelection = state(initialCodexSelection)
  const activeModel = state(initialSessionModel)
  const draftProvider = state(activeSessionId ? activeDriverValue() : defaultDriver())
  const draftModel = state(initialSessionModel)
  const draftEffort = state(initialCodexSelection?.effort || '')
  const draftSpeed = state(initialCodexSelection?.serviceTier || '')
  const composerProviders = derived(() => [...defaultProviders(), ...providerAccounts()])
  const pendingProviderSwitch = derived(() => Boolean(sessionId && (draftProvider() !== activeDriverValue()
    || (currentDriver() !== 'codex' && draftModel() !== activeModel()))))
  const handoffBlocked = derived(() => pendingProviderSwitch() && !editingFollowUp() && (uiBusy() || !sessionOnline() || Boolean(followUps().entries.length) || Boolean(localFollowUps()?.length)))
  const handoffHint = derived(() => {
    if (!pendingProviderSwitch()) return ''
    if (!sessionOnline()) return 'Reconnect to switch providers.'
    if (handoffBlocked()) return 'Finish the current turn and queued messages to switch providers.'
    return 'Continue with ' + draftPickerLabel() + ' using recent context.'
  })
  const draftIsCodex = derived(() => draftProvider().split(':')[0] === 'codex')
  function draftCodexSelection() {
    if (!draftIsCodex() || !draftModel()) return undefined
    return {
      model: draftModel(),
      ...(draftEffort() ? { effort: draftEffort() } : {}),
      ...(draftSpeed() ? { serviceTier: draftSpeed() } : {}),
    }
  }
  function sameCodexSelection(left, right) {
    return left?.model === right?.model && left?.effort === right?.effort && left?.serviceTier === right?.serviceTier
  }
  function matchesActiveCodexSelection(selection) {
    return !selection || sameCodexSelection(selection, appliedCodexSelection())
  }
  function showDraftCodexSelection(selection) {
    draftModel.set(selection.model)
    draftEffort.set(typeof selection.effort === 'string' ? selection.effort : '')
    draftSpeed.set(typeof selection.serviceTier === 'string' ? selection.serviceTier : '')
  }
  function canSteerDraft() {
    return !composerFiles().length && !freshSessionArmed() && composerText().trim() !== '/compact' && !pendingProviderSwitch() && canSteer() && matchesActiveCodexSelection(draftCodexSelection())
  }
  const selectedDraftAccount = derived(() => composerProviders().find(account => account.value === draftProvider()))
  const selectedDraftModel = derived(() => selectedDraftAccount()?.models?.find(model => model.id === draftModel()))
  const draftPickerLabel = derived(() => {
    if (comparingModels()) return draftModelChoices().map(modelBatchTargetName).join(', ')
    const model = selectedDraftModel()
    const effort = draftEffort()
    const speed = model?.speedTiers.find(tier => tier.id === draftSpeed())?.name
    return model ? [model.name, effort ? pickerEffortLabel(effort) : '', speed].filter(Boolean).join(' · ')
      : draftModel() ? [draftModel(), effort ? pickerEffortLabel(effort) : '', draftSpeed()].filter(Boolean).join(' · ')
        : selectedDraftAccount()?.name || DRIVER_LABELS[draftProvider().split(':')[0]]
  })

  const draftPickerTrigger = useRef('draftPickerTriggerBox')
  const draftPickerDialog = useRef('draftPickerDialogBox')
  const draftPickerSearch = useRef('draftPickerSearchBox')
  const draftPickerResults = useRef('draftPickerResultsBox')
  const draftPickerAccounts = useRef('draftPickerAccountsBox')
  const draftPickerOpen = state(false)
  const pickerAccount = state('')
  const pickerQuery = state('')
  const pickerIndex = state(0)
  const favoritePending = state(false)
  const favoriteError = state('')
  const pickerFavoriteKeys = derived(() => new Set(modelFavorites().map(favorite => {
    const account = favorite.providerInstanceId === undefined ? favorite.driverKind : `${favorite.driverKind}:${favorite.providerInstanceId}`
    return `${account}/${favorite.model}`
  })))
  const pickerOptionModel = derived(() => {
    const model = selectedDraftModel()
    return (pickerAccount() === draftProvider() || pickerAccount() === 'favorites') && draftProvider().split(':')[0] === 'codex'
      && (model?.reasoningEfforts.length || model?.speedTiers.length) ? model : undefined
  })
  const pickerResults = derived(() => {
    const search = pickerQuery().toLowerCase().trim().split(/\s+/).filter(Boolean)
    const favoritesOnly = pickerAccount() === 'favorites'
    const favoriteKeys = pickerFavoriteKeys()
    const accounts = composerProviders().filter(account => account.status === 'ready' && (favoritesOnly || search.length || account.value === pickerAccount()))
    return accounts.flatMap(account => {
      const rows = favoritesOnly || (sessionId && currentDriver() === 'codex' && account.value === activeDriverValue()) ? account.models || [] : [{ id: '', name: 'Provider default' }, ...(account.models || [])]
      return rows.filter(model => {
        if (favoritesOnly && !favoriteKeys.has(`${account.value}/${model.id}`)) return false
        const text = `${model.name} ${model.id} ${account.name}`.toLowerCase()
        return search.every(word => text.includes(word))
      }).map(model => ({ id: model.id, name: model.name, account: account.value, accountName: account.name, key: `${account.value}/${model.id}` }))
    })
  })
  const numberedPickerResults = derived(() => pickerResults().filter(result => result.id).slice(0, 9))
  const pickerStatus = derived(() => {
    if (providerCatalog() === 'failed') return 'Could not load provider accounts.'
    if (providerCatalog() === 'loading') return 'Checking provider accounts…'
    if (pickerAccount() === 'favorites' && !pickerQuery().trim()) return 'No favorite models available.'
    if (!pickerQuery().trim() && !pickerResults().length) return 'No models are available for this account.'
    return 'No matching models'
  })

  const pickerEfforts = derived(() => {
    const model = pickerOptionModel()
    return (model?.reasoningEfforts || []).filter(effort => !sessionId || effort !== model?.defaultReasoningEffort)
  })

  function pickerUsesDefaultEffort() {
    return !draftEffort() || (sessionId && draftEffort() === pickerOptionModel()?.defaultReasoningEffort)
  }

  function chooseDefaultEffort() {
    draftEffort.set(sessionId ? pickerOptionModel()?.defaultReasoningEffort || '' : '')
  }

  function pickerEffortLabel(effort) {
    return effort === 'xhigh' ? 'Extra high' : effort.charAt(0).toUpperCase() + effort.slice(1)
  }

  function positionDraftPicker() {
    const trigger = draftPickerTrigger.current
    const dialog = draftPickerDialog.current
    if (!trigger || !dialog?.open) return
    const anchor = trigger.getBoundingClientRect()
    const viewport = dialog.ownerDocument.documentElement
    const visual = dialog.ownerDocument.defaultView?.visualViewport
    const top = visual?.offsetTop || 0
    const height = visual?.height || viewport.clientHeight
    const sidebarEdge = sidebarRef.current?.getBoundingClientRect().right || 0
    const left = sidebarEdge + 8
    dialog.style.setProperty('--draft-picker-viewport', height + 'px')
    dialog.style.setProperty('--draft-picker-available-width', (viewport.clientWidth - left - 8) + 'px')
    const bounds = dialog.getBoundingClientRect()
    const below = anchor.bottom + 6
    const above = anchor.top - bounds.height - 6
    const preferred = above >= top + 8 || below + bounds.height > top + height - 8 ? above : below
    dialog.style.setProperty('--draft-picker-top', Math.max(top + 8, Math.min(preferred, top + height - bounds.height - 8)) + 'px')
    dialog.style.setProperty('--draft-picker-left', Math.max(left, Math.min(anchor.right - bounds.width, viewport.clientWidth - bounds.width - 8)) + 'px')
    revealPickerAccount()
  }

  function openDraftPicker(event) {
    const dialog = draftPickerDialog.current
    if (!dialog || dialog.open) return
    if (!sessionId && draftProject?.trusted) void loadDraftWorktreeOptions()
    pickerQuery.set('')
    favoriteError.set('')
    pickerAccount.set(draftProvider())
    pickerIndex.set(Math.max(0, pickerResults().findIndex(row => row.id === draftModel())))
    draftPickerOpen.set(true)
    dialog.showModal()
    void annotateDriverPickers()
    void nextTick(() => {
      positionDraftPicker()
      if (event?.pointerType !== 'touch') draftPickerSearch.current?.focus()
    })
  }

  function closeDraftPicker() {
    if (comparingModels()) draftModelChoices.set(modelChoicesWithOptions())
    draftPickerDialog.current?.close()
    draftPickerOpen.set(false)
    rememberPrompt()
    draftPickerTrigger.current?.focus()
  }

  function browsePickerAccount(value) {
    pickerAccount.set(value)
    pickerQuery.set('')
    pickerIndex.set(0)
    void nextTick(revealPickerAccount)
  }

  async function toggleModelFavorite(result) {
    if (!Number(activeProfile) || !result.id || favoritePending()) return
    const favorite = { ...agentChoice(result.account), model: result.id }
    const selected = !pickerFavoriteKeys().has(result.key)
    favoritePending.set(true)
    favoriteError.set('')
    try {
      await sendCommand({ type: 'profile.model-favorite.set', profileId: Number(activeProfile), favorite, selected })
      modelFavoritesRevision++
      modelFavorites.update(entries => selected ? [...entries, favorite] : entries.filter(entry => entry.driverKind !== favorite.driverKind
        || entry.providerInstanceId !== favorite.providerInstanceId || entry.model !== favorite.model))
      if (!selected && pickerAccount() === 'favorites') {
        pickerIndex.set(Math.max(0, Math.min(pickerIndex(), pickerResults().length - 1)))
        void nextTick(() => draftPickerSearch.current?.focus({ preventScroll: true }))
      }
    }
    catch (error) {
      favoriteError.set(error.message || 'Could not save this favorite.')
    }
    finally {
      favoritePending.set(false)
    }
  }

  function revealPickerAccount() {
    const list = draftPickerAccounts.current
    const selected = list?.querySelector('[aria-pressed="true"]')
    if (!selected) return
    const selection = selected.getBoundingClientRect()
    const bounds = list.getBoundingClientRect()
    const left = bounds.left + list.clientLeft
    const top = bounds.top + list.clientTop
    const right = left + list.clientWidth
    const bottom = top + list.clientHeight
    // Keep scrolling inside the account list as the dialog changes layout.
    // WebKit can otherwise scroll the wider dialog when resizing a focused picker.
    if (selection.left < left) list.scrollLeft += selection.left - left
    else if (selection.right > right) list.scrollLeft += selection.right - right
    if (selection.top < top) list.scrollTop += selection.top - top
    else if (selection.bottom > bottom) list.scrollTop += selection.bottom - bottom
  }

  function updatePickerQuery(event) {
    pickerQuery.set(event.currentTarget.value)
    pickerIndex.set(0)
  }

  function modelPickerShortcut(result, accessible = false) {
    const index = numberedPickerResults().findIndex(row => row.key === result.key)
    if (index === -1) return ''
    const command = 'modelPicker.jump.' + (index + 1)
    if (!keybindingTable()?.bindings?.[command]) return ''
    return accessible ? shortcutKeys(command) : chordLabel(command)
  }

  function pickerSearchKeydown(event) {
    if (event.isComposing || event.keyCode === 229) return
    if (event.key === 'Escape') {
      event.preventDefault()
      event.stopPropagation()
      closeDraftPicker()
      return
    }
    const rows = pickerResults()
    if (event.key === 'Enter') {
      event.preventDefault()
      if (rows[pickerIndex()]) pickDraftModel(rows[pickerIndex()], event)
    }
    if (rows.length && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
      event.preventDefault()
      const next = (pickerIndex() + (event.key === 'ArrowDown' ? 1 : -1) + rows.length) % rows.length
      pickerIndex.set(next)
      draftPickerResults.current?.querySelector(`#draft-model-result-${next}`)?.scrollIntoView({ block: 'nearest' })
    }
  }

  function matchesDraftModel(selection, result) {
    return selection.account === result.account && selection.id === result.id
  }

  function modelBatchTargetName(selection) {
    if (draftModelChoices().filter(choice => choice.name === selection.name).length < 2) return selection.name
    const account = composerProviders().find(account => account.value === selection.account)
    return selection.name + ' · ' + (account?.name || selection.account)
  }

  function draftModelSelected(result) {
    return comparingModels()
      ? draftModelChoices().some(selection => matchesDraftModel(selection, result))
      : draftProvider() === result.account && draftModel() === result.id
  }

  function currentDraftChoice() {
    const account = selectedDraftAccount()
    const model = selectedDraftModel() || account?.models?.find(model => model.isDefault)
    if (!model) return null
    return { account: account.value, id: model.id, name: model.name, effort: draftEffort(), speed: draftSpeed() }
  }

  function modelChoicesWithOptions() {
    const current = currentDraftChoice()
    return draftModelChoices().map(choice => current && matchesDraftModel(choice, current) ? current : choice)
  }

  function toggleDraftModel(result) {
    if (sessionId || !draftWorktreeOptions()?.canStartWorktree || !result.id) return
    const current = currentDraftChoice()
    const choices = comparingModels() ? modelChoicesWithOptions() : current ? [current] : []
    const selected = choices.find(choice => matchesDraftModel(choice, result))
    if (selected && choices.length === 1) return
    const next = selected
      ? choices.filter(choice => !matchesDraftModel(choice, result))
      : [...choices, { account: result.account, id: result.id, name: result.name, effort: '', speed: '' }]
    draftModelChoices.set(next.length > 1 ? next : [])
    if (next.length === 1 || !current || !next.some(choice => matchesDraftModel(choice, current))) {
      const choice = next[0]
      draftProvider.set(choice.account)
      draftModel.set(choice.id)
      draftEffort.set(choice.effort)
      draftSpeed.set(choice.speed)
    }
    void nextTick(positionDraftPicker)
  }

  function pickDraftModel(result, event) {
    if (event?.shiftKey && !sessionId && draftWorktreeOptions()?.canStartWorktree) {
      toggleDraftModel(result)
      return
    }
    if (!sessionId) {
      const choice = draftModelChoices()?.find(choice => matchesDraftModel(choice, result))
      draftModelChoices.set([])
      if (choice && (draftProvider() !== choice.account || draftModel() !== choice.id)) {
        draftProvider.set(choice.account)
        draftModel.set(choice.id)
        draftEffort.set(choice.effort)
        draftSpeed.set(choice.speed)
      }
    }
    if (draftProvider() !== result.account || draftModel() !== result.id) {
      draftProvider.set(result.account)
      draftModel.set(result.id)
      draftEffort.set(sessionId ? selectedDraftModel()?.defaultReasoningEffort || '' : '')
      draftSpeed.set('')
    }
    if (!sessionId && !result.account.includes(':')) localStorage.setItem('harness.defaultDriver', result.account)
    if (pickerAccount() !== 'favorites') browsePickerAccount(result.account)
    pickerIndex.set(Math.max(0, pickerResults().findIndex(row => row.key === result.key)))
    if (!pickerOptionModel()) closeDraftPicker()
    else void nextTick(positionDraftPicker)
  }

  useEventListener('resize', positionDraftPicker)
  onMount(() => {
    const viewport = draftPickerTrigger.current?.ownerDocument.defaultView?.visualViewport
    if (viewport) {
      useEventListener('resize', positionDraftPicker, { target: viewport })
      useEventListener('scroll', positionDraftPicker, { target: viewport })
    }
  })

  function driverStateLabel(status, version) {
    if (status === 'ready') return version ? `ready · ${version}` : 'ready'
    if (status === 'unauthenticated') return 'signed out'
    if (status === 'unavailable') return 'not installed'
    if (status === 'deleted') return 'account unavailable'
    return 'check failed'
  }

  function agentChoice(value) {
    const [driverKind, accountId] = value.split(':')
    return {
      driverKind,
      ...(accountId ? { providerInstanceId: Number(accountId) } : {}),
    }
  }

  // Each CLI's own login flow, run in the workspace terminal. The CLIs hold
  // their credentials; harness only starts the conversation.
  const LOGIN_COMMANDS = {
    claude: 'claude auth login',
    codex: 'codex login',
    opencode: 'opencode auth login',
    cursor: 'cursor-agent login',
    grok: 'grok login',
  }

  // Live feedback on what each driver can actually do right now: the server
  // probes the CLIs (installed? signed in? version?) and both pickers carry
  // the answer in their option labels, with unusable agents disabled — a
  // driver you cannot run should not be one click from a dead session.
  async function annotateDriverPickers() {
    if (workspaceStatusPaused) return
    providerCatalogRequest?.abort()
    const request = new AbortController()
    providerCatalogRequest = request
    if (!defaultProviders().length) providerCatalog.set('loading')
    const workspace = Number(activeWorkspaceId) || draftProject?.id || 0
    const modelsQuery = canCompose && (!activeSessionId || draftPickerOpen()) ? '&models=1' : ''
    const favoritesRevision = modelFavoritesRevision
    const catalog = await fetch(`/drivers?workspace=${workspace}&profile=${Number(activeProfile) || 0}${modelsQuery}`, { signal: request.signal })
      .then(response => response.ok ? response.json() : null).catch(() => null)
    if (request.signal.aborted) return
    if (!catalog) {
      if (modelsQuery || !defaultProviders().length) providerCatalog.set('failed')
      return
    }
    const { drivers, accounts = [], favorites = [] } = catalog
    canEditProviderAccounts.set(catalog.canEditProviderAccounts === true)
    if (modelsQuery && favoritesRevision === modelFavoritesRevision) modelFavorites.set(favorites)
    const selected = agentChoice(activeDriverValue())
    if (selected.providerInstanceId !== undefined && !accounts.some(account => account.id === selected.providerInstanceId)) {
      accounts.push({ id: selected.providerInstanceId, kind: selected.driverKind, name: 'Saved account', status: 'deleted' })
    }
    defaultProviders.set(drivers.map(info => ({
      ...info, value: info.kind, name: DRIVER_LABELS[info.kind] || info.kind,
      stateText: driverStateLabel(info.status, info.version),
    })))
    providerAccounts.set(accounts.map(account => {
      const managed = account.auth === 'chatgpt'
      const stateText = managed && account.status === 'unauthenticated'
        ? 'Reconnect on host'
        : driverStateLabel(account.status, account.version)
      const provider = managed ? 'ChatGPT plan' : DRIVER_LABELS[account.kind] ?? account.kind
      const name = `${provider} · ${account.name}`
      return { ...account, name, stateText, label: `${name} · ${stateText}`, value: `${account.kind}:${account.id}` }
    }))
    providerCatalog.set('ready')
    if (draftPickerOpen()) void nextTick(positionDraftPicker)
    for (const info of drivers) {
      const stateText = driverStateLabel(info.status, info.version)
      const option = settingsDriverRef.current?.querySelector(`option[value="${info.kind}"]`)
      if (option) {
        const label = DRIVER_LABELS[info.kind] ?? info.kind
        option.disabled = info.status !== 'ready'
        option.textContent = info.status === 'ready' && !info.version ? label : `${label} · ${info.status === 'ready' ? info.version : stateText}`
      }

      // Use the CLI's login action only when the default account is signed out.
      const row = document.querySelector(`[data-agent-row="${info.kind}"]`)
      if (row) {
        row.querySelector('[data-agent-state]').textContent = stateText
        const login = row.querySelector('[data-agent-login]')
        login.hidden = info.status !== 'unauthenticated'
      }
    }
  }

  // Log in = run the CLI's own login flow where it expects to run: a
  // terminal. Opens the workspace terminal and types the command; the CLI
  // takes it from there (device codes, browser hand-offs, whatever it does).
  function loginAgent(event) {
    const kind = event.currentTarget.dataset.kind
    const command = LOGIN_COMMANDS[kind]
    if (!command) return
    if (!Number(activeWorkspaceId)) {
      stxAlert(`Open a workspace first — the login runs in its terminal. Or run \`${command}\` in any terminal yourself.`)
      return
    }
    if (!sessionOnline() || terminalBusy()) {
      stxAlert('Wait for the workspace terminal to connect, then try logging in again.')
      return
    }
    closeSettings()
    if (!termOpen()) toggleTerminal()
    addTerminalTab()
    const tab = activeTerminalTab()
    // The controller holds this input for the selected pane until its PTY binds.
    if (tab) terminalController()?.input(tab, `${command}
`)
  }

  requestAnimationFrame(() => {
    annotateDriverPickers()
    restorePrompt()
    modelBatchNotice.set(pendingModelBatches().flatMap(batch => batch.started || []))
    const choices = draftModelChoices()
    if (!sessionId && Array.isArray(choices) && choices.length > 1) {
      void loadDraftWorktreeOptions()
      const choice = choices[0]
      draftProvider.set(choice.account)
      draftModel.set(choice.id)
      draftEffort.set(choice.effort)
      draftSpeed.set(choice.speed)
    }
  })

  function defaultDriver() {
    // The project's answer where it has one, the host's otherwise. This is
    // where the setting actually bites: it is the agent the composer starts a
    // new thread in this project with.
    const stored = projectPins().defaultDriver || settings().defaultDriver
    return KNOWN_DRIVERS.includes(stored) ? stored : 'claude'
  }

  let settingsTrigger = null

  function settingsLocation() {
    return codecUrl ? import(codecUrl).catch(() => undefined) : Promise.resolve(undefined)
  }

  function focusSettingsHeading() {
    if (settingsSelection() === 'threads') {
      snoozePreviewTime.set(new Date())
      snoozePreviewTimer.resume()
    }
    else snoozePreviewTimer.pause()
    void nextTick(() => {
      if (settingsPanel.current) settingsPanel.current.scrollTop = 0
      const heading = settingsDialogRef.current?.querySelector(`[data-settings-section="${settingsSelection()}"]`)
      heading?.focus({ preventScroll: true })
    })
  }

  function openSettings(event, section = 'general', updateLocation = true) {
    const dialog = settingsDialogRef.current
    if (!dialog || dialog.open) return
    settingsTrigger = event?.currentTarget?.matches?.('[data-account-button]') ? event.currentTarget : null
    workspaceActionsOpen.set(false)
    settingsSelection.set(section)
    dialog.showModal()
    if (updateLocation)
      void settingsLocation().then(location => dialog.open && location?.showSettingsSection(section))
    annotateDriverPickers()
    const box = settingsDriverRef.current
    if (box) box.value = defaultDriver()
    focusSettingsHeading()
  }

  function editSnoozeSettings() {
    closeThreadActions()
    openSettings(null, 'threads')
    settingsTrigger = threadActionsTrigger.current
    void nextTick(() => {
      const panel = settingsPanel.current
      const heading = panel?.querySelector('#settings-snooze-heading')
      if (!panel || !heading) return
      panel.scrollTop += heading.getBoundingClientRect().top - panel.getBoundingClientRect().top - 12
      heading.focus({ preventScroll: true })
    })
  }

  function settingsMatches(section) {
    return settingsResults().some(result => result.id === section)
  }

  function updateSettingsQuery(event) {
    settingsQuery.set(event.currentTarget.value)
  }

  function openMatchingSettings(event) {
    if (event.key !== 'Enter' || event.isComposing || !settingsQuery().trim()) return
    const match = settingsResults()[0]
    if (!match) return
    event.preventDefault()
    jumpToSettings(match.id)
  }

  function jumpToSettings(section) {
    settingsQuery.set('')
    settingsSelection.set(section)
    void settingsLocation().then(location => settingsDialogRef.current?.open && settingsSelection() === section && location?.showSettingsSection(section))
    focusSettingsHeading()
  }

  function hideSettings() {
    // A row left recording would otherwise keep capturing after the sheet is
    // gone, and the next chord pressed in the workspace would be swallowed
    // into a rebind nobody asked for.
    recordingKeybinding.set('')
    keybindingStatus.set('')
    snoozePreviewTimer.pause()
    settingsQuery.set('')
    settingsDialogRef.current?.close()
    settingsTrigger?.focus()
    settingsTrigger = null
  }

  function closeSettings() {
    hideSettings()
    void settingsLocation().then(location => location?.leaveSettings())
  }

  function cancelSettings(event) {
    event.preventDefault()
    closeSettings()
  }

  useEventListener('popstate', () => {
    void settingsLocation().then((location) => {
      const section = location?.currentSettingsSection()
      if (!section) {
        if (settingsDialogRef.current?.open) hideSettings()
        return
      }
      if (!settingsDialogRef.current?.open) openSettings(undefined, section, false)
      else {
        settingsSelection.set(section)
        focusSettingsHeading()
      }
    })
  })

  onMount(() => {
    if (initialSettingsSection) openSettings(undefined, initialSettingsSection, false)
  })

  let threadSearchTimer = null
  let threadSearchRequest = null
  let threadSearchTrigger = null

  function showShareCommand(label, withRepository = false, thread = false) {
    if (thread ? !sessionId : !composerText().trim()) return false
    if (withRepository && !shareRepository()) return false
    return shareSearch().toLowerCase().split(/\s+/).every(word => label.includes(word))
  }

  function loadShareRepository() {
    const workspace = Number(activeScratchSession ? 0 : activeWorkspaceId || draftProject?.id)
    if (!workspace || shareRepositoryRequest) return
    const request = new AbortController()
    shareRepositoryRequest = request
    void fetch('/prompt-link/project?workspace=' + workspace, { signal: request.signal }).then(async (response) => {
      if (!response.ok) return
      const result = await response.json()
      if (!request.signal.aborted) shareRepository.set(result.repository || '')
    }).catch(() => {}).finally(() => { shareRepositoryRequest = undefined })
  }

  async function shareLink(target, address, notice) {
    try {
      await composerDraftTools.writeClipboardText(target, address, desktop()?.clipboard)
      transcriptAnnouncement.set(notice)
    }
    catch {
      shareClipboardTrigger = target
      shareClipboardText.set(address)
      shareClipboardDialog.current?.showModal()
      void nextTick(() => shareClipboardBox.current?.select())
    }
  }

  function closeShareClipboard() {
    shareClipboardDialog.current?.close()
    const trigger = shareClipboardTrigger
    shareClipboardTrigger = null
    shareClipboardText.set('')
    const fallback = sessionId ? threadActionsTrigger.current : promptRef.current
    const focus = trigger?.getClientRects().length ? trigger : fallback
    focus?.focus()
  }

  function copyThreadLink(event) {
    const target = event.currentTarget instanceof HTMLElement ? event.currentTarget : threadActionsTrigger.current
    if (!sessionId || !target || !composerDraftTools) return
    if (threadActionsDialog.current?.open) closeThreadActions()
    if (threadSearchDialog.current?.open) closeThreadSearch()
    void shareLink(target, composerDraftTools.threadLink(target.ownerDocument.location.origin, sessionId), 'Thread link copied.')
  }

  function copyDraftPromptLink(event, withRepository = false) {
    const target = event.currentTarget
    if (!target || !composerDraftTools) return
    try {
      const context = withRepository && shareRepository() ? {
        repository: shareRepository(), provider: agentChoice(draftProvider()).driverKind, model: draftModel(),
      } : undefined
      const address = composerDraftTools.newThreadLink(target.ownerDocument.location.origin, composerText(), context)
      closeThreadSearch()
      void shareLink(target, address, 'Prompt link copied.')
    }
    catch (error) { stxAlert(error.message) }
  }

  function openThreadSearch(event) {
    const dialog = threadSearchDialog.current
    if (!dialog || dialog.open || (!Number(activeProfile) && !composerText().trim())) return
    threadSearchTrigger = event?.currentTarget?.matches?.('[data-thread-search-toggle], [data-nav-search]') ? event.currentTarget : null
    workspaceActionsOpen.set(false)
    if (composerText().trim()) loadShareRepository()
    dialog.showModal()
    threadSearchInput.current?.focus()
  }

  function closeThreadSearch() {
    threadSearchTimer?.stop()
    threadSearchRequest?.abort()
    threadSearchResults.set([])
    threadSearchStatus.set('')
    shareSearch.set('')
    if (threadSearchInput.current) threadSearchInput.current.value = ''
    threadSearchDialog.current?.close()
    threadSearchTrigger?.focus()
    threadSearchTrigger = null
  }

  function cancelThreadSearch(event) {
    event.preventDefault()
    closeThreadSearch()
  }

  function queueThreadSearch(event) {
    if (event.isComposing) return
    const query = event.currentTarget.value.trim()
    shareSearch.set(query)
    threadSearchTimer?.stop()
    threadSearchRequest?.abort()
    threadSearchResults.set([])
    threadSearchIndex.set(0)
    threadSearchStatus.set('')
    if (!query || !Number(activeProfile)) return
    threadSearchTimer = useTimeout(() => searchThreadResults(query), 160)
  }

  async function searchThreadResults(query) {
    const request = new AbortController()
    threadSearchRequest = request
    threadSearchStatus.set('Searching…')
    try {
      const params = new URLSearchParams({ profile: String(activeProfile), q: query })
      const response = await fetch(`/threads/search?${params}`, { signal: request.signal })
      if (!response.ok) throw new Error('Thread search failed.')
      const { results } = await response.json()
      if (request.signal.aborted) return
      threadSearchResults.set(results)
      threadSearchStatus.set(results.length ? '' : 'No matching threads.')
    }
    catch {
      if (!request.signal.aborted) threadSearchStatus.set('Could not search threads. Try again.')
    }
  }

  function chooseThreadSearchResult(result) {
    if (!result) return
    closeThreadSearch()
    navigate(`/s/${result.id}${result.turnId ? `#turn-${result.turnId}` : ''}`)
  }

  function threadSearchKeydown(event) {
    if (event.isComposing) return
    if (event.key === 'Escape') {
      event.preventDefault()
      event.stopPropagation()
      closeThreadSearch()
      return
    }
    const results = threadSearchResults()
    if (results.length === 0) {
      const command = threadSearchDialog.current?.querySelector('[data-share-commands]:not([hidden]) button:not([hidden])')
      if (event.key === 'Enter' && command) {
        event.preventDefault()
        command.click()
      }
      return
    }
    if (event.key === 'Enter') {
      event.preventDefault()
      chooseThreadSearchResult(results[threadSearchIndex()])
      return
    }
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return
    event.preventDefault()
    const step = event.key === 'ArrowDown' ? 1 : -1
    const index = (threadSearchIndex() + step + results.length) % results.length
    threadSearchIndex.set(index)
    threadSearchList.current?.children[index]?.scrollIntoView({ block: 'nearest' })
  }

  function saveDriverChoice() {
    const box = settingsDriverRef.current
    if (box) void updateSettings({ defaultDriver: box.value })
  }

  function setTerminalShell(event) {
    void updateSettings({ terminalShell: event.currentTarget.value })
  }

  // The desktop app menu's Settings… item (Cmd+,): craft evaluates this
  // event into the page, so the menu opens the same modal the chord does.
  useEventListener('craft:settings', openSettings, { target: window })

  // The desktop menu bar, declared by the page — the page is what knows
  // what harness can do. craft builds the native NSMenu from this: role
  // items (copy, paste, minimize…) act through the responder chain exactly
  // like a nib-built menu — the Edit roles are what make Cmd+C/V/X work in
  // the webview at all — and id items come back as `craft:menu:action`
  // events, routed below. In a plain browser there is no bridge and the
  // browser's own menus apply.
  effect(() => {
    if (!craftMenuReady()) return
    const focused = termOpen() && terminalInputFocused()
    const bindings = keybindingTable()?.bindings
    const canOperate = focused && sessionOnline() && !terminalBusy()
    const canSplit = focused && canSplitTerminal()
    const undoShortcut = visibleUndo() && threadUndoShortcutClaimed() && !focused ? keyboard?.craftShortcut(bindings?.['thread.undo']) : undefined
    const threadUndoItem = { id: 'thread.undo', label: 'Undo Thread Action', shortcut: undoShortcut }
    const terminalItem = (id, enabled) => ({
      id,
      label: keybindingRow(id)?.label,
      shortcut: keyboard?.craftShortcut(bindings?.[id]),
      enabled,
    })
    desktop()?.menu?.set({ menus: [
      { label: 'harness', items: [
        { id: 'about', label: 'About harness', role: 'about' },
        { separator: true },
        { id: 'settings', label: 'Settings…', shortcut: 'cmd+,' },
        { separator: true },
        { id: 'hide', label: 'Hide harness', role: 'hide', shortcut: 'cmd+h' },
        { id: 'hide-others', label: 'Hide Others', role: 'hideOthers', shortcut: 'cmd+alt+h' },
        { id: 'show-all', label: 'Show All', role: 'showAll' },
        { separator: true },
        { id: 'quit', label: 'Quit harness', role: 'quit', shortcut: 'cmd+q' },
      ] },
      { label: 'File', items: [
        { id: 'new-session', label: 'New Session', shortcut: focused ? undefined : 'cmd+n' },
        ...(focused ? [terminalItem('terminal.new', canOperate)] : []),
        { separator: true },
        { id: 'close-window', label: 'Close Window', role: 'close', shortcut: focused ? undefined : 'cmd+w' },
        ...(focused ? [terminalItem('terminal.close', canOperate)] : []),
      ] },
      { label: 'Edit', items: [
        ...(undoShortcut === 'cmd+z' ? [threadUndoItem] : [
          { id: 'undo', label: 'Undo', role: 'undo', shortcut: 'cmd+z' },
          ...(undoShortcut ? [threadUndoItem] : []),
        ]),
        { id: 'redo', label: 'Redo', role: 'redo', shortcut: 'cmd+shift+z' },
        { separator: true },
        { id: 'cut', label: 'Cut', role: 'cut', shortcut: 'cmd+x' },
        { id: 'copy', label: 'Copy', role: 'copy', shortcut: 'cmd+c' },
        { id: 'paste', label: 'Paste', role: 'paste', shortcut: 'cmd+v' },
        { id: 'select-all', label: 'Select All', role: 'selectAll', shortcut: 'cmd+a' },
      ] },
      { label: 'View', items: [
        { id: 'toggle-terminal', label: 'Toggle Terminal', shortcut: keyboard?.craftShortcut(bindings?.['terminal.toggle']) ?? 'ctrl+`' },
        ...(focused ? [terminalItem('terminal.split', canSplit), terminalItem('terminal.splitVertical', canSplit)] : []),
        { separator: true },
        { id: 'reload', label: 'Reload', role: 'reload', shortcut: 'cmd+r' },
      ] },
      { label: 'Window', items: [
        { id: 'minimize', label: 'Minimize', role: 'minimize', shortcut: 'cmd+m' },
        { id: 'zoom', label: 'Zoom', role: 'zoom' },
        { separator: true },
        { id: 'front', label: 'Bring All to Front', role: 'front' },
      ] },
    ] })
  })

  useEventListener('craft:menu:action', (event) => {
    const id = event.detail?.id
    if (id === 'settings') openSettings()
    else if (id === 'new-session') openDraft(visibleProfile())
    else if (id === 'toggle-terminal') toggleTerminal()
    else if (id === 'thread.undo' && visibleUndo() && !threadUndoBlocked() && !profileModalOpen()) void undoThreadAction()
    else if (termOpen() && terminalInputFocused()) runTerminalShortcut(id)
  }, { target: window })

  // Access: the devices paired with this server. Revoking dispatches the
  // same command the CLI uses; the list is server-rendered, so refresh.
  async function revokeDevice(event) {
    const deviceId = event.currentTarget.dataset.deviceId
    if (!deviceId) return
    const device = event.currentTarget.closest('li')
    if (!(await stxConfirm(`Revoke ${device?.querySelector('span')?.textContent ?? deviceId}? Its socket drops immediately.`))) return
    try {
      await sendCommand({ type: 'device.revoke', deviceId })
      refresh()
    }
    catch (error) {
      stxAlert(error.message)
    }
  }

  // Mint a pairing code through the endpoint the CLI uses; the session cookie
  // authenticates the fetch. Shown inline: the person pairing a phone is
  // looking at this screen and the phone at the same time.
  async function startPairing() {
    const response = await fetch('/pair/new', { method: 'POST' }).catch(() => null)
    if (!response?.ok) {
      stxAlert('Could not open pairing — is the server running with --remote?')
      return
    }
    const { code } = await response.json()
    pairCode.set(code)
  }

  async function createProfile() {
    const box = profileNameRef.current
    const name = (box?.value ?? '').trim()
    if (!name) return
    try {
      await sendCommand({ type: 'profile.create', name })
      profileModalOpen.set(false)
      box.value = ''
      refresh()
    }
    catch (error) {
      stxAlert(error.message)
    }
  }

  // Spaces beyond the active one's neighbours render without their rows, so
  // arriving at one has to fetch it. Navigating rather than rebuilding rows in
  // JS keeps a single renderer: the server already knows how to draw a space,
  // and a second implementation here would be one more thing to keep in step.
  // `spaceChange`, unprefixed: stx's defineEmits dispatches the bare event name
  // on the component's scope element, and it bubbles to here.
  useEventListener('spaceChange', (event) => {
    const id = event.detail?.id
    if (!id) return
    visibleProfile.set(id)
    watchSidebarOrder()
    // Repaint first: a swipe should feel like the window changed colour with
    // it, not after a round trip.
    paintWindow(id)
    if (!sessionId && String(id) !== String(activeProfile)) {
      navigate(`/?profile=${encodeURIComponent(id)}`)
      return
    }
    const panel = document.querySelector(`[data-space][data-space-id="${CSS.escape(id)}"]`)
    // Only a deferred panel needs the round trip; a neighbour is already drawn.
    if (!panel || !panel.hasAttribute('data-space-deferred')) return
    navigate(`/?profile=${encodeURIComponent(id)}`)
  }, { target: document })

  function setDiffFileLimit(path, limit) {
    diffFileLimits.update(current => {
      const next = new Map(current)
      if (limit) next.set(path, limit)
      else next.delete(path)
      return next
    })
  }

  function toggleDiffFile(file) {
    if (file.open && diffLineSelection()?.path === file.path) diffLineSelection.set(null)
    setDiffFileLimit(file.path, file.open ? 0 : diffPageSize)
    if (!file.open) void loadDiffContext(file.path)
    else {
      diffContextRequests.get(file.path)?.controller.abort()
      diffContextRequests.delete(file.path)
      diffContexts.update(current => {
        const next = new Map(current)
        next.delete(file.path)
        return next
      })
    }
  }

  function collapseDiffFiles() {
    stopDiffContextRequests()
    diffContexts.set(new Map())
    diffLineSelection.set(null)
    diffFileLimits.set(new Map())
  }

  function showMoreDiffRows(path) {
    setDiffFileLimit(path, (diffFileLimits().get(path) || 0) + diffPageSize)
  }

  function rememberRepositoryPullRequest(link) {
    linkedRepositoryPullRequests.update(current => current.some(item => item.repositoryKey === link.repositoryKey
      && item.repository === link.repository && item.number === link.number) ? current : current.concat(link))
  }

  function pullRequestLink(link) {
    return link ? 'https://github.com/' + link.repository + '/pull/' + link.number : undefined
  }

  function reviewPullRequestHref(link) {
    const selectedUrl = pullRequestLink(link)
    if (!selectedUrl) return undefined
    return '/pull-requests?' + new URLSearchParams({ profile: String(activeProfile), selectedUrl })
  }

  function toggleRepositoryChecks() {
    if (repositoryChecksOpen()) {
      repositoryChecksRequest?.abort()
      repositoryChecksLoading.set(false)
      repositoryChecksOpen.set(false)
      return
    }
    repositoryChecksShowAll.set(false)
    repositoryChecksOpen.set(true)
    void refreshRepositoryChecks()
  }

  async function refreshRepositoryChecks() {
    if (repositoryChecksLoading() || !selectedRepositoryPullRequest()) return
    const request = new AbortController()
    repositoryChecksRequest = request
    repositoryChecksLoading.set(true)
    repositoryChecksError.set('')
    const params = new URLSearchParams({ repository: diffRepository() })
    try {
      const response = await fetch('/s/' + sessionId + '/git/pull-request-checks?' + params, { signal: request.signal, cache: 'no-store' })
      const data = await response.json().catch(() => ({}))
      if (request.signal.aborted) return
      if (!response.ok) throw new Error(data.error || 'Could not read checks from GitHub. Try again.')
      repositoryChecksData.set(data)
    }
    catch (error) {
      if (!request.signal.aborted) {
        repositoryChecksData.set(null)
        repositoryChecksError.set(error.message || 'Could not read checks from GitHub. Try again.')
      }
    }
    finally {
      if (repositoryChecksRequest === request) {
        repositoryChecksLoading.set(false)
        repositoryChecksRequest = undefined
      }
    }
  }

  function toggleAllRepositoryChecks() {
    repositoryChecksShowAll.update(value => !value)
  }

  function openRepositoryPullRequest(event, publication = null) {
    repositoryPullRequestTrigger = event.currentTarget
    repositoryPullRequestContinuation.set(publication)
    repositoryPullRequestKey = diffRepository()
    repositoryPullRequestPreview.set(null)
    repositoryPullRequestResult.set(null)
    repositoryPullRequestBaseText.set('')
    repositoryPullRequestTitleText.set('')
    if (repositoryPullRequestBase.current) repositoryPullRequestBase.current.value = ''
    if (repositoryPullRequestTitle.current) repositoryPullRequestTitle.current.value = ''
    if (repositoryPullRequestBody.current) repositoryPullRequestBody.current.value = ''
    if (repositoryPullRequestDraft.current) repositoryPullRequestDraft.current.checked = false
    repositoryPullRequestDialog.current?.showModal()
    void runRepositoryPullRequest()
  }

  function closeRepositoryPullRequest() {
    if (repositoryPullRequestBusy()) return
    repositoryPullRequestRequest?.abort()
    repositoryPullRequestDialog.current?.close()
    if (repositoryPullRequestTrigger?.offsetWidth) repositoryPullRequestTrigger.focus()
    else diffClose.current?.focus()
  }

  function setRepositoryPullRequestBase(value) {
    repositoryPullRequestBaseText.set(value)
  }

  function setRepositoryPullRequestTitle(value) {
    repositoryPullRequestTitleText.set(value)
  }

  async function runRepositoryPullRequest(input) {
    repositoryPullRequestRequest?.abort()
    const request = new AbortController()
    repositoryPullRequestRequest = request
    repositoryPullRequestError.set('')
    repositoryPullRequestLoading.set(!input)
    repositoryPullRequestBusy.set(Boolean(input))
    const params = new URLSearchParams()
    if (repositoryPullRequestKey) params.set('repository', repositoryPullRequestKey)
    if (repositoryPullRequestContinuation()) params.set('publication', repositoryPullRequestContinuation())
    const base = repositoryPullRequestBaseText().trim()
    if (base && !input) params.set('base', base)
    try {
      const response = await fetch('/s/' + sessionId + '/git/pull-request?' + params, {
        signal: request.signal,
        ...(input ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(input) } : {}),
      })
      const data = await response.json().catch(() => ({}))
      if (request.signal.aborted) return
      if (!response.ok) throw new Error(data.error || 'Could not prepare the pull request.')
      if (input) {
        showRepositoryPullRequestResult(data, repositoryPullRequestKey)
        if (data.linked && repositoryPullRequestContinuation()) repositoryCommitFeedback.set(null)
        repositoryPullRequestBusy.set(false)
        closeRepositoryPullRequest()
        diffClose.current?.focus()
        refreshWorkspaceDiff()
      }
      else {
        if (!repositoryPullRequestPreview() && repositoryPullRequestContinuation()) {
          if (repositoryPullRequestBody.current) repositoryPullRequestBody.current.value = data.body || ''
          if (repositoryPullRequestDraft.current) repositoryPullRequestDraft.current.checked = data.draft === true
        }
        repositoryPullRequestPreview.set(data)
        repositoryPullRequestBaseText.set(data.baseRef)
        if (repositoryPullRequestBase.current) repositoryPullRequestBase.current.value = data.baseRef
        if (!repositoryPullRequestTitleText().trim() && repositoryPullRequestTitle.current) {
          repositoryPullRequestTitleText.set(data.title)
          repositoryPullRequestTitle.current.value = data.title
        }
        repositoryPullRequestError.set(data.problem || '')
      }
    }
    catch (error) {
      if (!request.signal.aborted) repositoryPullRequestError.set(error.message || 'Could not complete the pull request.')
    }
    finally {
      if (repositoryPullRequestRequest === request) {
        repositoryPullRequestLoading.set(false)
        repositoryPullRequestBusy.set(false)
        repositoryPullRequestRequest = undefined
      }
    }
  }

  function showRepositoryPullRequestResult(data, repository) {
    const link = data.pullRequest
    if (data.linked) rememberRepositoryPullRequest({ repository: link.repository, number: link.number, repositoryKey: repository })
    repositoryPullRequestResult.set({ repository, url: link.url, number: link.number,
      message: data.headChanged ? 'The pull request is open. GitHub reports a different head commit.'
        : data.linked ? (data.existing ? 'Linked pull request' : 'Opened pull request')
          : 'Pull request open on GitHub. Refresh the review to link it to this thread.' })
  }

  function refreshRepositoryPullRequest() {
    if (!repositoryPullRequestLoading() && !repositoryPullRequestBusy()) void runRepositoryPullRequest()
  }

  function submitRepositoryPullRequest() {
    if (!repositoryPullRequestCanSubmit()) return
    const { revision, baseRef } = repositoryPullRequestPreview()
    void runRepositoryPullRequest({ revision, baseRef, title: repositoryPullRequestTitle.current?.value || '',
      body: repositoryPullRequestBody.current?.value || '', draft: repositoryPullRequestDraft.current?.checked === true })
  }

  let repositorySyncPublication

  function openRepositorySync(action, event, publication) {
    repositorySyncTrigger = event.currentTarget
    repositorySyncKey = diffRepository()
    repositorySyncPublication = publication
    repositorySyncAction.set(action)
    repositorySyncResult.set(null)
    repositorySyncDialog.current?.showModal()
    void loadRepositorySync()
  }

  function closeRepositorySync() {
    if (repositorySyncBusy()) return
    repositorySyncRequest?.abort()
    repositorySyncDialog.current?.close()
    if (repositorySyncTrigger?.offsetWidth) repositorySyncTrigger.focus()
    else diffClose.current?.focus()
  }

  async function runRepositorySync(revision) {
    repositorySyncRequest?.abort()
    const request = new AbortController()
    repositorySyncRequest = request
    repositorySyncError.set('')
    repositorySyncBusy.set(Boolean(revision))
    repositorySyncLoading.set(!revision)
    if (!revision) repositorySyncPreview.set(null)
    const params = new URLSearchParams()
    if (repositorySyncKey) params.set('repository', repositorySyncKey)
    if (repositorySyncPublication) params.set('publication', repositorySyncPublication)
    const query = params.size ? '?' + params : ''
    try {
      const response = await fetch('/s/' + sessionId + '/git/' + repositorySyncAction() + query, {
        signal: request.signal,
        ...(revision ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ revision }) } : {}),
      })
      const body = await response.json().catch(() => ({}))
      if (request.signal.aborted) return
      if (!response.ok) throw new Error(body.error || 'Could not complete the Git action.')
      if (revision) {
        if (repositorySyncPublication && repositoryPublication()?.id === repositorySyncPublication) {
          repositoryPublication.set(null)
          repositoryCommitFeedback.set(null)
        }
        repositorySyncResult.set({ repository: repositorySyncKey, message: body.message })
        repositorySyncBusy.set(false)
        closeRepositorySync()
        diffClose.current?.focus()
        refreshWorkspaceDiff()
      }
      else {
        repositorySyncPreview.set(body)
        repositorySyncPublication = repositorySyncPublication || body.publication
        repositorySyncError.set(body.problem || '')
      }
    }
    catch (error) {
      if (!request.signal.aborted) repositorySyncError.set(error.message || 'Could not complete the Git action.')
    }
    finally {
      if (repositorySyncRequest === request) {
        repositorySyncBusy.set(false)
        repositorySyncLoading.set(false)
        repositorySyncRequest = undefined
      }
    }
  }

  function loadRepositorySync() {
    if (!repositorySyncBusy()) void runRepositorySync()
  }

  function submitRepositorySync() {
    const revision = repositorySyncPreview()?.revision
    if (revision && !repositorySyncBusy() && !repositorySyncError()) void runRepositorySync(revision)
  }

  function repositoryCommitAddress() {
    const query = new URLSearchParams()
    if (repositoryCommitKey) query.set('repository', repositoryCommitKey)
    if (!repositoryCommitStaged()) query.set('scope', 'working')
    if (repositoryCommitPublishes()) query.set('publish', repositoryCommitMode())
    return '/s/' + sessionId + '/git/commit' + (query.size ? '?' + query : '')
  }

  function openRepositoryCommit(scope, event, mode = '') {
    repositoryCommitTrigger = event.currentTarget
    repositoryCommitKey = diffRepository()
    repositoryCommitScope.set(scope)
    repositoryCommitMode.set(mode)
    stackedPullRequestTitle.set('')
    stackedPullRequestBody.set('')
    stackedPullRequestDraft.set(false)
    repositoryCommitMessage.set('')
    repositoryCommitNewBranch.set(false)
    repositoryCommitFeedback.set(null)
    repositoryCommitPreview.set(null)
    repositoryCommitExcluded.set(new Set())
    repositoryCommitEditing.set(false)
    repositoryCommitLimit.set(40)
    repositoryCommitDialog.current?.showModal()
    void loadRepositoryCommit()
  }

  function chooseRepositoryCommitFile(index, event) {
    const excluded = new Set(repositoryCommitExcluded())
    if (event.currentTarget.checked) excluded.delete(index)
    else excluded.add(index)
    repositoryCommitExcluded.set(excluded)
  }

  function chooseAllRepositoryCommitFiles(event) {
    const excluded = event.currentTarget.checked ? [] : repositoryCommitPreview().files.map((_, index) => index)
    repositoryCommitExcluded.set(new Set(excluded))
  }

  function closeRepositoryCommit() {
    if (repositoryCommitBusy()) return
    repositoryCommitRequest?.abort()
    repositoryCommitDialog.current?.close()
    if (repositoryCommitTrigger?.offsetWidth) repositoryCommitTrigger.focus()
    else diffClose.current?.focus()
  }

  function retryRepositoryPublication(event, fromReview = false) {
    const publication = fromReview ? repositoryCommitPreview()?.pendingPublication : repositoryPublication()
    if (!publication || (fromReview && repositoryCommitBusy())) return
    if (fromReview) {
      repositoryPublication.set({ ...publication, repository: repositoryCommitKey })
      repositoryCommitDialog.current?.close()
    }
    openRepositorySync('push', event, publication.id)
  }

  async function loadRepositoryCommit() {
    if (repositoryCommitBusy()) return
    repositoryCommitRequest?.abort()
    const request = new AbortController()
    repositoryCommitRequest = request
    repositoryCommitLoading.set(true)
    repositoryCommitError.set('')
    repositoryCommitGenerationFailed.set(false)
    const fallback = repositoryCommitStaged() ? 'Could not read the staged changes.' : 'Could not read the working-tree changes.'
    try {
      const response = await fetch(repositoryCommitAddress(), { signal: request.signal })
      const value = await response.json().catch(() => ({}))
      if (request.signal.aborted) return
      if (!response.ok) throw new Error(value.error || fallback)
      const previous = repositoryCommitPreview()
      const excluded = repositoryCommitExcluded()
      if (previous && excluded.size) {
        const included = new Set(previous.fileKeys.filter((_, index) => !excluded.has(index)))
        repositoryCommitExcluded.set(new Set(value.fileKeys.flatMap((key, index) => included.has(key) ? [] : [index])))
      }
      repositoryCommitPreview.set(value)
      if (value.problem) repositoryCommitError.set(value.problem)
    }
    catch (error) {
      if (!request.signal.aborted) repositoryCommitError.set(error.message || fallback)
    }
    finally {
      if (repositoryCommitRequest === request) {
        repositoryCommitLoading.set(false)
        repositoryCommitRequest = undefined
      }
    }
  }

  async function submitRepositoryCommit(newBranch = false) {
    const preview = repositoryCommitPreview()
    const message = repositoryCommitMessage().trim()
    if (!preview || !(newBranch ? repositoryCommitFeatureAllowed() : repositoryCommitCurrentAllowed())) return
    const target = newBranch ? preview.publish?.feature : preview.publish?.current
    const request = new AbortController()
    repositoryCommitRequest = request
    repositoryCommitNewBranch.set(newBranch)
    repositoryCommitBusy.set(true)
    repositoryCommitError.set('')
    repositoryCommitGenerationFailed.set(false)
    try {
      const response = await fetch(repositoryCommitAddress(), {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ message, revision: preview.revision, excluded: [...repositoryCommitExcluded()],
          newBranch, ...(!message && { generate: preview.generation }),
          ...(target && { publication: { id: crypto.randomUUID(), revision: target.revision } }),
          ...(repositoryCommitStacks() && { pullRequest: {
            revision: preview.pullRequest.revision, baseRef: preview.pullRequest.baseRef,
            title: stackedPullRequestTitle(), body: stackedPullRequestBody(), draft: stackedPullRequestDraft(),
            ...(!stackedPullRequestTitle().trim() && preview.pullRequest.generation && { generate: preview.pullRequest.generation }),
          } }),
        }), signal: request.signal,
      })
      const value = await response.json().catch(() => ({}))
      if (request.signal.aborted) return
      if (!response.ok || !value.commit) {
        repositoryCommitGenerationFailed.set(value.generationFailed === true)
        throw new Error(value.error || 'Could not confirm the commit.')
      }
      repositoryCommitFeedback.set({ repository: repositoryCommitKey,
        message: 'Committed ' + value.commit.slice(0, 7) + (value.branch ? ' on ' + value.branch : '') + '.'
          + (value.warning ? ' ' + value.warning : '') + (value.publication ? ' ' + value.publication.message : ''),
      })
      if (value.publication?.pullRequest) showRepositoryPullRequestResult(value.publication.pullRequest, repositoryCommitKey)
      if (value.publication?.retryable)
        repositoryPublication.set({ id: value.publication.id, commit: value.commit, repository: repositoryCommitKey })
      repositoryCommitBusy.set(false)
      repositoryCommitDialog.current?.close()
      diffClose.current?.focus()
      refreshWorkspaceDiff()
    }
    catch (error) {
      if (!request.signal.aborted) repositoryCommitError.set(error.message || 'Could not confirm the commit.')
    }
    finally {
      if (repositoryCommitRequest === request) {
        repositoryCommitBusy.set(false)
        repositoryCommitRequest = undefined
      }
    }
  }

  function refreshWorkspaceDiff() {
    diffRefresh.update(value => value + 1)
  }

  function matchingDiffContext(path, hunks) {
    const entry = diffContexts().get(path)
    return entry && entry.key === diffTools?.workspaceDiffContextKey(hunks) ? entry : undefined
  }

  function setDiffContext(path, entry) {
    diffContexts.update(current => new Map(current).set(path, entry))
  }

  function stopDiffContextRequests() {
    for (const request of diffContextRequests.values()) request.controller.abort()
    diffContextRequests.clear()
  }
  onDestroy(stopDiffContextRequests)

  async function loadDiffContext(path, retry = false) {
    if (!canExpandDiffContext) return
    const hunks = diffHunks().get(path)
    const key = diffTools?.workspaceDiffContextKey(hunks)
    if (!key) return
    const existing = diffContexts().get(path)
    if (existing?.key === key && (!retry || !existing.error)) return existing.value
    const previous = diffContextRequests.get(path)
    if (previous?.key === key) return previous.promise
    previous?.controller.abort()
    const controller = new AbortController()
    const active = () => !controller.signal.aborted && diffTools.workspaceDiffContextKey(diffHunks().get(path)) === key
    const promise = diffTools.loadWorkspaceDiffContext(sessionId, path, hunks[0].beforeObject, {
      mode: diffReviewMode(), target: diffComparisonTarget, repository: diffRepository(),
    }, controller.signal).then(lines => {
      if (!active()) return
      const value = { lines, revealed: new Map() }
      setDiffContext(path, { key, value })
      return value
    }).catch(error => {
      if (active()) setDiffContext(path, { key, error: error.message })
    }).finally(() => {
      if (diffContextRequests.get(path)?.controller === controller) diffContextRequests.delete(path)
    })
    diffContextRequests.set(path, { key, controller, promise })
    return promise
  }

  function expandDiffContext(path, gap, direction, event) {
    const entry = matchingDiffContext(path, diffHunks().get(path))
    if (!entry?.value) return
    const button = event.currentTarget
    setDiffContext(path, { ...entry, value: diffTools.expandWorkspaceDiffGap(entry.value, gap, direction) })
    void nextTick(() => {
      if (!button.isConnected) diffTools.revealWorkspaceDiffLine(changesPane.current, { path, side: 'after', line: gap.after }, true)
    })
  }

  function clearDiffComparison() {
    stopDiffContextRequests()
    pendingDiffLineLink = null
    pendingTurnFile = null
    diffComparisonTarget = undefined
    batch(() => {
      diffStatus.set('Loading comparison…')
      diffFiles.set([])
      diffPatch.set('')
      diffHunks.set(new Map())
      diffFileLimits.set(new Map())
      diffLineSelection.set(null)
      diffLineNotice.set('')
      diffLineReveal.set(null)
      diffContexts.set(new Map())
    })
  }

  function selectDiffRepository(repository) {
    const reviewingTurn = diffReviewMode() === 'turn'
    clearDiffComparison()
    batch(() => {
      diffReviewOptions.set(null)
      diffRepository.set(repository)
      if (!reviewingTurn) {
        diffReviewMode.set(repository ? 'uncommitted' : 'session')
        diffTurn.set('')
      }
      diffBaseRef.set('')
      diffCommit.set('')
    })
  }

  function changeDiffRepository(event) {
    selectDiffRepository(event.currentTarget.value)
  }

  function changeDiffReviewMode(event) {
    clearDiffComparison()
    diffReviewMode.set(event.currentTarget.value)
  }

  function changeDiffBase(event) {
    clearDiffComparison()
    diffCommit.set('')
    diffBaseRef.set(event.currentTarget.value)
  }

  function changeDiffCommit(event) {
    clearDiffComparison()
    diffCommit.set(event.currentTarget.value)
  }

  function changeDiffTurn(event) {
    clearDiffComparison()
    diffTurn.set(event.currentTarget.value)
  }

  function diffLineLabel(cell, side) {
    if (!cell) return ''
    if (diffLayout() === 'split') return side === 0 ? 'Before line ' + cell.before : 'After line ' + cell.after
    if (cell.kind === 'deletion') return 'Removed line ' + cell.before
    if (cell.kind === 'addition') return 'Added line ' + cell.after
    return 'Before line ' + cell.before + ', after line ' + cell.after
  }

  function diffGutterSide(side) {
    return diffLayout() === 'split' && side === 0 ? 'before' : 'after'
  }

  function isDiffLineSelected(path, side, line) {
    const selected = diffLineSelection()
    return selected?.path === path && selected.side === side && selected.line === line
  }

  function selectDiffLine(path, side, line) {
    diffLineSelection.set({ path, side, line })
    diffLineNotice.set('')
  }

  function navigateDiffLines(event) {
    const selected = diffTools?.moveWorkspaceDiffLine(event)
    if (selected) selectDiffLine(selected.path, selected.side, selected.line)
  }

  function revealSelectedDiffLine() {
    const selection = diffLineSelection()
    if (diffOpen() && selection) void nextTick(() => diffTools.revealWorkspaceDiffLine(changesPane.current, selection))
  }
  useEventListener('resize', revealSelectedDiffLine)

  function changeDiffLayout(layout) {
    diffLayout.set(layout)
    revealSelectedDiffLine()
  }

  function toggleDiffWrap() {
    diffWrap.set(!diffWrap())
    revealSelectedDiffLine()
  }

  async function copyDiffLineLink(event) {
    const line = diffLineSelection()
    if (!line) return
    try {
      await diffTools.copyWorkspaceDiffLink(event.currentTarget, {
        ...line, mode: diffReviewMode(), target: diffComparisonTarget, repository: diffRepository(),
      }, desktop()?.clipboard)
      diffLineNotice.set('Line link copied.')
    }
    catch { diffLineNotice.set('Could not copy the line link.') }
  }

  function openLinkedDiffLine() {
    const link = diffTools?.currentWorkspaceDiffLink(changesPane.current)
    if (!link) return
    clearDiffComparison()
    pendingDiffLineLink = link
    batch(() => {
      if (diffRepository() !== (link.repository || '')) diffReviewOptions.set(null)
      diffRepository.set(link.repository || '')
      diffReviewMode.set(link.mode)
      diffBaseRef.set(link.mode === 'branch' ? link.target || '' : '')
      diffCommit.set(link.mode === 'commit' ? link.target : '')
      diffTurn.set(link.mode === 'turn' ? link.target : '')
      if (workspaceFilesOpen()) closeWorkspaceFiles(false)
      diffOpen.set(true)
      refreshWorkspaceDiff()
    })
  }
  useEventListener('hashchange', openLinkedDiffLine)

  async function selectLinkedDiffLine(link) {
    let hunks = diffHunks().get(link.path)
    let found = diffTools.hasWorkspaceDiffLine(hunks, link)
    if (!found && hunks) {
      const context = await loadDiffContext(link.path)
      if (pendingDiffLineLink !== link) return
      hunks = diffHunks().get(link.path)
      const entry = matchingDiffContext(link.path, hunks)
      const revealed = context && hunks && entry?.value === context && diffTools.revealWorkspaceDiffContext(hunks, context, link)
      if (revealed) {
        found = true
        setDiffContext(link.path, { ...entry, value: revealed })
      }
    }
    if (pendingDiffLineLink !== link) return
    pendingDiffLineLink = null
    if (!found) {
      diffLineNotice.set('The selected line is no longer in this comparison.')
      return
    }
    diffLineReveal.set(link)
    selectDiffLine(link.path, link.side, link.line)
    void nextTick(() => diffTools.revealWorkspaceDiffLine(changesPane.current, link, true))
  }

  function showWorkspaceChanges(diff) {
    const files = diff.error ? [] : diff.files
    const count = `${diff.files.length} changed file${diff.files.length === 1 ? '' : 's'}`
    const scopes = {
      session: 'since this session started',
      'working-tree': 'in the working tree',
      branch: 'against ' + diff.comparisonLabel,
      commit: 'in commit ' + diff.comparisonLabel,
      turn: 'in turn ' + diff.comparisonLabel,
    }
    const scope = scopes[diff.scope]
    const insertions = files.reduce((total, file) => total + file.insertions, 0)
    const deletions = files.reduce((total, file) => total + file.deletions, 0)
    const status = diff.error ? diff.error
      : !diff.isRepository ? 'This workspace is not a git repository.'
      : files.length ? `${count} ${scope} · +${insertions} −${deletions}`
      : diff.scope === 'working-tree' ? 'No uncommitted changes.' : `No changes ${scope}.`
    diffComparisonTarget = diff.comparisonTarget
    const linked = pendingDiffLineLink
    const selectedFile = pendingTurnFile
    pendingTurnFile = null
    batch(() => {
      diffStatus.set(status)
      const patch = diff.error ? '' : diff.patch
      const hunks = diffTools.parseWorkspacePatch(patch)
      const previousFiles = diffFiles()
      const limits = new Map(diffFileLimits())
      const paths = new Set(files.map(file => file.path))
      for (const path of limits.keys()) if (!paths.has(path)) limits.delete(path)
      if (!previousFiles.length) {
        const first = selectedFile ? files.find(file => file.path === selectedFile) : files.find(file => hunks.has(file.path))
        if (first) limits.set(first.path, diffPageSize)
      }
      const selection = diffLineSelection()
      const selectionHunks = selection && hunks.get(selection.path)
      if (selection && !diffTools.hasWorkspaceDiffLine(selectionHunks, selection, matchingDiffContext(selection.path, selectionHunks)?.value)) {
        diffLineSelection.set(null)
        diffLineReveal.set(null)
        diffLineNotice.set('The selected line is no longer in this comparison.')
      }
      if (linked && hunks.has(linked.path)) limits.set(linked.path, diffPageSize)
      diffFiles.set(files)
      diffPatch.set(patch)
      diffHunks.set(hunks)
      diffFileLimits.set(limits)
    })
    for (const [path] of diffFileLimits()) void loadDiffContext(path)
    if (linked) void selectLinkedDiffLine(linked)
    if (selectedFile && diffOpen()) void nextTick(() => diffTools.focusWorkspaceDiffFile(changesPane.current, selectedFile))
  }

  effect(() => {
    const load = diffGitStatusLoader()
    const repository = diffRepository()
    const mode = diffReviewMode()
    diffRefresh()
    diffGitStatus.set(null)
    if (!sessionId || !load || !diffOpen() || workspaceStatusPaused || changesVisibility() !== 'visible'
      || mode === 'commit' || mode === 'turn') return
    const request = new AbortController()
    let timer
    async function update() {
      const status = await load(sessionId, repository, request.signal).catch(() => null)
      if (request.signal.aborted) return
      diffGitStatus.set(status)
      timer = useTimeout(update, 3500)
    }
    diffGitStatusStop = () => {
      request.abort()
      timer?.stop()
    }
    void update()
    return diffGitStatusStop
  })

  effect(() => {
    const load = reviewOptionsLoader()
    const base = diffBaseRef()
    const repository = diffRepository()
    diffRefresh()
    if (!sessionId || !load || !diffOpen() || changesVisibility() !== 'visible') return
    const controller = new AbortController()
    const { signal } = controller
    diffReviewError.set('')
    void load(sessionId, base, repository, signal).then(options => {
      if (signal.aborted) return
      batch(() => {
        diffRepositories.set(options.repositories)
        diffProjectRoot.set(options.hasProjectRepository)
        if (!repository && !options.hasProjectRepository && options.repositories.length) {
          selectDiffRepository(options.repositories[0].key)
          return
        }
        diffReviewOptions.set({ ...options, requestedBase: base })
      })
    }).catch(error => {
      if (!signal.aborted) diffReviewError.set(error.message)
    })
    return () => controller.abort()
  })

  effect(() => {
    const watchChanges = changesWatcher()
    diffRefresh()
    if (!sessionId || !watchChanges || !diffOpen() || changesVisibility() !== 'visible') return
    const mode = diffReviewMode()
    const repository = diffRepository()
    let target
    if (mode === 'branch') target = diffBaseRef()
    if (mode === 'commit') {
      const options = diffReviewOptions()
      if (!diffCommit() && (!options || options.requestedBase !== diffBaseRef())) return
      target = diffCommit() || options?.commits[0]?.sha
      if (!target) {
        diffStatus.set('No commits ahead of this branch base.')
        return
      }
    }
    if (mode === 'turn') {
      const options = diffReviewOptions()
      if (!options) return
      if (!diffTurn() && !options.turns.length) {
        diffStatus.set('No recorded turn comparisons.')
        return
      }
      target = diffTurn()
    }
    const comparison = mode === 'session' ? undefined : { mode, target, repository }
    return watchChanges(sessionId, showWorkspaceChanges, error => diffStatus.set(error || 'Could not refresh changes.'), comparison)
  })

  let diffTrigger = null
  let workspaceFilesTools = null
  let workspaceFilesController = null
  let workspaceFilesTrigger = null

  async function workspaceEditorRequest(method, params = {}) {
    const scope = sessionId ? { session: String(sessionId) } : { workspace: String(draftProject.id) }
    const response = await fetch('/workspace-editor?' + new URLSearchParams({ ...scope, ...params }), { method })
    if (response.status === 204) return null
    const result = await response.json()
    if (!response.ok) throw new Error(result.error || 'Could not reach the editor on the Harness host.')
    return result
  }

  async function chooseWorkspaceEditor(event, path = '', line = 0, usePreferred = false) {
    const dialog = workspaceEditorDialog.current
    if (!workspaceEditorAllowed || !dialog || dialog.open || editorBusy()) return
    const trigger = event?.currentTarget || dialog.ownerDocument.activeElement
    editorTrigger = trigger?.hasAttribute?.('data-workspace-editor-menu') ? workspaceActionsToggle.current : trigger
    workspaceActionsOpen.set(false)
    const target = { path, line, label: path || workspaceName || 'Workspace' }
    editorTarget.set(target)
    editorError.set('')
    editorAnnouncement.set('')
    editorChoices.set([])
    positionWorkspaceEditor(dialog)
    dialog.showModal()
    editorBusy.set(true)
    let choices = []
    try {
      const result = await workspaceEditorRequest('GET')
      if (editorTarget() !== target || !dialog.open) return
      choices = result.choices
      editorChoices.set(choices)
    }
    catch (error) {
      if (editorTarget() === target) editorError.set(error.message || 'Could not find editors on the Harness host.')
    }
    finally { editorBusy.set(false) }
    await nextTick()
    if (editorTarget() !== target || !dialog.open || !usePreferred) return
    const preferred = choices.find(choice => choice.id === preferredEditor())
      || choices.find(choice => choice.id !== 'file-manager')
    if (preferred) await launchWorkspaceEditor(preferred)
  }

  function positionWorkspaceEditor(dialog) {
    const opener = editorTrigger?.closest?.('button') || workspaceEditorHeader.current
    const box = opener?.getBoundingClientRect()
    if (!box?.width) return
    const { clientWidth, clientHeight } = dialog.ownerDocument.documentElement
    const width = Math.min(360, clientWidth - 24)
    const above = box.bottom + 220 > clientHeight && box.top > clientHeight / 2
    dialog.style.setProperty('--editor-inline', `${Math.max(12, Math.min(clientWidth - width - 12, box.right - width))}px`)
    dialog.style.setProperty('--editor-edge', `${above ? clientHeight - box.top + 6 : box.bottom + 6}px`)
    dialog.dataset.editorEdge = above ? 'above' : 'below'
  }

  useEventListener('resize', () => {
    const dialog = workspaceEditorDialog.current
    if (dialog?.open) positionWorkspaceEditor(dialog)
  })

  async function launchWorkspaceEditor(choice) {
    const target = editorTarget()
    if (!target || editorBusy()) return
    editorBusy.set(true)
    editorError.set('')
    try {
      await workspaceEditorRequest('POST', { editor: choice.id, path: target.path, line: String(target.line) })
      preferredEditor.set(choice.id)
      editorAnnouncement.set('Sent to ' + choice.label + '.')
      closeWorkspaceEditor()
    }
    catch (error) { editorError.set(error.message || 'Could not open the editor.') }
    finally { editorBusy.set(false) }
  }

  function closeWorkspaceEditor() {
    workspaceEditorDialog.current?.close()
  }

  function editorChooserKeydown(event) {
    if (event.key !== 'Escape') return
    event.preventDefault()
    event.stopPropagation()
    closeWorkspaceEditor()
  }

  function finishWorkspaceEditorClose() {
    // The browser queues close events. A keyboard shortcut can reopen the
    // dialog before the previous close reaches this handler.
    if (workspaceEditorDialog.current?.open) return
    editorTarget.set(null)
    const trigger = editorTrigger
    editorTrigger = null
    void nextTick(() => {
      const target = [trigger, workspaceEditorHeader.current, workspaceActionsToggle.current].find(element => element?.getClientRects?.().length)
      target?.focus({ preventScroll: true })
    })
  }

  function canOpenDiffLineInEditor() {
    return diffLineSelection()?.side === 'after' && ['session', 'uncommitted', 'branch'].includes(diffReviewMode())
  }

  function diffWorkingFile(path) {
    return diffRepository() ? `${diffRepository()}/${path}` : path
  }

  function chooseDiffEditor(event) {
    if (!canOpenDiffLineInEditor()) return
    const { path, line } = diffLineSelection()
    void chooseWorkspaceEditor(event, diffWorkingFile(path), line)
  }

  async function loadWorkspaceFiles() {
    if (!workspaceFilesController && hasWorkspaceFiles && codecUrl) {
      workspaceFilesTools = await import(codecUrl)
      workspaceFilesController ??= workspaceFilesTools.createWorkspaceFiles(
        sessionId ? { session: String(sessionId) } : { workspace: String(draftProject.id) },
        next => workspaceFileState.set(next),
      )
    }
    return workspaceFilesController
  }

  function closeWorkspaceFiles(restoreFocus = true) {
    workspaceFilesOpen.set(false)
    const trigger = workspaceFilesTrigger
    workspaceFilesTrigger = null
    if (restoreFocus) {
      void nextTick(() => {
        const target = [trigger, workspaceFilesToggle.current, workspaceActionsToggle.current].find(element => element?.getClientRects().length)
        target?.focus()
      })
    }
  }

  async function toggleWorkspaceFiles(event) {
    if (workspaceFilesOpen()) { closeWorkspaceFiles(); return }
    if (browserPreviewOpen()) closeBrowserPreview(false)
    workspaceFilesTrigger = workspaceActionsOpen() ? workspaceActionsToggle.current : event?.currentTarget
    workspaceActionsOpen.set(false)
    diffOpen.set(false)
    diffTrigger = null
    workspaceFilesOpen.set(true)
    void nextTick(() => workspaceFileClose.current?.focus())
    try { (await loadWorkspaceFiles())?.open() }
    catch { workspaceFileNotice.set('Could not load workspace files. Close the pane and try again.') }
  }

  function searchWorkspaceFiles(event) {
    workspaceFilesController?.search(event.currentTarget.value)
  }

  function refreshWorkspaceFiles() {
    workspaceFilesController?.refresh()
  }

  async function selectWorkspaceEntry(row) {
    if (row.kind === 'directory') workspaceFilesController?.toggleFolder(row.path)
    else if (row.kind === 'more') await workspaceFilesController?.loadMore(row.path)
    else await openWorkspaceFile(row.path)
  }

  async function openWorkspaceFile(path, line = 0) {
    workspaceFileMode.set('source')
    workspaceFileLine.set(0)
    workspaceFileJump.set('')
    workspaceFileNotice.set('')
    const request = workspaceFilesController?.openFile(path)
    await nextTick(() => workspaceFileHeading.current?.focus({ preventScroll: true }))
    await request
    const preview = workspaceFilePreview()
    if (preview?.path !== path) return
    if (line && preview.lines) showWorkspaceFileLine(line)
    else if (preview.kind === 'html' && !preview.truncated) workspaceFileMode.set('rendered')
  }

  function backWorkspaceFiles() {
    workspaceFilesController?.back()
    workspaceFileNotice.set('')
    void nextTick(() => workspaceFileSearch.current?.focus({ preventScroll: true }))
  }

  function showWorkspaceFileLine(requestedLine) {
    const lines = workspaceFilePreview()?.lines || 0
    if (!lines || !Number.isFinite(requestedLine)) return
    const line = Math.min(lines, Math.max(1, Math.trunc(requestedLine)))
    workspaceFileMode.set('source')
    workspaceFileLine.set(line)
    workspaceFileJump.set(String(line))
    void nextTick(() => workspaceFilesTools?.scrollWorkspaceFileLine(workspaceFileSource.current, line))
  }

  async function copySelectedWorkspaceFileLink(event) {
    try {
      await workspaceFilesTools.copyWorkspaceFileLink(event.currentTarget, workspaceFileSelected(), workspaceFileLine(), desktop()?.clipboard)
      workspaceFileNotice.set('Link copied.')
    }
    catch { workspaceFileNotice.set('Could not copy the link.') }
  }

  onMount(async () => {
    if (!hasWorkspaceFiles || !codecUrl) return
    try {
      const tools = await import(codecUrl)
      if (tools.currentWorkspaceDiffLink(changesPane.current)) return
      const link = tools.workspaceFileLocation(workspaceFileClose.current)
      if (!link) return
      const controller = await loadWorkspaceFiles()
      if (!controller) return
      workspaceFilesOpen.set(true)
      void controller.open()
      await openWorkspaceFile(link.path, link.line)
    }
    catch { workspaceFileNotice.set('Could not open the linked workspace file.') }
  })
  onDestroy(() => workspaceFilesController?.dispose())

  onMount(async () => {
    if (!sessionId || !codecUrl) return
    const codec = await import(codecUrl).catch(() => null)
    const transcript = transcriptRef.current
    if (codec && transcript?.isConnected) turnFilesObserver = codec.observeTurnFiles(transcript, sessionId, (id, repositories) => {
      turnFiles.update(files => ({ ...files, [id]: repositories }))
    })
  })
  onDestroy(() => turnFilesObserver?.dispose())

  function canOpenTurnDiff(turnId) {
    const repositories = turnFiles()[turnId]
    return Boolean(turnDiffs()[turnId]?.length) && (!repositories || repositories.some(repo => !repo.summary || repo.summary.total))
  }

  function turnFileLabel(turnId) {
    const repositories = turnFiles()[turnId]
    if (repositories === undefined) return ''
    if (repositories === null) return 'Recorded files unavailable'
    const total = repositories.reduce((sum, repo) => sum + (repo.summary?.total || 0), 0)
    if (!total) return repositories.some(repo => !repo.summary) ? 'Recorded files unavailable' : ''
    const insertions = repositories.reduce((sum, repo) => sum + (repo.summary?.insertions || 0), 0)
    const deletions = repositories.reduce((sum, repo) => sum + (repo.summary?.deletions || 0), 0)
    const count = total + (total === 1 ? ' changed file' : ' changed files')
    return insertions || deletions ? count + ' · +' + insertions + ' −' + deletions : count
  }

  function retryTurnFiles(turnId) {
    void turnFilesObserver?.load(String(turnId))
  }

  function canRetryTurnFiles(turnId) {
    const repositories = turnFiles()[turnId]
    return repositories === null || Boolean(repositories?.some(repo => !repo.summary))
  }

  function turnFileActionLabel(repo, file) {
    const label = 'Review ' + file.path + ' in ' + repo.label
    return file.insertions || file.deletions ? label + ', ' + file.insertions + ' additions, ' + file.deletions + ' deletions' : label
  }

  function openTurnDiff(turnId, event, selectedRepository, path) {
    const repositories = turnDiffs()[turnId]
    if (!repositories?.length) return
    const preferred = selectedRepository ?? diffRepository()
    const repository = repositories.includes(preferred) ? preferred : repositories[0]
    clearDiffComparison()
    pendingTurnFile = path ?? null
    batch(() => {
      if (repository !== diffRepository()) diffReviewOptions.set(null)
      diffRepository.set(repository)
      diffReviewMode.set('turn')
      diffTurn.set(String(turnId))
      openDiffPane(event.currentTarget)
      refreshWorkspaceDiff()
    })
  }

  function openDiffPane(trigger) {
    diffTrigger = trigger
    closeWorkspaceActions()
    if (workspaceFilesOpen()) closeWorkspaceFiles(false)
    if (browserPreviewOpen()) closeBrowserPreview(false)
    diffOpen.set(true)
    void nextTick(() => diffClose.current?.focus())
  }

  function toggleDiff(event) {
    if (diffOpen()) {
      diffOpen.set(false)
      pendingTurnFile = null
      const trigger = diffTrigger
      diffTrigger = null
      void nextTick(() => (trigger?.getClientRects().length ? trigger : workspaceActionsToggle.current)?.focus())
      return
    }
    openDiffPane(workspaceActionsOpen() ? workspaceActionsToggle.current : event?.currentTarget)
  }

  // ── The live wire ─────────────────────────────────────────────────────
  // Set by connectLiveSession once the socket and codec exist. Everything
  // that talks to the server — command dispatch, terminal frames — goes
  // through it, so the template handlers above can be plain top-level
  // functions the binding scope can see.
  let sendFrame = () => false

  // A command id the server can deduplicate on. Every dispatch carries one,
  // so a retry after a dropped ack replays the receipt rather than starting a
  // second agent run.
  let commandCounter = 0
  function dispatch(command) {
    sendFrame({
      t: 'dispatch',
      envelope: {
        id: `web_${sessionId}_${Date.now().toString(36)}_${++commandCounter}`,
        at: Date.now(),
        command,
      },
    })
  }

  function trackTranscriptPosition(event) {
    const { scrollHeight, scrollTop, clientHeight } = event.currentTarget
    followingTranscript.set(scrollHeight - scrollTop - clientHeight <= 48)
  }

  function jumpToLatest() {
    const transcript = transcriptRef.current
    if (!transcript) return
    followingTranscript.set(true)
    missingTurnLink.set(false)
    transcript.querySelector('[data-linked-turn]')?.removeAttribute('data-linked-turn')
    transcript.scrollTop = transcript.scrollHeight
    transcript.focus({ preventScroll: true })
    void nextTick(() => { transcript.scrollTop = transcript.scrollHeight })
  }

  async function handleTranscriptControl(event) {
    const copy = event.target?.closest?.('[data-copy-prompt-link], [data-copy-message-link]')
    if (copy && sessionId && composerDraftTools) {
      const turn = copy.closest('[data-turn]')
      const origin = copy.ownerDocument.location.origin
      try {
        if (copy.hasAttribute('data-copy-message-link')) {
          void shareLink(copy, composerDraftTools.threadLink(origin, sessionId, Number(turn?.dataset.turn)), 'Message link copied.')
        }
        else {
          const text = turn?.querySelector('[data-user-prompt]')?.textContent || ''
          void shareLink(copy, composerDraftTools.newThreadLink(origin, text), 'Prompt link copied.')
        }
      }
      catch (error) { stxAlert(error.message) }
      return
    }
    try {
      const message = await transcriptControl?.(event.target, desktop()?.clipboard)
      if (message) transcriptAnnouncement.set(message)
    }
    catch {
      stxAlert('Could not copy to the clipboard.')
    }
  }

  function handleTranscriptKeyboard(event) { transcriptMenuKeyboard?.(event) }

  function revealLinkedTurn() {
    const transcript = transcriptRef.current
    const outcome = transcript && composerDraftTools?.linkedTurn(transcript)
    missingTurnLink.set(outcome === 'missing')
    if (outcome) followingTranscript.set(false)
  }

  useEventListener('hashchange', revealLinkedTurn, { target: window })

  function paintTranscript(updateMarkdown) {
    if (transcriptFrame) return
    transcriptFrame = requestAnimationFrame(() => {
      transcriptFrame = 0
      const transcript = transcriptRef.current
      if (!transcript) return
      for (const turnId of changedResponses) {
        const response = transcript.querySelector(`[data-turn="${turnId}"] [data-response]`)
        if (response) {
          updateMarkdown(response, responseByTurn.get(turnId))
          transcriptHighlighter?.update(response)
        }
      }
      changedResponses.clear()
      if (followingTranscript()) transcript.scrollTop = transcript.scrollHeight
    })
  }
  let transcriptHighlighter
  onDestroy(() => {
    cancelAnimationFrame(transcriptFrame)
    transcriptHighlighter?.stop()
  })

  function updateClientTurn(turnId, change) {
    liveTurns.update(turns => turns.map(turn => turn.id === turnId ? change(turn) : turn))
  }

  // The composer keeps the text and caret until the host accepts the command.
  // A retry of the same draft reuses the recorded command ID.
  // The engine's id derivation (packages/engine/src/reducer.ts), verbatim:
  // FNV-1a over the command id. Duplicated so the page can know a session's
  // id at creation time and navigate straight to it — the alternative is
  // parsing it back out of the event stream it just caused.
  function derivedSessionId(commandId) {
    let hash = 2166136261
    for (let i = 0; i < commandId.length; i++) {
      hash ^= commandId.charCodeAt(i)
      hash = Math.imul(hash, 16777619)
    }
    return (hash >>> 0) % 2147483647 + 1
  }

  function sentAttachmentUrl(id) {
    return `/composer-attachments/${id}?session=${sessionId}`
  }

  function openSentImage(event) {
    const trigger = event.currentTarget
    const dialog = sentImageDialog.current
    const id = trigger?.dataset.previewSentImage
    if (!dialog || dialog.open || !id) return
    sentImageTrigger = trigger
    sentImageStatus.set('loading')
    sentImage.set({ url: sentAttachmentUrl(id), name: trigger.querySelector('[data-attachment-name]')?.textContent || 'Image' })
    dialog.showModal()
  }

  function closeSentImage() {
    sentImageDialog.current?.close()
  }

  function finishSentImageClose() {
    sentImage.set(null)
    sentImageTrigger?.focus({ preventScroll: true })
    sentImageTrigger = null
  }

  function chooseComposerFilesDialog(replacing) {
    const picker = composerFileInput.current
    if (!picker) return
    replaceUploadKey = typeof replacing === 'string' ? replacing : undefined
    picker.multiple = !replaceUploadKey
    picker.click()
  }

  function chooseComposerFiles(event) {
    composerFileActions()?.choose(event, replaceUploadKey)
    replaceUploadKey = undefined
    if (composerFileInput.current) composerFileInput.current.multiple = true
  }

  function stashLabel(entry) {
    return entry.text.trim().replace(/\s+/g, ' ').slice(0, 120) || entry.files[0]?.name || 'Saved prompt'
  }

  function refreshPromptStash() {
    if (!promptStash) return
    try { stashEntries.set(promptStash.entries()) }
    catch { stashError.set('Could not read the saved prompts.') }
  }

  function openPromptStash() {
    const dialog = promptStashDialog.current
    if (!dialog || dialog.open || !promptRef.current?.form || promptRef.current.form.hidden || editingFollowUp()) return
    stashError.set('')
    refreshPromptStash()
    dialog.showModal()
    stashOpen.set(true)
  }

  function closePromptStash() {
    promptStashDialog.current?.close()
  }

  function finishPromptStashClose() {
    stashOpen.set(false)
    if (stashCloseToEditor) promptRef.current?.focus({ preventScroll: true })
    else promptStashButton.current?.focus({ preventScroll: true })
    stashCloseToEditor = false
  }

  function readStashDraftSnapshot() {
    const persisted = localStorage.getItem(promptDraftKey)
    if (persisted !== null && persisted !== JSON.stringify(composerDraft()))
      throw new Error('The draft changed in another tab. Reopen the thread to load it.')
    return persisted
  }

  async function stashCurrentPrompt() {
    const box = promptRef.current
    if (!box || box.form?.hidden || !promptStash || startPending() || editingFollowUp() || !hasComposerMessage()) return
    const text = box.value
    const files = composerFiles()
    const upload = composerDraft()?.upload
    stashError.set('')
    startPending.set(true)
    stashBusy.set(true)
    try {
      const snapshot = readStashDraftSnapshot()
      stashEntries.set(await promptStash.save(text, files, upload))
      if (localStorage.getItem(promptDraftKey) !== snapshot)
        throw new Error('The draft changed in another tab. Your saved prompt is in the stash.')
      if (box.value !== text || composerDraft()?.upload?.draft !== upload?.draft) return
      localStorage.removeItem(promptDraftKey)
      box.value = ''
      composerText.set('')
      composerDraft.set(null)
      composerRecall?.reset()
      sidebarDrafts?.update()
      if (upload && files.length) composerDraftTools.releaseComposerUploads(upload, files)
      if (stashOpen()) {
        stashCloseToEditor = true
        closePromptStash()
      }
      else box.focus({ preventScroll: true })
    }
    catch (error) { stashError.set(error.message || 'Could not stash this prompt.') }
    finally {
      startPending.set(false)
      stashBusy.set(false)
    }
  }

  async function restoreStashedPrompt(entry) {
    const box = promptRef.current
    if (!box || box.form?.hidden || !promptStash || startPending() || editingFollowUp()) return
    const current = composerFiles()
    const seen = new Set(current.flatMap(file => file.id ? [file.id, file.key] : [file.key]))
    if (current.length + entry.files.filter(file => !seen.has(file.id) && !seen.has(file.key)).length > 100) {
      stashError.set('The composer holds up to 100 attachments. Remove a file before restoring.')
      return
    }
    const existingUpload = composerDraft()?.upload
    const upload = existingUpload ?? { scope: uploadScope, draft: composerDraftTools.newComposerDraftId() }
    let unclaimedFiles
    stashError.set('')
    startPending.set(true)
    stashBusy.set(true)
    try {
      const snapshot = readStashDraftSnapshot()
      const restored = await promptStash.restoreFiles(entry, upload)
      if (!existingUpload) unclaimedFiles = restored
      if (localStorage.getItem(promptDraftKey) !== snapshot)
        throw new Error('The draft changed in another tab. Your saved prompt is still in the stash.')
      if (box.form?.hidden || !promptStash.entries().some(item => item.id === entry.id)) return
      const files = [...composerFiles(), ...restored.filter(file => !seen.has(file.id) && !seen.has(file.key))]
      const existing = box.value.trimEnd()
      const text = existing && entry.text ? existing + '\n\n' + entry.text : existing || entry.text
      const draft = { ...composerDraft(), text, files, ...(files.length ? { upload } : {}),
        start: text.length, end: text.length, discardedDraft: undefined, commandId: undefined }
      localStorage.setItem(promptDraftKey, JSON.stringify(draft))
      unclaimedFiles = undefined
      composerDraft.set(draft)
      composerText.set(text)
      box.value = text
      box.setSelectionRange(text.length, text.length)
      composerRecall?.reset()
      sidebarDrafts?.update()
      stashEntries.set(promptStash.remove(entry))
      if (stashOpen()) {
        stashCloseToEditor = true
        closePromptStash()
      }
      else box.focus({ preventScroll: true })
    }
    catch (error) { stashError.set(error.message || 'Could not restore this prompt.') }
    finally {
      if (unclaimedFiles) composerDraftTools.releaseComposerUploads(upload, unclaimedFiles)
      startPending.set(false)
      stashBusy.set(false)
    }
  }

  async function restoreEarlierPrompt() {
    const entry = initialRewoundPrompt
    const box = promptRef.current
    if (!canRestoreEarlierPrompt() || !composerDraftTools || !box || box.form?.hidden
      || startPending() || editingFollowUp() || composerFilesPending()) return
    restorePrompt()
    const upload = composerDraft()?.upload ?? { scope: uploadScope, draft: composerDraftTools.newComposerDraftId() }
    startPending.set(true)
    restoredPromptError.set('')
    try {
      const snapshot = readStashDraftSnapshot()
      const restored = entry.attachments ? await composerDraftTools.restoreRewoundAttachments(sessionId, entry.operation, upload) : []
      if (localStorage.getItem(promptDraftKey) !== snapshot || box.form?.hidden)
        throw new Error('The draft changed in another tab. Reopen the thread to restore the earlier prompt.')
      const current = composerFiles()
      const ids = new Set(current.map(file => file.id))
      const files = [...current, ...restored.filter(file => !ids.has(file.id))]
      if (files.length > 100) throw new Error('The composer holds up to 100 attachments. Remove a file before restoring.')
      const existing = box.value.trimEnd()
      const text = existing && entry.text ? existing + '\n\n' + entry.text : existing || entry.text
      const draft = { ...composerDraft(), text, files, ...(files.length ? { upload } : {}),
        start: text.length, end: text.length, rewoundOperation: entry.operation, discardedDraft: undefined, commandId: undefined }
      localStorage.setItem(promptDraftKey, JSON.stringify(draft))
      restoredRewind.set(entry.operation)
      if (requestedRewind() === entry.operation) requestedRewind.set('')
      composerDraft.set(draft)
      composerText.set(text)
      box.value = text
      box.setSelectionRange(text.length, text.length)
      composerRecall?.reset()
      sidebarDrafts?.update()
      box.focus({ preventScroll: true })
    }
    catch (error) { restoredPromptError.set(error.message || 'Could not restore the earlier prompt.') }
    finally { startPending.set(false) }
  }

  function removeStashedPrompt(entry) {
    if (!promptStash || startPending()) return
    try {
      stashEntries.set(promptStash.remove(entry))
      promptStashDialog.current?.querySelector('[data-restore-stashed-prompt], [data-stash-current]')?.focus()
    }
    catch { stashError.set('Could not remove the saved prompt.') }
  }

  function stashOrRestorePrompt() {
    if (stashOpen()) closePromptStash()
    else if (hasComposerMessage()) void stashCurrentPrompt()
    else {
      refreshPromptStash()
      if (stashEntries().length === 1) void restoreStashedPrompt(stashEntries()[0])
      else openPromptStash()
    }
  }

  function composerDragOver(event) {
    if (Array.from(event.dataTransfer?.types ?? []).includes('Files')) event.preventDefault()
  }

  function setComposerFiles(files, upload) {
    const previous = composerDraft()
    const remainder = { createdAt: Date.now(), ...previous }
    delete remainder.commandId
    delete remainder.files
    delete remainder.upload
    delete remainder.discardedDraft
    const text = promptRef.current?.value ?? remainder.text ?? ''
    composerDraft.set(files.length ? { ...remainder, text, files, upload } : text ? { ...remainder, text } : null)
    rememberPrompt()
    sidebarDrafts?.update()
  }

  function updateComposerFiles() { fileMentionPicker?.update() }
  function closeComposerFiles() { fileMentionPicker?.close() }
  function pickComposerFile(path) { fileMentionPicker?.pick(path) }

  function composerCaretMoved() {
    rememberPrompt()
    updateComposerFiles()
  }

  function composerKeyup(event) {
    rememberPrompt()
    if (!event.isComposing && ['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) updateComposerFiles()
  }

  function promptEdited(event) {
    composerRecall?.reset()
    rememberPrompt(true)
    if (!event?.isComposing) updateComposerFiles()
  }

  function rememberPrompt(edited = false) {
    const box = promptRef.current
    if (!box) return
    composerText.set(box.value)
    if (editingFollowUp()) return
    if (!box.value) sharedPromptNotice.set('')
    const previous = composerDraft()
    // Autofocus can report a caret or selection before the saved text is restored.
    // Only a deliberate editor change can clear the saved value through this path.
    if (!box.value && previous?.text && edited !== true) return
    if (!box.value && !previous?.files?.length) {
      if (previous?.text) composerDraft.set(null)
      return
    }
    const { value: text, selectionStart: start, selectionEnd: end, selectionDirection: direction } = box
    if (previous?.text === text && composerDraftTools?.wasComposerDraftDiscarded(localStorage, promptDraftKey)) return
    const codexSelection = draftCodexSelection()
    const provider = !sessionId || pendingProviderSwitch() ? draftProvider() : undefined
    const model = provider ? draftModel() : undefined
    const worktree = !sessionId && draftWorktreeOptions()
      ? { isolated: draftIsolated(), selection: draftWorktreeSelection() }
      : previous?.worktree
    const sameSelection = previous?.provider === provider && previous?.model === model && sameCodexSelection(previous?.codexSelection, codexSelection)
      && JSON.stringify(previous?.worktree) === JSON.stringify(worktree)
    const linkNotice = sharedPromptNotice() || undefined
    if (previous?.text === text && previous.start === start && previous.end === end && previous.direction === direction
      && sameSelection && previous.linkNotice === linkNotice) return
    composerDraft.set({
      text, start, end, direction, createdAt: previous?.createdAt ?? Date.now(),
      ...(previous?.files?.length ? { files: previous.files, upload: previous.upload } : {}),
      ...(codexSelection ? { codexSelection } : {}),
      ...(provider ? { provider, model } : {}),
      ...(worktree ? { worktree } : {}),
      ...(linkNotice ? { linkNotice } : {}),
      ...(sameSelection && previous?.text === text && previous.commandId ? { commandId: previous.commandId } : {}),
    })
  }

  function canDiscardComposer() {
    return draftDiscardReady() && Boolean(composerDraft()?.text || composerFiles().length) && !editingFollowUp() && !startPending()
      && !composerFiles().some(file => file.status === 'uploading')
  }

  function discardCurrentDraft() {
    discardDraft(promptDraftKey)
  }

  function linkedPromptWarning(prompt) {
    return prompt.hiddenCharacters ? 'Hidden characters were removed from this prompt. Read it carefully before sending.' : ''
  }

  function showLinkedPrompt(review) {
    linkReview.set(review)
    linkReviewError.set('')
    if (!promptLinkDialog.current?.open) promptLinkDialog.current?.showModal()
  }

  function cancelPromptLink() {
    if (linkOpening()) return
    const review = linkReview()
    promptLinkDialog.current?.close()
    linkReview.set(null)
    if (review?.newThread) openDraftAddress('/')
    else promptRef.current?.focus()
  }

  function dismissLinkedPromptNotice() {
    sharedPromptNotice.set('')
    if (composerDraft()?.linkNotice) {
      const draft = { ...composerDraft() }
      delete draft.linkNotice
      composerDraft.set(draft)
    }
  }

  function replaceFromPromptLink(prompt) {
    const box = promptRef.current
    if (!box?.form || box.form.hidden || startPending() || editingFollowUp())
      throw new Error('This composer is unavailable. Open the prompt as a new draft.')
    box.value = prompt.text
    box.setSelectionRange(prompt.text.length, prompt.text.length)
    sharedPromptNotice.set(linkedPromptWarning(prompt))
    rememberPrompt()
    promptLinkDialog.current?.close()
    linkReview.set(null)
    box.focus({ preventScroll: true })
  }

  async function openLinkedDraft(prompt, project, target) {
    const profile = String(project?.profile || activeProfile || '0')
    let notice = linkedPromptWarning(prompt)
    let choice
    if (prompt.provider || prompt.model) {
      const params = new URLSearchParams({ profile, workspace: String(project?.id || 0), models: '1' })
      const request = new AbortController()
      linkedPromptRequest = request
      const catalog = await fetch('/drivers?' + params, { signal: request.signal }).then(response => response.ok ? response.json() : null).catch(() => null)
      if (request.signal.aborted) return
      linkedPromptRequest = undefined
      const accounts = [...(catalog?.drivers || []), ...(catalog?.accounts || [])]
      choice = composerDraftTools.matchingLinkedModel(prompt.provider, prompt.model, accounts)
      if (!choice) notice = [notice, 'The linked model is unavailable. Your default model was selected.'].filter(Boolean).join(' ')
    }
    const address = composerDraftTools.storeLinkedDraft(target, { profile, workspace: project?.id, id: newCommandId() }, {
      text: prompt.text, notice, ...choice,
    })
    openDraftAddress(address)
  }

  async function acceptLinkedPrompt(destination) {
    const review = linkReview()
    const target = promptRef.current ?? transcriptRef.current
    if (!review?.prompt?.text || !target || linkOpening()) return
    linkOpening.set(true)
    try {
      if (destination === 'selected' && review.replace) replaceFromPromptLink(review.prompt)
      else await openLinkedDraft(review.prompt, destination === 'selected' ? review.project : null, target)
    }
    catch (error) { linkReviewError.set(error.message || 'Could not open this prompt.') }
    finally { linkOpening.set(false) }
  }

  async function openIncomingPromptLink() {
    const target = promptRef.current ?? transcriptRef.current
    const link = target && composerDraftTools.readPromptLink(target, Boolean(sessionId))
    if (!link || (link.prompt?.pullRequest && draftProject && !draftProject.trusted)) return
    composerDraftTools.clearPromptLink(target)
    const { newThread, prompt, error, rawText } = link
    if (error) {
      showLinkedPrompt({ title: 'Could not open prompt link', detail: error, newThread })
      return
    }
    if (!newThread) {
      restorePrompt()
      const editable = promptRef.current?.form && !promptRef.current.form.hidden && !inputRequest() && !initialNavigation.archivedAt
      if (editable && !promptRef.current.value && !composerFiles().length) {
        replaceFromPromptLink(prompt)
        return
      }
      showLinkedPrompt({
        title: editable ? 'Replace draft text?' : 'Open linked prompt',
        detail: editable ? 'This thread already has a draft. Its attachments will stay with it.' : 'This thread cannot receive a draft right now.',
        prompt, replace: Boolean(editable),
      })
      return
    }
    if (!prompt.repository) {
      showLinkedPrompt({ title: 'Opening linked prompt', prompt, newThread })
      await acceptLinkedPrompt('scratch')
      return
    }
    showLinkedPrompt({ title: 'Open linked prompt', detail: 'Looking for ' + prompt.repository + ' on this host.', prompt, newThread })
    const request = new AbortController()
    linkedPromptRequest = request
    const endpoint = prompt.pullRequest ? pullRequestAddress(prompt.pullRequest) : '/prompt-link/project?repo=' + encodeURIComponent(prompt.repository)
    const result = await fetch(endpoint, { signal: request.signal })
      .then(response => response.ok ? response.json() : null).catch(() => null)
    if (request.signal.aborted || !linkReview()) return
    linkedPromptRequest = undefined
    if (result?.sessionId) {
      openPullRequestThread(result.sessionId, rawText)
      return
    }
    const project = result?.project
    const canCheckOut = Boolean(prompt.pullRequest && project && result?.canCheckOut)
    const label = prompt.pullRequest ? prompt.repository + '#' + prompt.pullRequest.split('/').at(-1) : ''
    const title = canCheckOut ? 'Check out ' + label + '?' : prompt.pullRequest ? 'Open pull request' : 'Open linked prompt'
    const detail = canCheckOut ? 'This creates an isolated worktree in ' + project.name + ' and runs any configured setup.'
      : prompt.pullRequest && project ? 'Check out this pull request from the Harness host.'
        : project ? 'Open a draft in ' + project.name + '.' : prompt.repository + ' is unavailable on this host.'
    showLinkedPrompt({ title, detail, prompt, newThread, project, canCheckOut, rawText, canClone: projectCloneAllowed && !project })
  }

  function pullRequestAddress(pullRequest, project, thread) {
    const params = new URLSearchParams({ pr: pullRequest })
    if (pullRequestProfile) params.set('profile', String(pullRequestProfile))
    if (project) params.set('workspace', String(project))
    if (thread) params.set('session', String(thread))
    return '/prompt-link/pull-request?' + params
  }

  function openPullRequestThread(id, rawText) {
    const params = rawText?.trim() ? '?' + new URLSearchParams({ prompt: rawText }) : ''
    openDraftAddress('/s/' + id + params)
  }

  async function requestPullRequestCheckout(pullRequest, project, thread) {
    const response = await fetch(pullRequestAddress(pullRequest, project, thread), { method: 'POST', headers: { 'content-type': 'application/json' } })
    const result = await response.json().catch(() => ({}))
    if (!response.ok || !result.sessionId) throw new Error(result.error || 'Could not start the pull request checkout.')
    return result.sessionId
  }

  async function confirmPullRequestCheckout() {
    const review = linkReview()
    if (!review?.canCheckOut || linkOpening()) return
    linkOpening.set(true)
    linkReviewError.set('')
    try {
      const id = await requestPullRequestCheckout(review.prompt.pullRequest, review.project.id)
      openPullRequestThread(id, review.rawText)
    }
    catch (error) { linkReviewError.set(error.message || 'Could not start the pull request checkout.') }
    finally { linkOpening.set(false) }
  }

  async function retryPullRequestCheckout() {
    if (pullRequestRetrying() || !sessionPullRequest || workspaceBranch()) return
    pullRequestRetrying.set(true)
    pullRequestRetryError.set('')
    const previousError = sessionError()
    sessionError.set('')
    try { await requestPullRequestCheckout(sessionPullRequest.url, activeWorkspaceId, sessionId) }
    catch (error) {
      sessionError.set(previousError)
      pullRequestRetryError.set(error.message || 'Could not retry the checkout.')
    }
    finally { pullRequestRetrying.set(false) }
  }

  async function connectComposerDrafts() {
    composerDraftTools = await import(codecUrl)
    const projectId = Number(activeWorkspaceId || draftProject?.id) || 0
    if (projectId && !activeScratchSession) {
      fileMentionPicker = composerDraftTools.createFileMentionPicker({
        editor: () => promptRef.current,
        popup: () => composerFilePopup.current,
        scope: sessionId ? { session: String(sessionId) } : { workspace: String(projectId) },
        updateMenu: menu => composerFileMenu.set(menu),
        inserted: promptEdited,
      })
    }
    try {
      promptStash = composerDraftTools.createPromptStash(localStorage)
      refreshPromptStash()
      stashReady.set(true)
    }
    catch { stashError.set('Browser storage is unavailable for the stash.') }
    composerRecall = composerDraftTools.createPromptRecall()
    composerFileStatus = composerDraftTools.composerFileStatus
    composerFileActions.set(composerDraftTools.createComposerFileActions({
      files: composerFiles, upload: () => composerDraft()?.upload, setFiles: setComposerFiles,
      setError: message => composerFilesError.set(message), inputBlocked: () => startPending() || Boolean(editingFollowUp()),
      newKey: newCommandId, focusEditor: () => promptRef.current?.focus(),
      sources: composerUploadSources, scope: uploadScope,
    }))
    const sidebar = sidebarRef.current
    const discardTemplate = draftDiscardTemplate.current
    const sectionTemplate = sidebarDraftTemplate.current
    if (sidebar && discardTemplate && sectionTemplate) {
      sidebarDrafts = composerDraftTools.watchSidebarDrafts({
        root: sidebar, discardTemplate, sectionTemplate, currentKey: promptDraftKey,
        discard: discardDraft, startProject: startProjectDraft, open: openDraftAddress,
      })
    }
    draftDiscardReady.set(true)
    expireUndoNotices()
    if (initialRewoundPrompt && requestedRewind() === initialRewoundPrompt.operation) await restoreEarlierPrompt()
    if (!resumeProjectClone()) await openIncomingPromptLink()
  }

  function discardDraft(key) {
    if (!composerDraftTools) return
    const here = key === promptDraftKey
    if (here && !canDiscardComposer()) return
    expireUndoNotices()
    try {
      const box = here ? promptRef.current : null
      if (box) rememberPrompt()
      const claim = newCommandId()
      const entry = composerDraftTools.discardComposerDraft(localStorage, key, claim, box?.value)
      if (!entry) return
      const groups = draftUndo()
      const mergeLatest = visibleUndo()?.action === 'discarded'
      const entries = mergeLatest ? groups.at(-1).entries.filter(item => item.key !== key) : []
      const now = Date.now()
      const expiresAt = now + 5000
      const earlier = (mergeLatest ? groups.slice(0, -1) : groups)
        .map(group => ({ ...group, expiresAt, entries: group.entries.filter(item => item.key !== key) }))
        .filter(group => group.entries.length)
      const offers = [...earlier, { action: 'discarded', offeredAt: now, expiresAt, entries: [...entries, entry] }]
      try { composerDraftTools.persistDraftUndo(draftUndoKey, offers) }
      catch {
        composerDraftTools.restoreComposerDraft(localStorage, entry)
        throw new Error('Could not save draft recovery.')
      }
      if (box) {
        box.value = ''
        composerText.set('')
        sharedPromptNotice.set('')
        composerDraft.set({ discardedDraft: claim })
        if (!sidebarOpen()) box.focus()
      }
      if (here) composerFilesError.set('')
      draftUndo.set(offers)
      threadUndoBatch.set(claim)
      threadUndoShortcutClaimed.set(true)
      sidebarDrafts?.update()
    }
    catch {
      stxAlert('Could not discard the draft. Try again.')
    }
  }

  function restoreDiscardedDrafts(offer) {
    if (!composerDraftTools) return
    draftUndo.update(groups => groups.slice(0, -1))
    let skipped = 0
    for (const entry of offer.entries) {
      try {
        const here = entry.key === promptDraftKey
        const editor = here ? promptRef.current : null
        if ((editor && (editor.value || startPending() || editingFollowUp()))
          || !composerDraftTools.restoreComposerDraft(localStorage, entry)) {
          skipped++
          composerDraftTools.expireComposerDraft(localStorage, entry)
          continue
        }
        if (editor) {
          composerDraft.set(entry.draft)
          sidebarDrafts?.restoreCurrent(entry)
          restorePrompt()
          if (!sidebarOpen()) editor.focus()
        }
      }
      catch { skipped++ }
    }
    sidebarDrafts?.update()
    if (sidebarOpen()) sidebarRef.current?.querySelector('[data-saved-draft-link][aria-current="page"], a[data-sidebar-item][data-active="true"]')?.focus()
    if (skipped) stxAlert(skipped === 1 ? 'A draft changed and could not be restored.' : `${skipped} drafts changed and could not be restored.`)
  }

  function restorePrompt() {
    const box = promptRef.current
    if (!box || box.value) return
    const saved = composerDraft()
    const pending = pendingFirstPrompt()
    const first = sessionId && pending?.sessionId === sessionId && typeof pending.text === 'string' ? pending : null
    if (first) pendingFirstPrompt.set(null)
    const current = typeof saved?.text === 'string' ? saved : first
    if (!current?.text && !current?.files?.length) return
    sharedPromptNotice.set(current.linkNotice || '')
    if (current === first && first.files?.length) composerDraft.set(first)
    if (current.files?.some(file => file.status === 'uploading' && !composerUploadSources.has(file.key))) {
      const files = current.files.map(file => file.status === 'uploading' && !composerUploadSources.has(file.key)
        ? { ...file, status: 'failed', error: 'Upload interrupted. Attach this file again.' } : file)
      composerDraft.set({ ...current, files })
    }
    if (typeof current.provider === 'string' && KNOWN_DRIVERS.includes(agentChoice(current.provider).driverKind)) {
      draftProvider.set(current.provider)
      draftModel.set(typeof current.model === 'string' ? current.model : '')
    }
    if (draftIsCodex() && typeof current.codexSelection?.model === 'string') showDraftCodexSelection(current.codexSelection)
    if (!sessionId && current.worktree && draftProject?.trusted) {
      const selection = current.worktree.selection
      draftIsolated.set(current.worktree.isolated === true)
      if (typeof selection?.baseBranch === 'string') draftBaseBranch.set(selection.baseBranch)
      if (Array.isArray(selection?.repositories)) draftRepositoryKeys.set(selection.repositories.filter(key => typeof key === 'string'))
      void loadDraftWorktreeOptions()
    }
    box.value = current.text
    const start = Number.isInteger(current.start) ? current.start : box.value.length
    const end = Number.isInteger(current.end) ? current.end : start
    box.setSelectionRange(start, end, current.direction)
    rememberPrompt()
    if (current === first) void sendPrompt()
  }

  function armFreshProviderSession() {
    if (composerFiles().length) {
      composerFilesError.set('Remove the attachments before running this command.')
      return
    }
    if (!sessionId || !runningTurnId()) {
      stxAlert('Send a message before starting a fresh provider session.')
      return
    }
    storedFreshSession.set(newCommandId())
    const box = promptRef.current
    if (box) {
      box.value = ''
      box.focus()
    }
    composerText.set('')
    composerDraft.set(null)
  }

  function keepCurrentProviderSession() {
    storedFreshSession.set('')
    promptRef.current?.focus()
  }

  async function loadDraftWorktreeOptions(event) {
    if (workspaceStatusPaused || (event && !event.currentTarget.open) || !draftProject?.trusted || draftWorktreeOptions() || draftWorktreeRequest) return
    const request = new AbortController()
    draftWorktreeRequest = request
    draftWorktreeLoad.set('Loading repositories…')
    try {
      const query = new URLSearchParams({ workspace: String(draftProject.id) })
      const response = await fetch('/workspace-repositories?' + query, { signal: request.signal })
      if (!response.ok) throw new Error('Could not load project repositories. Close and reopen this panel to retry.')
      const options = await response.json()
      if (request.signal.aborted) return
      const keys = options.repositories.map(repository => repository.key)
      const saved = composerDraft()?.worktree?.selection ?? worktreePreferences()?.[draftProject.id]
      batch(() => {
        draftWorktreeOptions.set(options)
        draftRepositoryKeys.set(Array.isArray(saved?.repositories) ? keys.filter(key => saved.repositories.includes(key)) : keys.length <= 8 ? keys : [])
        draftBaseBranch.set(typeof saved?.baseBranch === 'string' ? saved.baseBranch : '')
        draftWorktreeLoad.set(options.canStartWorktree ? '' : options.requiresProjectCommand
          ? 'Start this project’s worktree from the Harness host.'
          : 'No Git repositories were found in this project.')
      })
    }
    catch (error) { draftWorktreeLoad.set(request.signal.aborted ? '' : error.message) }
    finally { draftWorktreeRequest = undefined }
  }

  function changeDraftWorktreeMode(event) {
    draftIsolated.set(event.currentTarget.value === 'worktree')
    rememberPrompt()
  }

  function selectDraftRepository(key, event) {
    const selected = event.currentTarget.checked
    draftRepositoryKeys.update(keys => selected ? [...keys, key] : keys.filter(value => value !== key))
    rememberPrompt()
  }

  function editDraftBaseBranch(event) {
    draftBaseBranch.set(event.currentTarget.value)
    rememberPrompt()
  }

  function modelLaunchOptions(selection, model) {
    const choice = agentChoice(selection.account)
    const effort = model?.reasoningEfforts.includes(selection.effort) ? selection.effort : ''
    const serviceTier = model?.speedTiers.some(tier => tier.id === selection.speed) ? selection.speed : ''
    return {
      ...choice,
      ...(model ? { model: model.id } : {}),
      ...(choice.driverKind === 'codex' && (effort || serviceTier)
        ? { codexTurnOptions: { ...(effort ? { effort } : {}), ...(serviceTier ? { serviceTier } : {}) } }
        : {}),
    }
  }

  function prepareModelBatch(text, uploads) {
    if (!draftWorktreeOptions()?.canStartWorktree) throw new Error('Choose a Git project to send to multiple models.')
    const worktree = draftWorktreeSelection()
    const selections = modelChoicesWithOptions()
    const targets = selections.map(selection => {
      const account = composerProviders().find(account => account.value === selection.account && account.status === 'ready')
      const model = account?.models?.find(model => model.id === selection.id)
      if (!model) throw new Error('The selected model ' + selection.name + ' is unavailable.')
      const id = newCommandId()
      return {
        id, sessionId: derivedSessionId(id), name: modelBatchTargetName(selection),
        create: { type: 'session.create', workspaceId: draftProject.id, ...modelLaunchOptions(selection, model), isolate: true, worktree },
      }
    })
    draftModelChoices.set(selections)
    worktreePreferences.update(preferences => ({ ...preferences, [draftProject.id]: worktree }))
    return { id: targets[0].id, text, uploads, targets }
  }

  async function submitModelBatch(batch) {
    if (!batch?.targets?.length || activeModelBatches().includes(batch.id)) return
    activeModelBatches.update(ids => [...ids, batch.id])
    startedBackgroundThread.set(null)
    try {
      const { sendModelBatch } = await import(codecUrl)
      await sendModelBatch(batch, sendCommand, (target, error) => {
        pendingModelBatches.update(batches => batches.flatMap(current => {
          if (current.id !== batch.id) return [current]
          const targets = error
            ? current.targets.map(item => item.id === target.id ? { ...item, error } : item)
            : current.targets.filter(item => item.id !== target.id)
          const started = error ? current.started : [...(current.started || []), { id: target.sessionId, name: target.name }]
          return targets.length ? [{ ...current, targets, started }] : []
        }))
        if (!error) modelBatchNotice.update(threads => [...threads, { id: target.sessionId, name: target.name }])
      })
    }
    catch (error) { stxAlert(error.message || 'Could not send to the selected models.') }
    finally { activeModelBatches.update(ids => ids.filter(id => id !== batch.id)) }
  }

  function dismissModelBatch() {
    if (modelBatchBusy()) return
    modelBatchNotice.set([])
    promptRef.current?.focus()
  }

  function discardModelBatch(batch) {
    if (activeModelBatches().includes(batch.id)) return
    pendingModelBatches.update(batches => batches.filter(item => item.id !== batch.id))
    promptRef.current?.focus()
  }

  function draftWorktreeSelection() {
    return { repositories: draftRepositoryKeys(), baseBranch: draftBaseBranch().trim() }
  }

  async function sendPrompt(mode = followUpPreference(), background = false) {
    const box = promptRef.current
    const raw = box?.value ?? ''
    const text = raw.trim()
    if (!hasComposerMessage() || startPending() || composerFilesPending() || conversationRewind()) return
    const files = editingFollowUp() ? [] : composerFiles()
    if (files.length && ['/clear', '/compact'].includes(text.toLowerCase())) {
      composerFilesError.set('Remove the attachments before running this command.')
      return
    }
    composerFilesError.set('')
    const editing = editingFollowUp()
    if (!editing && text.toLowerCase() === '/clear') {
      armFreshProviderSession()
      return
    }
    if (handoffBlocked()) return
    if (sessionId && background && !editing && !sessionOnline()) {
      stxAlert('Reconnect to send and open a new draft.')
      return
    }
    if (editing) {
      startPending.set(true)
      try {
        await followUpActions()?.saveEdit(text)
      }
      catch (error) { stxAlert(error.message) }
      finally { startPending.set(false) }
      return
    }

    const freshArm = freshSessionArmed() ? storedFreshSession() : ''
    const freshContext = freshArm ? { freshContext: true } : {}
    if (text === '/compact' && (!sessionId || pendingProviderSwitch() || freshContext.freshContext)) {
      stxAlert('Send a message to start this provider conversation before compacting it.')
      return
    }
    rememberPrompt()
    const draft = composerDraft()
    const commandId = draft?.commandId ?? newCommandId()
    const uploads = files.length ? { ...draft.upload, ids: files.map(file => file.id) } : null
    const attachmentInput = uploads ? { uploads } : {}
    if (draft) composerDraft.set({ ...draft, commandId })

    function openFreshDraft() {
      if (!box.isConnected || promptRef.current !== box || box.value || composerFiles().length) return
      const target = activeScratchSession ? `profile=${providerProfileId || 0}&project=none` : `workspace=${activeWorkspaceId}`
      openNewDraft(target)
    }

    function finishSend() {
      if (freshArm && storedFreshSession() === freshArm) storedFreshSession.set('')
      if (box.value === raw) {
        box.value = ''
        composerText.set('')
        sharedPromptNotice.set('')
        composerDraft.set(null)
        if (background && sessionId) openFreshDraft()
      }
      else if (uploads && composerDraft()?.upload?.draft === uploads.draft) setComposerFiles([], draft.upload)
    }

    const codexSelection = draftCodexSelection()
    if (pendingProviderSwitch()) {
      startPending.set(true)
      try {
        const choice = agentChoice(draftProvider())
        const model = draftModel() ? { model: draftModel() } : {}
        const { model: _model, ...options } = codexSelection ?? {}
        await sendCommand({ type: 'session.handoff', sessionId, afterTurnId: runningTurnId(), text, ...attachmentInput, ...choice, ...model,
          ...(codexSelection ? { codexTurnOptions: options } : {}), ...freshContext }, commandId)
        finishSend()
      }
      catch (error) {
        stxAlert(error.message || 'Could not switch providers. Your draft is still here.')
      }
      finally {
        startPending.set(false)
      }
      return
    }

    if (canSteerDraft() && mode === 'steer') {
      if (steeringPending()) return
      startPending.set(true)
      try {
        await sendCommand({ type: 'session.turn.steer', sessionId, turnId: runningTurnId(), text }, commandId)
        finishSend()
      }
      catch (error) {
        stxAlert(error.message || 'Could not steer the turn. Your draft is still here.')
      }
      finally {
        startPending.set(false)
      }
      return
    }

    if (sessionId && (uiBusy() || (!sessionOnline() && !sessionConnecting()) || localFollowUps()?.length
      || (freshContext.freshContext && followUps().entries.length))) {
      const actions = followUpActions()
      if (!actions) return
      const accepted = actions.stage({ id: commandId, text, ...attachmentInput, ...(uploads ? { fileNames: files.map(file => file.name) } : {}), ...(codexSelection ? { codexSelection } : {}), ...freshContext })
      if (freshArm && storedFreshSession() === freshArm) storedFreshSession.set('')
      box.value = ''
      composerText.set('')
      sharedPromptNotice.set('')
      composerDraft.set(null)
      followingTranscript.set(true)
      void nextTick(() => {
        const transcript = transcriptRef.current
        if (transcript) transcript.scrollTop = transcript.scrollHeight
      })
      if (background) {
        startPending.set(true)
        try {
          if (await accepted) openFreshDraft()
        }
        finally { startPending.set(false) }
      }
      return
    }

    if (!sessionId) {
      if (!draftProject?.trusted && !draftWithoutProject) return
      if (comparingModels()) {
        try {
          const batch = prepareModelBatch(text, uploads)
          if (!pendingModelBatches().length) modelBatchNotice.set([])
          pendingModelBatches.update(batches => [...batches, batch])
          finishSend()
          void submitModelBatch(batch)
          box.focus()
        }
        catch (error) { stxAlert(error.message) }
        return
      }
      startPending.set(true)
      try {
        const account = selectedDraftAccount()
        if (providerCatalog() === 'ready' && account?.status !== 'ready') throw new Error('Choose an available agent to start this session.')
        const { providerInstanceId, ...options } = modelLaunchOptions({
          account: draftProvider(), effort: draftEffort(), speed: draftSpeed(),
        }, selectedDraftModel())
        if (draftWithoutProject) {
          const profileId = Number(activeProfile) || undefined
          await sendCommand({ type: 'session.scratch.create', profileId, label: text || files[0]?.name, ...options }, commandId)
        }
        else {
          const worktree = draftUsesWorktree() ? draftWorktreeSelection() : undefined
          await sendCommand({
            type: 'session.create', workspaceId: draftProject.id, ...options, ...(providerInstanceId !== undefined ? { providerInstanceId } : {}),
            ...(worktree && { isolate: true, worktree }),
          }, commandId)
          if (worktree) worktreePreferences.update(preferences => ({ ...preferences, [draftProject.id]: worktree }))
        }
        const nextSession = derivedSessionId(commandId)
        // Keep the first turn's receipt stable across retries, including
        // switching between opening the thread and staying in this composer.
        await sendCommand({ type: 'session.turn.start', sessionId: nextSession, text, ...attachmentInput }, commandId + '_first')
        finishSend()
        if (background) {
          modelBatchNotice.set([])
          startedBackgroundThread.set(nextSession)
          startPending.set(false)
          box.focus()
        }
        else navigate(`/s/${nextSession}`)
      }
      catch (error) {
        startPending.set(false)
        stxAlert(error.message)
      }
      return
    }

    startPending.set(true)
    try {
      const compactAfterTurnId = compactNextPrompt() ? idleCompactionOffer()?.afterTurnId : undefined
      await sendCommand({ type: 'session.turn.start', sessionId, text, ...attachmentInput, ...(codexSelection ? { codexSelection } : {}),
        ...(compactAfterTurnId === undefined ? {} : { compactAfterTurnId }), ...freshContext }, commandId)
      finishSend()
    }
    catch (error) {
      stxAlert(error.message || 'Could not send the prompt. Your draft is still here.')
    }
    finally {
      startPending.set(false)
    }
  }

  function promptKeydown(event) {
    if (event.isComposing || event.keyCode === 229) return
    if (fileMentionPicker?.keydown(event)) return
    const command = matchedCommand(event, false, true)
    if (command === 'composer.sendAndNewThread' || (!sessionId && command === 'composer.startBackground')) {
      event.preventDefault()
      if (!event.repeat) void sendPrompt(followUpPreference(), true)
      return
    }
    if (event.key === 'ArrowDown' && offerClearCommand()) {
      event.preventDefault()
      clearCommandBox.current?.focus()
      return
    }
    if (event.key === 'Enter' && !event.altKey && (event.metaKey || event.ctrlKey) && (event.shiftKey ? canSteer() : canSteerDraft()) && !editingFollowUp()) {
      event.preventDefault()
      if (event.shiftKey) {
        const entry = followUps().entries[0]
        if (entry && showQueueSend(entry) && !steeringPending()) void sendQueuedFollowUp(entry.id)
      }
      else {
        void sendPrompt(oppositeFollowUp())
      }
      return
    }
    if (event.altKey && event.key === 'ArrowUp' && !event.isComposing && event.target.selectionStart === 0
      && event.target.selectionEnd === 0 && !editingFollowUp()) {
      const entry = followUps().entries.at(-1)
      if (entry && !entry.steering) {
        event.preventDefault()
        followUpActions()?.beginEdit(entry)
        return
      }
    }
    if (sessionId && !startPending() && !editingFollowUp() && !composerFiles().length
      && promptRef.current && transcriptRef.current && composerRecall?.step(event, promptRef.current, transcriptRef.current)) {
      rememberPrompt(true)
      return
    }
    if (event.key === 'Escape' && editingFollowUp()) {
      event.preventDefault()
      followUpActions()?.endEdit()
      return
    }
    if (event.key === 'Enter' && !event.altKey && !event.shiftKey && !event.isComposing && event.keyCode !== 229) {
      event.preventDefault()
      event.target.form?.requestSubmit()
    }
  }

  function dismissBackgroundNotice() {
    startedBackgroundThread.set(null)
    promptRef.current?.focus()
  }

  // Optimistic: Stop hides immediately through `stopPressed`, but the turn is
  // not over until the log says so — `turn.interrupted` is what settles it.
  function stopTurn() {
    if (!sessionId || !sessionOnline()) return
    stopPressed.set(true)
    dispatch({ type: 'session.turn.interrupt', sessionId })
  }

  function closeConnectorOptions(restoreFocus = false) {
    const details = connectorOptions.current
    if (!details?.open) return
    details.open = false
    if (restoreFocus) details.querySelector('summary')?.focus()
  }

  function blurConnectorOptions(event) {
    if (event.relatedTarget && !event.currentTarget.contains(event.relatedTarget)) closeConnectorOptions()
  }

  function guardConnectorOptions(event) {
    if (pendingApprovalId()) event.preventDefault()
  }

  function handleConnectorOptions(event) {
    const details = connectorOptions.current
    if (event.key === 'Escape' && details?.open) {
      event.preventDefault()
      event.stopPropagation()
      closeConnectorOptions(true)
      return
    }
    if (!details || pendingApprovalId() || !['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return
    const buttons = [...details.querySelectorAll('button:not(:disabled)')]
    if (!buttons.length) return
    event.preventDefault()
    details.open = true
    const index = buttons.indexOf(event.target)
    if (event.key === 'Home' || (event.key === 'ArrowDown' && index === -1)) buttons[0].focus()
    else if (event.key === 'End' || (event.key === 'ArrowUp' && index === -1)) buttons.at(-1)?.focus()
    else buttons[(index + (event.key === 'ArrowDown' ? 1 : -1) + buttons.length) % buttons.length].focus()
  }

  useEventListener('pointerdown', (event) => {
    if (connectorOptions.current?.open && !connectorOptions.current.contains(event.target)) closeConnectorOptions()
  }, { target: document })

  async function respondToApproval(decision, scope = 'once') {
    const id = approvalId()
    if (!id || !sessionId || pendingApprovalId()) return
    pendingApprovalId.set(id)
    try {
      await sendCommand({
        type: 'session.approval.respond',
        sessionId,
        approvalId: id,
        decision,
        scope,
      })
    }
    catch (error) {
      if (pendingApprovalId() === id) {
        pendingApprovalId.set(0)
        stxAlert(error instanceof Error ? error.message : 'Could not submit this approval.')
      }
    }
  }
  function approveTool() { respondToApproval('allowed') }
  function denyTool() { respondToApproval('denied') }

  function waitingSessionState() {
    return pendingApprovals().length ? 'awaiting-approval' : inputRequest() ? 'awaiting-input' : 'running'
  }

  function questionActivityLabel(outcome) {
    if (outcome === 'answered') return 'Question answered'
    if (outcome === 'declined') return 'Question declined'
    if (outcome === 'interrupted') return 'Question interrupted'
    return 'Input requested'
  }

  function updateInputActivity(request, outcome) {
    const updated = { requestId: request.requestId, outcome }
    const applyActivity = (list) => list.some(item => item.requestId === request.requestId)
      ? list.map(item => item.requestId === request.requestId ? updated : item)
      : [...list, updated]
    if (request.turnId === initialResponseTurn) ssrInputActivity.update(applyActivity)
    else updateClientTurn(request.turnId, turn => ({ ...turn, inputRequests: applyActivity(turn.inputRequests) }))
  }

  const terminalController = state(null)
  const terminalStates = state({})
  const activeTerminalStatus = derived(() => terminalStates()[terminalTabs().activeKey])
  const terminalBusy = derived(() => Boolean(activeTerminalStatus()?.busy))
  const terminalExited = derived(() => Boolean(activeTerminalStatus()?.exited))
  const terminalError = derived(() => activeTerminalStatus()?.error || '')
  const canRestartTerminal = derived(() => terminalExited() || Boolean(terminalError()))
  const terminalStatus = derived(() => activeTerminalStatus()?.reconnecting ? 'Reconnecting…' : activeTerminalStatus()?.activity || '')
  const canSplitTerminal = derived(() => sessionOnline() && !terminalBusy() && visibleTerminalTabs().length > 0 && visibleTerminalTabs().length < 4)
  const terminalActionsOpen = state(false)
  const terminalActionSelection = state('')
  const terminalActionHasOutput = state(false)
  const terminalActionWritable = state(false)
  const terminalClipboardNotice = state('')
  const terminalReadableText = state('')
  const terminalPasteText = state('')
  const terminalKeyboardOpen = state(false)
  const terminalKeyboardViewport = state(0)
  let terminalKeyboardRestingHeight = 0
  let terminalActionKey = ''
  let terminalActionOrigin = null
  let terminalPasteTarget = null
  let terminalTrigger = null

  function boundedTerminalHeight(height) {
    return Number.isFinite(height) ? Math.min(58, Math.max(22, Math.round(height))) : 31
  }

  function resizeTerminalByKey(event) {
    const step = event.shiftKey ? 10 : 3
    const heights = { ArrowUp: terminalHeight() + step, ArrowDown: terminalHeight() - step, Home: 22, End: 58 }
    if (!Object.hasOwn(heights, event.key)) return
    event.preventDefault()
    const height = boundedTerminalHeight(heights[event.key])
    terminalHeight.set(height)
    storedTerminalHeight.set(height)
  }

  function beginTerminalResize(event) {
    if (event.button !== 0) return
    const grip = event.currentTarget
    const viewportHeight = grip.ownerDocument.documentElement.clientHeight
    if (!viewportHeight) return
    event.preventDefault()
    grip.focus({ preventScroll: true })
    grip.setPointerCapture(event.pointerId)
    terminalDrag = { pointerId: event.pointerId, y: event.clientY, height: terminalHeight(), viewportHeight }
  }

  function moveTerminalResize(event) {
    if (terminalDrag?.pointerId !== event.pointerId) return
    const delta = (terminalDrag.y - event.clientY) * 100 / terminalDrag.viewportHeight
    terminalHeight.set(boundedTerminalHeight(terminalDrag.height + delta))
  }

  function endTerminalResize(event) {
    if (terminalDrag?.pointerId !== event.pointerId) return
    storedTerminalHeight.set(terminalHeight())
    terminalDrag = null
  }

  function cancelTerminalResize(event) {
    if (terminalDrag?.pointerId !== event.pointerId) return
    terminalHeight.set(terminalDrag.height)
    terminalDrag = null
  }

  function restoreTerminalFocus() {
    const trigger = terminalTrigger?.getClientRects().length ? terminalTrigger : termHeaderToggle.current
    trigger?.focus()
    terminalTrigger = null
  }

  function revealActiveTerminalTab() {
    const active = terminalTabStrip.current?.querySelector('[aria-selected="true"]')
    active?.scrollIntoView({ block: 'nearest', inline: 'nearest' })
  }

  effect(() => {
    if (termOpen() && canRestartTerminal()) void nextTick(revealActiveTerminalTab)
  })

  function focusActiveTerminalTab() {
    revealActiveTerminalTab()
    terminalController()?.focus(terminalTabs().activeKey)
  }

  function showTerminalProcess() {
    if (!termOpen() || !sessionOnline()) return
    const dock = terminalTabs()
    if (!activeTerminalTab()) {
      const tab = { key: crypto.randomUUID(), number: 1, started: false }
      saveTerminalTabs([tab], tab.key)
      requestAnimationFrame(showTerminalProcess)
      void nextTick(focusActiveTerminalTab)
      return
    }
    if (!terminalDock()) saveTerminalTabs(dock.tabs, dock.activeKey)
    terminalController()?.show(visibleTerminalTabs())
  }

  function saveTerminalTabs(tabs, activeKey, directions = terminalTabs().directions || {}) {
    terminalDock.set({ tabs, activeKey, directions })
    if (legacyTerminalSession()?.key) legacyTerminalSession.set(null)
  }

  function showSelectedTerminal(tabs, key, directions) {
    saveTerminalTabs(tabs, key, directions)
    void nextTick(focusActiveTerminalTab)
    requestAnimationFrame(showTerminalProcess)
  }

  function addTerminalTab(direction) {
    if (!sessionOnline() || terminalBusy() || (direction && !canSplitTerminal())) return
    const { tabs, directions } = terminalTabs()
    const tab = { key: crypto.randomUUID(), number: (tabs.at(-1)?.number ?? 0) + 1, started: false }
    if (direction) {
      const group = activeTerminalGroup()
      showSelectedTerminal([...tabs, { ...tab, group }], tab.key, { ...directions, [group]: direction })
    }
    else showSelectedTerminal([...tabs, tab], tab.key)
  }

  function selectTerminalGroup(key) {
    if (key === activeTerminalGroup()) {
      void nextTick(focusActiveTerminalTab)
      return
    }
    const { tabs } = terminalTabs()
    const tab = tabs.find(item => (item.group || item.key) === key)
    if (tab) showSelectedTerminal(tabs, tab.key)
  }

  function selectTerminalPane(key) {
    if (key !== terminalTabs().activeKey && visibleTerminalTabs().some(tab => tab.key === key))
      saveTerminalTabs(terminalTabs().tabs, key)
  }

  function focusTerminalPane(key) {
    selectTerminalPane(key)
    void nextTick(focusActiveTerminalTab)
  }

  function focusTerminalInput(key) {
    selectTerminalPane(key)
    terminalInputFocused.set(true)
  }

  function blurTerminalInput(event) {
    if (!event.relatedTarget?.closest?.('[data-terminal-host], [data-terminal-keyboard-input]')) terminalInputFocused.set(false)
  }

  function keepTerminalKeyboard(event) {
    if (terminalKeyboardOpen()) event.preventDefault()
  }

  function toggleTerminalKeyboard() {
    if (terminalKeyboardOpen()) {
      terminalKeyboardInput.current?.blur()
      focusActiveTerminalTab()
    }
    else terminalKeyboardInput.current?.focus({ preventScroll: true })
  }

  function terminalKeyboardFocused(event) {
    // Keep one space before the caret so a soft Backspace can emit an input
    // event even though the shell, rather than the textarea, holds the line.
    event.currentTarget.value = ' '
    event.currentTarget.setSelectionRange(1, 1)
    const owner = event.currentTarget.ownerDocument
    terminalKeyboardRestingHeight = owner.defaultView?.visualViewport?.height || owner.documentElement.clientHeight
    terminalKeyboardOpen.set(true)
    terminalInputFocused.set(true)
  }

  function terminalKeyboardBlurred(event) {
    event.currentTarget.value = ''
    terminalKeyboardOpen.set(false)
    terminalKeyboardViewport.set(0)
    blurTerminalInput(event)
  }

  function fitTerminalKeyboardViewport() {
    const input = terminalKeyboardInput.current
    if (!input || !terminalKeyboardOpen()) return
    const view = input.ownerDocument.defaultView?.visualViewport
    if (!view || view.scale !== 1) return
    const height = Math.round(view.height)
    if (terminalKeyboardRestingHeight - height > 100) terminalKeyboardViewport.set(height)
    else if (terminalKeyboardViewport()) {
      input.blur()
      focusActiveTerminalTab()
    }
  }

  onMount(() => {
    const view = terminalKeyboardInput.current?.ownerDocument.defaultView?.visualViewport
    if (view) useEventListener('resize', fitTerminalKeyboardViewport, { target: view })
  })

  function terminalKeyboardSend(data) {
    const tab = activeTerminalTab()
    if (tab) terminalController()?.input(tab, data)
  }

  function terminalKeyboardEdited(event) {
    if (event.isComposing || !terminalKeyboardOpen()) return
    const input = event.currentTarget
    const text = input.value.startsWith(' ') ? input.value.slice(1) : input.value
    input.value = ' '
    input.setSelectionRange(1, 1)
    if (event.inputType === 'deleteContentBackward') terminalKeyboardSend('\x7f')
    else if (event.inputType === 'insertLineBreak' || event.inputType === 'insertParagraph') terminalKeyboardSend('\r')
    else if (event.inputType === 'insertFromPaste') {
      const tab = activeTerminalTab()
      if (tab) terminalController()?.pasteText(tab.key, text)
    }
    else if (text) terminalKeyboardSend(text)
  }

  function terminalKeyboardKeydown(event) {
    // Printable and composing input reaches the PTY through the edit event.
    if (event.isComposing || event.keyCode === 229 || (event.key.length === 1 && !event.metaKey && !event.ctrlKey && !event.altKey)) return
    const tab = activeTerminalTab()
    if (tab) termKeydown(tab, event)
  }

  function terminalKeyboardPaste(event) {
    const tab = activeTerminalTab()
    if (tab) pasteTerminalEvent(tab.key, event)
  }

  function terminalPanelElement(selector) {
    return termSurface.current?.closest('[data-terminal]')?.querySelector(selector)
  }

  function openTerminalActions(key, event) {
    const menu = terminalPanelElement('[data-terminal-actions]')
    const dock = terminalController()
    if (!menu || !dock || !key || typeof menu.showPopover !== 'function') return
    event.preventDefault()
    if (menu.matches(':popover-open')) {
      menu.hidePopover()
      if (event.type === 'click') return
    }
    terminalActionKey = key
    terminalActionOrigin = event.currentTarget
    terminalActionSelection.set(dock.selectedText(key))
    terminalActionHasOutput.set(dock.hasOutput(key))
    terminalActionWritable.set(dock.canPaste(key))
    terminalClipboardNotice.set('')
    const context = event.type === 'contextmenu' && (event.clientX || event.clientY)
    const anchor = terminalActionOrigin.getBoundingClientRect()
    const viewport = menu.ownerDocument.documentElement
    menu.showPopover()
    terminalActionsOpen.set(true)
    const { width, height } = menu.getBoundingClientRect()
    const x = context ? event.clientX : anchor.right - width
    const y = context ? event.clientY : anchor.top - height - 4
    menu.style.left = Math.max(8, Math.min(x, viewport.clientWidth - width - 8)) + 'px'
    menu.style.top = Math.max(8, Math.min(y, viewport.clientHeight - height - 8)) + 'px'
    menu.focus({ preventScroll: true })
    void nextTick(() => {
      if (menu.matches(':popover-open')) (menu.querySelector('button:not(:disabled)') || menu).focus({ preventScroll: true })
    })
  }

  function terminalActionsToggled(event) {
    const open = event.currentTarget.matches(':popover-open')
    terminalActionsOpen.set(open)
    if (!open) terminalActionSelection.set('')
  }

  function terminalActionsKeydown(event) {
    const menu = event.currentTarget
    if (event.key === 'Tab') {
      menu.hidePopover()
      terminalActionOrigin?.focus({ preventScroll: true })
      return
    }
    const items = [...menu.querySelectorAll('button:not(:disabled)')]
    const index = items.indexOf(event.target)
    const next = event.key === 'ArrowDown' ? items[(index + 1) % items.length]
      : event.key === 'ArrowUp' ? items[(index - 1 + items.length) % items.length]
        : event.key === 'Home' ? items[0] : event.key === 'End' ? items.at(-1) : null
    if (!next) return
    event.preventDefault()
    next.focus({ preventScroll: true })
  }

  function pasteTerminalEvent(key, event) {
    event.preventDefault()
    terminalController()?.pasteText(key, event.clipboardData?.getData('text/plain') || '')
  }

  async function copyTerminalText(target, text) {
    try {
      await composerDraftTools.writeClipboardText(target, text, desktop()?.clipboard)
      terminalClipboardNotice.set('Copied terminal output.')
    }
    catch {
      terminalClipboardNotice.set('Could not copy. Use the system Copy command.')
    }
  }

  function addTerminalTextToDraft(text) {
    const box = promptRef.current
    if (!box || box.form?.hidden || !text) return
    if (text.length > 32000) {
      terminalClipboardNotice.set('Select up to 32,000 characters to add to chat.')
      return
    }
    let fence = '~~~'
    for (const match of text.matchAll(/~+/gu)) {
      if (match[0].length >= fence.length) fence = '~'.repeat(match[0].length + 1)
    }
    const before = box.value.trimEnd()
    box.value = (before ? before + '\n\n' : '') + 'Terminal output\n\n' + fence + '\n' + text + '\n' + fence
    box.setSelectionRange(box.value.length, box.value.length)
    promptEdited()
    box.focus({ preventScroll: true })
  }

  async function runTerminalAction(action, event) {
    const key = terminalActionKey
    const dock = terminalController()
    if (!dock || !key) return
    const target = event.currentTarget
    const selection = terminalActionSelection()
    terminalPanelElement('[data-terminal-actions]')?.hidePopover()
    if (action === 'read') {
      terminalReadableText.set(dock.visibleText(key))
      terminalPanelElement('[data-terminal-text-dialog]')?.showModal()
      return
    }
    dock.focus(key)
    if (action === 'all') dock.selectAll(key)
    else if (action === 'latest') dock.jumpToLatest(key)
    else if (action === 'chat') addTerminalTextToDraft(selection)
    else if (action === 'copy') await copyTerminalText(target, selection)
    else if (action === 'paste' && dock.canPaste(key)) {
      try {
        const text = await composerDraftTools.readClipboardText(target, desktop()?.clipboard)
        if (text) {
          dock.pasteText(key, text)
          return
        }
      }
      catch { /* The system edit menu can still accept an explicit paste. */ }
      if (!termOpen() || terminalController() !== dock || !dock.canPaste(key)) return
      terminalPasteTarget = { dock, key }
      terminalPasteText.set('')
      terminalPasteDialog.current?.showModal()
    }
  }

  function submitTerminalPaste() {
    const text = terminalPasteText()
    const target = terminalPasteTarget
    if (!text || !target || terminalController() !== target.dock || !target.dock.canPaste(target.key)) return
    target.dock.pasteText(target.key, text)
    terminalPasteDialog.current?.close()
  }

  function finishTerminalPaste() {
    const target = terminalPasteTarget
    terminalPasteTarget = null
    terminalPasteText.set('')
    if (termOpen() && target?.dock === terminalController()) target.dock.focus(target.key)
  }

  function closeTerminalTextDialog() {
    terminalReadableText.set('')
    terminalActionOrigin?.focus({ preventScroll: true })
  }

  useEventListener('selectionchange', () => terminalController()?.selectionChanged(), { target: document })
  useEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    const menu = terminalPanelElement('[data-terminal-actions]')
    if (!menu?.matches(':popover-open')) return
    event.preventDefault()
    event.stopPropagation()
    menu.hidePopover()
    terminalActionOrigin?.focus({ preventScroll: true })
  }, { target: document, capture: true })
  useEventListener('pointerdown', (event) => {
    if (!terminalActionsOpen() || event.target?.closest?.('[data-terminal-actions], [data-terminal-actions-trigger]')) return
    const menu = terminalPanelElement('[data-terminal-actions]')
    if (menu?.matches(':popover-open')) menu.hidePopover()
  }, { target: document })
  useEventListener('resize', () => {
    if (terminalActionsOpen()) terminalPanelElement('[data-terminal-actions]')?.hidePopover()
  })

  function terminalTabKeydown(event) {
    const tabs = [...event.currentTarget.querySelectorAll('[role="tab"]')]
    const index = tabs.indexOf(event.target)
    if (index < 0) return
    const target = event.key === 'Home' ? tabs[0]
      : event.key === 'End' ? tabs.at(-1)
      : event.key === 'ArrowRight' ? tabs[(index + 1) % tabs.length]
      : event.key === 'ArrowLeft' ? tabs[(index - 1 + tabs.length) % tabs.length]
      : undefined
    if (!target) return
    event.preventDefault()
    target.focus()
  }

  function finishTerminalClose(key, action) {
    const { tabs, activeKey, directions } = terminalTabs()
    const tab = tabs.find(item => item.key === key)
    if (!tab) return
    const group = tab.group || tab.key
    if (action === 'restart') {
      const replacement = { ...tab, key: crypto.randomUUID(), group, name: undefined, started: false }
      const updated = tabs.map(item => item.key === key ? replacement : item)
      if (activeKey === key) showSelectedTerminal(updated, replacement.key)
      else {
        saveTerminalTabs(updated, activeKey)
        requestAnimationFrame(showTerminalProcess)
      }
      return
    }
    const remaining = tabs.filter(item => item.key !== key)
    const groupTabs = tabs.filter(item => (item.group || item.key) === group)
    const groupIndex = groupTabs.indexOf(tab)
    const next = remaining.find(item => item.key === activeKey) ?? groupTabs[groupIndex + 1] ?? groupTabs[groupIndex - 1]
      ?? remaining[tabs.indexOf(tab)] ?? remaining.at(-1)
    const nextDirections = { ...directions }
    if (!remaining.some(item => (item.group || item.key) === group)) delete nextDirections[group]
    if (next?.key === activeKey) {
      saveTerminalTabs(remaining, activeKey, nextDirections)
      requestAnimationFrame(showTerminalProcess)
    }
    else if (next) showSelectedTerminal(remaining, next.key, nextDirections)
    else {
      saveTerminalTabs([], '', {})
      if (termOpen()) {
        termOpen.set(false)
        restoreTerminalFocus()
      }
    }
  }

  function restartTerminal() {
    const tab = activeTerminalTab()
    if (!tab || !sessionOnline() || terminalBusy()) return
    terminalController()?.close(tab.key, 'restart')
  }

  async function endTerminal() {
    const tab = activeTerminalTab()
    if (!tab || !sessionOnline() || terminalBusy()) return
    if (terminalController()?.canEnd(tab.key) && !await stxConfirm(`End Terminal ${tab.number}? Its shell will stop and its scrollback will be cleared.`, { confirmText: 'End terminal', cancelText: 'Keep terminal' })) return
    if (tab.key === activeTerminalTab()?.key && sessionOnline() && !terminalBusy()) terminalController()?.close(tab.key, 'end')
  }

  function toggleTerminal(event) {
    // No workspace, no shell to open.
    if (!sessionId || !Number(activeWorkspaceId)) return
    if (!wideWorkspace() && browserPreviewOpen()) closeBrowserPreview(false)
    if (!wideWorkspace() && workspaceFilesOpen()) {
      closeWorkspaceFiles(false)
      if (termOpen()) {
        void nextTick(focusActiveTerminalTab)
        return
      }
    }
    if (!wideWorkspace() && diffOpen()) {
      diffOpen.set(false)
      diffTrigger = null
      if (termOpen()) {
        void nextTick(focusActiveTerminalTab)
        return
      }
    }
    if (termOpen()) {
      const menu = terminalPanelElement('[data-terminal-actions]')
      if (menu?.matches(':popover-open')) menu.hidePopover()
      termOpen.set(false)
      restoreTerminalFocus()
      return
    }
    terminalTrigger = workspaceActionsOpen() ? workspaceActionsToggle.current
      : event?.currentTarget ?? termSurface.current?.ownerDocument.activeElement
    closeWorkspaceActions()
    termOpen.set(true)
    // Focused now, not in the frame callback: keys typed right after the
    // click must land in the host (they buffer until the PTY binds).
    void nextTick(focusActiveTerminalTab)
    // Measured after the binding has shown the panel — a display:none box
    // measures zero — and the PTY opens at the size actually on screen.
    requestAnimationFrame(showTerminalProcess)
  }

  // Window chords. Which chord runs which command comes from the keyboard
  // registry, so the Keyboard settings section is the single place that
  // decides — the defaults are still Ctrl+` for the terminal, the editor
  // convention, and Cmd+, for settings, where in the desktop window the menu
  // item usually claims the chord first and arrives as `craft:settings`.
  effect(() => {
    if (sidebarShortcutBlocked() || terminalInputFocused() || recordingKeybinding()) sidebarJumpHints?.clear()
  })
  useEventListener('keydown', (event) => {
    // Recording comes before the dialog guard: the pane records from inside
    // the open settings sheet, and the chord being bound must not also run
    // the command it is being bound to.
    if (recordingKeybinding()) {
      event.preventDefault()
      captureKeybinding(event)
      return
    }
    if (event.defaultPrevented) return
    if (repositoryPullRequestDialog.current?.open) {
      if (event.key === 'Escape') {
        event.preventDefault()
        closeRepositoryPullRequest()
      }
      return
    }
    if (repositorySyncDialog.current?.open) {
      if (event.key === 'Escape') {
        event.preventDefault()
        closeRepositorySync()
      }
      return
    }
    if (repositoryCommitDialog.current?.open) {
      if (event.key === 'Escape') {
        event.preventDefault()
        closeRepositoryCommit()
      }
      return
    }
    updateSidebarJumpHints(event)
    const command = matchedCommand(event, Boolean(event.target?.closest?.('[data-terminal-host]')))
    if (draftPickerOpen()) {
      const number = /^modelPicker\.jump\.([1-9])$/.exec(command || '')
      if (number && !event.repeat) {
        event.preventDefault()
        const result = numberedPickerResults()[Number(number[1]) - 1]
        if (result) pickDraftModel(result)
      }
      return
    }
    const editable = event.target?.closest?.('textarea, input, [contenteditable="true"]')
    if (command === 'composer.stash' && stashReady() && promptRef.current?.form && !promptRef.current.form.hidden
      && !threadUndoBlocked() && !editingFollowUp() && (!editable || editable === promptRef.current)) {
      event.preventDefault()
      if (!event.repeat && !startPending()) stashOrRestorePrompt()
      return
    }
    if (threadUndoBlocked() || stashOpen()) return
    if (command === 'thread.undo' && visibleUndo() && (!editable || threadUndoShortcutClaimed()) && !profileModalOpen()) {
      event.preventDefault()
      if (!event.repeat) void undoThreadAction()
      return
    }
    if (visibleUndo() && !['Alt', 'Control', 'Meta', 'Shift'].includes(event.key)) threadUndoShortcutClaimed.set(false)
    if (arrangementOpen()) return
    if (!event.repeat && command && /^thread\.(?:jump\.|next$|previous$)/.test(command) && !sidebarShortcutBlocked()) {
      const sidebar = sidebarRef.current
      const target = sidebar && keyboard?.sidebarShortcutTarget(sidebar, String(visibleProfile()), sessionId, command)
      if (target) {
        event.preventDefault()
        if (sidebarOpen()) closeSidebar()
        const address = new URL(target, location.origin)
        if (address.pathname !== location.pathname || address.search !== location.search) openDraftAddress(target)
      }
      return
    }
    // Esc closes whichever sheet is open. preventDefault matters beyond the
    // DOM: an unhandled keyDown climbs WKWebView's responder chain and AppKit
    // answers it with the system beep.
    if (event.key === 'Escape') {
      if (transcriptFindOpen()) {
        event.preventDefault()
        closeTranscriptFind()
      }
      else if (profileModalOpen()) {
        event.preventDefault()
        closeProfileModal()
      }
      else if (workspaceActionsOpen()) {
        event.preventDefault()
        closeWorkspaceActions()
      }
      else if (sidebarOpen()) {
        event.preventDefault()
        closeSidebar()
      }
      else if (workspaceFilesOpen()) {
        event.preventDefault()
        closeWorkspaceFiles()
      }
      else if (browserPreviewOpen()) {
        event.preventDefault()
        closeBrowserPreview()
      }
      else if (diffOpen()) {
        event.preventDefault()
        toggleDiff()
      }
      return
    }
    // A command whose precondition fails is left unhandled rather than
    // swallowed, so Cmd+F still reaches the browser's own find on a page with
    // no transcript.
    if (command === 'transcript.find' && sessionId) {
      event.preventDefault()
      openTranscriptFind(event.target)
      return
    }
    if (command === 'settings.open') {
      event.preventDefault()
      openSettings()
      return
    }
    if (command === 'thread.copyReference' && sessionId && !editable && !event.target?.ownerDocument?.getSelection()?.toString()) {
      event.preventDefault()
      if (!event.repeat) copyThreadLink(event)
      return
    }
    if (command === 'thread.search' && (Number(activeProfile) || composerText().trim())) {
      event.preventDefault()
      openThreadSearch()
      return
    }
    if (command === 'thread.startWithoutProject') {
      event.preventDefault()
      startScratchDraft()
      return
    }
    if (command === 'editor.open' && workspaceEditorAllowed && !event.repeat) {
      event.preventDefault()
      void chooseWorkspaceEditor(null, '', 0, true)
      return
    }
    if (command !== 'terminal.toggle') return
    event.preventDefault()
    toggleTerminal()
  }, { target: window })

  useEventListener('input', () => {
    if (visibleUndo()) threadUndoShortcutClaimed.set(false)
  }, { target: window })

  useEventListener('storage', (event) => {
    if (event.key === composerDraftTools?.PROMPT_STASH_KEY || event.key === null) refreshPromptStash()
  }, { target: window })

  function threadUndoBlocked() {
    return projectDialog.current?.open || cloneDialog.current?.open || settingsDialogRef.current?.open || threadSearchDialog.current?.open
      || threadActionsDialog.current?.open || workspaceEditorDialog.current?.open
      || promptLinkDialog.current?.open || shareClipboardDialog.current?.open
  }

  function termKeydown(tab, event) {
    if (event.target?.closest?.('[data-terminal-link]')) return
    if ((event.ctrlKey && event.shiftKey || event.metaKey) && !event.altKey && event.key.toLowerCase() === 'c') {
      const text = terminalController()?.selectedText(tab.key)
      if (text) {
        event.preventDefault()
        void copyTerminalText(event.currentTarget, text)
        return
      }
    }
    if (terminalClipboardNotice()) terminalClipboardNotice.set('')
    const command = matchedCommand(event, true)
    if (command === 'settings.open') return
    if (!command) {
      terminalController()?.keydown(tab, event)
      return
    }
    event.preventDefault()
    event.stopPropagation()
    if (!event.repeat) runTerminalShortcut(command)
  }

  async function openTerminalLink(event) {
    const link = event.target?.closest?.('[data-terminal-link]')
    if (!link || !previewDiscoveryAllowed || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
    const url = terminalController()?.previewAddress(link.href, link.ownerDocument.location.origin)
    if (!url) return
    event.preventDefault()
    await showBrowserPreview(event)
    if (!browserPreviewTools() || !browserPreviewOpen()) return
    openDiscoveredPreview({ url })
  }

  function runTerminalShortcut(command) {
    if (command === 'terminal.toggle') toggleTerminal()
    else if (command === 'terminal.new') addTerminalTab()
    else if (command === 'terminal.split') addTerminalTab('columns')
    else if (command === 'terminal.splitVertical') addTerminalTab('rows')
    else if (command === 'terminal.close') void endTerminal()
  }

  // The page speaks CBOR to the socket, so it needs the same codec the server
  // uses. It arrives as a module rather than as assumed globals — the island
  // used to call `window.__harnessEncode`, which nothing ever defined, so the
  // socket connected and then threw on its first frame. An async function
  // rather than top-level await: a client script's body is emitted inside a
  // plain function wrapper, where `await` only exists behind `async`.
  async function connectLiveSession() {
    const codec = await import(codecUrl)
    const { applyFollowUpEvent, claudeCompactionReturnAt, codexSelectionLabel, threadDisplayTitle, createFollowUpActions, createSessionSocket, createThreadSidebar, createTerminalDock, updateTranscriptMarkdown, createQuestionForm, paintQuestionFiles, useTranscriptControl, closeTranscriptMenu, createTranscriptHighlighter, watchWorkspaceChanges, loadWorkspaceReviewOptions, loadRepositoryStatus } = codec
    snoozeEditor.set({
      ...codec.createSnoozeEditor({
        initial: settings().snoozePresets ?? [],
        render(rows) {
          snoozePreviewTime.set(new Date())
          snoozeRows.set(rows)
        },
        error: message => snoozeSaveError.set(message),
        async save(presets) {
          await sendCommand({ type: 'settings.update', changes: { snoozePresets: presets } })
        },
      }),
      maxRows: codec.maxSnoozePresets,
    })
    function receiveHostSettings(frame) {
      if (frame?.t === 'host-settings') {
        settings.update(previous => ({ ...previous, ...frame.settings }))
        if (frame.settings?.snoozePresets) snoozeEditor()?.receive(frame.settings.snoozePresets)
        // The reply carries a project's answers only when this client asked
        // about one, and the whole set rather than a delta.
        if (frame.workspaceId === projectSettingsId && frame.projectSettings) projectPins.set({ ...frame.projectSettings })
        return true
      }
      const event = frame?.t === 'event' && frame.event.sessionId === 0 && frame.event.payload.type === 'settings.updated'
        ? frame.event.payload
        : null
      if (!event) return false
      // A change to some other project is still a settings event and not the
      // sidebar's to read, so it is consumed here and dropped.
      if (event.workspaceId !== undefined) {
        if (event.workspaceId === projectSettingsId) {
          projectPins.update((previous) => {
            const next = { ...previous, ...event.changes }
            for (const key of event.inherit || []) delete next[key]
            return next
          })
        }
        return true
      }
      settings.update(previous => ({ ...previous, ...event.changes }))
      if (event.changes.snoozePresets) snoozeEditor()?.receive(event.changes.snoozePresets)
      return true
    }
    const sidebar = sidebarRef.current
    const threadSidebar = sidebar && createThreadSidebar({
      root: sidebar,
      arrangement: threadArrangement.current,
      onLayout(profileId, layout) {
        if (!arrangementOpen() || profileId !== Number(providerProfileId)) return
        arrangementLayout.set(layout)
        restoreArrangementFocus()
      },
      async save(sessionId, intent, fromArrangement) {
        if (fromArrangement) {
          await saveArrangement(sessionId, intent)
          return
        }
        threadOrderStatus.set('')
        try {
          await sendThreadOrganization({ sessionId, action: 'drop', ...intent })
          threadOrderStatus.set('Thread position saved.')
        }
        catch (error) { stxAlert(error.message) }
      },
      async rename(sessionId, title) {
        try { await sendThreadOrganization({ sessionId, action: 'rename', title }) }
        catch (error) { stxAlert(error.message) }
      },
    })
    cancelArrangementDrag = () => threadSidebar?.cancelArrangement()
    const watchOrder = (connection) => {
      watchSidebarOrder = () => {
        const profileId = Number(arrangementOpen() ? providerProfileId : visibleProfile())
        if (profileId) connection.send({ t: 'watch-sidebar', profileId })
      }
    }
    if (!sessionId) {
      const connection = createSessionSocket({
        url: serverUrl, sessionId: null, cursor: () => 0,
        onSocket: socket => { liveSocket = socket },
        onFrame: frame => receiveHostSettings(frame) || threadSidebar?.receive(frame),
        onOnline: (online) => {
          if (!online) return
          watchSidebarOrder()
          connection.send({ t: 'read-settings', ...(projectSettingsId ? { workspaceId: projectSettingsId } : {}) })
        },
      })
      watchOrder(connection)
      reconnectLiveSession = connection.open
      disconnectLiveSession = () => {
        threadSidebar?.dispose()
        connection.dispose()
      }
      connection.open()
      return
    }
    diffTools = codec
    changesWatcher.set(watchWorkspaceChanges)
    reviewOptionsLoader.set(loadWorkspaceReviewOptions)
    diffGitStatusLoader.set(loadRepositoryStatus)
    openLinkedDiffLine()
    transcriptControl = useTranscriptControl
    transcriptMenuKeyboard = closeTranscriptMenu
    questionForm.set(createQuestionForm({
      state,
      initialRequests: initialInputs,
      sessionId,
      focus(target) {
        void nextTick(() => {
          if (target === 'answer') questionCard.current?.querySelector('[data-question-answer]')?.focus()
          else (target === 'prompt' ? promptRef.current : questionCard.current)?.focus({ preventScroll: true })
        })
      },
      hasFocus(target) {
        return target === 'card' ? questionCard.current?.matches(':focus-within') : promptRef.current?.matches(':focus')
      },
      recordActivity(request, outcome) {
        updateInputActivity(request, outcome)
        if (request.attachments?.length) void nextTick(() => paintQuestionFiles(transcriptRef.current, sessionId, request))
      },
      send(requestId, answers) {
        return sendCommand({ type: 'session.input.respond', sessionId, requestId, answers })
      },
    }))

    const transcript = transcriptRef.current
    if (initialInputActivity.some(request => request.attachments?.length))
      void nextTick(() => initialInputActivity.forEach(request => paintQuestionFiles(transcriptRef.current, sessionId, request)))
    if (transcript) {
      transcriptHighlighter = createTranscriptHighlighter(transcript)
      transcriptHighlighter?.update(transcript)
    }
    const liveResponse = transcript?.querySelector('[data-live-response]')
    if (liveResponse) {
      responseByTurn.set(initialResponseTurn, JSON.parse(liveResponse.getAttribute('data-response-source') || '""'))
      liveResponse.removeAttribute('data-response-source')
    }
    const hash = transcript?.ownerDocument.location?.hash
    if (hash?.startsWith('#turn-')) {
      followingTranscript.set(false)
      void nextTick(revealLinkedTurn)
    }
    paintTranscript(updateTranscriptMarkdown)

    let cursor = Number(sinceSeq) || 0
    followUpActions.set(createFollowUpActions({
      sessionId, online: sessionOnline, inputBlocked: () => Boolean(inputRequest()),
      editor: () => promptRef.current, setText: text => composerText.set(text),
      rememberDraft: rememberPrompt, restoreDraft: restorePrompt, hasDraft: () => Boolean(composerDraft()?.text || composerFiles().length),
      editing: editingFollowUp, local: localFollowUps, sending: outboxSending, pending: queueActionPending,
      send: sendCommand, alert: stxAlert,
      transcript: () => transcriptRef.current, steeringMessage: () => steeringMessage.current,
    }))

    const terminal = createTerminalDock({
      workspaceId: Number(activeWorkspaceId), sessionId,
      surface: () => termSurface.current, visible: termOpen, online: sessionOnline,
      send: frame => sendFrame(frame),
      started(key) {
        const dock = terminalTabs()
        if (dock.tabs.some(tab => tab.key === key && !tab.started))
          saveTerminalTabs(dock.tabs.map(tab => tab.key === key ? { ...tab, started: true } : tab), dock.activeKey)
      },
      closed: finishTerminalClose,
      openPreview: url => previewProjectScript(url, true),
      updateStatus(key, status) {
        terminalStates.update((previous) => {
          if (status) return { ...previous, [key]: status }
          const { [key]: removed, ...remaining } = previous
          return remaining
        })
      },
    })
    terminalController.set(terminal)

    function onMessage(frame) {
      if (receiveHostSettings(frame)) return
      if (threadSidebar?.receive(frame)) return
      if (frame && terminal.receive(frame)) return
      if (frame?.t !== 'event') return
      if (frame.event.sessionId === 0 && frame.event.payload.type === 'profile.claude-compaction.updated') {
        const { profileId, providerInstanceId, changes } = frame.event.payload
        if (profileId === providerProfileId) applyAccountCompaction(providerInstanceId, changes)
        return
      }
      if (frame.event.sessionId !== sessionId || frame.event.seq <= cursor) return
      cursor = frame.event.seq
      const payload = frame.event.payload
      const updatedQueue = applyFollowUpEvent(followUps(), payload)
      if (updatedQueue !== followUps()) {
        followUps.set(updatedQueue)
        const editing = editingFollowUp()
        if (editing && !updatedQueue.entries.some(entry => entry.id === editing.id)) followUpActions()?.endEdit(true)
        paintTranscript(updateTranscriptMarkdown)
      }
      if (payload.type === 'session.navigation-changed') {
        threadNavigation.update(previous => ({
          ...previous, ...payload.changes,
          ...('settledAt' in payload.changes && { settledAutomatically: payload.changes.settledAutomatically === true }),
        }))
        if (payload.changes.title) currentThreadTitle.set(payload.changes.title)
        if (typeof payload.changes.settledAt === 'number') void refreshProjectSettlement()
      }
      if (payload.type === 'session.pull-request-linked') rememberRepositoryPullRequest(payload.pullRequest)
      if (payload.type === 'session.worktree-reserved') worktreeSetup.set(Boolean(payload.intent?.layout))
      if (payload.type === 'session.git-branch-resolved') {
        if (payload.worktreeBranch) workspaceBranch.set(payload.worktreeBranch)
        if (diffOpen()) refreshWorkspaceDiff()
      }
      if (payload.type === 'session.isolated') {
        if (sessionPullRequest && !turns.length && !liveTurns().length && uiState() === 'failed') {
          setSessionState('idle')
          sessionError.set('')
        }
        worktreeSetup.set(false)
        workspaceBranch.set(payload.branch)
        isolatedRewind.set(payload.combined && !payload.combined.checkouts.some(checkout => !checkout.key) ? 'repositories' : 'files')
      }
      if (payload.type === 'session.isolated' || payload.type === 'session.worktree-restored') {
        if (diffOpen()) refreshWorkspaceDiff()
        projectSetupPreview = sessionOnline()
        void refreshProjectSetup()
      }
      if (payload.type === 'turn.started' && projectSetup()?.status === 'pending') {
        projectSetupPreview = sessionOnline()
        void refreshProjectSetup()
      }
      if (payload.type === 'session.fork-finished' || payload.type === 'session.fork-portable') forkStatus.set('ready')
      if (payload.type === 'session.fork-failed') {
        forkError.set(payload.message)
        forkStatus.set('failed')
      }
      if (payload.type === 'session.provider-bound') {
        contextUsage.set(null)
        idleCompactionCandidate.set(null)
      }
      if (payload.type === 'session.provider-switched') {
        contextUsage.set(null)
        idleCompactionCandidate.set(null)
        const previous = activeDriverValue()
        const target = payload.providerInstanceId === undefined ? payload.driverKind : `${payload.driverKind}:${payload.providerInstanceId}`
        const followsActive = draftProvider() === previous && !pendingProviderSwitch()
        activeDriverValue.set(target)
        activeModel.set(payload.model || '')
        if (followsActive || draftProvider() === target) {
          draftProvider.set(target)
          showDraftCodexSelection({ model: payload.model || '', ...payload.codexTurnOptions })
        }
        appliedCodexSelection.set(payload.driverKind === 'codex' && payload.model
          ? { model: payload.model, ...payload.codexTurnOptions } : null)
      }
      if (payload.type === 'turn.started') {
        sessionError.set('')
        if (payload.freshContext) {
          contextUsage.set(null)
          idleCompactionCandidate.set(null)
        }
        if (payload.codexSelection) {
          const previous = appliedCodexSelection()
          if (previous?.model !== payload.codexSelection.model || previous?.serviceTier !== payload.codexSelection.serviceTier)
            contextUsage.set(null)
          const useApplied = matchesActiveCodexSelection(draftCodexSelection())
          appliedCodexSelection.set(payload.codexSelection)
          if (useApplied) showDraftCodexSelection(payload.codexSelection)
        }
        // Only the user's half opens a new exchange; the assistant's turn is
        // the reply within it.
        if (payload.role === 'user') {
          responseByTurn.set(payload.turnId, '')
          if (!initialHasTurns && !liveTurns().length) currentThreadTitle.set(threadDisplayTitle(threadNavigation().title, payload.text))
          if (payload.switchedProvider || payload.freshContext) rewindableTurns.set([])
          if (threadNavigation().settledAt || threadNavigation().snoozedUntil)
            threadNavigation.update(previous => ({ ...previous, settledAt: null, snoozedUntil: null, settledAutomatically: false }))
          steerableTurn.set(0)
          runningTurnId.set(payload.turnId)
          liveTurns.update(turns => [...turns, {
            id: payload.turnId,
            prompt: payload.text ?? '',
            attachments: payload.attachments ?? [],
            automaticCompaction: payload.automaticCompaction === true,
            freshContext: payload.freshContext === true,
            providerSwitch: payload.switchedProvider ? 'Continued with ' + DRIVER_LABELS[payload.switchedProvider] : '',
            modelChange: payload.modelChanged && payload.codexSelection ? codexSelectionLabel(payload.codexSelection) : '',
            tools: [],
            inputRequests: [],
            hasResponse: false,
          }])
          transcriptAnnouncement.set('')
          setSessionState('running')
          paintTranscript(updateTranscriptMarkdown)
        }
      }
      else if (payload.type === 'turn.steering-ready') {
        steerableTurn.set(payload.turnId)
      }
      else if (payload.type === 'turn.steer.resolved') {
        if (payload.outcome === 'delivered') {
          void nextTick(() => followUpActions()?.showDelivery(payload.turnId, payload.text))
          transcriptAnnouncement.set('Follow-up sent to the active turn.')
          paintTranscript(updateTranscriptMarkdown)
        }
        else {
          transcriptAnnouncement.set(payload.outcome === 'uncertain'
            ? 'Delivery could not be confirmed. The message is held for review.'
            : 'The agent did not accept the follow-up. The message is held in the queue.')
        }
      }
      else if (payload.type === 'tool.call.began') {
        // Deduplicated by id: a replayed frame must not grow a second row.
        const call = { callId: payload.callId, name: payload.toolName }
        if (payload.turnId !== initialResponseTurn) {
          updateClientTurn(payload.turnId, turn => turn.tools.some(t => t.callId === call.callId)
            ? turn
            : { ...turn, tools: [...turn.tools, call] })
        }
        else {
          ssrTools.update(tools => tools.some(t => t.callId === call.callId)
            ? tools
            : [...tools, call])
        }
        paintTranscript(updateTranscriptMarkdown)
      }
      else if (payload.type === 'tool.call.ended') {
        // Recorded by id: tools run in parallel and finish out of order, and
        // every row's `:data-tool-state` binding reads this map, so resolving
        // "the last row" could never mark the wrong one failed.
        toolResults.update(results => ({
          ...results,
          [payload.callId]: payload.ok ? 'ok' : 'failed',
        }))
      }
      else if (payload.type === 'assistant.delta') {
        const previous = responseByTurn.get(payload.turnId)
        if (previous === undefined || !payload.text) return
        responseByTurn.set(payload.turnId, previous + payload.text)
        changedResponses.add(payload.turnId)
        if (!previous) {
          if (payload.turnId === initialResponseTurn) ssrHasResponse.set(true)
          else updateClientTurn(payload.turnId, turn => ({ ...turn, hasResponse: true }))
        }
        paintTranscript(updateTranscriptMarkdown)
      }
      else if (payload.type === 'checkpoint.captured' && payload.kind === 'turn-start') {
        rewindCheckpoints.update(points => ({ ...points, [payload.turnId]: { id: payload.checkpointId, resetsStaging: Boolean(payload.repositories) } }))
      }
      else if (payload.type === 'checkpoint.reverted') {
        revertingId.set(payload.checkpointId)
        rewindNotice.set('')
      }
      else if (payload.type === 'checkpoint.restored' || payload.type === 'checkpoint.restore-failed') {
        revertingId.set(0)
        rewindNotice.set(payload.type === 'checkpoint.restore-failed' ? payload.message : payload.skipped?.length
          ? `Rewind finished. No earlier checkpoint for ${payload.skipped.join(', ')}.` : 'Rewind finished.')
        if (diffOpen()) refreshWorkspaceDiff()
      }
      else if (payload.type === 'turn.rewind-requested') {
        conversationRewind.set({ status: 'running', turnId: payload.turnId })
        conversationRewindNotice.set('')
      }
      else if (payload.type === 'turn.rewind-provider-confirmed') {
        conversationRewind.set({ ...conversationRewind(), status: 'restoring-files' })
      }
      else if (payload.type === 'turn.rewind-settled') {
        if (payload.outcome === 'rewound') refresh()
        else {
          conversationRewind.set(payload.outcome === 'uncertain' ? { ...conversationRewind(), status: 'uncertain' } : null)
          conversationRewindNotice.set(payload.message || '')
        }
      }
      else if (payload.type === 'turn.completed' || payload.type === 'turn.interrupted') {
        const usage = payload.type === 'turn.completed' ? payload.contextUsage : undefined
        contextUsage.set(usage ?? null)
        const availableAt = activeDriverValue().split(':')[0] === 'claude'
          ? claudeCompactionReturnAt(usage, frame.event.at)
          : undefined
        idleCompactionCandidate.set(availableAt === undefined ? null : {
          availableAt, afterTurnId: payload.turnId, usedTokens: usage.usedTokens,
        })
        if (payload.type === 'turn.completed' && payload.reviewRepositories?.length)
          turnDiffs.update(diffs => ({ ...diffs, [payload.turnId]: payload.reviewRepositories }))
        if (payload.type === 'turn.completed' && payload.responseForkable) {
          forkableTurns.update(turns => [...turns, payload.turnId])
          if (payload.providerTurnId && ['codex', 'claude'].includes(activeDriverValue().split(':')[0]))
            rewindableTurns.update(turns => [...turns, payload.turnId])
        }
        else rewindableTurns.set([])
        if (payload.type === 'turn.completed' && payload.contextCompacted) {
          if (payload.turnId === initialResponseTurn) ssrCompactedTurn.set(payload.turnId)
          else updateClientTurn(payload.turnId, turn => ({ ...turn, contextCompacted: true }))
        }
        batch(() => {
          setSessionState('idle')
          closeConnectorOptions()
          pendingApprovals.set([])
          pendingApprovalId.set(0)
          questionForm()?.interrupt()
        })
        if (payload.type === 'turn.interrupted') {
          if (payload.turnId === initialResponseTurn) ssrInterrupted.set(true)
          else updateClientTurn(payload.turnId, turn => ({ ...turn, interrupted: true }))
        }
        transcriptAnnouncement.set(payload.type === 'turn.completed'
          ? (payload.contextCompacted ? 'Context compacted.' : 'Agent finished responding.')
          : 'Response interrupted.')
        if (diffOpen()) refreshWorkspaceDiff()
      }
      else if (payload.type === 'session.failed') {
        contextUsage.set(null)
        idleCompactionCandidate.set(null)
        // A failed turn is over too. Leaving Stop up would offer to interrupt
        // something that already stopped; 'failed' is not busy, so the
        // bindings put Send back while the chip says what happened.
        batch(() => {
          setSessionState('failed')
          sessionError.set(payload.message || 'The agent could not finish this response.')
          closeConnectorOptions()
          pendingApprovals.set([])
          pendingApprovalId.set(0)
          questionForm()?.interrupt()
        })
        transcriptAnnouncement.set('')
      }
      else if (payload.type === 'approval.requested') {
        batch(() => {
          setSessionState('awaiting-approval')
          pendingApprovals.update(requests => requests.some(request => request.approvalId === payload.approvalId)
            ? requests
            : [...requests, { approvalId: payload.approvalId, toolName: payload.toolName, connector: payload.connector }])
          transcriptAnnouncement.set('An approval needs your attention.')
        })
        paintTranscript(updateTranscriptMarkdown)
      }
      else if (payload.type === 'approval.resolved') {
        if (!pendingApprovals().some(request => request.approvalId === payload.approvalId)) return
        if (approvalId() === payload.approvalId) closeConnectorOptions()
        batch(() => {
          pendingApprovals.update(requests => requests.filter(request => request.approvalId !== payload.approvalId))
          if (pendingApprovalId() === payload.approvalId) pendingApprovalId.set(0)
          setSessionState(waitingSessionState())
        })
      }
      else if (payload.type === 'input.requested' || payload.type === 'input.resolved') {
        batch(() => {
          questionForm()?.update(payload)
          setSessionState(waitingSessionState())
          transcriptAnnouncement.set(payload.type === 'input.requested' ? 'The agent has a question.' : questionActivityLabel(payload.outcome))
        })
        paintTranscript(updateTranscriptMarkdown)
      }
    }

    const connection = createSessionSocket({
      url: serverUrl, sessionId, cursor: () => cursor, onFrame: onMessage,
      onSocket: socket => { liveSocket = socket },
      onOnline(online) {
        sessionOnline.set(online)
        sessionConnecting.set(false)
        if (online) {
          watchSidebarOrder()
          connection.send({ t: 'read-settings', ...(projectSettingsId ? { workspaceId: projectSettingsId } : {}) })
          void followUpActions()?.flush()
          void refreshProjectSetup()
          void refreshProjectSettlement()
          if (termOpen()) requestAnimationFrame(showTerminalProcess)
        }
        else {
          cancelArrangementDrag()
          arrangementLayout.set(null)
          terminal.onOffline()
        }
      },
    })
    watchOrder(connection)
    sendFrame = connection.send
    reconnectLiveSession = connection.open
    disconnectLiveSession = () => {
      threadSidebar?.dispose()
      followUpActions()?.dispose()
      terminal.dispose()
      connection.dispose()
    }
    connection.open()
  }

  onUnmounted(() => sidebarDrafts?.dispose())
  onUnmounted(stopWorkspaceStatusRequests)
  useEventListener('pagehide', stopWorkspaceStatusRequests, { target: window })
  useEventListener('pageshow', (event) => {
    if (!event.persisted || !workspaceStatusPaused) return
    workspaceStatusPaused = false
    if (diffOpen()) refreshWorkspaceDiff()
    void annotateDriverPickers()
    void refreshProjectSetup()
    void refreshProjectSettlement()
  }, { target: window })
  if (codecUrl) void connectComposerDrafts().catch(() => {})
  if ((sessionId || activeProfile || initialSettingsSection) && serverUrl && codecUrl)
    void connectLiveSession().catch(() => sessionConnecting.set(false))
</script>
