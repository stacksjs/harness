<script server>
/**
 * The harness surface.
 *
 * SSR-first with islands, not an SPA. A session transcript is mostly-static,
 * append-heavy text — the worst case for a component tree that re-reconciles
 * and the best case for server rendering. The shell, the profile list and every
 * settled turn come down as HTML; only the live tail and the composer hydrate.
 *
 * Profiles are the Arc "spaces": one profile per project, each with its own
 * colour, swiped between. `<Sidebar :spaces>` is the whole integration — the
 * mapping below is the only harness-specific part.
 */
export const profiles = $props.profiles || []
export const sessions = $props.sessions || []
export const activeProfile = $props.activeProfile || (profiles[0] && profiles[0].id) || ''
export const activeSession = $props.activeSession || null
export const serverUrl = $props.serverUrl || ''
// The browser CBOR bundle. Empty when the server could not build one, which
// costs the page its live updates but not its rendered transcript.
export const codecUrl = $props.codecUrl || ''
// The sequence this render already contains. The socket resumes from here so a
// load replays only what is missing.
export const sinceSeq = $props.sinceSeq || 0
// A decision this session is blocked on, if any. Rendered rather than waited
// for: the client that raised it may be long gone.
export const pendingApproval = activeSession ? (activeSession.pendingApproval || null) : null

// One space per profile. `pinned` is the favourite-repos tile grid; the
// sections are the profile's sessions, split by whether they are live.
//
// Only the active space and its immediate neighbours render their rows. Every
// space used to, which cost ~9.5ms of server render each — 175ms at fourteen
// projects, on every page load, to display one. Neighbours are kept because
// they are what a single swipe can reveal, so the common gesture never lands
// on an empty panel; anything further away fills in on arrival.
const activeSpaceIndex = Math.max(0, profiles.findIndex(profile => String(profile.id) === String(activeProfile)))

// id -> tint, for the native titlebar. The web sidebar gets the tint through
// `<Sidebar :spaces>`; the window chrome around it is ours to paint.
export const spaceTints = JSON.stringify(Object.fromEntries(
  profiles.map(profile => [String(profile.id), profile.tint || '']),
))

export const spaces = profiles.map((profile, index) => ({
  id: String(profile.id),
  deferred: Math.abs(index - activeSpaceIndex) > 1,
  label: profile.name,
  icon: profile.icon || 'i-hugeicons-folder-01',
  tint: profile.tint || 'blue',
  pinned: (profile.workspaces || []).map(workspace => ({
    id: String(workspace.id),
    label: workspace.name,
    icon: 'i-hugeicons-folder-01',
  })),
  // Only groups that have something in them. An empty "Active" heading with
  // nothing under it is noise, and with most profiles idle it was showing on
  // almost every space.
  sections: [
    {
      id: `active-${profile.id}`,
      label: 'Active',
      items: (profile.sessions || []).filter(s => s.state === 'running').map(toItem),
    },
    {
      id: `recent-${profile.id}`,
      label: 'Recent',
      items: (profile.sessions || []).filter(s => s.state !== 'running').map(toItem),
    },
  ].filter(section => section.items.length > 0),
  clear: { id: 'clear', label: 'Clear' },
  action: { id: 'new-session', label: 'New Session', icon: 'i-hugeicons-add-01' },
}))

function toItem(session) {
  return {
    id: String(session.id),
    label: session.title || `Session ${session.id}`,
    icon: 'i-hugeicons-message-01',
    href: `/s/${session.id}`,
  }
}

export const hasProfiles = profiles.length > 0
export const turns = activeSession ? activeSession.turns : []
export const sessionTitle = activeSession ? (activeSession.title || `Session ${activeSession.id}`) : 'No session'
export const sessionState = activeSession ? activeSession.state : 'idle'
// Empty unless this session runs in a worktree of its own.
export const sessionBranch = activeSession ? (activeSession.branch || '') : ''
export const activeSessionId = activeSession ? activeSession.id : 0
export const activeWorkspaceId = activeSession ? (activeSession.workspaceId || 0) : 0
// The last turn is the only one that can still change, so it is the only one
// that needs hydrating — everything above it is settled history.
export const settledTurns = turns.slice(0, Math.max(0, turns.length - 1))
export const liveTurn = turns.length > 0 ? turns[turns.length - 1] : null
</script>

<div class="flex h-screen w-screen overflow-hidden bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
  {{--
    `data-harness-sidebar`, not `data-stx-sidebar`: the latter is the Sidebar
    component's own marker, and putting it on a wrapper made two elements claim
    it. `tintTarget()` resolves `closest('[data-stx-sidebar]')`, so the space
    palette was being written to this wrapper instead of the pane — it reached
    the pane by inheritance and worked by luck.
  --}}
  <aside class="w-[280px] shrink-0 border-r border-black/5 dark:border-white/5" data-harness-sidebar>
    @if(hasProfiles)
      <Sidebar
        :spaces="spaces"
        :space="activeProfile"
        spacePersistKey="harness.profile"
        :showSpaceAdd="true"
      />
    @else
      <div class="flex h-full flex-col items-center justify-center gap-2 px-6 text-center">
        <p class="text-[13px] opacity-60">No profiles yet.</p>
        <p class="text-[12px] opacity-40">Create one with <code>./buddy profiles:create</code></p>
      </div>
    @endif
  </aside>

  <main class="flex min-w-0 flex-1 flex-col">
    <header class="flex h-[44px] shrink-0 items-center gap-3 border-b border-black/5 px-4 dark:border-white/5">
      <span class="truncate text-[13px] font-medium">{{ sessionTitle }}</span>
      <span
        data-session-state
        class="rounded-full px-2 py-[2px] text-[11px] leading-[14px] opacity-70"
      >{{ sessionState }}</span>
      {{--
        An isolated session edits its own checkout, not the workspace. Saying
        which branch makes that visible, and names the thing you merge.
      --}}
      @if(sessionBranch)
        <span
          class="truncate rounded-[5px] border border-black/10 px-[6px] py-[1px] font-mono text-[11px] leading-[15px] opacity-70 dark:border-white/15"
          title="This session runs in its own worktree on {{ sessionBranch }}"
        >{{ sessionBranch }}</span>
      @endif
      {{--
        Changes sit behind a toggle rather than always-on. Reading a repository
        costs a subprocess, and most page loads never look at the diff.
      --}}
      <button
        type="button"
        data-diff-toggle
        class="ml-auto rounded-[6px] border border-black/10 px-2 py-[3px] text-[12px] dark:border-white/15"
        aria-expanded="false"
      >Changes</button>
    </header>

    <section data-diff hidden class="max-h-[45%] shrink-0 overflow-y-auto border-b border-black/5 px-4 py-3 dark:border-white/5">
      <div data-diff-status class="text-[12px] opacity-60">Loading…</div>
      <ul data-diff-files class="mb-2 list-none"></ul>
      <pre data-diff-patch class="overflow-x-auto text-[12px] leading-[17px]"></pre>
    </section>

    {{--
      The transcript. Settled turns are plain server-rendered HTML and hydrate
      on `visible`, so scrolling back through a long session costs nothing until
      you actually scroll. The live tail hydrates eagerly — it is the only part
      the socket writes to.
    --}}
    <div data-transcript class="min-h-0 flex-1 overflow-y-auto px-4 py-3">
      @foreach(settledTurns as turn)
        <article stx-hydrate="visible" class="mb-5" data-turn="{{ turn.id }}">
          <div class="mb-1 text-[12px] font-medium opacity-50">You</div>
          <div class="mb-3 whitespace-pre-wrap text-[13px] leading-[20px]">{{ turn.prompt }}</div>
          {{--
            What the agent ran, before what it said. These were in the log from
            the start and rendered nowhere, so the transcript showed a reply
            with no evidence behind it.
          --}}
          <div data-tools>
          @foreach(turn.toolCalls as call)
            <div class="mb-1 flex items-center gap-[6px] text-[12px]" data-tool-call="{{ call.callId }}" data-tool-state="{{ call.state }}">
              <span class="tool-dot" aria-hidden="true"></span>
              <span class="font-mono opacity-70">{{ call.name }}</span>
            </div>
          @endforeach
          </div>
          <div class="mb-1 text-[12px] font-medium opacity-50">Agent</div>
          <div class="whitespace-pre-wrap text-[13px] leading-[20px]" data-response>{{ turn.response }}</div>
          {{--
            Undo this turn. Only offered where a snapshot exists: a workspace
            that is not a repository has nothing to revert to, and a disabled
            button that never explains itself is worse than no button.
          --}}
          @if(turn.checkpointId)
            <button
              type="button"
              data-revert="{{ turn.checkpointId }}"
              class="mt-2 rounded-[6px] border border-black/10 px-2 py-[2px] text-[11px] opacity-60 hover:opacity-100 dark:border-white/15"
            >Revert this turn</button>
          @endif
        </article>
      @endforeach

      @if(liveTurn)
        <article class="mb-5" data-turn="{{ liveTurn.id }}" data-live>
          <div class="mb-1 text-[12px] font-medium opacity-50">You</div>
          <div class="mb-3 whitespace-pre-wrap text-[13px] leading-[20px]">{{ liveTurn.prompt }}</div>
          <div data-tools>
          @foreach(liveTurn.toolCalls as call)
            <div class="mb-1 flex items-center gap-[6px] text-[12px]" data-tool-call="{{ call.callId }}" data-tool-state="{{ call.state }}">
              <span class="tool-dot" aria-hidden="true"></span>
              <span class="font-mono opacity-70">{{ call.name }}</span>
            </div>
          @endforeach
          </div>
          <div class="mb-1 text-[12px] font-medium opacity-50">Agent</div>
          <div class="whitespace-pre-wrap text-[13px] leading-[20px]" data-response data-live-response>{{ liveTurn.response }}</div>
          {{--
            The newest turn is the one people most want to undo, and it was the
            only one without the button because it is not in `settledTurns`.
            Hidden while it is still running — the reducer refuses a revert
            mid-turn anyway, since restoring files under a working agent leaves
            it editing a tree that changed for reasons it cannot see.
          --}}
          @if(liveTurn.checkpointId)
            <button
              type="button"
              data-revert="{{ liveTurn.checkpointId }}"
              class="mt-2 rounded-[6px] border border-black/10 px-2 py-[2px] text-[11px] opacity-60 hover:opacity-100 dark:border-white/15"
            >Revert this turn</button>
          @endif
        </article>
      @endif

      <div
        data-approval
        @if(!pendingApproval)hidden@endif
        @if(pendingApproval)data-approval-id="{{ pendingApproval.approvalId }}"@endif
        class="mb-5 rounded-[10px] border border-amber-500/30 bg-amber-500/10 p-3"
      >
        <div class="mb-2 text-[12px] font-medium">
          <span data-approval-tool>{{ pendingApproval ? pendingApproval.toolName : '' }}</span> wants to run.
        </div>
        <div class="flex gap-2">
          <button type="button" data-approve class="rounded-[6px] bg-neutral-900 px-3 py-1 text-[12px] text-white dark:bg-white dark:text-neutral-900">Allow</button>
          <button type="button" data-deny class="rounded-[6px] border border-black/10 px-3 py-1 text-[12px] dark:border-white/15">Deny</button>
        </div>
      </div>
    </div>

    <form data-composer class="flex shrink-0 items-end gap-2 border-t border-black/5 p-3 dark:border-white/5">
      <textarea
        data-prompt
        rows="2"
        placeholder="Ask the agent…"
        class="min-h-[40px] flex-1 resize-none rounded-[8px] border border-black/10 bg-white px-3 py-2 text-[13px] outline-none dark:border-white/10 dark:bg-neutral-900"
      ></textarea>
      <button type="submit" data-send class="h-[36px] rounded-[8px] bg-neutral-900 px-4 text-[13px] text-white dark:bg-white dark:text-neutral-900">Send</button>
      {{--
        Stop is the one control a running agent must always offer. It replaces
        Send rather than sitting beside it: while a turn runs there is nothing
        to send, and two enabled buttons invite sending into a busy session.
      --}}
      <button type="button" data-stop hidden class="h-[36px] rounded-[8px] border border-black/15 px-4 text-[13px] dark:border-white/20">Stop</button>
    </form>
  </main>
</div>

<style>
  /* Three states, three colours: running, succeeded, failed. A tool that is
     still going must not look like one that finished, or a hung command reads
     as a completed one. */
  .tool-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0.35;
  }
  [data-tool-state="running"] .tool-dot {
    background: rgb(245 158 11);
    opacity: 1;
    animation: tool-pulse 1.1s ease-in-out infinite;
  }
  [data-tool-state="ok"] .tool-dot {
    background: rgb(34 197 94);
    opacity: 0.9;
  }
  [data-tool-state="failed"] .tool-dot {
    background: rgb(239 68 68);
    opacity: 1;
  }
  /* A failed tool is the one row worth reading twice. */
  [data-tool-state="failed"] .font-mono { opacity: 1; }

  @keyframes tool-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  /* Respect the setting rather than animating regardless — this dot sits in a
     transcript people watch for minutes at a time. */
  @media (prefers-reduced-motion: reduce) {
    [data-tool-state="running"] .tool-dot { animation: none; }
  }
</style>

<script type="module" data-harness-island data-session="{{ activeSessionId }}" data-workspace="{{ activeWorkspaceId }}" data-url="{{ serverUrl }}" data-codec="{{ codecUrl }}" data-since-seq="{{ sinceSeq }}" data-space-tints="{{ spaceTints }}">
  // The live island. Everything above this is static HTML; this wires the
  // socket to the one turn that can still change.
  //
  // Deliberately small and framework-free: it appends text to a node and
  // toggles a panel. Anything heavier belongs on the server.
  // Count native-switcher creations before stx's sidebar controller runs.
  //
  // `<SidebarSpaces>` calls `createSpacesSidebar` itself on mount, so the only
  // way to know the native rail actually bound — rather than merely being
  // *reachable* — is to watch the call. Patched here because this script runs
  // before the component's own onMount.
  try {
    const nativeUI = window.craft?.nativeUI
    if (nativeUI && typeof nativeUI.createSpacesSidebar === 'function') {
      const original = nativeUI.createSpacesSidebar.bind(nativeUI)
      window.__harnessSpacesCalls = 0
      nativeUI.createSpacesSidebar = (options) => {
        window.__harnessSpacesCalls++
        window.__harnessSpacesArg = options
        return original(options)
      }
    }
  }
  catch {}

  // Report what native surfaces this window actually has. In a browser every
  // flag is false and nothing else changes; in a Craft window it tells us
  // whether the host's injection and gesture bridge are really there.
  try {
    const craft = window.craft
    fetch('/native-probe', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        seen: true,
        craft: Boolean(craft),
        gestures: typeof craft?.gestures?.onSwipe === 'function',
        nativeUI: Boolean(craft?.nativeUI),
        spacesSidebar: typeof craft?.nativeUI?.createSpacesSidebar === 'function',
        nativeSidebarFlag: Boolean(window.__craftNativeSidebar),
        userAgent: navigator.userAgent.slice(0, 60),
      }),
    }).catch(() => {})
  }
  catch {}

  // Second pass, once the sidebar controller has mounted: did it bind?
  setTimeout(() => {
    fetch('/native-probe', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        seen: true,
        phase: 'mounted',
        craft: Boolean(window.craft),
        gestures: typeof window.craft?.gestures?.onSwipe === 'function',
        spacesSidebar: typeof window.craft?.nativeUI?.createSpacesSidebar === 'function',
        spacesBound: window.__harnessSpacesCalls ?? 0,
        spacesCount: window.__harnessSpacesArg?.spaces?.length ?? 0,
        activeSpace: window.__harnessSpacesArg?.activeSpace ?? null,
      }),
    }).catch(() => {})
  }, 2500)

  // Not `document.currentScript`: it is always null inside a module, per spec,
  // so reading `.dataset` off it threw and the socket was never opened. The
  // whole live half of this page was dead in a browser — invisible because the
  // server-rendered transcript still looked correct.
  // A global shortcut, so harness is reachable without finding its window.
  //
  // Registered from the page rather than from the Zig host because the handler
  // is page logic — focus, then put the cursor in the composer. In a browser
  // `window.craft` is absent and this is skipped; a browser cannot claim a
  // system-wide key anyway.
  try {
    const shortcuts = window.craft?.shortcuts
    if (shortcuts) {
      // Registration and the handler are separate: the host owns the hotkey and
      // delivers a `craft:shortcut` event carrying the id it was registered
      // under, so the page does not hold a callback the OS knows nothing about.
      shortcuts.register('harness.summon', 'Cmd+Shift+H')
      shortcuts.on?.((event) => {
        if ((event?.id ?? event) !== 'harness.summon') return
        window.craft?.window?.focus?.()
        // Someone who summoned the window deliberately should land ready to
        // type, not hunting for the input.
        document.querySelector('[data-composer] [data-prompt]')?.focus()
      })
    }
  }
  catch { /* a host without the shortcuts bridge is not an error */ }

  // Paint the native window in the active profile's colour.
  //
  // This is the half of the Arc idea AppKit owns: the web sidebar takes its
  // tint through `<Sidebar :spaces>`, but the titlebar and the window behind it
  // do not, so a tinted sidebar used to sit inside grey chrome. In a browser
  // `window.craft` is absent and this is simply skipped.
  //
  // It could not have worked before craft v0.0.62 regardless —
  // `setBackgroundColor` was one of the twenty window actions whose payload the
  // bridge discarded.
  const spaceTints = (() => {
    try { return JSON.parse(document.querySelector('[data-harness-island]')?.dataset.spaceTints || '{}') }
    catch { return {} }
  })()

  function paintWindow(spaceId) {
    const tint = spaceTints[spaceId]
    // No tint means the profile never chose one; leaving the window alone is
    // better than inventing a colour it did not ask for.
    if (!tint) return
    try { window.craft?.window?.setBackgroundColor?.(tint) }
    catch { /* a host without the window bridge is not an error */ }
  }

  paintWindow(document.querySelector('[data-space][data-space-active="true"]')?.dataset.spaceId)

  // The sidebar's own controls. `<Sidebar>` renders "New Session" and the
  // space "+" and emits when they are pressed; nothing was listening, so both
  // were buttons that did nothing.
  //
  // These dispatch over the socket like every other command, then reload —
  // the sidebar is server-rendered, and re-rendering it here would be a second
  // implementation of what the server already does.
  // Resolved when the server reports a restore finished. A list because the
  // socket handler is registered separately from the button that is waiting.
  const revertWaiters = []

  // Reverting throws away work on disk, so it asks first. The confirmation
  // names what will happen rather than saying "are you sure": the destructive
  // part is the files created since, which is exactly what people forget.
  document.addEventListener('click', async (event) => {
    const button = event.target.closest?.('[data-revert]')
    if (!button) return

    const checkpointId = Number(button.dataset.revert)
    if (!checkpointId) return
    if (!window.confirm('Put the workspace back to before this turn? Files the agent created since will be deleted.')) return

    button.disabled = true
    button.textContent = 'Reverting…'

    // Waits for `checkpoint.restored`, not for the dispatch ack.
    // `checkpoint.reverted` only means the revert was accepted; the git work
    // runs after it, so reloading on the ack showed a half-restored tree —
    // files rewritten, files the agent added not yet removed.
    const restored = new Promise((resolve) => {
      revertWaiters.push(resolve)
      // A revert that never reports back should still let go of the page.
      setTimeout(resolve, 15000)
    })

    await sendCommand({ type: 'session.checkpoint.revert', sessionId, checkpointId })
    await restored

    // Reloaded rather than patched: the diff, the turn list and the workspace
    // have all moved, and re-deriving that here would be a second renderer.
    window.location.reload()
  })

  const island = document.querySelector('[data-harness-island]')
  // Set by the transcript's socket once it opens, so a sidebar command reuses
  // it rather than opening a second connection to the same server.
  let liveSocket = null

  /**
   * Dispatch a command that is not about the open session.
   *
   * Reuses the transcript's socket when there is one. On the index page there
   * is no session and therefore no socket, so this opens a short-lived one —
   * the alternative is keeping a connection open on a page that never streams.
   *
   * Resolves on the server's ack so a caller can reload without outrunning the
   * write.
   */
  async function sendCommand(command) {
    const { encode } = await import(island.dataset.codec)
    const envelope = {
      id: `web_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`,
      at: Date.now(),
      command,
    }

    if (liveSocket && liveSocket.readyState === WebSocket.OPEN) {
      liveSocket.send(encode({ t: 'dispatch', envelope }))
      // The island's own handler will see the ack; a short settle is enough,
      // and the command is idempotent by id if the reload races it.
      return new Promise(resolve => setTimeout(() => resolve(true), 150))
    }

    return new Promise((resolve) => {
      const socket = new WebSocket(island.dataset.url)
      socket.binaryType = 'arraybuffer'
      socket.addEventListener('open', () => socket.send(encode({ t: 'dispatch', envelope })))
      socket.addEventListener('message', () => { socket.close(); resolve(true) })
      // A dispatch that never acks must not leave the page waiting forever.
      setTimeout(() => { try { socket.close() } catch {} ; resolve(false) }, 4000)
    })
  }

  document.addEventListener('spaceAction', async (event) => {
    const { spaceId, role } = event.detail || {}
    if (role !== 'action' || !spaceId) return

    // A session needs somewhere to run. The profile's first workspace is the
    // obvious default; with none there is nothing to guess at, and saying so
    // beats creating a session that fails on its first turn.
    const panel = document.querySelector(`[data-space][data-space-id="${CSS.escape(spaceId)}"]`)
    const workspaceId = Number(panel?.querySelector('[data-space-pinned-item]')?.dataset.pinnedId)
    if (!workspaceId) {
      window.alert('This profile has no workspace yet. Add one with `./buddy harness:run --path <dir>`.')
      return
    }

    await sendCommand({ type: 'session.create', workspaceId, driverKind: 'claude' })
    window.location.assign(`/?profile=${encodeURIComponent(spaceId)}`)
  })

  document.addEventListener('spaceAdd', async () => {
    const name = window.prompt('Name this profile')
    if (!name || !name.trim()) return
    await sendCommand({ type: 'profile.create', name: name.trim() })
    window.location.reload()
  })

  // Spaces beyond the active one's neighbours render without their rows, so
  // arriving at one has to fetch it. Navigating rather than rebuilding rows in
  // JS keeps a single renderer: the server already knows how to draw a space,
  // and a second implementation here would be one more thing to keep in step.
  // `spaceChange`, unprefixed: stx's defineEmits dispatches the bare event name
  // on the component's scope element, and it bubbles to here.
  document.addEventListener('spaceChange', (event) => {
    const id = event.detail?.id
    if (!id) return
    // Repaint first: a swipe should feel like the window changed colour with
    // it, not after a round trip.
    paintWindow(id)
    const panel = document.querySelector(`[data-space][data-space-id="${CSS.escape(id)}"]`)
    // Only a deferred panel needs the round trip; a neighbour is already drawn.
    if (!panel || !panel.hasAttribute('data-space-deferred')) return
    window.location.assign(`/?profile=${encodeURIComponent(id)}`)
  })

  // The diff panel: what the agent changed on disk, which is what a transcript
  // cannot tell you. Fetched on open and on demand, never polled — a repository
  // read is a subprocess, and a transcript nobody is reviewing should not pay
  // for one every few seconds.
  const diffToggle = document.querySelector('[data-diff-toggle]')
  const diffPanel = document.querySelector('[data-diff]')
  if (diffToggle && diffPanel) {
    const status = diffPanel.querySelector('[data-diff-status]')
    const fileList = diffPanel.querySelector('[data-diff-files]')
    const patchNode = diffPanel.querySelector('[data-diff-patch]')

    async function loadDiff(sessionId) {
      status.textContent = 'Loading…'
      fileList.replaceChildren()
      patchNode.textContent = ''

      let diff
      try {
        diff = await (await fetch(`/s/${sessionId}/diff`)).json()
      }
      catch {
        status.textContent = 'Could not read the workspace.'
        return
      }

      if (diff.error) { status.textContent = diff.error; return }
      if (!diff.isRepository) { status.textContent = 'This workspace is not a git repository.'; return }
      if (diff.files.length === 0) { status.textContent = 'No uncommitted changes.'; return }

      // Which comparison this is, said plainly: a count is easy to over-trust,
      // and "what this session changed" and "what is uncommitted here" are
      // different claims.
      const count = `${diff.files.length} changed file${diff.files.length === 1 ? '' : 's'}`
      status.textContent = diff.scope === 'session'
        ? `${count} since this session started`
        : `${count} in the working tree`

      for (const file of diff.files) {
        const row = document.createElement('li')
        row.className = 'flex items-center gap-[8px] py-[1px] text-[12px]'
        row.dataset.diffFile = file.path

        const badge = document.createElement('span')
        badge.className = 'w-[64px] shrink-0 text-[11px] uppercase opacity-50'
        badge.textContent = file.status

        const name = document.createElement('span')
        name.className = 'truncate font-mono'
        // textContent: a path is data, and a repository can contain anything.
        name.textContent = file.path

        const counts = document.createElement('span')
        counts.className = 'ml-auto shrink-0 font-mono text-[11px]'
        // Untracked files have no counts; showing +0 -0 implies an empty file.
        counts.textContent = file.status === 'untracked' ? '' : `+${file.insertions} −${file.deletions}`

        row.append(badge, name, counts)
        fileList.append(row)
      }

      patchNode.textContent = diff.patch
    }

    diffToggle.addEventListener('click', () => {
      const opening = diffPanel.hidden
      diffPanel.hidden = !opening
      diffToggle.setAttribute('aria-expanded', String(opening))
      if (opening && sessionId) loadDiff(sessionId)
    })
  }

  const root = document.querySelector('[data-harness-island]')
  const sessionId = Number(root?.dataset.session)
  const url = root?.dataset.url
  const codecUrl = root?.dataset.codec

  // The page speaks CBOR to the socket, so it needs the same codec the server
  // uses. It arrives as a module rather than as assumed globals — the island
  // used to call `window.__harnessEncode`, which nothing ever defined, so the
  // socket connected and then threw on its first frame.
  if (sessionId && url && codecUrl) {
    const { encode, decode, Terminal, TERMINAL_CSS, toHtml } = await import(codecUrl)

    const socket = new WebSocket(url)
    socket.binaryType = 'arraybuffer'
    liveSocket = socket

    const transcript = document.querySelector('[data-transcript]')
    const responseNode = () => document.querySelector('[data-live-response]')
    const stateNode = document.querySelector('[data-session-state]')
    const approval = document.querySelector('[data-approval]')

    // Start a fresh turn in the transcript.
    //
    // Without this the island only ever knew the one `[data-live-response]`
    // node the server rendered, so a turn started after page load appended its
    // reply to the *previous* turn's answer — two exchanges run together in one
    // paragraph, with the new prompt never shown at all.
    function beginTurn(turnId, prompt) {
      // The previous turn is settled now: it can no longer receive deltas, and
      // `data-live` is what marks the one turn that still can.
      const previous = responseNode()
      if (previous) previous.removeAttribute('data-live-response')
      const previousArticle = transcript.querySelector('[data-turn][data-live]')
      if (previousArticle) previousArticle.removeAttribute('data-live')

      const article = document.createElement('article')
      article.className = 'mb-5'
      article.dataset.turn = String(turnId)
      article.dataset.live = ''

      const you = document.createElement('div')
      you.className = 'mb-1 text-[12px] font-medium opacity-50'
      you.textContent = 'You'

      const ask = document.createElement('div')
      ask.className = 'mb-3 whitespace-pre-wrap text-[13px] leading-[20px]'
      // textContent, never innerHTML: a prompt is user input and must never be
      // parsed as markup.
      ask.textContent = prompt ?? ''

      const tools = document.createElement('div')
      tools.dataset.tools = ''

      const who = document.createElement('div')
      who.className = 'mb-1 text-[12px] font-medium opacity-50'
      who.textContent = 'Agent'

      const answer = document.createElement('div')
      answer.className = 'whitespace-pre-wrap text-[13px] leading-[20px]'
      answer.dataset.response = ''
      answer.dataset.liveResponse = ''

      article.append(you, ask, tools, who, answer)
      // Before the approval panel, which is the last child and must stay there.
      transcript.insertBefore(article, approval)
      // Follow the tail, the way a terminal does.
      transcript.scrollTop = transcript.scrollHeight
    }

    // A command id the server can deduplicate on. Every dispatch carries one,
    // so a retry after a dropped ack replays the receipt rather than starting a
    // second agent run.
    let commandCounter = 0
    function dispatch(command) {
      socket.send(encode({
        t: 'dispatch',
        envelope: {
          id: `web_${sessionId}_${Date.now().toString(36)}_${++commandCounter}`,
          at: Date.now(),
          command,
        },
      }))
    }

    // The composer. Without this the page could watch a session but not drive
    // one, which is most of the point of a control surface.
    const composer = document.querySelector('[data-composer]')
    const prompt = composer?.querySelector('[data-prompt]')
    composer?.addEventListener('submit', (event) => {
      event.preventDefault()
      const text = prompt.value.trim()
      if (!text) return
      // Cleared optimistically: the turn appears when `turn.started` comes back
      // from the server, so the transcript still only ever shows what the log
      // actually contains.
      prompt.value = ''
      dispatch({ type: 'session.turn.start', sessionId, text })
    })

    // Enter sends, Shift+Enter makes a newline — the convention every chat
    // surface uses, and the textarea would otherwise only ever insert newlines.
    prompt?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
        event.preventDefault()
        composer.requestSubmit()
      }
    })

    const sendButton = composer?.querySelector('[data-send]')
    const stopButton = composer?.querySelector('[data-stop]')

    /**
     * Show Stop while a turn runs, Send otherwise.
     *
     * Driven from the session state rather than from the click, so a turn
     * started elsewhere — the CLI, the desktop window, another tab — puts this
     * page into the same state. There is one execution boundary; the UI should
     * reflect it rather than track its own idea of what is running.
     */
    /**
     * `state` is the session's own state string, not a boolean.
     *
     * A turn blocked on an approval is still in flight, and collapsing that to
     * "not running" was wrong twice over: it overwrote the server's
     * `awaiting-approval` with `idle`, so a session waiting on *you* looked
     * like a session doing nothing, and it offered Send instead of Stop on a
     * turn that had not finished.
     */
    const IN_FLIGHT = new Set(['running', 'awaiting-approval'])

    function setRunning(state) {
      const busy = IN_FLIGHT.has(state)
      if (stateNode) stateNode.textContent = state
      if (sendButton) sendButton.hidden = busy
      if (stopButton) stopButton.hidden = !busy
      // A revert mid-turn is refused by the reducer; hiding the button says so
      // before the click rather than after.
      for (const button of document.querySelectorAll('[data-revert]')) button.hidden = busy
    }
    // Seeded from what the server rendered, which is the whole session state
    // and not just whether a turn is running.
    setRunning(stateNode?.textContent.trim() || 'idle')

    stopButton?.addEventListener('click', () => {
      // Optimistic: the button goes away immediately, but the turn is not over
      // until the log says so. `turn.interrupted` is what actually settles it.
      stopButton.hidden = true
      dispatch({ type: 'session.turn.interrupt', sessionId })
    })

    function respondToApproval(allow) {
      const approvalId = Number(approval.dataset.approvalId)
      if (!approvalId) return
      // Hidden immediately: the decision is made, and leaving the panel up
      // invites a second click that answers an id the server has retired.
      approval.hidden = true
      approval.removeAttribute('data-approval-id')
      dispatch({
        type: 'session.approval.respond',
        sessionId,
        approvalId,
        decision: allow ? 'allowed' : 'denied',
        scope: 'once',
      })
    }

    approval?.querySelector('[data-approve]')?.addEventListener('click', () => respondToApproval(true))
    approval?.querySelector('[data-deny]')?.addEventListener('click', () => respondToApproval(false))

    socket.addEventListener('open', () => {
      // Resume from the last sequence the server rendered into this page, so a
      // reload replays the gap rather than the whole session.
      // From the sequence the server already rendered, not from zero.
      // `window.__harnessSinceSeq` was read here and never written anywhere, so
      // every load resubscribed from the beginning and the server replayed the
      // whole session on top of the transcript already on the page — the
      // response appeared twice.
      socket.send(encode({ t: 'subscribe', sessionId, sinceSeq: Number(root.dataset.sinceSeq) || 0 }))
    })

    // ── Terminal (M6): a shell in the session's workspace ────────────────
    // The server owns the PTY and streams bytes as term-data frames; the page
    // renders them through @harness/ansi's grid — the same renderer a settled
    // transcript would use — and sends keystrokes back whole. Local-only by
    // server policy, so a paired phone sees the button do nothing beyond the
    // refusal notice.
    const termWorkspaceId = Number(root.dataset.workspace) || 0
    let term = null
    let termId = null
    let termScreen = null
    let termPanel = null
    let termRenderQueued = false

    function renderTerm() {
      if (termRenderQueued || !term || !termScreen) return
      termRenderQueued = true
      requestAnimationFrame(() => {
        termRenderQueued = false
        termScreen.innerHTML = toHtml(term.snapshot())
        termScreen.parentElement.scrollTop = termScreen.parentElement.scrollHeight
      })
    }

    // Named keys → the bytes a terminal expects. Anything printable goes as-is.
    const TERM_KEYS = {
      'Enter': '\r',
      'Backspace': '\x7F',
      'Tab': '\t',
      'Escape': '\x1B',
      'ArrowUp': '\x1B[A',
      'ArrowDown': '\x1B[B',
      'ArrowRight': '\x1B[C',
      'ArrowLeft': '\x1B[D',
    }

    function termSend(data) {
      if (termId !== null) socket.send(encode({ t: 'term-input', termId, data }))
    }

    function toggleTerminal() {
      if (termPanel) {
        termPanel.hidden = !termPanel.hidden
        if (!termPanel.hidden) termScreen.parentElement.focus()
        return
      }

      const style = document.createElement('style')
      style.textContent = `${TERMINAL_CSS}\n[data-terminal]{--t-color-0:#1c1e26;--t-color-1:#e05561;--t-color-2:#8cc265;--t-color-3:#d18f52;--t-color-4:#4aa5f0;--t-color-5:#c162de;--t-color-6:#42b3c2;--t-color-7:#d7dae0;--t-color-8:#5f6672;--t-color-9:#ff616e;--t-color-10:#a5e075;--t-color-11:#f0a45d;--t-color-12:#4dc4ff;--t-color-13:#de73ff;--t-color-14:#4cd1e0;--t-color-15:#ffffff}`
      document.head.append(style)

      termPanel = document.createElement('section')
      termPanel.dataset.terminal = ''
      termPanel.setAttribute('aria-label', 'Terminal')
      termPanel.style.cssText = 'position:fixed;right:16px;bottom:64px;width:min(720px,calc(100vw - 32px));height:340px;z-index:60;border-radius:10px;overflow:hidden;background:#16181f;border:1px solid rgba(255,255,255,0.12);box-shadow:0 12px 40px rgba(0,0,0,0.45);display:flex;flex-direction:column'

      const host = document.createElement('div')
      host.tabIndex = 0
      host.style.cssText = 'flex:1;overflow-y:auto;padding:8px 10px;outline:none;font:12px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace;color:#d7dae0;white-space:pre'
      termScreen = document.createElement('div')
      host.append(termScreen)
      termPanel.append(host)
      document.body.append(termPanel)

      host.addEventListener('keydown', (event) => {
        if (event.metaKey) return
        let data = null
        if (event.ctrlKey && event.key.length === 1) {
          const code = event.key.toLowerCase().charCodeAt(0)
          if (code >= 97 && code <= 122) data = String.fromCharCode(code - 96)
        }
        else if (TERM_KEYS[event.key]) {
          data = TERM_KEYS[event.key]
        }
        else if (event.key.length === 1) {
          data = event.key
        }
        if (data === null) return
        event.preventDefault()
        termSend(data)
      })
      host.addEventListener('paste', (event) => {
        event.preventDefault()
        termSend(event.clipboardData.getData('text'))
      })

      socket.send(encode({ t: 'term-open', workspaceId: termWorkspaceId, cols: 100, rows: 24 }))
      host.focus()
    }

    if (termWorkspaceId) {
      const toggle = document.createElement('button')
      toggle.type = 'button'
      toggle.dataset.terminalToggle = ''
      toggle.textContent = '>_'
      toggle.setAttribute('aria-label', 'Toggle terminal')
      toggle.style.cssText = 'position:fixed;right:16px;bottom:16px;z-index:61;width:38px;height:34px;border-radius:8px;background:#16181f;color:#d7dae0;border:1px solid rgba(255,255,255,0.14);font:12px ui-monospace,monospace;cursor:pointer'
      toggle.addEventListener('click', toggleTerminal)
      document.body.append(toggle)
    }

    socket.addEventListener('message', (event) => {
      const frame = decode(new Uint8Array(event.data))
      if (frame?.t === 'term-opened') {
        termId = frame.termId
        term = new Terminal({ cols: frame.cols, rows: frame.rows })
        renderTerm()
        return
      }
      if (frame?.t === 'term-data') {
        if (frame.termId === termId && term) {
          term.write(frame.data)
          renderTerm()
        }
        return
      }
      if (frame?.t === 'term-exit') {
        if (frame.termId === termId && term) {
          term.write(`\r\n[exited${frame.code === null ? '' : ` (${frame.code})`}]`)
          renderTerm()
          termId = null
        }
        return
      }
      if (frame?.t === 'term-error') {
        // The one the server sends a paired phone: terminals are local-only.
        window.alert(frame.message)
        return
      }
      if (frame?.t !== 'event') return
      const payload = frame.event.payload
      if (payload.type === 'turn.started') {
        // Only the user's half opens a new exchange; the assistant's turn is
        // the reply within it.
        if (payload.role === 'user') {
          beginTurn(payload.turnId, payload.text)
          setRunning('running')
        }
      }
      else if (payload.type === 'tool.call.began') {
        const tools = document.querySelector('[data-turn][data-live] [data-tools]')
        if (tools && !tools.querySelector(`[data-tool-call="${CSS.escape(payload.callId)}"]`)) {
          const row = document.createElement('div')
          row.className = 'mb-1 flex items-center gap-[6px] text-[12px]'
          row.dataset.toolCall = payload.callId
          row.dataset.toolState = 'running'

          const dot = document.createElement('span')
          dot.className = 'tool-dot'
          dot.setAttribute('aria-hidden', 'true')

          const name = document.createElement('span')
          name.className = 'font-mono opacity-70'
          // textContent: a tool name comes from the provider, and an MCP server
          // can name a tool anything at all.
          name.textContent = payload.toolName

          row.append(dot, name)
          tools.append(row)
          transcript.scrollTop = transcript.scrollHeight
        }
      }
      else if (payload.type === 'tool.call.ended') {
        // Found by id: tools run in parallel and finish out of order, so
        // resolving the last row would mark the wrong one failed.
        const row = document.querySelector(`[data-tool-call="${CSS.escape(payload.callId)}"]`)
        if (row) row.dataset.toolState = payload.ok ? 'ok' : 'failed'
      }
      else if (payload.type === 'assistant.delta') {
        const node = responseNode()
        if (node) {
          node.textContent += payload.text
          transcript.scrollTop = transcript.scrollHeight
        }
      }
      else if (payload.type === 'checkpoint.restored') {
        // The workspace is actually back now.
        while (revertWaiters.length > 0) revertWaiters.shift()()
      }
      else if (payload.type === 'turn.completed' || payload.type === 'turn.interrupted') {
        setRunning('idle')
      }
      else if (payload.type === 'session.failed') {
        // A failed turn is over too. Leaving Stop up would offer to interrupt
        // something that already stopped.
        setRunning('idle')
        if (stateNode) stateNode.textContent = 'failed'
      }
      else if (payload.type === 'approval.requested') {
        setRunning('awaiting-approval')
        approval.querySelector('[data-approval-tool]').textContent = payload.toolName
        approval.hidden = false
        approval.dataset.approvalId = String(payload.approvalId)
      }
      else if (payload.type === 'approval.resolved') {
        // The turn resumes; it did not end.
        setRunning('running')
        approval.hidden = true
      }
    })
  }
</script>
