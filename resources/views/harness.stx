<script server>
/**
 * The harness surface.
 *
 * SSR-first with islands, not an SPA. A session transcript is mostly-static,
 * append-heavy text — the worst case for a component tree that re-reconciles
 * and the best case for server rendering. The shell, the profile list and every
 * settled turn come down as HTML; only the live tail and the composer hydrate.
 *
 * Profiles are the Arc "spaces": one profile per project, each with its own
 * colour, swiped between. `<Sidebar :spaces>` is the whole integration — the
 * mapping below is the only harness-specific part.
 */
export const profiles = $props.profiles || []
export const sessions = $props.sessions || []
export const activeProfile = $props.activeProfile || (profiles[0] && profiles[0].id) || ''
export const activeSession = $props.activeSession || null
export const initialSettingsSection = $props.settingsSection || ''
export const settingsSections = $props.settingsSections || []
// The keyboard registry, with both platform spellings of every default chord.
export const keybindings = $props.keybindings || []
// Settings this host owns, shared by every client connected to it.
export const hostSettings = $props.hostSettings || { defaultDriver: 'claude', followUpBehavior: 'queue' }
export const draftProject = $props.draftWorkspace || null
export const draftWithoutProject = $props.draftWithoutProject === true
export const serverUrl = $props.serverUrl || ''
// The browser CBOR bundle. Empty when the server could not build one, which
// costs the page its live updates but not its rendered transcript.
export const codecUrl = $props.codecUrl || ''
// The sequence this render already contains. The socket resumes from here so a
// load replays only what is missing.
export const sinceSeq = $props.sinceSeq || 0
// A decision this session is blocked on, if any. Rendered rather than waited
// for: the client that raised it may be long gone.
export const initialApprovals = activeSession?.pendingApprovals || []
export const initialInputs = activeSession?.pendingInputs || []
export const initialFollowUps = activeSession?.followUps || { entries: [], held: false }
const pendingApproval = initialApprovals[0]

// One space per profile. `pinned` is the favourite-repos tile grid; the
// sections group the profile's threads by their current navigation state.
//
// Only the active space and its immediate neighbours render their rows. Every
// space used to, which cost ~9.5ms of server render each — 175ms at fourteen
// projects, on every page load, to display one. Neighbours are kept because
// they are what a single swipe can reveal, so the common gesture never lands
// on an empty panel; anything further away fills in on arrival.
const activeSpaceIndex = Math.max(0, profiles.findIndex(profile => String(profile.id) === String(activeProfile)))

// id -> tint, for the native titlebar. The web sidebar gets the tint through
// `<Sidebar :spaces>`; the window chrome around it is ours to paint. Reaches
// the island through the server -> client bridge, like every other export the
// island references.
export const spaceTints = Object.fromEntries(
  profiles.map(profile => [String(profile.id), profile.tint || '']),
)

export const spaces = profiles.map((profile, index) => ({
  id: String(profile.id),
  deferred: Math.abs(index - activeSpaceIndex) > 1,
  label: profile.name,
  icon: profile.icon || 'i-hugeicons-folder-01',
  tint: profile.tint || 'blue',
  pinned: (profile.workspaces || []).map(workspace => ({
    id: String(workspace.id),
    label: workspace.name,
    icon: 'i-hugeicons-folder-01',
    href: `/?workspace=${workspace.id}`,
  })),
  sections: threadSections(profile),
  clear: { id: 'clear', label: 'Clear' },
}))

function threadSections(profile) {
  const recent = (profile.sessions || []).filter(session => !session.navigation?.archivedAt).reverse()
  const collect = (id, label, rows) => ({ id: id + '-' + profile.id, label, items: rows.map(toItem) })
  const snoozed = recent.filter(session => session.navigation?.snoozedUntil)
  const visible = recent.filter(session => !session.navigation?.snoozedUntil)
  const pinned = visible.filter(session => session.navigation?.pinnedOrder != null)
    .sort((a, b) => a.navigation.pinnedOrder - b.navigation.pinnedOrder)
  const unpinned = visible.filter(session => session.navigation?.pinnedOrder == null)
  const active = unpinned.filter(session => !session.navigation?.settledAt && session.state !== 'stopped')
  const settled = unpinned.filter(session => session.navigation?.settledAt || session.state === 'stopped')
    .sort((a, b) => (b.navigation?.settledAt ?? 0) - (a.navigation?.settledAt ?? 0))
  return [
    collect('pinned', 'Pinned', pinned),
    collect('active', 'Active', active.filter(session => session.state !== 'running')),
    collect('working', 'Working', active.filter(session => session.state === 'running')),
    collect('snoozed', 'Snoozed', snoozed.sort((a, b) => a.navigation.snoozedUntil - b.navigation.snoozedUntil)),
    collect('settled', 'Settled', settled),
  ].filter(section => section.items.length)
}

function toItem(session) {
  const waiting = session.state === 'awaiting-approval' || session.state === 'awaiting-input'
  return {
    id: String(session.id),
    label: session.title,
    icon: waiting ? 'i-hugeicons-help-circle' : session.state === 'running' ? 'i-hugeicons-loading-03' : 'i-hugeicons-message-01',
    href: `/s/${session.id}`,
  }
}

export const initialNavigation = activeSession?.navigation || {}
export const archivedThreads = (profiles.find(profile => String(profile.id) === String(activeProfile))?.sessions || [])
  .filter(session => session.navigation?.archivedAt)
  .sort((a, b) => b.navigation.archivedAt - a.navigation.archivedAt)

export const hasProfiles = profiles.length > 0
export const turns = activeSession ? activeSession.turns : []
export const sessionTitle = activeSession ? (activeSession.title || `Session ${activeSession.id}`) : draftProject?.name || (draftWithoutProject ? 'New session' : 'Harness')
export const sessionState = activeSession ? activeSession.state : 'idle'
// Empty unless this session runs in a worktree of its own.
export const sessionBranch = activeSession ? (activeSession.branch || '') : ''
export const sessionDriver = activeSession ? (activeSession.driverKind || '') : ''
export const sessionProviderInstanceId = activeSession?.providerInstanceId ?? null
export const promptPlaceholder = activeSession ? 'Ask the agent…' : 'Type here to start a new session…'
export const activeSessionId = activeSession ? activeSession.id : 0
export const activeWorkspaceId = activeSession ? (activeSession.workspaceId || 0) : 0
export const activeScratchSession = activeSession?.scratch === true
export const workspaceName = activeSession && !activeScratchSession
  ? profiles.flatMap(profile => profile.workspaces || []).find(workspace => workspace.id === activeWorkspaceId)?.name
  : undefined
export const canCompose = Boolean(activeSession || draftProject?.trusted || draftWithoutProject)
export const profileProjects = Object.fromEntries(profiles.map(profile => {
  const projects = profile.workspaces || []
  return [String(profile.id), projects.find(workspace => workspace.trusted) || projects[0] || null]
}))
export const draftProjectChoices = profiles.find(profile => String(profile.id) === String(activeProfile))?.workspaces || []
// The last turn is the only one that can still change, so it is the only one
// that needs hydrating — everything above it is settled history.
export const settledTurns = turns.slice(0, Math.max(0, turns.length - 1))
export const liveTurn = turns.length > 0 ? turns[turns.length - 1] : null
export const initialHasResponse = Boolean(liveTurn?.response)
export const initialResponseTurn = liveTurn?.id || 0
export const initialSteerable = liveTurn?.steerable === true
export const initialInputActivity = liveTurn?.inputRequests || []
</script>

{{--
  The shared browser module, fetched and compiled while the page paints rather
  than on the first dynamic import that needs it. Everything interactive here
  waits on it: the socket, the command sender, the transcript finder, and the
  keyboard registry that answers the window chords. Without the hint, a chord
  pressed in the first moments after a load found no registry and did nothing.
--}}
@if(codecUrl)
  <link rel="modulepreload" href="{{ codecUrl }}">
@endif
<div data-harness-shell :data-sidebar-collapsed="sidebarCollapsed()" class="flex overflow-hidden h-[100dvh] w-full text-neutral-900 dark:text-neutral-100">
  {{--
    `data-harness-sidebar`, not `data-stx-sidebar`: the latter is the Sidebar
    component's own marker, and putting it on a wrapper made two elements claim
    it. `tintTarget()` resolves `closest('[data-stx-sidebar]')`, so the space
    palette was being written to this wrapper instead of the pane — it reached
    the pane by inheritance and worked by luck.
  --}}
  <aside id="harness-sidebar" ref="sidebarBox" tabindex="-1" aria-label="Workspace navigation" class="shrink-0 border-black/5 border-r dark:border-white/5" data-harness-sidebar :data-open="sidebarOpen() ? 'true' : 'false'" :style="'--harness-sidebar-width: ' + sidebarWidth() + 'px'">
    <div data-navigation-chrome>
      <div class="flex gap-2 items-center justify-between h-11 px-3">
        <a href="/" class="flex gap-2 items-center min-w-0 font-semibold text-sm">
          <span class="inline-block size-4 i-hugeicons-command-line" aria-hidden="true"></span>
          Harness
        </a>
        <button type="button" data-sidebar-close @click="toggleSidebar" aria-label="Close navigation" aria-controls="harness-sidebar" class="harness-icon-button">
          <span class="inline-block size-4 i-hugeicons-sidebar-left" aria-hidden="true"></span>
        </button>
      </div>
      @if(hasProfiles)
        <div class="flex gap-1 items-center px-2 pb-2">
          <button type="button" data-nav-search @click="openThreadSearch" aria-label="Search threads" title="Search threads" aria-haspopup="dialog" class="harness-nav-search">
            <span class="inline-block size-4 i-hugeicons-search-01" aria-hidden="true"></span>
            <span>Search</span>
          </button>
          <button type="button" @click="openProjectPicker" aria-label="Add project" title="Add project" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-folder-add" aria-hidden="true"></span>
          </button>
          <button type="button" @click="openDraft(visibleProfile())" aria-label="New thread" title="New thread" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-pencil-edit-02" aria-hidden="true"></span>
          </button>
        </div>
      @endif
    </div>
    <div data-navigation-content>
    @if(hasProfiles)
      <Sidebar
        :spaces="spaces"
        :space="activeProfile"
        placement="static"
        spacePersistKey="harness.profile"
        :showSpaceAdd="true"
      />
    @else
      <div class="flex flex-col gap-2 items-center justify-center px-6 h-full text-center">
        <p class="text-[13px] text-neutral-600 dark:text-neutral-300">No profiles yet</p>
        <button type="button" @click="openProfileModal" class="px-3 py-1 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15">Create profile</button>
      </div>
    @endif
    </div>
    <div data-navigation-footer>
      <button type="button" data-account-button data-nav-settings @click="openSettings" aria-label="Settings" :title="settingsShortcutTitle()" class="harness-icon-button">
        <span class="inline-block size-4 i-hugeicons-settings-02" aria-hidden="true"></span>
      </button>
    </div>
  </aside>
  <button type="button" data-sidebar-scrim hidden :hidden="!sidebarOpen()" @click="closeSidebar" aria-label="Close navigation"></button>
  <div
    data-sidebar-resize
    role="separator"
    tabindex="0"
    aria-label="Resize workspace navigation"
    aria-controls="harness-sidebar"
    aria-orientation="vertical"
    aria-valuemin="192"
    aria-valuemax="416"
    aria-valuenow="250"
    :aria-valuenow="String(sidebarWidth())"
    @keydown="resizeSidebarByKey"
    @pointerdown="beginSidebarResize"
    @pointermove="moveSidebarResize"
    @pointerup="endSidebarResize"
    @pointercancel="cancelSidebarResize"
  ></div>

  <main data-workspace-layout data-details-open="true" :data-details-open="workspaceDetailsOpen()" :data-diff-open="diffOpen()" :inert="!desktopSidebar() && sidebarOpen()" class="flex-1 min-w-0">
    <header data-workspace-header class="flex relative gap-3 items-center shrink-0 px-4 h-[44px] border-b border-black/5 dark:border-white/5">
      <button type="button" data-sidebar-toggle class="harness-icon-button" ref="sidebarToggleBox" @click="toggleSidebar" aria-label="Open navigation" aria-controls="harness-sidebar" aria-expanded="false" :aria-expanded="sidebarOpen() ? 'true' : 'false'">
        <span class="inline-block size-4 i-hugeicons-sidebar-left" aria-hidden="true"></span>
      </button>
      <div data-workspace-heading class="flex gap-2 items-center min-w-0">
        @if(workspaceName)
          <span data-workspace-project class="min-w-0 text-xs text-neutral-600 dark:text-neutral-400 truncate" title="{{ workspaceName }}">{{ workspaceName }}</span>
          <span class="text-neutral-400" aria-hidden="true">/</span>
        @endif
        @if(activeSession)
          <button type="button" data-workspace-title data-thread-actions-trigger ref="threadActionsTriggerBox" @click="openThreadActions" aria-haspopup="dialog" aria-controls="harness-thread-actions" :aria-expanded="threadActionsOpen()" :title="currentThreadTitle()" class="flex gap-1 items-center min-w-0 font-medium text-start text-[13px] rounded-md">
            <span class="min-w-0 truncate" :text="currentThreadTitle()">{{ sessionTitle }}</span>
            <span class="shrink-0 inline-block size-3 i-hugeicons-arrow-down-01 text-neutral-500" aria-hidden="true"></span>
          </button>
        @else
          <span data-workspace-title class="min-w-0 font-medium text-[13px] truncate" title="{{ sessionTitle }}">{{ sessionTitle }}</span>
        @endif
      </div>
      @if(activeSession)
      <span
        data-session-state
        data-state="{{ sessionState }}"
        :data-state="uiState()"
        class="px-2 py-[2px] leading-[14px] text-[11px] whitespace-nowrap rounded-full opacity-70"
        :text="uiState() === 'awaiting-input' ? 'Question' : uiState() === 'awaiting-approval' ? 'Approval' : uiState()"
      >{{ sessionState === 'awaiting-input' ? 'Question' : sessionState === 'awaiting-approval' ? 'Approval' : sessionState }}</span>
      @endif
      {{-- Which agent answers in this session — the composer picker's ground truth. --}}
      @if(sessionDriver)
        <span data-session-driver class="px-[6px] py-[1px] leading-[15px] text-[11px] border border-black/10 rounded-[5px] dark:border-white/15 opacity-70">{{ sessionDriver }}</span>
      @endif
      {{--
        An isolated session edits its own checkout, not the workspace. Saying
        which branch makes that visible, and names the thing you merge.
      --}}
      @if(sessionBranch)
        <span
          data-workspace-branch
          class="px-[6px] py-[1px] font-mono leading-[15px] text-[11px] truncate border border-black/10 rounded-[5px] dark:border-white/15 opacity-70"
          title="This session runs in its own worktree on {{ sessionBranch }}"
        >{{ sessionBranch }}</span>
      @endif
      <div data-header-actions>
        @if(hasProfiles)
          <button type="button" data-thread-search-toggle @click="openThreadSearch" aria-label="Search threads" title="Search threads" aria-haspopup="dialog" :aria-keyshortcuts="shortcutKeys('thread.search')" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-search-01" aria-hidden="true"></span>
          </button>
        @endif
        @if(activeSession && !activeScratchSession)
          <button type="button" data-header-pane @click="toggleDiff" aria-label="Show changes" title="Changes" aria-controls="harness-changes" :aria-expanded="diffOpen() ? 'true' : 'false'" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-file-02" aria-hidden="true"></span>
          </button>
        @endif
        @if(activeWorkspaceId)
          <button type="button" data-header-pane @click="toggleTerminal" aria-label="Open terminal" title="Terminal" aria-controls="harness-terminal" :aria-expanded="termOpen() ? 'true' : 'false'" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-command-line" aria-hidden="true"></span>
          </button>
        @endif
        @if(draftProject || activeSession || draftWithoutProject)
          <button type="button" data-workspace-actions-toggle ref="workspaceActionsToggleBox" @click="toggleWorkspaceActions" aria-label="Workspace actions" title="Workspace tools" aria-controls="harness-workspace-actions" aria-expanded="false" :aria-expanded="(wideWorkspace() ? workspaceDetailsOpen() : workspaceActionsOpen()) ? 'true' : 'false'" class="harness-icon-button">
            <span data-workspace-tools-icon hidden :hidden="!wideWorkspace()" class="size-4 i-hugeicons-sidebar-right" aria-hidden="true"></span>
            <span data-workspace-menu-icon :hidden="wideWorkspace()" class="size-4 i-hugeicons-more-horizontal" aria-hidden="true"></span>
          </button>
        @endif
        <button type="button" data-account-button data-header-settings :title="settingsShortcutTitle()" aria-label="Settings" @click="openSettings" class="harness-icon-button">
          <span class="inline-block size-4 i-hugeicons-settings-02" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <div data-workspace-content>
    <div data-workspace-lane>
    {{--
      The transcript. Settled turns are plain server-rendered HTML and hydrate
      on `visible`, so scrolling back through a long session costs nothing until
      you actually scroll. The live tail hydrates eagerly — it is the only part
      the socket writes to.
    --}}
    <div data-transcript-viewport :style="transcriptFindOpen() ? '--harness-transcript-top: 56px' : ''" class="relative flex-1 min-h-0 min-w-0">
    <div data-transcript ref="transcriptBox" @scroll="trackTranscriptPosition" @click="handleTranscriptControl" @keydown="handleTranscriptKeyboard" tabindex="0" role="region" aria-label="Conversation" class="overflow-y-auto px-4 pt-[var(--harness-transcript-top,12px)] pb-3 h-full min-w-0">
      {{--
        A blank canvas says the app is broken; an empty state says what to do.
        Typing below is the fastest path, so it is the one named first.
      --}}
      @if(turns.length === 0)
        <div data-empty-state :hidden="liveTurns().length > 0" class="flex flex-col gap-2 items-center justify-center h-full text-center">
          @if(activeSession)
            <p class="text-[14px] font-medium">Start the conversation</p>
            <p class="text-[13px] text-neutral-600 dark:text-neutral-300">Send a prompt to the agent below.</p>
          @elseif(draftWithoutProject)
            <h1 class="font-semibold text-[20px]">New session</h1>
            <p class="max-w-[40ch] text-[13px] text-neutral-600 dark:text-neutral-300">Files from this session stay in a new scratch folder on the host.</p>
          @elseif(draftProject && draftProject.trusted)
            <p class="text-[16px] font-semibold">Start a session in {{ draftProject.name }}</p>
            <p class="text-[13px] text-neutral-600 dark:text-neutral-300">Choose an agent and send your first message.</p>
          @elseif(draftProject)
            <p class="text-[16px] font-semibold">Trust {{ draftProject.name }} to start</p>
            <p class="max-w-[34ch] text-[13px] text-neutral-600 dark:text-neutral-300">Trust lets agents access this folder when you start a session.</p>
            <button type="button" data-project-trust @click="trustProject" :disabled="projectBusy()" class="mt-1 px-3 h-9 text-[13px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-[8px]">Trust folder</button>
          @else
            <h1 class="text-[20px] font-semibold">Open a project</h1>
            <p class="max-w-[40ch] text-[13px] text-neutral-600 dark:text-neutral-300">Add a folder from the host to start working with an agent.</p>
            <button type="button" data-first-project @click="openProjectPicker" class="mt-2 px-4 h-9 text-[13px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-[8px]">Add project</button>
            <button type="button" data-start-without-project @click="startWithoutProject" class="px-3 h-9 text-[13px] underline underline-offset-4">Start without a project</button>
          @endif
          @if(!activeSession && draftProjectChoices.length)
            <label class="flex gap-2 items-center mt-4 text-[12px] text-neutral-600 dark:text-neutral-300">
              Project
              <select data-draft-project @change="chooseProject" class="px-2 h-8 max-w-[190px] text-neutral-900 dark:text-neutral-100 bg-white dark:bg-neutral-900 border border-black/15 rounded-[6px] dark:border-white/20">
                <option value="none" @if(draftWithoutProject)selected@endif>No project</option>
                @foreach(draftProjectChoices as workspace)
                  <option value="{{ workspace.id }}" @if(workspace.id === draftProject?.id)selected@endif>{{ workspace.name }}</option>
                @endforeach
              </select>
            </label>
          @endif
        </div>
      @endif
      @foreach(settledTurns as turn)
        <article stx-hydrate="visible" class="mb-5" data-turn="{{ turn.id }}" id="turn-{{ turn.id }}">
          <div class="sr-only">You</div>
          <div data-user-prompt class="mb-4 ms-auto px-3 py-2 max-w-[90%] w-fit rounded-xl whitespace-pre-wrap break-words text-sm leading-5">{{ turn.prompt }}</div>
          @foreach(turn.steered as message)
            <div data-steered-message class="mb-3 ps-3 border-blue-500/40 border-s-2">
              <div class="mb-1 font-medium text-[12px] text-neutral-600 dark:text-neutral-400">You followed up</div>
              <div data-steering-text class="break-words text-[13px] whitespace-pre-wrap">{{ message.text }}</div>
            </div>
          @endforeach
          {{--
            What the agent ran, before what it said. These were in the log from
            the start and rendered nowhere, so the transcript showed a reply
            with no evidence behind it.
          --}}
          <div data-tools>
          @foreach(turn.toolCalls as call)
            <div class="flex gap-[6px] items-center mb-1 text-[12px]" data-tool-call="{{ call.callId }}" data-tool-state="{{ call.state }}">
              <span class="tool-dot" aria-hidden="true"></span>
              <span class="font-mono opacity-70">{{ call.name }}</span>
            </div>
          @endforeach
          </div>
          @foreach(turn.inputRequests as request)
            <div data-question-activity class="mb-2 text-[12px] text-neutral-600 dark:text-neutral-400">
              {{ request.outcome === 'answered' ? 'Question answered' : request.outcome === 'declined' ? 'Question declined' : 'Question interrupted' }}
              @foreach(request.attachments as file)
                <a class="block break-words underline" href="/s/{{ activeSession.id }}/question-attachments/{{ file.id }}" download>{!! file.nameHtml !!}</a>
              @endforeach
            </div>
          @endforeach
          @if(turn.response)<div class="mb-1 font-medium text-[12px] opacity-50">Agent</div>@endif
          <div class="transcript-markdown" data-response data-ssr-response="{{ turn.id }}"></div>
          {{--
            Undo this turn. Only offered where a snapshot exists: a workspace
            that is not a repository has nothing to revert to, and a disabled
            button that never explains itself is worse than no button.
          --}}
          @if(turn.checkpointId)
            <button
              type="button"
              data-revert="{{ turn.checkpointId }}"
              class="mt-2 px-2 py-[2px] text-[11px] border border-black/10 rounded-[6px] dark:border-white/15 opacity-60 hover:opacity-100"
              :hidden="uiBusy()"
              :disabled="revertingId() === {{ turn.checkpointId }}"
              :text="revertingId() === {{ turn.checkpointId }} ? 'Reverting…' : 'Revert this turn'"
              @click="revertTurn({{ turn.checkpointId }})"
            >Revert this turn</button>
          @endif
        </article>
      @endforeach

      @if(liveTurn)
        <article class="mb-5" data-turn="{{ liveTurn.id }}" id="turn-{{ liveTurn.id }}" data-live>
          <div class="sr-only">You</div>
          <div data-user-prompt class="mb-4 ms-auto px-3 py-2 max-w-[90%] w-fit rounded-xl whitespace-pre-wrap break-words text-sm leading-5">{{ liveTurn.prompt }}</div>
          <div data-steering-history>
            @foreach(liveTurn.steered as message)
              <div data-steered-message class="mb-3 ps-3 border-blue-500/40 border-s-2">
                <div class="mb-1 font-medium text-[12px] text-neutral-600 dark:text-neutral-400">You followed up</div>
                <div data-steering-text class="break-words text-[13px] whitespace-pre-wrap">{{ message.text }}</div>
              </div>
            @endforeach
          </div>
          <div data-tools>
          {{--
            The static state is the SSR truth; the binding overlays what
            finished after this page rendered. Tools finish out of order, so
            every row reads the result map by its own id.
          --}}
          @foreach(liveTurn.toolCalls as call)
            <div class="flex gap-[6px] items-center mb-1 text-[12px]" data-tool-call="{{ call.callId }}" data-tool-state="{{ call.state }}" :data-tool-state="toolResults()['{{ call.callId }}'] || '{{ call.state }}'">
              <span class="tool-dot" aria-hidden="true"></span>
              <span class="font-mono opacity-70">{{ call.name }}</span>
            </div>
          @endforeach
          {{-- Tools this turn starts after page load render here, after the server-drawn rows. --}}
          <template :for="call in ssrTools" :key="call.callId">
            <div class="flex gap-[6px] items-center mb-1 text-[12px]" :data-tool-call="call.callId" :data-tool-state="toolResults()[call.callId] || 'running'">
              <span class="tool-dot" aria-hidden="true"></span>
              <span class="font-mono opacity-70" :text="call.name"></span>
            </div>
          </template>
          </div>
          <template :for="request in ssrInputActivity()" :key="request.requestId">
            <div data-question-activity :data-question-request="request.requestId" class="mb-2 text-[12px] text-neutral-600 dark:text-neutral-400">
              <span :text="questionActivityLabel(request.outcome)"></span>
            </div>
          </template>
          <div @if(!liveTurn.response && sessionState !== 'running')hidden@endif
            :hidden="!ssrHasResponse() && (runningTurnId() !== initialResponseTurn || uiState() !== 'running')"
            class="mb-1 font-medium text-[12px] opacity-50">Agent</div>
          {{--
            A page can load mid-turn before any token exists; the dots hold
            that gap too, and the first streamed byte hides them.
          --}}
          @if(!liveTurn.response)
            <div data-thinking class="thinking-dots" @if(sessionState !== 'running')hidden@endif :hidden="ssrHasResponse() || uiState() !== 'running' || runningTurnId() !== initialResponseTurn" aria-label="Waiting for the agent"><span></span><span></span><span></span></div>
          @endif
          <div class="transcript-markdown" data-response data-live-response data-ssr-response="{{ liveTurn.id }}"></div>
          {{--
            The newest turn is the one people most want to undo, and it was the
            only one without the button because it is not in `settledTurns`.
            Hidden while it is still running — the reducer refuses a revert
            mid-turn anyway, since restoring files under a working agent leaves
            it editing a tree that changed for reasons it cannot see.
          --}}
          @if(liveTurn.checkpointId)
            <button
              type="button"
              data-revert="{{ liveTurn.checkpointId }}"
              class="mt-2 px-2 py-[2px] text-[11px] border border-black/10 rounded-[6px] dark:border-white/15 opacity-60 hover:opacity-100"
              :hidden="uiBusy()"
              :disabled="revertingId() === {{ liveTurn.checkpointId }}"
              :text="revertingId() === {{ liveTurn.checkpointId }} ? 'Reverting…' : 'Revert this turn'"
              @click="revertTurn({{ liveTurn.checkpointId }})"
            >Revert this turn</button>
          @endif
        </article>
      @endif

      {{--
        Turns started on this page. The island pushes into `liveTurns` and the
        runtime renders the rows — the keyed reuse means a streaming response
        updates its own article in place. Prompts and tool names stay plain text.
      --}}
      <template :for="turn in liveTurns" :key="turn.id">
        <article class="mb-5" :data-turn="turn.id" :id="'turn-' + turn.id">
          <div class="sr-only">You</div>
          <div data-user-prompt class="mb-4 ms-auto px-3 py-2 max-w-[90%] w-fit rounded-xl whitespace-pre-wrap break-words text-sm leading-5" :text="turn.prompt"></div>
          <div data-steering-history></div>
          <div data-tools>
            <template :for="call in turn.tools" :key="call.callId">
              <div class="flex gap-[6px] items-center mb-1 text-[12px]" :data-tool-call="call.callId" :data-tool-state="toolResults()[call.callId] || 'running'">
                <span class="tool-dot" aria-hidden="true"></span>
                <span class="font-mono opacity-70" :text="call.name"></span>
              </div>
            </template>
          </div>
          <template :for="request in turn.inputRequests" :key="request.requestId">
            <div data-question-activity :data-question-request="request.requestId" class="mb-2 text-[12px] text-neutral-600 dark:text-neutral-400">
              <span :text="questionActivityLabel(request.outcome)"></span>
            </div>
          </template>
          <div :hidden="!turn.hasResponse && (runningTurnId() !== turn.id || uiState() !== 'running')"
            class="mb-1 font-medium text-[12px] opacity-50">Agent</div>
          {{-- Until the first token: dots, not a label over blank space. --}}
          <div data-thinking class="thinking-dots" :hidden="turn.hasResponse || uiState() !== 'running' || runningTurnId() !== turn.id" aria-label="Waiting for the agent"><span></span><span></span><span></span></div>
          <div class="transcript-markdown" data-response></div>
        </article>
      </template>

      @if(activeSession)
        <template ref="steeringMessageBox">
          <div data-steered-message class="mb-3 ps-3 border-blue-500/40 border-s-2">
            <div class="mb-1 font-medium text-[12px] text-neutral-600 dark:text-neutral-400">You followed up</div>
            <div data-steering-text class="break-words text-[13px] whitespace-pre-wrap"></div>
          </div>
        </template>
      @endif
      @includeWhen(activeSession, '../partials/harness-follow-ups')
    </div>
    @if(activeSession)
      @include('../partials/harness-transcript-find')
      <button type="button" data-jump-to-latest @click="jumpToLatest" hidden :hidden="followingTranscript()" class="absolute bottom-3 inset-e-4 px-3 h-9 font-medium text-[12px] bg-white dark:bg-neutral-900 border border-black/15 rounded-full shadow-sm dark:border-white/20">Jump to latest</button>
      <p class="sr-only" role="status" :text="transcriptAnnouncement()"></p>
    @endif
    </div>

    @if(activeSession)
      <div data-thread-archived @if(!initialNavigation.archivedAt)hidden@endif :hidden="!threadNavigation().archivedAt" class="mx-auto mb-3 px-3 py-2 flex gap-2 items-center text-sm border border-black/10 rounded-md dark:border-white/15">
        <span>Archived thread</span>
        <button type="button" @click="organizeThread('restore')" :disabled="threadActionBusy()" class="font-medium underline">Restore thread</button>
      </div>
    @endif

    @includeWhen(activeSession, '../partials/harness-approval-card')
    @includeWhen(activeSession, '../partials/harness-question-card')

    @if(canCompose)
    <form data-composer :data-steer-ready="canSteer()" :data-session-online="sessionOnline()" @if(initialInputs.length || initialNavigation.archivedAt)hidden@endif :hidden="Boolean(inputRequest() || threadNavigation().archivedAt)" @submit.prevent="sendPrompt()" class="grid gap-2 items-end shrink-0">
      {{--
        Enter sends, Shift+Enter makes a newline — the convention every chat
        surface uses; the textarea would otherwise only ever insert newlines.
      --}}
      <textarea
        data-prompt
        ref="promptBox"
        @keydown="promptKeydown"
        @input="rememberPrompt"
        @keyup="rememberPrompt"
        @select="rememberPrompt"
        @click="rememberPrompt"
        rows="2"
        placeholder="{{ promptPlaceholder }}"
        :placeholder="composerPlaceholder()"
        class="px-1 py-1 min-h-[46px] min-w-0 text-sm bg-transparent outline-none resize-none"
      ></textarea>
      {{--
        The agent picker, where every LLM surface puts its model switch. It
        shows the session's own driver; picking another offers a fresh session
        with it — a different CLI cannot resume this one's conversation, and
        pretending otherwise would silently drop the context.
      --}}
      <select
        data-driver-picker
        ref="driverPickerBox"
        @change="driverPicked"
        title="Agent for this session"
        class="px-2 h-8 max-w-[170px] min-w-0 text-xs bg-transparent border border-transparent rounded-md hover:border-black/15 dark:hover:border-white/20"
      >
        <option value="claude">Claude Code</option>
        <option value="codex">Codex</option>
        <option value="opencode">OpenCode</option>
        <option value="cursor">Cursor</option>
        <option value="grok">Grok</option>
        <option :for="account in providerAccounts()" :key="account.id" :value="account.value" :disabled="account.status !== 'ready'" :text="account.label"></option>
      </select>
      <div class="flex flex-wrap gap-2 justify-end">
        <button type="submit" data-send :hidden="!showSend()" :disabled="startPending() || sessionConnecting() || (sendLabel() === 'Steer' && steeringPending())" :text="sendLabel()" class="px-4 h-8 text-[13px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-full">Send</button>
        <span class="md:hidden" :hidden="!canSteer() || !composerText().trim() || Boolean(editingFollowUp())">
          <button type="button" :disabled="startPending() || (oppositeFollowUp() === 'steer' && steeringPending())" :text="oppositeFollowUp() === 'steer' ? 'Steer' : 'Queue'" @click="sendPrompt(oppositeFollowUp())" class="px-3 h-[36px] text-[13px] border border-black/15 rounded-[8px] dark:border-white/20">Steer</button>
        </span>
        <button type="button" :hidden="!editingFollowUp()" @click="followUpActions()?.endEdit()" class="px-3 h-[36px] text-[13px] border border-black/15 rounded-[8px] dark:border-white/20">Cancel</button>
        <button type="button" data-resume-queue :hidden="!showResume()" :disabled="!sessionOnline() || queueActionPending()" @click="followUpActions()?.run('send')" class="px-4 h-8 text-[13px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-full">Resume</button>
        <button type="button" data-stop hidden :hidden="!uiBusy() || stopPressed()" :disabled="!sessionOnline()" @click="stopTurn" class="px-4 h-8 text-[13px] text-white bg-red-600 rounded-full hover:bg-red-700">Stop</button>
      </div>
    </form>
    @endif
    @if(activeWorkspaceId)
    <section id="harness-terminal" data-terminal hidden :hidden="!termOpen()" aria-label="Terminal" class="terminal-panel">
      <div data-terminal-toolbar>
        <span>Terminal</span>
        <button type="button" aria-label="Close terminal" title="Close terminal" @click="toggleTerminal" class="harness-icon-button">
          <span class="inline-block size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
        </button>
      </div>
      <div data-terminal-host ref="termHostBox" @keydown="termKeydown" @paste="termPaste" tabindex="0" class="terminal-host">
        {{--
          Ten glyphs in the host's own font, laid out but invisible: the ruler
          the island measures to turn pixels into columns and rows.
        --}}
        <span data-term-metric ref="termMetricBox" aria-hidden="true" class="term-metric">0123456789</span>
        <div data-terminal-screen ref="termScreenBox"></div>
      </div>
    </section>
  @endif
    </div>
    @if(draftProject || activeSession || draftWithoutProject)
      <button type="button" data-workspace-actions-scrim hidden tabindex="-1" :hidden="!workspaceActionsOpen()" @click="closeWorkspaceActions" aria-label="Close workspace actions"></button>
      <aside data-workspace-rail aria-label="Workspace tools">
        <div id="harness-workspace-actions" data-workspace-actions :data-open="workspaceActionsOpen() ? 'true' : 'false'">
          @if(activeWorkspaceId)
            <div data-workspace-context>
              <span class="inline-block size-4 i-hugeicons-folder-01" aria-hidden="true"></span>
              <span class="min-w-0 truncate" title="{{ workspaceName || sessionTitle }}">{{ workspaceName || sessionTitle }}</span>
            </div>
          @endif
        {{--
          Changes sit behind a toggle rather than always-on. Reading a repository
          costs a subprocess, and most page loads never look at the diff.
        --}}
        @if(activeSession && !activeSession.scratch)
        <button
          type="button"
          data-diff-toggle
          aria-controls="harness-changes"
          class="px-2 py-[3px] text-[12px] border border-black/10 rounded-[6px] dark:border-white/15"
          aria-expanded="false"
          :aria-expanded="diffOpen() ? 'true' : 'false'"
          @click="toggleDiff"
        ><span class="inline-block size-4 i-hugeicons-file-02" aria-hidden="true"></span><span>Changes</span></button>
        @endif
        @if(activeWorkspaceId)
          <button type="button" data-terminal-toggle class="terminal-toggle" @click="toggleTerminal" aria-label="Toggle terminal" aria-controls="harness-terminal" aria-expanded="false" :aria-expanded="termOpen() ? 'true' : 'false'">
            <span class="inline-block size-4 i-hugeicons-command-line" aria-hidden="true"></span>
            <span>Terminal</span>
          </button>
        @endif
        @if(activeScratchSession)
          <button type="button" data-promote-scratch @click="promoteScratchProject" :disabled="projectBusy()" class="px-2 h-8 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15">Turn into project</button>
        @endif
        @if(draftProject || activeSession || draftWithoutProject)
        <button type="button" data-project-add @click="openProjectPicker" class="flex gap-1.5 items-center shrink-0 px-2 h-8 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15" aria-label="Add project" title="Add project">
          <span class="inline-block size-4 i-hugeicons-folder-add" aria-hidden="true"></span>
          <span>Add project</span>
        </button>
        @endif
      </div>
    <section id="harness-changes" aria-labelledby="harness-changes-title" data-diff hidden :hidden="!diffOpen()" class="overflow-y-auto px-3 py-2">
      <div class="flex gap-2 items-center justify-between mb-1">
        <h2 id="harness-changes-title" class="font-semibold text-[13px]">Changes</h2>
        <button type="button" @click="toggleDiff" aria-label="Close changes" title="Close changes" class="harness-icon-button">
          <span class="inline-block size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
        </button>
      </div>
      <div data-diff-status class="text-[12px] opacity-60" :text="diffStatus()">Loading…</div>
      <ul data-diff-files class="mb-2 list-none">
        <template :for="file in diffFiles" :key="file.path">
          <li class="flex gap-[8px] items-center py-[1px] text-[12px]" :data-diff-file="file.path">
            <span class="shrink-0 w-[64px] text-[11px] uppercase opacity-50" :text="file.status"></span>
            {{-- :text assigns text, never markup — a path is data, and a repository can contain anything. --}}
            <span class="font-mono truncate" :text="file.path"></span>
            {{-- Untracked files have no counts; showing +0 -0 implies an empty file. --}}
            <span class="shrink-0 ml-auto font-mono text-[11px]" :text="file.status === 'untracked' ? '' : '+' + file.insertions + ' −' + file.deletions"></span>
          </li>
        </template>
      </ul>
      <pre data-diff-patch class="overflow-x-auto leading-[17px] text-[12px]" :text="diffPatch()"></pre>
    </section>
      </aside>
    @endif
    </div>
  </main>

  @if(activeSession)
    @include('../partials/harness-thread-actions')
  @endif

  <dialog data-thread-search ref="threadSearchDialogBox" aria-labelledby="thread-search-heading" @cancel="cancelThreadSearch" @click.self="closeThreadSearch" class="mb-auto mt-8 mx-auto p-0 md:mt-auto text-neutral-900 dark:text-neutral-100 bg-white dark:bg-neutral-900 border border-black/10 rounded-[12px] dark:border-white/15 shadow-xl">
    <div class="p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 id="thread-search-heading" class="font-semibold text-[14px]">Search threads</h2>
        <button type="button" @click="closeThreadSearch" aria-label="Close search" class="inline-flex items-center justify-center size-7 hover:bg-black/5 dark:hover:bg-white/10 rounded-[6px]">
          <span class="inline-block size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
        </button>
      </div>
      <input data-thread-search-input ref="threadSearchInputBox" type="search" maxlength="120" role="combobox" aria-label="Search thread titles and messages" aria-controls="thread-search-list" aria-autocomplete="list" aria-expanded="false" :aria-expanded="threadSearchResults().length ? 'true' : 'false'" :aria-activedescendant="selectedThreadSearchId()" @input="queueThreadSearch" @compositionend="queueThreadSearch" @keydown="threadSearchKeydown" autocomplete="off" placeholder="Search titles, projects, and messages" class="px-3 py-2 w-full text-[14px] bg-neutral-50 dark:bg-neutral-950 border border-black/15 rounded-[8px] dark:border-white/20" />
      <p role="status" :hidden="!threadSearchStatus()" :text="threadSearchStatus()" class="mt-2 text-[12px] text-neutral-600 dark:text-neutral-300"></p>
      <ul id="thread-search-list" data-thread-search-list ref="threadSearchListBox" role="listbox" aria-label="Matching threads" :hidden="!threadSearchResults().length" class="overflow-y-auto mt-2">
        <li :for="(result, index) in threadSearchResults()" :key="result.id" :id="'thread-search-result-' + result.id" data-thread-search-option role="option" :aria-selected="threadSearchIndex() === index ? 'true' : 'false'" @click="chooseThreadSearchResult(result)" class="px-3 py-2 rounded-[6px] cursor-pointer">
          <div class="flex gap-2 items-center justify-between">
            <span class="min-w-0 font-medium text-[13px] truncate" :text="result.title"></span>
            <span class="max-w-[40%] text-[11px] text-neutral-600 truncate dark:text-neutral-300" :text="result.project"></span>
          </div>
          <p :if="result.excerpt" class="mt-1 text-[12px] text-neutral-600 truncate dark:text-neutral-300" :text="result.excerpt"></p>
        </li>
      </ul>
    </div>
  </dialog>

  <dialog data-project-dialog ref="projectDialogBox" aria-labelledby="project-dialog-heading" class="m-auto p-0 text-neutral-900 dark:text-neutral-100 bg-white dark:bg-neutral-900 border border-black/10 rounded-[14px] dark:border-white/15 shadow-xl" @cancel="cancelProjectPicker">
    <form class="flex flex-col gap-4 p-5" @submit.prevent="registerProject">
      <div class="flex flex-col gap-1">
        <h2 id="project-dialog-heading" class="text-[17px] font-semibold">Add project</h2>
        <p class="text-[13px] text-neutral-600 dark:text-neutral-300">Enter the absolute path of a folder on the computer running Harness.</p>
      </div>
      <div class="flex flex-col gap-2">
        <label for="project-folder" class="text-[13px] font-medium">Folder path</label>
        <div class="flex gap-2">
          <input id="project-folder" data-project-path ref="projectPathBox" type="text" required autocomplete="off" spellcheck="false" :disabled="projectBusy()" class="px-3 py-2 w-full min-w-0 font-mono text-[13px] bg-neutral-50 dark:bg-neutral-950 border border-black/15 rounded-[8px] dark:border-white/20" />
          <button type="button" data-project-browse hidden :hidden="!hasFolderPicker()" :disabled="projectBusy()" @click="browseProject" class="px-3 text-[13px] border border-black/15 rounded-[8px] dark:border-white/20">Browse</button>
        </div>
      </div>
      <label class="flex gap-2 items-start text-[13px]">
        <input data-project-trust-checkbox ref="projectTrustBox" type="checkbox" :disabled="projectBusy()" class="mt-[3px] accent-neutral-900 dark:accent-neutral-100" />
        <span>Trust this folder for agent sessions</span>
      </label>
      <p data-project-error role="alert" :text="projectError()" :hidden="!projectError()" hidden class="text-[13px] text-red-700 dark:text-red-300"></p>
      <div class="flex gap-2 justify-end">
        <button type="button" :disabled="projectBusy()" @click="closeProjectPicker" class="px-3 h-9 text-[13px] border border-black/15 rounded-[8px] dark:border-white/20">Cancel</button>
        <button type="submit" data-project-submit :disabled="projectBusy()" :text="projectBusy() ? 'Adding…' : 'Add project'" class="px-3 h-9 text-[13px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-[8px]">Add project</button>
      </div>
    </form>
  </dialog>

  {{--
    The terminal (M6). Structure is server-rendered so the island only wires
    bytes and keys — no createElement, no injected styles (stx-standards §8,
    §11). Hidden until toggled; absent entirely when the session has no
    workspace, because a shell needs somewhere to open.
  --}}
  {{--
    Naming a new profile. Replaces window.prompt: the name arrives through a
    form the page owns, so it can be styled, cancelled and focused like
    everything else. Opened by the sidebar's spaceAdd event.
  --}}
  <div data-profile-modal hidden :hidden="!profileModalOpen()" @click.self="closeProfileModal" class="flex fixed inset-0 z-[70] items-center justify-center bg-black/40">
    <form @submit.prevent="createProfile" class="p-4 w-[320px] bg-white dark:bg-neutral-900 rounded-[10px] shadow-xl">
      <label class="block mb-2 font-medium text-[13px]" for="profile-name">Name this profile</label>
      <input
        id="profile-name"
        ref="profileNameBox"
        type="text"
        autocomplete="off"
        class="mb-3 px-3 py-2 w-full text-[13px] bg-white dark:bg-neutral-950 border border-black/10 outline-none rounded-[8px] dark:border-white/10"
      />
      <div class="flex gap-2 justify-end">
        <button type="button" @click="closeProfileModal" class="px-3 py-1 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15">Cancel</button>
        <button type="submit" class="px-3 py-1 text-[12px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-[6px]">Create</button>
      </div>
    </form>
  </div>

  {{--
    Settings. Opened by Cmd+, — as the app-menu item in the desktop window
    (craft forwards it as a `craft:settings` event) and as a page chord
    everywhere else.
  --}}
  <dialog data-settings-modal ref="settingsDialogBox" aria-labelledby="harness-settings-title" @click.self="closeSettings" @cancel="cancelSettings" class="m-auto p-0 text-neutral-900 dark:text-neutral-100 bg-white dark:bg-neutral-900 border border-black/10 dark:border-white/15 shadow-xl">
    <div data-settings-shell>
      <nav data-settings-navigation aria-label="Settings sections">
        @foreach(settingsSections as section)
          <button type="button" data-settings-target="{{ section.id }}" aria-label="{{ section.label }}" title="{{ section.label }}" :aria-current="settingsSelection() === '{{ section.id }}' ? 'page' : null" @click="jumpToSettings('{{ section.id }}')">
            <span class="inline-block size-4 {{ section.icon }}" aria-hidden="true"></span>
            <span data-settings-tab-label>{{ section.label }}</span>
          </button>
        @endforeach
      </nav>
      <header data-settings-header class="flex gap-2 items-center">
        <h2 id="harness-settings-title" class="text-sm text-neutral-600 dark:text-neutral-400">Settings</h2>
        <span aria-hidden="true" class="text-neutral-400">/</span>
        <span data-settings-breadcrumb class="flex-1 min-w-0 font-medium text-sm truncate" :text="settingsSelectionLabel()"></span>
        <button type="button" @click="closeSettings" aria-label="Close settings" title="Close settings" class="harness-icon-button">
          <span class="inline-block size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
        </button>
      </header>
      <div data-settings-panel ref="settingsPanelBox">
      <section :hidden="settingsSelection() !== 'appearance'" data-settings-pane>
        <h3 data-settings-section="appearance" tabindex="-1">Appearance</h3>
        <AppearancePicker v-model:value="appearancePreference" label="Appearance" :options="[{ value: 'light', label: 'Light' }, { value: 'dark', label: 'Dark' }, { value: 'auto', label: 'System' }]" />
      </section>
      {{--
        Keyboard. One row per registered command, so the chords the window
        answers are visible and changeable in the same place rather than being
        learned from tooltips. Overrides are this browser's own, which is what
        keeps a loopback origin and a paired remote one independent.
      --}}
      <section :hidden="settingsSelection() !== 'keybindings'" data-settings-pane>
        <h3 data-settings-section="keybindings" tabindex="-1">Keyboard</h3>
        <p class="mb-3 text-[12px] text-neutral-600 dark:text-neutral-300">Shortcuts apply to this browser only. Choose Change, then press the new chord with at least one modifier. Esc keeps the current one.</p>
        <ul data-keybinding-list class="my-0 list-none">
          @foreach(keybindings as binding)
            <li data-keybinding-row="{{ binding.id }}" class="flex flex-wrap gap-3 items-center py-2 border-b border-black/5 dark:border-white/10">
              {{-- 12rem before the controls wrap: a phone gets two lines rather than a squeezed chord. --}}
              <span class="flex-1 min-w-[12rem]">
                <span class="block font-medium text-[13px]">{{ binding.label }}</span>
                <span class="block text-[12px] text-neutral-600 dark:text-neutral-300">{{ binding.description }}</span>
              </span>
              <kbd data-keybinding-chord :text="chordLabel('{{ binding.id }}')" class="shrink-0 px-[6px] py-[1px] font-mono leading-[18px] text-[12px] border border-black/10 rounded-[5px] dark:border-white/15 opacity-70">{{ binding.other }}</kbd>
              <button type="button" data-keybinding-record data-command="{{ binding.id }}" :aria-pressed="recordingKeybinding() === '{{ binding.id }}' ? 'true' : 'false'" @click="recordKeybinding('{{ binding.id }}')" :text="recordingKeybinding() === '{{ binding.id }}' ? 'Press keys…' : 'Change'" class="shrink-0 px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Change</button>
              <button type="button" data-keybinding-reset data-command="{{ binding.id }}" :disabled="!keybindingOverrides()['{{ binding.id }}']" @click="resetKeybinding('{{ binding.id }}')" class="shrink-0 px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15 disabled:opacity-40">Reset</button>
            </li>
          @endforeach
        </ul>
        <p data-keybinding-status role="status" aria-live="polite" class="mt-3 min-h-[1.25rem] text-[12px] text-neutral-600 dark:text-neutral-300" :text="keybindingStatus()"></p>
        <button type="button" data-keybinding-reset-all :disabled="!keybindingOverridden()" @click="resetAllKeybindings" class="px-3 py-1 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15 disabled:opacity-40">Reset all shortcuts</button>
      </section>
      <section :hidden="settingsSelection() !== 'general'" data-settings-pane>
      <h3 data-settings-section="general" tabindex="-1">General</h3>
      <label class="block mb-2 font-medium text-[13px]" for="settings-driver">Agent for new sessions</label>
      <select
        id="settings-driver"
        ref="settingsDriverBox"
        :value="settings().defaultDriver"
        @change="saveDriverChoice"
        class="mb-2 px-3 py-2 w-full text-[13px] bg-white dark:bg-neutral-950 border border-black/10 outline-none rounded-[8px] dark:border-white/10"
      >
        <option value="claude">Claude Code</option>
        <option value="codex">Codex</option>
        <option value="opencode">OpenCode</option>
        <option value="cursor">Cursor</option>
        <option value="grok">Grok</option>
      </select>
      <label class="block mb-2 font-medium text-[13px]" for="settings-follow-up">Follow-up behavior</label>
      <select id="settings-follow-up" :value="followUpPreference()" @change="setFollowUpPreference" class="mb-3 px-3 py-2 w-full text-[13px] bg-white dark:bg-neutral-950 border border-black/10 rounded-[8px] dark:border-white/10">
        <option value="queue">Queue for the next turn</option>
        <option value="steer">Steer the active turn</option>
      </select>
      <p data-host-settings-note class="mb-2 text-[12px] text-neutral-600 dark:text-neutral-300">These apply to every client of this host. Appearance and keyboard shortcuts stay with this browser.</p>
      <p data-settings-error role="alert" :hidden="!settingsSaveError()" :text="settingsSaveError()" class="mb-2 text-[12px] text-red-700 dark:text-red-300"></p>
      </section>
      <section :hidden="settingsSelection() !== 'providers'" data-settings-pane>
      <h3 data-settings-section="providers" tabindex="-1">Providers</h3>
      {{--
        One row per agent CLI, filled by the same `/drivers` probe that
        annotates the pickers. "Log in" runs the CLI's own login flow in the
        workspace terminal. Managed ChatGPT plan accounts are listed below.
      --}}
      <ul class="mb-3" data-agent-list>
        <li data-agent-row="claude" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">Claude Code</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="claude" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
        <li data-agent-row="codex" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">Codex</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="codex" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
        <li data-agent-row="opencode" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">OpenCode</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="opencode" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
        <li data-agent-row="cursor" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">Cursor</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="cursor" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
        <li data-agent-row="grok" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">Grok</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="grok" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
      </ul>
      <ul :if="providerAccounts().length" class="mb-3" aria-label="Project provider accounts">
        <li :for="account in providerAccounts()" :key="account.id" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate" :text="account.name"></span>
          <span class="text-[11px] opacity-60" :text="account.stateText"></span>
        </li>
      </ul>

      </section>
      <section :hidden="settingsSelection() !== 'access'" data-settings-pane>
      <h3 data-settings-section="access" tabindex="-1">Access</h3>
      @if(devices.length)
        <ul class="mb-2">
          @foreach(devices as device)
            <li class="flex gap-2 items-center py-1 text-[13px]">
              <span class="flex-1 truncate">{{ device.name }}</span>
              <button type="button" data-revoke-device data-device-id="{{ device.id }}" @click="revokeDevice" class="px-2 py-0.5 text-[11px] text-red-600 border border-red-600/30 rounded-[6px] dark:text-red-400 dark:border-red-400/30">Revoke</button>
            </li>
          @endforeach
        </ul>
      @else
        <p class="mb-2 text-[12px] opacity-60">No devices are paired.</p>
      @endif
      @if(remoteEnabled)
        <div class="flex gap-2 items-center mb-3">
          <button type="button" data-pair-device @click="startPairing" class="px-3 py-1 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15">Pair a device…</button>
          {{-- The minted code, shown beside the button. Five minutes, once. --}}
          <code data-pair-code :text="pairCode()" class="text-[13px] tracking-widest"></code>
        </div>
      @else
        <p class="mb-3 text-[12px] opacity-60">Pairing needs the server started with <code>--remote</code>.</p>
      @endif

      </section>
      <section :hidden="settingsSelection() !== 'archived'" data-settings-pane>
      <h3 data-settings-section="archived" tabindex="-1">Archived threads</h3>
      @if(archivedThreads.length)
        <ul data-archived-threads class="my-0 list-none">
          @foreach(archivedThreads as archived)
            <li class="flex gap-3 items-center mb-2 text-[13px]" data-archived-thread="{{ archived.id }}">
              <a href="/s/{{ archived.id }}" class="flex-1 min-w-0 truncate">{{ archived.title }}</a>
              <button type="button" @click="organizeThread('restore', {}, {{ archived.id }})" :disabled="threadActionBusy()" class="font-medium underline">Restore</button>
            </li>
          @endforeach
        </ul>
      @else
        <p class="mb-3 text-[12px] text-neutral-600 dark:text-neutral-300">No archived threads in this profile.</p>
      @endif
      </section>
      </div>
    </div>
  </dialog>


</div>


<script client>
  // Native diagnostics, in a script of their own. The main island below uses
  // signals, which makes stx defer it to the mount queue — after the Sidebar
  // component's own mount. This block must run before that, so it stays
  // signal-free and executes at document position.
  //
  // Count native-switcher creations before stx's sidebar controller runs.
  // `<SidebarSpaces>` calls `createSpacesSidebar` itself on mount, so the only
  // way to know the native rail actually bound — rather than merely being
  // *reachable* — is to watch the call.
  try {
    const nativeUI = window.craft?.nativeUI
    if (nativeUI && typeof nativeUI.createSpacesSidebar === 'function') {
      const original = nativeUI.createSpacesSidebar.bind(nativeUI)
      window.__harnessSpacesCalls = 0
      nativeUI.createSpacesSidebar = (options) => {
        window.__harnessSpacesCalls++
        window.__harnessSpacesArg = options
        return original(options)
      }
    }
  }
  catch {}

  // Report what native surfaces this window actually has. In a browser every
  // flag is false and nothing else changes; in a Craft window it tells us
  // whether the host's injection and gesture bridge are really there.
  function reportNativeProbe(payload) {
    navigator.sendBeacon('/native-probe', new Blob([JSON.stringify(payload)], { type: 'application/json' }))
  }

  try {
    const craft = window.craft
    reportNativeProbe({
      seen: true,
      craft: Boolean(craft),
      gestures: typeof craft?.gestures?.onSwipe === 'function',
      nativeUI: Boolean(craft?.nativeUI),
      spacesSidebar: typeof craft?.nativeUI?.createSpacesSidebar === 'function',
      nativeSidebarFlag: Boolean(window.__craftNativeSidebar),
      userAgent: navigator.userAgent.slice(0, 60),
    })
  }
  catch {}

  // Second pass, once the sidebar controller has mounted: did it bind?
  // A raw setTimeout on purpose: useTimeout would make this script
  // signal-bearing, stx would defer it to the mount queue, and the patch
  // above would install after the Sidebar's mount — too late to count.
  setTimeout(() => {
    reportNativeProbe({
      seen: true,
      phase: 'mounted',
      craft: Boolean(window.craft),
      gestures: typeof window.craft?.gestures?.onSwipe === 'function',
      spacesSidebar: typeof window.craft?.nativeUI?.createSpacesSidebar === 'function',
      spacesBound: window.__harnessSpacesCalls ?? 0,
      spacesCount: window.__harnessSpacesArg?.spaces?.length ?? 0,
      activeSpace: window.__harnessSpacesArg?.activeSpace ?? null,
    })
  }, 2500)
</script>

<script client>
  // The live island. Everything above this is static HTML; this wires the
  // socket to the one turn that can still change.
  //
  // A `client` script, not a raw module: server exports arrive through the
  // server -> client bridge (activeSessionId, serverUrl, codecUrl, sinceSeq,
  // spaceTints, activeWorkspaceId, sessionState are seeded as locals — no
  // data-* plumbing), and stx's signals and composables are auto-imported.
  // Because it declares signals, stx wraps it in `window.stx.mount(...)` and
  // returns its top-level declarations as the scope the template bindings
  // (`:for`, `:text`, `:data-*` in the markup above) resolve against.

  // What can change after load, as signals; the template renders them.
  // Turns started on this page. The server-rendered live turn is not here —
  // its new tool calls stream into `ssrTools`.
  const liveTurns = state([])
  const ssrHasResponse = state(initialHasResponse)
  const followingTranscript = state(true)
  const transcriptAnnouncement = state('')
  const responseByTurn = new Map()
  const changedResponses = new Set()
  let transcriptControl
  let transcriptMenuKeyboard
  let transcriptFrame = 0
  const ssrTools = state([])
  // callId -> 'ok' | 'failed'. One map for every row — server-rendered rows
  // read it through their own `:data-tool-state` binding, loop rows through
  // theirs — because tools finish out of order and a row is found by id.
  const toolResults = state({})
  // The diff panel's three regions. Filled by loadDiff, rendered by bindings.
  const diffStatus = state('Loading…')
  const diffFiles = state([])
  const diffPatch = state('')

  const sessionId = Number(activeSessionId) || 0
  const promptScope = sessionId ? `session:${sessionId}`
    : draftProject ? `project:${draftProject.id}` : 'projectless'
  const composerDraft = useLocalStorage(`harness.composer.v1:${activeProfile || 0}:${promptScope}`, null, {
    listenToStorageChanges: false,
  })
  const pendingFirstPrompt = useSessionStorage('harness.pendingPrompt.v2', null)
  const followUps = state(initialFollowUps)
  const steeringMessage = useRef('steeringMessageBox')
  // Host settings, seeded from the render and kept here so a change shows at
  // once rather than after the round trip. They are not in `localStorage`:
  // the phone and the laptop pointed at one host must agree about which agent
  // a new thread starts with, and the browser store cannot give them that.
  const settings = state({ ...hostSettings })
  const settingsSaveError = state('')
  const followUpPreference = derived(() => settings().followUpBehavior)
  const oppositeFollowUp = derived(() => followUpPreference() === 'steer' ? 'queue' : 'steer')
  const steeringPending = derived(() => followUps().entries.some(entry => entry.steering))
  const localFollowUps = useLocalStorage(`harness.follow-ups.v1:${activeProfile || 0}:${promptScope}`, [], { listenToStorageChanges: false })
  const sessionOnline = state(false)
  const sessionConnecting = state(Boolean(sessionId && serverUrl && codecUrl))
  const outboxSending = state('')
  const followUpActions = state(null)
  const queueActionPending = state(false)
  const editingFollowUp = state(null)
  const composerText = state('')
  const composerPlaceholder = derived(() => editingFollowUp() ? 'Edit queued message' : promptPlaceholder)
  const visibleFollowUps = derived(() => {
    const committed = followUps().entries
    return [...committed, ...(Array.isArray(localFollowUps()) ? localFollowUps() : [])
      .filter(entry => !committed.some(item => item.id === entry.id))
      .map(entry => ({ ...entry, local: true }))]
  })

  // The session's own state string, not a boolean: a turn blocked on an
  // approval is still in flight, and collapsing that to "not running" once
  // made a session waiting on *you* look idle. Seeded from the server render;
  // the chip, Send/Stop and the revert buttons all bind to it.
  const uiState = state(sessionState || 'idle')
  const runningTurnId = state(initialResponseTurn)
  const steerableTurn = state(initialSteerable ? initialResponseTurn : 0)
  const canSteer = derived(() => sessionOnline() && uiState() === 'running' && steerableTurn() !== 0 && steerableTurn() === runningTurnId())
  const currentThreadTitle = state(sessionTitle)
  const threadNavigation = state(initialNavigation)
  const threadActionsOpen = state(false)
  const threadActionForm = state('')
  const threadActionBusy = state(false)
  const threadActionError = state('')
  const threadTitleDraft = state('')
  const threadActionsDialog = useRef('threadActionsDialogBox')
  const threadActionsTrigger = useRef('threadActionsTriggerBox')
  const threadWakeTime = useRef('threadWakeTimeBox')
  const threadTitleEdit = useRef('threadTitleEditBox')

  function positionThreadActions() {
    const trigger = threadActionsTrigger.current
    const dialog = threadActionsDialog.current
    if (!trigger || !dialog?.open) return
    const anchor = trigger.getBoundingClientRect()
    const viewport = dialog.ownerDocument.documentElement.clientWidth
    const width = dialog.getBoundingClientRect().width
    dialog.style.setProperty('--thread-menu-top', anchor.bottom + 5 + 'px')
    dialog.style.setProperty('--thread-menu-left', Math.max(8, Math.min(anchor.left, viewport - width - 8)) + 'px')
  }

  function openThreadActions() {
    const dialog = threadActionsDialog.current
    if (!dialog || dialog.open) return
    threadTitleDraft.set(currentThreadTitle())
    threadActionError.set('')
    threadActionForm.set('')
    dialog.showModal()
    threadActionsOpen.set(true)
    positionThreadActions()
  }

  function closeThreadActions(event) {
    event?.preventDefault()
    threadActionsDialog.current?.close()
    threadActionsOpen.set(false)
    threadActionsTrigger.current?.focus()
  }

  function openThreadActionForm(form) {
    if (threadActionForm() === form) {
      threadActionForm.set('')
      return
    }
    threadActionError.set('')
    threadActionForm.set(form)
    if (form === 'rename') void nextTick(() => threadTitleEdit.current?.select())
  }

  useEventListener('resize', positionThreadActions)

  async function organizeThread(action, fields = {}, target = sessionId) {
    if (!target || threadActionBusy()) return
    threadActionBusy.set(true)
    threadActionError.set('')
    try {
      await sendCommand({ type: 'session.organize', sessionId: target, action, ...fields })
      refresh()
    }
    catch (error) {
      if (threadActionsDialog.current?.open) threadActionError.set(error.message)
      else stxAlert(error.message)
      threadActionBusy.set(false)
    }
  }

  function renameThread() {
    void organizeThread('rename', { title: threadTitleDraft() })
  }

  function snoozeThread(hours) {
    const until = hours ? Date.now() + hours * 60 * 60 * 1000 : Date.parse(threadWakeTime.current?.value ?? '')
    if (!Number.isFinite(until) || until <= Date.now()) {
      threadActionError.set('Choose a wake time in the future.')
      return
    }
    void organizeThread('snooze', { until })
  }

  const uiBusy = derived(() => uiState() === 'running' || uiState() === 'awaiting-approval' || uiState() === 'awaiting-input')
  const showResume = derived(() => Boolean(sessionId && !uiBusy() && followUps().held && followUps().entries.length && !steeringPending() && followUps().entries[0]?.steeringIssue !== 'uncertain' && !composerText().trim() && !editingFollowUp()))
  const showSend = derived(() => !showResume() && Boolean(!uiBusy() || composerText().trim() || editingFollowUp()))
  const sendLabel = derived(() => {
    if (editingFollowUp()) return 'Save edit'
    if (canSteer() && followUpPreference() === 'steer') return 'Steer'
    return sessionId && (uiBusy() || !sessionOnline()) ? 'Queue' : 'Send'
  })
  function showQueueSend(entry) {
    return !entry.local && !entry.steering && entry.steeringIssue !== 'uncertain'
      && editingFollowUp()?.id !== entry.id && (!uiBusy() || canSteer())
  }
  function sendQueuedFollowUp(id) {
    if (canSteer()) return followUpActions()?.steerQueued(id, runningTurnId())
    return followUpActions()?.run('send', id)
  }
  function setFollowUpPreference(event) {
    void updateSettings({ followUpBehavior: event.target.value === 'steer' ? 'steer' : 'queue' })
  }

  /**
   * Write host settings, optimistically.
   *
   * The select already shows the new value, so the state moves first and is
   * put back if the host refuses. Leaving the control ahead of the host would
   * have the next reload silently undo the change.
   */
  async function updateSettings(changes) {
    const previous = settings()
    if (Object.entries(changes).every(([key, value]) => previous[key] === value)) return
    settings.set({ ...previous, ...changes })
    settingsSaveError.set('')
    try {
      await sendCommand({ type: 'settings.update', changes })
    }
    catch (error) {
      settings.set(previous)
      settingsSaveError.set(error.message || 'Could not save that setting.')
    }
  }
  // Stop hides the moment it is clicked, before the log settles the turn.
  const stopPressed = state(false)
  function setSessionState(next) {
    batch(() => {
      uiState.set(next)
      stopPressed.set(false)
    })
  }

  const pendingApprovals = state(initialApprovals)
  const pendingApprovalId = state(0)
  const approvalId = derived(() => pendingApprovals()[0]?.approvalId || 0)
  const approvalTool = derived(() => pendingApprovals()[0]?.toolName || '')
  const connectorApproval = derived(() => pendingApprovals()[0]?.connector)
  const connectorOptions = useRef('connectorOptionsBox')
  const primaryConnectorChoices = derived(() => connectorApproval()?.choices.filter(choice => choice.decision !== 'cancelled' && choice.scope === 'once') ?? [])
  const moreConnectorChoices = derived(() => connectorApproval()?.choices.filter(choice => choice.decision === 'cancelled' || choice.scope !== 'once') ?? [])

  const questionForm = state(null)
  const questionCard = useRef('questionCardBox')
  const ssrInputActivity = state(initialInputActivity)
  const inputRequest = derived(() => questionForm() ? questionForm().request() : initialInputs[0])

  const diffOpen = state(false)
  const termOpen = state(false)
  const startPending = state(false)
  const projectBusy = state(false)
  const projectError = state('')
  const visibleProfile = state(activeProfile)
  const desktop = useNativeDesktop()
  const hasFolderPicker = state(typeof desktop()?.dialog?.showOpenDialog === 'function')
  desktop.onReady((craft) => {
    hasFolderPicker.set(typeof craft.dialog?.showOpenDialog === 'function')
  })
  const projectDialog = useRef('projectDialogBox')
  const projectPath = useRef('projectPathBox')
  const projectTrust = useRef('projectTrustBox')
  const sidebarOpen = state(false)
  const sidebarCollapsed = useLocalStorage('harness.sidebarCollapsed', false)
  const desktopSidebar = useMediaQuery('(min-width: 48rem)')
  const storedSidebarWidth = useLocalStorage('harness.sidebarWidth', 250)
  const sidebarWidth = state(boundedSidebarWidth(storedSidebarWidth()))
  let sidebarDrag = null
  const workspaceActionsOpen = state(false)
  const workspaceDetailsOpen = useLocalStorage('harness.workspaceDetailsOpen', true)
  const wideWorkspace = useMediaQuery('(min-width: 75rem)')
  const workspaceActionsToggle = useRef('workspaceActionsToggleBox')
  const sidebarRef = useRef('sidebarBox')
  const sidebarToggleRef = useRef('sidebarToggleBox')
  const promptRef = useRef('promptBox')
  const profileNameRef = useRef('profileNameBox')
  const driverPickerRef = useRef('driverPickerBox')
  const settingsDriverRef = useRef('settingsDriverBox')
  const settingsDialogRef = useRef('settingsDialogBox')
  const settingsPanel = useRef('settingsPanelBox')
  const settingsSelection = state(initialSettingsSection || 'general')
  const settingsSelectionLabel = derived(() => settingsSections.find(section => section.id === settingsSelection())?.label || 'General')

  // The keyboard registry's live state. `keybindingTable` is null until the
  // shared module loads; the rows fall back to the server-rendered defaults
  // until it does, so the pane never paints a raw `Mod+K`.
  const keybindingTable = state(null)
  const keybindingOverrides = derived(() => keybindingTable()?.overrides || {})
  const keybindingOverridden = derived(() => Object.keys(keybindingOverrides()).length > 0)
  const recordingKeybinding = state('')
  const keybindingStatus = state('')
  // Which spelling of a chord this keyboard uses. `userAgentData` first — it
  // is the only one of the three that is not deprecated — then the two older
  // fields, because Safari and WebKit still answer only those.
  const appleKeyboard = /mac|iphone|ipad/i.test(navigator.userAgentData?.platform || navigator.platform || navigator.userAgent)
  let keyboard = null
  let keybindingStore = null

  function keybindingRow(id) {
    return keybindings.find(binding => binding.id === id) || null
  }

  function chordLabel(id) {
    const row = keybindingRow(id)
    const bound = keybindingTable()?.bindings?.[id]
    if (keyboard && bound && bound !== row?.chord) return keyboard.formatChordText(bound, appleKeyboard)
    return (appleKeyboard ? row?.apple : row?.other) || ''
  }

  const settingsShortcutTitle = derived(() => `Settings (${chordLabel('settings.open')})`)

  // What a control advertising this chord should put in `aria-keyshortcuts`.
  // Rebinding has to move the announced chord too, or assistive technology
  // keeps reading out a key that no longer does anything.
  function shortcutKeys(id) {
    const row = keybindingRow(id)
    const bound = keybindingTable()?.bindings?.[id]
    if (keyboard && bound && bound !== row?.chord) {
      const chord = keyboard.parseChord(bound)
      if (chord) return keyboard.ariaKeyshortcuts(chord)
    }
    return row?.aria || ''
  }

  function matchedCommand(event) {
    const table = keybindingTable()
    return keyboard && table ? keyboard.matchCommand(table.bindings, event) : null
  }

  // Load the registry once, and report anything the stored overrides lost. A
  // preference that silently reverts reads as a bug in the setting, so the
  // pane says which binding it could not keep.
  async function loadKeybindings() {
    if (!codecUrl || keybindingStore) return
    try {
      const module = await import(codecUrl)
      keybindingStore = module.createKeybindingStore(localStorage)
      keyboard = module
      const resolved = keybindingStore.read()
      keybindingTable.set(resolved)
      if (resolved.rejected.length) {
        const names = resolved.rejected.map(entry => keybindingRow(entry.id)?.label || entry.id)
        keybindingStatus.set(`Restored the default shortcut for ${names.join(', ')}.`)
      }
      // Announced on the document, because "the chords work now" is not
      // visible on screen: a test, or a person watching, otherwise cannot
      // tell a chord that did nothing from one that arrived too early.
      document.documentElement.dataset.harnessKeyboard = 'ready'
    }
    catch {
      // No registry means no rebinding and no window chords; Escape and every
      // on-screen control still work.
    }
  }

  // Started here rather than on mount: the import is the only thing between a
  // painted page and a working chord, so it begins as early as the island can
  // begin anything.
  void loadKeybindings()

  function recordKeybinding(id) {
    if (!keybindingStore) return
    if (recordingKeybinding() === id) {
      recordingKeybinding.set('')
      keybindingStatus.set('')
      return
    }
    recordingKeybinding.set(id)
    keybindingStatus.set(`Press the new shortcut for ${keybindingRow(id)?.label || id}.`)
  }

  // Captured from the window handler, ahead of its dialog guard, so the chord
  // being recorded cannot also trigger the command it is being bound to.
  function captureKeybinding(event) {
    const id = recordingKeybinding()
    if (!id || !keybindingStore || !keyboard) return
    if (event.key === 'Escape') {
      recordingKeybinding.set('')
      keybindingStatus.set('Kept the current shortcut.')
      return
    }
    const chord = keyboard.chordFromEvent(event)
    if (!chord) {
      // A modifier on its own keeps waiting — it is half of a chord. Anything
      // else without a modifier is refused: a bare key would fire while
      // typing in the composer.
      if (!/^(Shift|Meta|Control|Alt|AltGraph|CapsLock|Dead|Unidentified)$/.test(event.key))
        keybindingStatus.set(appleKeyboard ? 'Hold ⌘, ⌃, or ⌥ and press a key.' : 'Hold Ctrl or Alt and press a key.')
      return
    }
    const text = keyboard.chordText(chord)
    const result = keybindingStore.save(id, text)
    const shown = keyboard.formatChordText(text, appleKeyboard)
    if (result.ok) {
      keybindingTable.set(result.resolved)
      recordingKeybinding.set('')
      keybindingStatus.set(`${keybindingRow(id)?.label || id} is now ${shown}.`)
      return
    }
    // Recording stays open on a refusal so the next press is another attempt
    // rather than a reopened row, and the command keeps the chord it had.
    if (result.reason === 'conflict') keybindingStatus.set(`${shown} already belongs to ${result.command.label}. Pick another chord.`)
    else keybindingStatus.set(appleKeyboard ? 'Hold ⌘, ⌃, or ⌥ and press a key.' : 'Hold Ctrl or Alt and press a key.')
  }

  function resetKeybinding(id) {
    if (!keybindingStore) return
    keybindingTable.set(keybindingStore.reset(id))
    recordingKeybinding.set('')
    keybindingStatus.set(`${keybindingRow(id)?.label || id} is back to ${chordLabel(id)}.`)
  }

  function resetAllKeybindings() {
    if (!keybindingStore) return
    keybindingTable.set(keybindingStore.resetAll())
    recordingKeybinding.set('')
    keybindingStatus.set('Every shortcut is back to its default.')
  }
  const colorMode = useColorMode()
  const appearancePreference = state(colorMode.preference)
  const unsubscribeAppearance = colorMode.subscribe((_mode, preference) => appearancePreference.set(preference))
  onDestroy(unsubscribeAppearance)
  effect(() => {
    const preference = appearancePreference()
    if (preference !== colorMode.preference) colorMode.set(preference)
    const nativeWindow = desktop()?.window
    if (typeof nativeWindow?.setAppearance === 'function')
      void nativeWindow.setAppearance(preference === 'auto' ? 'system' : preference).catch(() => {})
  })
  const threadSearchDialog = useRef('threadSearchDialogBox')
  const threadSearchInput = useRef('threadSearchInputBox')
  const threadSearchList = useRef('threadSearchListBox')
  const threadSearchResults = state([])
  const threadSearchStatus = state('')
  const threadSearchIndex = state(0)
  const selectedThreadSearchId = derived(() => {
    const id = threadSearchResults()[threadSearchIndex()]?.id
    return id === undefined ? undefined : `thread-search-result-${id}`
  })
  const transcriptRef = useRef('transcriptBox')
  const transcriptFindInput = useRef('transcriptFindInputBox')
  const transcriptFindOpen = state(false)
  const transcriptFindQuery = state('')
  const transcriptFindIndex = state(-1)
  const transcriptFindCount = state(0)
  const transcriptFindStatus = derived(() => transcriptFindQuery().trim()
    ? (transcriptFindIndex() + 1) + '/' + transcriptFindCount()
    : '')
  let transcriptFinder = null
  let transcriptFindTrigger = null

  function openTranscriptFind(trigger) {
    if (!sessionId) return
    if (!transcriptFindOpen()) {
      transcriptFindTrigger = trigger?.matches?.('input, textarea, button, a[href], [tabindex]') ? trigger : threadActionsTrigger.current
      transcriptFindOpen.set(true)
    }
    void nextTick(() => {
      transcriptFindInput.current?.focus()
      transcriptFindInput.current?.select()
    })
  }

  function findFromThreadActions() {
    closeThreadActions()
    openTranscriptFind()
  }

  async function findTranscriptText(event) {
    if (event.isComposing) return
    const query = event.currentTarget.value
    transcriptFindQuery.set(query)
    if (!codecUrl || !transcriptRef.current) return
    const { createTranscriptFinder } = await import(codecUrl)
    if (!transcriptFindOpen() || query !== transcriptFindQuery()) return
    transcriptFinder ??= createTranscriptFinder(transcriptRef.current, (index, count) => {
      transcriptFindIndex.set(index)
      transcriptFindCount.set(count)
    })
    transcriptFinder.search(query)
  }

  function stepTranscriptFind(direction) {
    transcriptFinder?.step(direction)
  }

  function closeTranscriptFind() {
    transcriptFinder?.close()
    transcriptFinder = null
    transcriptFindOpen.set(false)
    transcriptFindQuery.set('')
    transcriptFindIndex.set(-1)
    transcriptFindCount.set(0)
    transcriptFindTrigger?.focus()
    transcriptFindTrigger = null
  }

  function transcriptFindKeydown(event) {
    if (event.isComposing || event.keyCode === 229 || event.key !== 'Enter') return
    event.preventDefault()
    stepTranscriptFind(event.shiftKey ? -1 : 1)
  }

  onDestroy(() => transcriptFinder?.close())

  const termScreenRef = useRef('termScreenBox')
  const termHostRef = useRef('termHostBox')
  const termMetricRef = useRef('termMetricBox')

  function toggleSidebar() {
    if (desktopSidebar()) {
      sidebarCollapsed.set(!sidebarCollapsed())
      if (sidebarCollapsed()) void nextTick(() => sidebarToggleRef.current?.focus())
      else void nextTick(() => sidebarRef.current?.focus())
      return
    }
    if (sidebarOpen()) closeSidebar()
    else openSidebar()
  }

  function openSidebar() {
    workspaceActionsOpen.set(false)
    sidebarOpen.set(true)
    void nextTick(() => sidebarRef.current?.focus())
  }

  function closeSidebar() {
    sidebarOpen.set(false)
    void nextTick(() => sidebarToggleRef.current?.focus())
  }

  function boundedSidebarWidth(width) {
    return Number.isFinite(width) ? Math.min(416, Math.max(192, Math.round(width))) : 250
  }

  function resizeSidebarByKey(event) {
    const step = event.shiftKey ? 40 : 12
    const widths = {
      ArrowLeft: sidebarWidth() - step,
      ArrowRight: sidebarWidth() + step,
      Home: 192,
      End: 416,
    }
    if (!Object.hasOwn(widths, event.key)) return
    event.preventDefault()
    const width = boundedSidebarWidth(widths[event.key])
    sidebarWidth.set(width)
    storedSidebarWidth.set(width)
  }

  function beginSidebarResize(event) {
    if (event.button !== 0) return
    event.preventDefault()
    event.currentTarget.focus()
    event.currentTarget.setPointerCapture(event.pointerId)
    sidebarDrag = { pointerId: event.pointerId, x: event.clientX, width: sidebarWidth() }
  }

  function moveSidebarResize(event) {
    if (sidebarDrag?.pointerId !== event.pointerId) return
    sidebarWidth.set(boundedSidebarWidth(sidebarDrag.width + event.clientX - sidebarDrag.x))
  }

  function endSidebarResize(event) {
    if (sidebarDrag?.pointerId !== event.pointerId) return
    storedSidebarWidth.set(sidebarWidth())
    sidebarDrag = null
  }

  function cancelSidebarResize(event) {
    if (sidebarDrag?.pointerId !== event.pointerId) return
    sidebarWidth.set(sidebarDrag.width)
    sidebarDrag = null
  }
  function toggleWorkspaceActions() {
    if (wideWorkspace()) workspaceDetailsOpen.set(!workspaceDetailsOpen())
    else workspaceActionsOpen.update(open => !open)
  }

  function closeWorkspaceActions() {
    if (!workspaceActionsOpen()) return
    workspaceActionsOpen.set(false)
    workspaceActionsToggle.current?.focus()
  }

  // The "name this profile" form. Replaces window.prompt: the name arrives
  // through a small form the page owns, so it can be styled and cancelled
  // like everything else.
  const profileModalOpen = state(false)
  // A freshly minted pairing code, shown beside the button that minted it.
  const pairCode = state('')
  // The checkpoint currently being restored; its button reads this for its
  // label and disabled state.
  const revertingId = state(0)

  // A global shortcut, so harness is reachable without finding its window.
  //
  // Registered from the page rather than from the Zig host because the handler
  // is page logic — focus, then put the cursor in the composer. In a browser
  // `window.craft` is absent and this is skipped; a browser cannot claim a
  // system-wide key anyway.
  try {
    const shortcuts = window.craft?.shortcuts
    if (shortcuts) {
      // Registration and the handler are separate: the host owns the hotkey and
      // delivers a `craft:shortcut` event carrying the id it was registered
      // under, so the page does not hold a callback the OS knows nothing about.
      shortcuts.register('harness.summon', 'Cmd+Shift+H')
      shortcuts.on?.((event) => {
        if ((event?.id ?? event) !== 'harness.summon') return
        window.craft?.window?.focus?.()
        // Someone who summoned the window deliberately should land ready to
        // type, not hunting for the input.
        promptRef.current?.focus()
      })
    }
  }
  catch { /* a host without the shortcuts bridge is not an error */ }

  // Paint the native window in the active profile's colour.
  //
  // This is the half of the Arc idea AppKit owns: the web sidebar takes its
  // tint through `<Sidebar :spaces>`, but the titlebar and the window behind it
  // do not, so a tinted sidebar used to sit inside grey chrome. In a browser
  // `window.craft` is absent and this is simply skipped.
  //
  // It could not have worked before craft v0.0.62 regardless —
  // `setBackgroundColor` was one of the twenty window actions whose payload the
  // bridge discarded.
  function paintWindow(spaceId) {
    const tint = (spaceTints || {})[spaceId]
    // No tint means the profile never chose one; leaving the window alone is
    // better than inventing a colour it did not ask for.
    if (!tint) return
    try { window.craft?.window?.setBackgroundColor?.(tint) }
    catch { /* a host without the window bridge is not an error */ }
  }

  paintWindow(document.querySelector('[data-space][data-space-active="true"]')?.dataset.spaceId)

  // The sidebar's own controls. `<Sidebar>` renders "New Session" and the
  // space "+" and emits when they are pressed; nothing was listening, so both
  // were buttons that did nothing.
  //
  // These dispatch over the socket like every other command, then reload —
  // the sidebar is server-rendered, and re-rendering it here would be a second
  // implementation of what the server already does.
  // Resolved when the server reports a restore finished. A list because the
  // socket handler is registered separately from the button that is waiting.
  const revertWaiters = []

  // Reverting throws away work on disk, so it asks first. The confirmation
  // names what will happen rather than saying "are you sure": the destructive
  // part is the files created since, which is exactly what people forget.
  // Each revert button calls this through its own @click, with its checkpoint.
  async function revertTurn(checkpointId) {
    if (!checkpointId || !sessionId) return
    const confirmed = await stxConfirm(
      'Put the workspace back to before this turn? Files the agent created since will be deleted.',
      { type: 'warning', confirmText: 'Revert', cancelText: 'Keep my files' },
    )
    if (!confirmed) return

    revertingId.set(checkpointId)

    // Waits for `checkpoint.restored`, not for the dispatch ack.
    // `checkpoint.reverted` only means the revert was accepted; the git work
    // runs after it, so reloading on the ack showed a half-restored tree —
    // files rewritten, files the agent added not yet removed.
    const restored = new Promise((resolve) => {
      revertWaiters.push(resolve)
      // A revert that never reports back should still let go of the page.
      useTimeout(resolve, 15000)
    })

    try {
      await sendCommand({ type: 'session.checkpoint.revert', sessionId, checkpointId })
    }
    catch (error) {
      revertingId.set(0)
      stxAlert(error.message)
      return
    }
    await restored

    // Reloaded rather than patched: the diff, the turn list and the workspace
    // have all moved, and re-deriving that here would be a second renderer.
    refresh()
  }

  // Set by the transcript's socket once it opens, so a sidebar command reuses
  // it rather than opening a second connection to the same server.
  let liveSocket = null
  let disconnectLiveSession = () => {}
  let reconnectLiveSession = () => {}
  onUnmounted(() => disconnectLiveSession())
  useEventListener('online', () => reconnectLiveSession())

  /**
   * Dispatch a command that is not about the open session.
   *
   * Reuses the transcript's socket when there is one. On the index page there
   * is no session and therefore no socket, so this opens a short-lived one —
   * the alternative is keeping a connection open on a page that never streams.
   *
   * Resolves on the server's ack so a caller can reload without outrunning the
   * write.
   */
  async function sendCommand(command, commandId) {
    const { sendBrowserCommand } = await import(codecUrl)
    return sendBrowserCommand(serverUrl, {
      id: commandId ?? newCommandId(),
      at: Date.now(),
      command,
    }, liveSocket)
  }

  function newCommandId() {
    return `web_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`
  }

  let projectPickerTrigger = null

  function openProjectPicker(event) {
    const dialog = projectDialog.current
    if (!dialog || dialog.open) return
    projectPickerTrigger = workspaceActionsOpen() ? workspaceActionsToggle.current : event?.currentTarget ?? null
    workspaceActionsOpen.set(false)
    projectError.set('')
    if (projectPath.current) projectPath.current.value = ''
    if (projectTrust.current) projectTrust.current.checked = false
    dialog.showModal()
    projectPath.current?.focus()
  }

  function closeProjectPicker() {
    projectDialog.current?.close()
    projectPickerTrigger?.focus()
    projectPickerTrigger = null
  }

  function cancelProjectPicker(event) {
    event.preventDefault()
    if (!projectBusy()) closeProjectPicker()
  }

  async function browseProject() {
    const craft = desktop()
    if (typeof craft?.dialog?.showOpenDialog !== 'function') return
    try {
      const selection = await craft.dialog.showOpenDialog({
        title: 'Choose a project folder',
        properties: ['openDirectory'],
      })
      const path = selection?.filePaths?.[0]
      if (!selection?.canceled && typeof path === 'string' && projectPath.current)
        projectPath.current.value = path
    }
    catch {
      projectError.set('Could not open the folder picker. You can enter the path above.')
    }
  }

  async function registerProject() {
    const path = projectPath.current?.value
    if (!path?.trim() || projectBusy()) return
    const id = newCommandId()
    projectBusy.set(true)
    projectError.set('')
    try {
      const profileId = Number(visibleProfile()) || undefined
      await sendCommand({
        type: 'workspace.register',
        ...(profileId ? { profileId } : {}),
        path,
        trusted: projectTrust.current?.checked === true,
      }, id)
      closeProjectPicker()
      navigate(`/?workspace=${derivedSessionId(id)}`)
    }
    catch (error) {
      projectError.set(error.message || 'Could not add the folder.')
    }
    finally {
      projectBusy.set(false)
    }
  }

  async function trustProject() {
    if (!draftProject || projectBusy()) return
    projectBusy.set(true)
    try {
      await sendCommand({ type: 'workspace.trust', workspaceId: draftProject.id, trusted: true })
      refresh()
    }
    catch (error) {
      stxAlert(error.message || 'Could not trust the folder.')
    }
    finally {
      projectBusy.set(false)
    }
  }

  async function promoteScratchProject() {
    if (!activeScratchSession || projectBusy()) return
    projectBusy.set(true)
    try {
      await sendCommand({ type: 'workspace.promote', workspaceId: Number(activeWorkspaceId) })
      refresh()
    }
    catch (error) {
      stxAlert(error.message || 'Could not turn this folder into a project.')
    }
    finally {
      projectBusy.set(false)
    }
  }

  function chooseProject(event) {
    if (event.currentTarget.value === 'none') {
      startWithoutProject()
      return
    }
    const id = Number(event.currentTarget.value)
    if (id) navigate(`/?workspace=${id}`)
  }

  function startWithoutProject() {
    const profile = Number(activeProfile)
    navigate(profile ? `/?profile=${profile}&project=none` : '/?project=none')
  }

  function openDraft(profileId) {
    const project = String(profileId) === String(activeProfile) ? draftProject : profileProjects[String(profileId)]
    if (project) navigate(`/?workspace=${project.id}`)
    else openProjectPicker()
  }

  useEventListener('spaceAction', (event) => {
    const { spaceId, role } = event.detail || {}
    if (role !== 'action' || !spaceId) return
    visibleProfile.set(spaceId)
    openDraft(spaceId)
  }, { target: document })

  function openProfileModal() {
    profileModalOpen.set(true)
    // Focus after the binding has shown the form.
    void nextTick(() => profileNameRef.current?.focus())
  }

  useEventListener('spaceAdd', openProfileModal, { target: document })

  function closeProfileModal() {
    profileModalOpen.set(false)
  }

  // Settings. The one setting is device-local — which agent this machine
  // starts sessions with — so it lives in localStorage, not the event log:
  // a preference of this keyboard, not a fact about the project.
  const KNOWN_DRIVERS = ['claude', 'codex', 'opencode', 'cursor', 'grok']
  const DRIVER_LABELS = { claude: 'Claude Code', codex: 'Codex', opencode: 'OpenCode', cursor: 'Cursor', grok: 'Grok' }
  const providerAccounts = state([])
  const activeDriverValue = sessionProviderInstanceId === null ? sessionDriver : `${sessionDriver}:${sessionProviderInstanceId}`

  function driverStateLabel(status, version) {
    if (status === 'ready') return version ? `ready · ${version}` : 'ready'
    if (status === 'unauthenticated') return 'signed out'
    if (status === 'unavailable') return 'not installed'
    if (status === 'deleted') return 'account unavailable'
    return 'check failed'
  }

  function agentChoice(value) {
    const [driverKind, accountId] = value.split(':')
    return {
      driverKind,
      ...(accountId ? { providerInstanceId: Number(accountId) } : {}),
    }
  }

  // Each CLI's own login flow, run in the workspace terminal. The CLIs hold
  // their credentials; harness only starts the conversation.
  const LOGIN_COMMANDS = {
    claude: 'claude auth login',
    codex: 'codex login',
    opencode: 'opencode auth login',
    cursor: 'cursor-agent login',
    grok: 'grok login',
  }

  // Live feedback on what each driver can actually do right now: the server
  // probes the CLIs (installed? signed in? version?) and both pickers carry
  // the answer in their option labels, with unusable agents disabled — a
  // driver you cannot run should not be one click from a dead session.
  async function annotateDriverPickers() {
    const workspace = Number(activeWorkspaceId) || draftProject?.id || 0
    const response = await fetch(`/drivers?workspace=${workspace}`).catch(() => null)
    if (!response?.ok) return
    const { drivers, accounts = [] } = await response.json()
    if (sessionProviderInstanceId !== null && !accounts.some(account => account.id === sessionProviderInstanceId)) {
      accounts.push({ id: sessionProviderInstanceId, kind: sessionDriver, name: 'Saved account', status: 'deleted' })
    }
    const picker = driverPickerRef.current
    const selection = picker?.value || activeDriverValue || defaultDriver()
    providerAccounts.set(accounts.map(account => {
      const managed = account.auth === 'chatgpt'
      const stateText = managed && account.status === 'unauthenticated'
        ? 'Reconnect on host'
        : driverStateLabel(account.status, account.version)
      const provider = managed ? 'ChatGPT plan' : DRIVER_LABELS[account.kind] ?? account.kind
      const name = `${provider} · ${account.name}`
      return { ...account, name, stateText, label: `${name} · ${stateText}`, value: `${account.kind}:${account.id}` }
    }))
    void nextTick(() => {
      if (picker) picker.value = selection
    })
    for (const info of drivers) {
      const stateText = driverStateLabel(info.status, info.version)
      for (const boxName of ['driverPickerBox', 'settingsDriverBox']) {
        const option = useRef(boxName).current?.querySelector(`option[value="${info.kind}"]`)
        if (!option) continue
        const label = DRIVER_LABELS[info.kind] ?? info.kind
        if (info.status === 'ready') {
          option.disabled = false
          option.textContent = info.version ? `${label} · ${info.version}` : label
        }
        else {
          option.disabled = true
          option.textContent = `${label} · ${stateText}`
        }
      }

      // Use the CLI's login action only when the default account is signed out.
      const row = document.querySelector(`[data-agent-row="${info.kind}"]`)
      if (row) {
        row.querySelector('[data-agent-state]').textContent = stateText
        const login = row.querySelector('[data-agent-login]')
        login.hidden = info.status !== 'unauthenticated'
      }
    }
  }

  // Log in = run the CLI's own login flow where it expects to run: a
  // terminal. Opens the workspace terminal and types the command; the CLI
  // takes it from there (device codes, browser hand-offs, whatever it does).
  function loginAgent(event) {
    const kind = event.currentTarget.dataset.kind
    const command = LOGIN_COMMANDS[kind]
    if (!command) return
    if (!Number(activeWorkspaceId)) {
      stxAlert(`Open a workspace first — the login runs in its terminal. Or run \`${command}\` in any terminal yourself.`)
      return
    }
    closeSettings()
    if (!termOpen()) toggleTerminal()
    // Buffered by termSend until the PTY binds, so this works on a terminal
    // that is still opening. A paired phone gets the server's local-only
    // refusal instead, which names the command to run by hand.
    termSend(`${command}\r`)
  }

  // Switching agents mid-session gets a new session rather than a silent
  // handover: a different CLI cannot resume this conversation, so the honest
  // move is a fresh start in the same workspace, said out loud.
  async function driverPicked(event) {
    const picker = event.currentTarget
    const value = picker.value
    const choice = agentChoice(value)
    if (!activeSessionId) {
      if (choice.providerInstanceId === undefined) void updateSettings({ defaultDriver: choice.driverKind })
      return
    }
    if (value === activeDriverValue) return
    const label = providerAccounts().find(account => account.value === value)?.name || DRIVER_LABELS[choice.driverKind]
    if (await stxConfirm(`Start a new session with ${label} in this workspace?`)) {
      try {
        const commandId = newCommandId()
        if (activeScratchSession) {
          await sendCommand({ type: 'session.scratch.create', profileId: Number(activeProfile), driverKind: choice.driverKind, label: '' }, commandId)
        }
        else {
          await sendCommand({ type: 'session.create', workspaceId: Number(activeWorkspaceId), ...choice }, commandId)
        }
        navigate(`/s/${derivedSessionId(commandId)}`)
      }
      catch (error) {
        picker.value = activeDriverValue
        stxAlert(error.message)
      }
    }
    else {
      picker.value = activeDriverValue
    }
  }

  // After mount: the picker shows this session's driver (or the default when
  // no session is open), then the probe results land in the labels. A prompt
  // left by type-to-start sends itself once the socket can carry it.
  requestAnimationFrame(() => {
    const picker = driverPickerRef.current
    if (picker) picker.value = activeDriverValue || defaultDriver()
    annotateDriverPickers()

    restorePrompt()
  })

  function defaultDriver() {
    const stored = settings().defaultDriver
    return KNOWN_DRIVERS.includes(stored) ? stored : 'claude'
  }

  let settingsTrigger = null

  function settingsLocation() {
    return codecUrl ? import(codecUrl).catch(() => undefined) : Promise.resolve(undefined)
  }

  function focusSettingsHeading() {
    void nextTick(() => {
      if (settingsPanel.current) settingsPanel.current.scrollTop = 0
      const heading = settingsDialogRef.current?.querySelector(`[data-settings-section="${settingsSelection()}"]`)
      heading?.focus({ preventScroll: true })
    })
  }

  function openSettings(event, section = 'general', updateLocation = true) {
    const dialog = settingsDialogRef.current
    if (!dialog || dialog.open) return
    settingsTrigger = event?.currentTarget?.matches?.('[data-account-button]') ? event.currentTarget : null
    workspaceActionsOpen.set(false)
    settingsSelection.set(section)
    dialog.showModal()
    if (updateLocation)
      void settingsLocation().then(location => dialog.open && location?.showSettingsSection(section))
    annotateDriverPickers()
    const box = settingsDriverRef.current
    if (box) box.value = defaultDriver()
    focusSettingsHeading()
  }

  function jumpToSettings(section) {
    settingsSelection.set(section)
    void settingsLocation().then(location => settingsDialogRef.current?.open && settingsSelection() === section && location?.showSettingsSection(section))
    focusSettingsHeading()
  }

  function hideSettings() {
    // A row left recording would otherwise keep capturing after the sheet is
    // gone, and the next chord pressed in the workspace would be swallowed
    // into a rebind nobody asked for.
    recordingKeybinding.set('')
    keybindingStatus.set('')
    settingsDialogRef.current?.close()
    settingsTrigger?.focus()
    settingsTrigger = null
  }

  function closeSettings() {
    hideSettings()
    void settingsLocation().then(location => location?.leaveSettings())
  }

  function cancelSettings(event) {
    event.preventDefault()
    closeSettings()
  }

  useEventListener('popstate', () => {
    void settingsLocation().then((location) => {
      const section = location?.currentSettingsSection()
      if (!section) {
        if (settingsDialogRef.current?.open) hideSettings()
        return
      }
      if (!settingsDialogRef.current?.open) openSettings(undefined, section, false)
      else {
        settingsSelection.set(section)
        focusSettingsHeading()
      }
    })
  })

  onMount(() => {
    if (initialSettingsSection) openSettings(undefined, initialSettingsSection, false)
  })

  let threadSearchTimer = null
  let threadSearchRequest = null
  let threadSearchTrigger = null

  function openThreadSearch(event) {
    const dialog = threadSearchDialog.current
    if (!dialog || dialog.open || !Number(activeProfile)) return
    threadSearchTrigger = event?.currentTarget?.matches?.('[data-thread-search-toggle], [data-nav-search]') ? event.currentTarget : null
    workspaceActionsOpen.set(false)
    dialog.showModal()
    threadSearchInput.current?.focus()
  }

  function closeThreadSearch() {
    threadSearchTimer?.stop()
    threadSearchRequest?.abort()
    threadSearchResults.set([])
    threadSearchStatus.set('')
    if (threadSearchInput.current) threadSearchInput.current.value = ''
    threadSearchDialog.current?.close()
    threadSearchTrigger?.focus()
    threadSearchTrigger = null
  }

  function cancelThreadSearch(event) {
    event.preventDefault()
    closeThreadSearch()
  }

  function queueThreadSearch(event) {
    if (event.isComposing) return
    const query = event.currentTarget.value.trim()
    threadSearchTimer?.stop()
    threadSearchRequest?.abort()
    threadSearchResults.set([])
    threadSearchIndex.set(0)
    threadSearchStatus.set('')
    if (!query) return
    threadSearchTimer = useTimeout(() => searchThreadResults(query), 160)
  }

  async function searchThreadResults(query) {
    const request = new AbortController()
    threadSearchRequest = request
    threadSearchStatus.set('Searching…')
    try {
      const params = new URLSearchParams({ profile: String(activeProfile), q: query })
      const response = await fetch(`/threads/search?${params}`, { signal: request.signal })
      if (!response.ok) throw new Error('Thread search failed.')
      const { results } = await response.json()
      if (request.signal.aborted) return
      threadSearchResults.set(results)
      threadSearchStatus.set(results.length ? '' : 'No matching threads.')
    }
    catch {
      if (!request.signal.aborted) threadSearchStatus.set('Could not search threads. Try again.')
    }
  }

  function chooseThreadSearchResult(result) {
    if (!result) return
    closeThreadSearch()
    navigate(`/s/${result.id}${result.turnId ? `#turn-${result.turnId}` : ''}`)
  }

  function threadSearchKeydown(event) {
    if (event.isComposing) return
    if (event.key === 'Escape') {
      event.preventDefault()
      event.stopPropagation()
      closeThreadSearch()
      return
    }
    const results = threadSearchResults()
    if (results.length === 0) return
    if (event.key === 'Enter') {
      event.preventDefault()
      chooseThreadSearchResult(results[threadSearchIndex()])
      return
    }
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return
    event.preventDefault()
    const step = event.key === 'ArrowDown' ? 1 : -1
    const index = (threadSearchIndex() + step + results.length) % results.length
    threadSearchIndex.set(index)
    threadSearchList.current?.children[index]?.scrollIntoView({ block: 'nearest' })
  }

  function saveDriverChoice() {
    const box = settingsDriverRef.current
    if (box) void updateSettings({ defaultDriver: box.value })
  }

  // The desktop app menu's Settings… item (Cmd+,): craft evaluates this
  // event into the page, so the menu opens the same modal the chord does.
  useEventListener('craft:settings', openSettings, { target: window })

  // The desktop menu bar, declared by the page — the page is what knows
  // what harness can do. craft builds the native NSMenu from this: role
  // items (copy, paste, minimize…) act through the responder chain exactly
  // like a nib-built menu — the Edit roles are what make Cmd+C/V/X work in
  // the webview at all — and id items come back as `craft:menu:action`
  // events, routed below. In a plain browser there is no bridge and the
  // browser's own menus apply.
  if (window.craft?.menu?.set) {
    window.craft.menu.set({ menus: [
      { label: 'harness', items: [
        { id: 'about', label: 'About harness', role: 'about' },
        { separator: true },
        { id: 'settings', label: 'Settings…', shortcut: 'cmd+,' },
        { separator: true },
        { id: 'hide', label: 'Hide harness', role: 'hide', shortcut: 'cmd+h' },
        { id: 'hide-others', label: 'Hide Others', role: 'hideOthers', shortcut: 'cmd+alt+h' },
        { id: 'show-all', label: 'Show All', role: 'showAll' },
        { separator: true },
        { id: 'quit', label: 'Quit harness', role: 'quit', shortcut: 'cmd+q' },
      ] },
      { label: 'File', items: [
        { id: 'new-session', label: 'New Session', shortcut: 'cmd+n' },
        { separator: true },
        { id: 'close-window', label: 'Close Window', role: 'close', shortcut: 'cmd+w' },
      ] },
      { label: 'Edit', items: [
        { id: 'undo', label: 'Undo', role: 'undo', shortcut: 'cmd+z' },
        { id: 'redo', label: 'Redo', role: 'redo', shortcut: 'cmd+shift+z' },
        { separator: true },
        { id: 'cut', label: 'Cut', role: 'cut', shortcut: 'cmd+x' },
        { id: 'copy', label: 'Copy', role: 'copy', shortcut: 'cmd+c' },
        { id: 'paste', label: 'Paste', role: 'paste', shortcut: 'cmd+v' },
        { id: 'select-all', label: 'Select All', role: 'selectAll', shortcut: 'cmd+a' },
      ] },
      { label: 'View', items: [
        { id: 'toggle-terminal', label: 'Toggle Terminal', shortcut: 'ctrl+`' },
        { separator: true },
        { id: 'reload', label: 'Reload', role: 'reload', shortcut: 'cmd+r' },
      ] },
      { label: 'Window', items: [
        { id: 'minimize', label: 'Minimize', role: 'minimize', shortcut: 'cmd+m' },
        { id: 'zoom', label: 'Zoom', role: 'zoom' },
        { separator: true },
        { id: 'front', label: 'Bring All to Front', role: 'front' },
      ] },
    ] })
  }

  useEventListener('craft:menu:action', (event) => {
    const id = event.detail?.id
    if (id === 'settings') openSettings()
    else if (id === 'new-session') openDraft(visibleProfile())
    else if (id === 'toggle-terminal') toggleTerminal()
  }, { target: window })

  // Access: the devices paired with this server. Revoking dispatches the
  // same command the CLI uses; the list is server-rendered, so refresh.
  async function revokeDevice(event) {
    const deviceId = event.currentTarget.dataset.deviceId
    if (!deviceId) return
    const device = event.currentTarget.closest('li')
    if (!(await stxConfirm(`Revoke ${device?.querySelector('span')?.textContent ?? deviceId}? Its socket drops immediately.`))) return
    try {
      await sendCommand({ type: 'device.revoke', deviceId })
      refresh()
    }
    catch (error) {
      stxAlert(error.message)
    }
  }

  // Mint a pairing code through the endpoint the CLI uses; the session cookie
  // authenticates the fetch. Shown inline: the person pairing a phone is
  // looking at this screen and the phone at the same time.
  async function startPairing() {
    const response = await fetch('/pair/new', { method: 'POST' }).catch(() => null)
    if (!response?.ok) {
      stxAlert('Could not open pairing — is the server running with --remote?')
      return
    }
    const { code } = await response.json()
    pairCode.set(code)
  }

  async function createProfile() {
    const box = profileNameRef.current
    const name = (box?.value ?? '').trim()
    if (!name) return
    try {
      await sendCommand({ type: 'profile.create', name })
      profileModalOpen.set(false)
      box.value = ''
      refresh()
    }
    catch (error) {
      stxAlert(error.message)
    }
  }

  // Spaces beyond the active one's neighbours render without their rows, so
  // arriving at one has to fetch it. Navigating rather than rebuilding rows in
  // JS keeps a single renderer: the server already knows how to draw a space,
  // and a second implementation here would be one more thing to keep in step.
  // `spaceChange`, unprefixed: stx's defineEmits dispatches the bare event name
  // on the component's scope element, and it bubbles to here.
  useEventListener('spaceChange', (event) => {
    const id = event.detail?.id
    if (!id) return
    visibleProfile.set(id)
    // Repaint first: a swipe should feel like the window changed colour with
    // it, not after a round trip.
    paintWindow(id)
    if (!sessionId && String(id) !== String(activeProfile)) {
      navigate(`/?profile=${encodeURIComponent(id)}`)
      return
    }
    const panel = document.querySelector(`[data-space][data-space-id="${CSS.escape(id)}"]`)
    // Only a deferred panel needs the round trip; a neighbour is already drawn.
    if (!panel || !panel.hasAttribute('data-space-deferred')) return
    navigate(`/?profile=${encodeURIComponent(id)}`)
  }, { target: document })

  // The diff panel: what the agent changed on disk, which is what a transcript
  // cannot tell you. Fetched on open and on demand, never polled — a repository
  // read is a subprocess, and a transcript nobody is reviewing should not pay
  // for one every few seconds.
  async function loadDiff() {
    batch(() => {
      diffStatus.set('Loading…')
      diffFiles.set([])
      diffPatch.set('')
    })

    let diff
    try {
      diff = await (await fetch(`/s/${sessionId}/diff`)).json()
    }
    catch {
      diffStatus.set('Could not read the workspace.')
      return
    }

    if (diff.error) { diffStatus.set(diff.error); return }
    if (!diff.isRepository) { diffStatus.set('This workspace is not a git repository.'); return }
    if (diff.files.length === 0) { diffStatus.set('No uncommitted changes.'); return }

    // Which comparison this is, said plainly: a count is easy to over-trust,
    // and "what this session changed" and "what is uncommitted here" are
    // different claims.
    const count = `${diff.files.length} changed file${diff.files.length === 1 ? '' : 's'}`
    batch(() => {
      diffStatus.set(diff.scope === 'session'
        ? `${count} since this session started`
        : `${count} in the working tree`)
      diffFiles.set(diff.files)
      diffPatch.set(diff.patch)
    })
  }

  let diffTrigger = null

  function toggleDiff(event) {
    if (diffOpen()) {
      diffOpen.set(false)
      diffTrigger?.focus()
      diffTrigger = null
      return
    }
    diffTrigger = workspaceActionsOpen() ? workspaceActionsToggle.current : event?.currentTarget
    closeWorkspaceActions()
    diffOpen.set(true)
    if (sessionId) loadDiff()
  }

  // ── The live wire ─────────────────────────────────────────────────────
  // Set by connectLiveSession once the socket and codec exist. Everything
  // that talks to the server — command dispatch, terminal frames — goes
  // through it, so the template handlers above can be plain top-level
  // functions the binding scope can see.
  let sendFrame = () => false

  // A command id the server can deduplicate on. Every dispatch carries one,
  // so a retry after a dropped ack replays the receipt rather than starting a
  // second agent run.
  let commandCounter = 0
  function dispatch(command) {
    sendFrame({
      t: 'dispatch',
      envelope: {
        id: `web_${sessionId}_${Date.now().toString(36)}_${++commandCounter}`,
        at: Date.now(),
        command,
      },
    })
  }

  function trackTranscriptPosition(event) {
    const { scrollHeight, scrollTop, clientHeight } = event.currentTarget
    followingTranscript.set(scrollHeight - scrollTop - clientHeight <= 48)
  }

  function jumpToLatest() {
    const transcript = transcriptRef.current
    if (!transcript) return
    followingTranscript.set(true)
    transcript.scrollTop = transcript.scrollHeight
    transcript.focus({ preventScroll: true })
  }

  async function handleTranscriptControl(event) {
    try {
      const message = await transcriptControl?.(event.target, desktop()?.clipboard)
      if (message) transcriptAnnouncement.set(message)
    }
    catch {
      stxAlert('Could not copy to the clipboard.')
    }
  }

  function handleTranscriptKeyboard(event) { transcriptMenuKeyboard?.(event) }

  function paintTranscript(updateMarkdown) {
    if (transcriptFrame) return
    transcriptFrame = requestAnimationFrame(() => {
      transcriptFrame = 0
      const transcript = transcriptRef.current
      if (!transcript) return
      for (const turnId of changedResponses) {
        const response = transcript.querySelector(`[data-turn="${turnId}"] [data-response]`)
        if (response) {
          updateMarkdown(response, responseByTurn.get(turnId))
          transcriptHighlighter?.update(response)
        }
      }
      changedResponses.clear()
      if (followingTranscript()) transcript.scrollTop = transcript.scrollHeight
    })
  }
  let transcriptHighlighter
  onDestroy(() => {
    cancelAnimationFrame(transcriptFrame)
    transcriptHighlighter?.stop()
  })

  function updateClientTurn(turnId, change) {
    liveTurns.update(turns => turns.map(turn => turn.id === turnId ? change(turn) : turn))
  }

  // The composer keeps the text and caret until the host accepts the command.
  // A retry of the same draft reuses the recorded command ID.
  // The engine's id derivation (packages/engine/src/reducer.ts), verbatim:
  // FNV-1a over the command id. Duplicated so the page can know a session's
  // id at creation time and navigate straight to it — the alternative is
  // parsing it back out of the event stream it just caused.
  function derivedSessionId(commandId) {
    let hash = 2166136261
    for (let i = 0; i < commandId.length; i++) {
      hash ^= commandId.charCodeAt(i)
      hash = Math.imul(hash, 16777619)
    }
    return (hash >>> 0) % 2147483647 + 1
  }

  function rememberPrompt() {
    const box = promptRef.current
    if (!box) return
    composerText.set(box.value)
    if (editingFollowUp()) return
    const previous = composerDraft()
    if (!box.value) {
      if (previous) composerDraft.set(null)
      return
    }
    const { value: text, selectionStart: start, selectionEnd: end, selectionDirection: direction } = box
    if (previous?.text === text && previous.start === start && previous.end === end && previous.direction === direction) return
    composerDraft.set({
      text, start, end, direction,
      ...(previous?.text === text && previous.commandId ? { commandId: previous.commandId } : {}),
    })
  }

  function restorePrompt() {
    const box = promptRef.current
    if (!box || box.value) return
    const saved = composerDraft()
    const pending = pendingFirstPrompt()
    const first = sessionId && pending?.sessionId === sessionId && typeof pending.text === 'string' ? pending : null
    if (first) pendingFirstPrompt.set(null)
    const current = typeof saved?.text === 'string' ? saved : first
    if (!current?.text) return
    box.value = current.text
    const start = Number.isInteger(current.start) ? current.start : box.value.length
    const end = Number.isInteger(current.end) ? current.end : start
    box.setSelectionRange(start, end, current.direction)
    rememberPrompt()
    if (current === first) void sendPrompt()
  }

  async function sendPrompt(mode = followUpPreference()) {
    const box = promptRef.current
    const raw = box?.value ?? ''
    const text = raw.trim()
    if (!text || startPending()) return
    const editing = editingFollowUp()
    if (editing) {
      startPending.set(true)
      try {
        await followUpActions()?.saveEdit(text)
      }
      catch (error) { stxAlert(error.message) }
      finally { startPending.set(false) }
      return
    }

    rememberPrompt()
    const draft = composerDraft()
    const commandId = draft?.commandId ?? newCommandId()
    if (draft) composerDraft.set({ ...draft, commandId })

    if (canSteer() && mode === 'steer') {
      if (steeringPending()) return
      startPending.set(true)
      try {
        await sendCommand({ type: 'session.turn.steer', sessionId, turnId: runningTurnId(), text }, commandId)
        if (box.value === raw) {
          box.value = ''
          composerText.set('')
          composerDraft.set(null)
        }
      }
      catch (error) {
        stxAlert(error.message || 'Could not steer the turn. Your draft is still here.')
      }
      finally {
        startPending.set(false)
      }
      return
    }

    if (sessionId && (uiBusy() || (!sessionOnline() && !sessionConnecting()) || localFollowUps()?.length)) {
      const actions = followUpActions()
      if (!actions) return
      actions.stage({ id: commandId, text })
      box.value = ''
      composerText.set('')
      composerDraft.set(null)
      followingTranscript.set(true)
      void nextTick(() => {
        const transcript = transcriptRef.current
        if (transcript) transcript.scrollTop = transcript.scrollHeight
      })
      return
    }

    if (!sessionId) {
      if (!draftProject?.trusted && !draftWithoutProject) return
      startPending.set(true)
      try {
        const picker = driverPickerRef.current
        if (picker?.selectedOptions[0]?.disabled) throw new Error('Choose an available agent to start this session.')
        const choice = agentChoice(picker?.value || defaultDriver())
        if (draftWithoutProject) {
          const profileId = Number(activeProfile) || undefined
          await sendCommand({ type: 'session.scratch.create', profileId, driverKind: choice.driverKind, label: text }, commandId)
        }
        else {
          await sendCommand({ type: 'session.create', workspaceId: draftProject.id, ...choice }, commandId)
        }
        const nextSession = derivedSessionId(commandId)
        pendingFirstPrompt.set({ sessionId: nextSession, text: raw })
        if (box.value === raw) {
          box.value = ''
          composerText.set('')
          composerDraft.set(null)
        }
        navigate(`/s/${nextSession}`)
      }
      catch (error) {
        startPending.set(false)
        stxAlert(error.message)
      }
      return
    }

    startPending.set(true)
    try {
      await sendCommand({ type: 'session.turn.start', sessionId, text }, commandId)
      if (box.value === raw) {
        box.value = ''
        composerText.set('')
        composerDraft.set(null)
      }
    }
    catch (error) {
      stxAlert(error.message || 'Could not send the prompt. Your draft is still here.')
    }
    finally {
      startPending.set(false)
    }
  }

  function promptKeydown(event) {
    if (event.isComposing || event.keyCode === 229) return
    if (event.key === 'Enter' && (event.metaKey || event.ctrlKey) && canSteer() && !editingFollowUp()) {
      event.preventDefault()
      if (event.shiftKey) {
        const entry = followUps().entries[0]
        if (entry && showQueueSend(entry) && !steeringPending()) void sendQueuedFollowUp(entry.id)
      }
      else {
        void sendPrompt(oppositeFollowUp())
      }
      return
    }
    if (event.altKey && event.key === 'ArrowUp' && !event.isComposing && event.target.selectionStart === 0
      && event.target.selectionEnd === 0 && !editingFollowUp()) {
      const entry = followUps().entries.at(-1)
      if (entry && !entry.steering) {
        event.preventDefault()
        followUpActions()?.beginEdit(entry)
        return
      }
    }
    if (event.key === 'Escape' && editingFollowUp()) {
      event.preventDefault()
      followUpActions()?.endEdit()
      return
    }
    if (event.key === 'Enter' && !event.shiftKey && !event.isComposing && event.keyCode !== 229) {
      event.preventDefault()
      event.target.form?.requestSubmit()
    }
  }

  // Optimistic: Stop hides immediately through `stopPressed`, but the turn is
  // not over until the log says so — `turn.interrupted` is what settles it.
  function stopTurn() {
    if (!sessionId || !sessionOnline()) return
    stopPressed.set(true)
    dispatch({ type: 'session.turn.interrupt', sessionId })
  }

  function closeConnectorOptions(restoreFocus = false) {
    const details = connectorOptions.current
    if (!details?.open) return
    details.open = false
    if (restoreFocus) details.querySelector('summary')?.focus()
  }

  function blurConnectorOptions(event) {
    if (event.relatedTarget && !event.currentTarget.contains(event.relatedTarget)) closeConnectorOptions()
  }

  function guardConnectorOptions(event) {
    if (pendingApprovalId()) event.preventDefault()
  }

  function handleConnectorOptions(event) {
    const details = connectorOptions.current
    if (event.key === 'Escape' && details?.open) {
      event.preventDefault()
      event.stopPropagation()
      closeConnectorOptions(true)
      return
    }
    if (!details || pendingApprovalId() || !['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return
    const buttons = [...details.querySelectorAll('button:not(:disabled)')]
    if (!buttons.length) return
    event.preventDefault()
    details.open = true
    const index = buttons.indexOf(event.target)
    if (event.key === 'Home' || (event.key === 'ArrowDown' && index === -1)) buttons[0].focus()
    else if (event.key === 'End' || (event.key === 'ArrowUp' && index === -1)) buttons.at(-1)?.focus()
    else buttons[(index + (event.key === 'ArrowDown' ? 1 : -1) + buttons.length) % buttons.length].focus()
  }

  useEventListener('pointerdown', (event) => {
    if (connectorOptions.current?.open && !connectorOptions.current.contains(event.target)) closeConnectorOptions()
  }, { target: document })

  async function respondToApproval(decision, scope = 'once') {
    const id = approvalId()
    if (!id || !sessionId || pendingApprovalId()) return
    pendingApprovalId.set(id)
    try {
      await sendCommand({
        type: 'session.approval.respond',
        sessionId,
        approvalId: id,
        decision,
        scope,
      })
    }
    catch (error) {
      if (pendingApprovalId() === id) {
        pendingApprovalId.set(0)
        stxAlert(error instanceof Error ? error.message : 'Could not submit this approval.')
      }
    }
  }
  function approveTool() { respondToApproval('allowed') }
  function denyTool() { respondToApproval('denied') }

  function waitingSessionState() {
    return pendingApprovals().length ? 'awaiting-approval' : inputRequest() ? 'awaiting-input' : 'running'
  }

  function questionActivityLabel(outcome) {
    if (outcome === 'answered') return 'Question answered'
    if (outcome === 'declined') return 'Question declined'
    if (outcome === 'interrupted') return 'Question interrupted'
    return 'Input requested'
  }

  function updateInputActivity(request, outcome) {
    const updated = { requestId: request.requestId, outcome }
    const applyActivity = (list) => list.some(item => item.requestId === request.requestId)
      ? list.map(item => item.requestId === request.requestId ? updated : item)
      : [...list, updated]
    if (request.turnId === initialResponseTurn) ssrInputActivity.update(applyActivity)
    else updateClientTurn(request.turnId, turn => ({ ...turn, inputRequests: applyActivity(turn.inputRequests) }))
  }

  // ── Terminal (M6): a shell in the session's workspace ─────────────────
  // The server owns the PTY and streams bytes as term-data frames; the page
  // renders them through @harness/ansi's grid and sends keystrokes back
  // whole. Local-only by server policy, so a paired phone sees the button do
  // nothing beyond the refusal notice.
  let term = null
  let termId = null
  let termToHtml = null
  let termRenderQueued = false

  function renderTerm() {
    const screen = termScreenRef.current
    if (termRenderQueued || !term || !termToHtml || !screen) return
    termRenderQueued = true
    requestAnimationFrame(() => {
      termRenderQueued = false
      screen.innerHTML = termToHtml(term.snapshot())
      screen.parentElement.scrollTop = screen.parentElement.scrollHeight
    })
  }

  // Named keys → the bytes a terminal expects. Anything printable goes as-is.
  const TERM_KEYS = {
    'Enter': '\r',
    'Backspace': '\x7F',
    'Tab': '\t',
    'Escape': '\x1B',
    'ArrowUp': '\x1B[A',
    'ArrowDown': '\x1B[B',
    'ArrowRight': '\x1B[C',
    'ArrowLeft': '\x1B[D',
  }

  // Typed-ahead keys arrive before term-opened does — the PTY takes a
  // moment to spawn — and dropping them loses the first characters of the
  // first command. Held here, flushed the moment the terminal binds.
  let termPendingInput = ''

  function termSend(data) {
    if (termId === null) {
      termPendingInput += data
      return
    }
    sendFrame({ t: 'term-input', termId, data })
  }

  // Pixels -> columns and rows, via the ruler span rendered in the host's own
  // font. Falls back to the classic 100x24 until the panel has laid out.
  let termMeasured = { cols: 100, rows: 24 }
  function measureTerm() {
    const host = termHostRef.current
    const metric = termMetricRef.current
    if (!host || !metric) return termMeasured
    const cell = metric.getBoundingClientRect()
    const box = host.getBoundingClientRect()
    if (cell.width > 0 && cell.height > 0 && box.width > 0) {
      termMeasured = {
        // The host has 10px side and 8px top padding; the ruler is 10 glyphs.
        cols: Math.max(20, Math.floor((box.width - 20) / (cell.width / 10))),
        rows: Math.max(5, Math.floor((box.height - 16) / cell.height)),
      }
    }
    return termMeasured
  }

  // Live resize: when the panel's box changes — a narrow window shrinks it —
  // the PTY is told the new size (the shell sees SIGWINCH) and the local grid
  // follows. Watching starts on first open, when the host exists to observe.
  let termObserver = null
  function watchTermSize() {
    if (termObserver || typeof ResizeObserver === 'undefined') return
    const host = termHostRef.current
    if (!host) return
    termObserver = new ResizeObserver(() => {
      if (termId === null) return
      const before = `${termMeasured.cols}x${termMeasured.rows}`
      const { cols, rows } = measureTerm()
      if (`${cols}x${rows}` === before) return
      sendFrame({ t: 'term-resize', termId, cols, rows })
      if (term) {
        term.resize(cols, rows)
        renderTerm()
      }
    })
    termObserver.observe(host)
  }

  let terminalTrigger = null

  function toggleTerminal(event) {
    // No workspace, no shell to open.
    if (!Number(activeWorkspaceId)) return
    if (termOpen()) {
      termOpen.set(false)
      terminalTrigger?.focus()
      terminalTrigger = null
      return
    }
    terminalTrigger = workspaceActionsOpen() ? workspaceActionsToggle.current
      : event?.currentTarget ?? termHostRef.current?.ownerDocument.activeElement
    closeWorkspaceActions()
    termOpen.set(true)
    // Focused now, not in the frame callback: keys typed right after the
    // click must land in the host (they buffer until the PTY binds).
    void nextTick(() => termHostRef.current?.focus())
    // Measured after the binding has shown the panel — a display:none box
    // measures zero — and the PTY opens at the size actually on screen.
    requestAnimationFrame(() => {
      const { cols, rows } = measureTerm()
      if (termId === null && term === null)
        sendFrame({ t: 'term-open', workspaceId: Number(activeWorkspaceId) || 0, cols, rows })
      watchTermSize()
    })
  }

  // Window chords. Which chord runs which command comes from the keyboard
  // registry, so the Keyboard settings section is the single place that
  // decides — the defaults are still Ctrl+` for the terminal, the editor
  // convention, and Cmd+, for settings, where in the desktop window the menu
  // item usually claims the chord first and arrives as `craft:settings`.
  useEventListener('keydown', (event) => {
    // Recording comes before the dialog guard: the pane records from inside
    // the open settings sheet, and the chord being bound must not also run
    // the command it is being bound to.
    if (recordingKeybinding()) {
      event.preventDefault()
      captureKeybinding(event)
      return
    }
    if (projectDialog.current?.open || settingsDialogRef.current?.open || threadSearchDialog.current?.open || threadActionsDialog.current?.open) return
    // Esc closes whichever sheet is open. preventDefault matters beyond the
    // DOM: an unhandled keyDown climbs WKWebView's responder chain and AppKit
    // answers it with the system beep.
    if (event.key === 'Escape') {
      if (transcriptFindOpen()) {
        event.preventDefault()
        closeTranscriptFind()
      }
      else if (profileModalOpen()) {
        event.preventDefault()
        closeProfileModal()
      }
      else if (workspaceActionsOpen()) {
        event.preventDefault()
        closeWorkspaceActions()
      }
      else if (sidebarOpen()) {
        event.preventDefault()
        closeSidebar()
      }
      return
    }
    // A command whose precondition fails is left unhandled rather than
    // swallowed, so Cmd+F still reaches the browser's own find on a page with
    // no transcript.
    const command = matchedCommand(event)
    if (command === 'transcript.find' && sessionId) {
      event.preventDefault()
      openTranscriptFind(event.target)
      return
    }
    if (command === 'settings.open') {
      event.preventDefault()
      openSettings()
      return
    }
    if (command === 'thread.search' && Number(activeProfile)) {
      event.preventDefault()
      openThreadSearch()
      return
    }
    if (command === 'thread.startWithoutProject') {
      event.preventDefault()
      startWithoutProject()
      return
    }
    if (command !== 'terminal.toggle') return
    event.preventDefault()
    toggleTerminal()
  }, { target: window })

  function termKeydown(event) {
    if (event.metaKey) return
    // The toggle chord belongs to the window handler, not the shell — asked
    // of the registry, so rebinding it moves both halves at once.
    if (matchedCommand(event) === 'terminal.toggle') return
    let data = null
    if (event.ctrlKey && event.key.length === 1) {
      const code = event.key.toLowerCase().charCodeAt(0)
      if (code >= 97 && code <= 122) data = String.fromCharCode(code - 96)
    }
    else if (TERM_KEYS[event.key]) {
      data = TERM_KEYS[event.key]
    }
    else if (event.key.length === 1) {
      data = event.key
    }
    if (data === null) return
    event.preventDefault()
    termSend(data)
  }

  function termPaste(event) {
    event.preventDefault()
    termSend(event.clipboardData.getData('text'))
  }

  // The page speaks CBOR to the socket, so it needs the same codec the server
  // uses. It arrives as a module rather than as assumed globals — the island
  // used to call `window.__harnessEncode`, which nothing ever defined, so the
  // socket connected and then threw on its first frame. An async function
  // rather than top-level await: a client script's body is emitted inside a
  // plain function wrapper, where `await` only exists behind `async`.
  async function connectLiveSession() {
    const { applyFollowUpEvent, threadDisplayTitle, createFollowUpActions, createSessionSocket, Terminal, toHtml, updateTranscriptMarkdown, createQuestionForm, paintQuestionFiles, useTranscriptControl, closeTranscriptMenu, createTranscriptHighlighter } = await import(codecUrl)
    transcriptControl = useTranscriptControl
    transcriptMenuKeyboard = closeTranscriptMenu
    questionForm.set(createQuestionForm({
      state,
      initialRequests: initialInputs,
      sessionId,
      focus(target) {
        void nextTick(() => {
          if (target === 'answer') questionCard.current?.querySelector('[data-question-answer]')?.focus()
          else (target === 'prompt' ? promptRef.current : questionCard.current)?.focus({ preventScroll: true })
        })
      },
      hasFocus(target) {
        return target === 'card' ? questionCard.current?.matches(':focus-within') : promptRef.current?.matches(':focus')
      },
      recordActivity(request, outcome) {
        updateInputActivity(request, outcome)
        if (request.attachments?.length) void nextTick(() => paintQuestionFiles(transcriptRef.current, sessionId, request))
      },
      send(requestId, answers) {
        return sendCommand({ type: 'session.input.respond', sessionId, requestId, answers })
      },
    }))

    const transcript = transcriptRef.current
    if (initialInputActivity.some(request => request.attachments?.length))
      void nextTick(() => initialInputActivity.forEach(request => paintQuestionFiles(transcriptRef.current, sessionId, request)))
    if (transcript) {
      transcriptHighlighter = createTranscriptHighlighter(transcript)
      transcriptHighlighter?.update(transcript)
    }
    const liveResponse = transcript?.querySelector('[data-live-response]')
    if (liveResponse) {
      responseByTurn.set(initialResponseTurn, JSON.parse(liveResponse.getAttribute('data-response-source') || '""'))
      liveResponse.removeAttribute('data-response-source')
    }
    const hash = transcript?.ownerDocument.location?.hash
    if (hash?.startsWith('#turn-')) followingTranscript.set(false)
    else paintTranscript(updateTranscriptMarkdown)

    let cursor = Number(sinceSeq) || 0
    termToHtml = toHtml
    followUpActions.set(createFollowUpActions({
      sessionId, online: sessionOnline, inputBlocked: () => Boolean(inputRequest()),
      editor: () => promptRef.current, setText: text => composerText.set(text),
      rememberDraft: rememberPrompt, restoreDraft: restorePrompt, hasDraft: () => Boolean(composerDraft()?.text),
      editing: editingFollowUp, local: localFollowUps, sending: outboxSending, pending: queueActionPending,
      send: sendCommand, alert: stxAlert,
      transcript: () => transcriptRef.current, steeringMessage: () => steeringMessage.current,
    }))

    function onMessage(frame) {
      if (frame?.t === 'term-opened') {
        termId = frame.termId
        term = new Terminal({ cols: frame.cols, rows: frame.rows })
        if (termPendingInput) {
          sendFrame({ t: 'term-input', termId, data: termPendingInput })
          termPendingInput = ''
        }
        renderTerm()
        return
      }
      if (frame?.t === 'term-data') {
        if (frame.termId === termId && term) {
          term.write(frame.data)
          renderTerm()
        }
        return
      }
      if (frame?.t === 'term-exit') {
        if (frame.termId === termId && term) {
          term.write(`\r\n[exited${frame.code === null ? '' : ` (${frame.code})`}]`)
          renderTerm()
          termId = null
        }
        return
      }
      if (frame?.t === 'term-error') {
        // The one the server sends a paired phone: terminals are local-only.
        stxAlert(frame.message)
        return
      }
      if (frame?.t !== 'event' || frame.event.sessionId !== sessionId || frame.event.seq <= cursor) return
      cursor = frame.event.seq
      const payload = frame.event.payload
      const updatedQueue = applyFollowUpEvent(followUps(), payload)
      if (updatedQueue !== followUps()) {
        followUps.set(updatedQueue)
        const editing = editingFollowUp()
        if (editing && !updatedQueue.entries.some(entry => entry.id === editing.id)) followUpActions()?.endEdit(true)
        paintTranscript(updateTranscriptMarkdown)
      }
      if (payload.type === 'session.navigation-changed') {
        threadNavigation.update(previous => ({ ...previous, ...payload.changes }))
        if (payload.changes.title) currentThreadTitle.set(payload.changes.title)
      }
      if (payload.type === 'turn.started') {
        // Only the user's half opens a new exchange; the assistant's turn is
        // the reply within it.
        if (payload.role === 'user') {
          responseByTurn.set(payload.turnId, '')
          if (payload.turnId === 1) currentThreadTitle.set(threadDisplayTitle(threadNavigation().title, payload.text))
          if (threadNavigation().settledAt || threadNavigation().snoozedUntil)
            threadNavigation.update(previous => ({ ...previous, settledAt: null, snoozedUntil: null }))
          steerableTurn.set(0)
          runningTurnId.set(payload.turnId)
          liveTurns.update(turns => [...turns, {
            id: payload.turnId,
            prompt: payload.text ?? '',
            tools: [],
            inputRequests: [],
            hasResponse: false,
          }])
          transcriptAnnouncement.set('')
          setSessionState('running')
          paintTranscript(updateTranscriptMarkdown)
        }
      }
      else if (payload.type === 'turn.steering-ready') {
        steerableTurn.set(payload.turnId)
      }
      else if (payload.type === 'turn.steer.resolved') {
        if (payload.outcome === 'delivered') {
          void nextTick(() => followUpActions()?.showDelivery(payload.turnId, payload.text))
          transcriptAnnouncement.set('Follow-up sent to the active turn.')
          paintTranscript(updateTranscriptMarkdown)
        }
        else {
          transcriptAnnouncement.set(payload.outcome === 'uncertain'
            ? 'Delivery could not be confirmed. The message is held for review.'
            : 'The agent did not accept the follow-up. The message is held in the queue.')
        }
      }
      else if (payload.type === 'tool.call.began') {
        // Deduplicated by id: a replayed frame must not grow a second row.
        const call = { callId: payload.callId, name: payload.toolName }
        if (payload.turnId !== initialResponseTurn) {
          updateClientTurn(payload.turnId, turn => turn.tools.some(t => t.callId === call.callId)
            ? turn
            : { ...turn, tools: [...turn.tools, call] })
        }
        else {
          ssrTools.update(tools => tools.some(t => t.callId === call.callId)
            ? tools
            : [...tools, call])
        }
        paintTranscript(updateTranscriptMarkdown)
      }
      else if (payload.type === 'tool.call.ended') {
        // Recorded by id: tools run in parallel and finish out of order, and
        // every row's `:data-tool-state` binding reads this map, so resolving
        // "the last row" could never mark the wrong one failed.
        toolResults.update(results => ({
          ...results,
          [payload.callId]: payload.ok ? 'ok' : 'failed',
        }))
      }
      else if (payload.type === 'assistant.delta') {
        const previous = responseByTurn.get(payload.turnId)
        if (previous === undefined || !payload.text) return
        responseByTurn.set(payload.turnId, previous + payload.text)
        changedResponses.add(payload.turnId)
        if (!previous) {
          if (payload.turnId === initialResponseTurn) ssrHasResponse.set(true)
          else updateClientTurn(payload.turnId, turn => ({ ...turn, hasResponse: true }))
        }
        paintTranscript(updateTranscriptMarkdown)
      }
      else if (payload.type === 'checkpoint.restored') {
        // The workspace is actually back now.
        while (revertWaiters.length > 0) revertWaiters.shift()()
      }
      else if (payload.type === 'turn.completed' || payload.type === 'turn.interrupted') {
        batch(() => {
          setSessionState('idle')
          closeConnectorOptions()
          pendingApprovals.set([])
          pendingApprovalId.set(0)
          questionForm()?.interrupt()
        })
        transcriptAnnouncement.set(payload.type === 'turn.completed' ? 'Agent finished responding.' : 'Response stopped.')
      }
      else if (payload.type === 'session.failed') {
        // A failed turn is over too. Leaving Stop up would offer to interrupt
        // something that already stopped; 'failed' is not busy, so the
        // bindings put Send back while the chip says what happened.
        batch(() => {
          setSessionState('failed')
          closeConnectorOptions()
          pendingApprovals.set([])
          pendingApprovalId.set(0)
          questionForm()?.interrupt()
        })
        transcriptAnnouncement.set('The agent could not finish this response.')
      }
      else if (payload.type === 'approval.requested') {
        batch(() => {
          setSessionState('awaiting-approval')
          pendingApprovals.update(requests => requests.some(request => request.approvalId === payload.approvalId)
            ? requests
            : [...requests, { approvalId: payload.approvalId, toolName: payload.toolName, connector: payload.connector }])
          transcriptAnnouncement.set('An approval needs your attention.')
        })
        paintTranscript(updateTranscriptMarkdown)
      }
      else if (payload.type === 'approval.resolved') {
        if (!pendingApprovals().some(request => request.approvalId === payload.approvalId)) return
        if (approvalId() === payload.approvalId) closeConnectorOptions()
        batch(() => {
          pendingApprovals.update(requests => requests.filter(request => request.approvalId !== payload.approvalId))
          if (pendingApprovalId() === payload.approvalId) pendingApprovalId.set(0)
          setSessionState(waitingSessionState())
        })
      }
      else if (payload.type === 'input.requested' || payload.type === 'input.resolved') {
        batch(() => {
          questionForm()?.update(payload)
          setSessionState(waitingSessionState())
          transcriptAnnouncement.set(payload.type === 'input.requested' ? 'The agent has a question.' : questionActivityLabel(payload.outcome))
        })
        paintTranscript(updateTranscriptMarkdown)
      }
    }

    const connection = createSessionSocket({
      url: serverUrl, sessionId, cursor: () => cursor, onFrame: onMessage,
      onSocket: socket => { liveSocket = socket },
      onOnline(online) {
        sessionOnline.set(online)
        sessionConnecting.set(false)
        if (online) void followUpActions()?.flush()
        else if (termId && term) {
          term.write('\r\n[connection closed]')
          termId = null
          renderTerm()
        }
      },
    })
    sendFrame = connection.send
    reconnectLiveSession = connection.open
    disconnectLiveSession = () => {
      followUpActions()?.dispose()
      connection.dispose()
    }
    connection.open()
  }

  if (sessionId && serverUrl && codecUrl) void connectLiveSession().catch(() => sessionConnecting.set(false))
</script>
