<script server>
/**
 * The harness surface.
 *
 * SSR-first with islands, not an SPA. A session transcript is mostly-static,
 * append-heavy text — the worst case for a component tree that re-reconciles
 * and the best case for server rendering. The shell, the profile list and every
 * settled turn come down as HTML; only the live tail and the composer hydrate.
 *
 * Profiles are the Arc "spaces": one profile per project, each with its own
 * colour, swiped between. `<Sidebar :spaces>` is the whole integration — the
 * mapping below is the only harness-specific part.
 */
export const profiles = $props.profiles || []
export const sessions = $props.sessions || []
export const activeProfile = $props.activeProfile || (profiles[0] && profiles[0].id) || ''
export const activeSession = $props.activeSession || null
export const initialSettingsSection = $props.settingsSection || ''
export const settingsSections = $props.settingsSections || []
// The keyboard registry, with both platform spellings of every default chord.
export const keybindings = $props.keybindings || []
// Settings this host owns, shared by every client connected to it.
export const hostSettings = $props.hostSettings || { defaultDriver: 'claude', followUpBehavior: 'queue', terminalShell: 'system', claudeIdleCompaction: 'whenReturning', claudeAutoCompactAfter: null, autoSettleAfterDays: 7 }
export const draftProject = $props.draftWorkspace || null
export const draftWithoutProject = $props.draftWithoutProject === true
export const serverUrl = $props.serverUrl || ''
// The browser CBOR bundle. Empty when the server could not build one, which
// costs the page its live updates but not its rendered transcript.
export const codecUrl = $props.codecUrl || ''
// The sequence this render already contains. The socket resumes from here so a
// load replays only what is missing.
export const sinceSeq = $props.sinceSeq || 0
// A decision this session is blocked on, if any. Rendered rather than waited
// for: the client that raised it may be long gone.
export const initialApprovals = activeSession?.pendingApprovals || []
export const initialInputs = activeSession?.pendingInputs || []
export const initialFollowUps = activeSession?.followUps || { entries: [], held: false }
export const initialContextUsage = activeSession?.contextUsage || null
export const initialIdleCompaction = activeSession?.idleCompaction || null
export const providerProfileId = $props.providerProfileId || 0
export const initialAccountCompaction = $props.claudeCompactionByAccount || {}
const pendingApproval = initialApprovals[0]

// One space per profile. Its project rows contain threads that are ready for another message.
//
// Only the active space and its immediate neighbours render their rows. Every
// space used to, which cost ~9.5ms of server render each — 175ms at fourteen
// projects, on every page load, to display one. Neighbours are kept because
// they are what a single swipe can reveal, so the common gesture never lands
// on an empty panel; anything further away fills in on arrival.
const activeSpaceIndex = Math.max(0, profiles.findIndex(profile => String(profile.id) === String(activeProfile)))

// id -> tint, for the native titlebar. The web sidebar gets the tint through
// `<Sidebar :spaces>`; the window chrome around it is ours to paint. Reaches
// the island through the server -> client bridge, like every other export the
// island references.
export const spaceTints = Object.fromEntries(
  profiles.map(profile => [String(profile.id), profile.tint || '']),
)

export const spaces = profiles.map((profile, index) => ({
  id: String(profile.id),
  deferred: Math.abs(index - activeSpaceIndex) > 1,
  label: profile.name,
  icon: profile.icon || 'i-hugeicons-folder-01',
  tint: profile.tint || 'blue',
  showTitle: false,
  sections: threadSections(profile),
}))

function threadSections(profile) {
  const sessionsById = new Map((profile.sessions || []).map(session => [session.id, session]))
  const projectsById = new Map((profile.workspaces || []).map(workspace => [workspace.id, workspace]))
  return (profile.sidebar || []).map(section => {
    const rows = section.rows.map(row => toItem(sessionsById.get(row.id)))
    const project = projectsById.get(section.workspaceId)
    return {
      id: section.id,
      label: project?.name || section.label,
      items: project
        ? [{ id: 'compose-' + project.id, label: 'New thread', icon: 'i-hugeicons-pencil-edit-02', href: `/?workspace=${project.id}` }, ...rows]
        : rows,
    }
  })
}

function toItem(session) {
  const waiting = session.state === 'awaiting-approval' || session.state === 'awaiting-input'
  return {
    id: String(session.id),
    label: session.title,
    icon: waiting ? 'i-hugeicons-help-circle' : session.state === 'running' ? 'i-hugeicons-loading-03' : 'i-hugeicons-message-01',
    href: `/s/${session.id}`,
  }
}

export const initialNavigation = activeSession?.navigation || {}
export const archivedThreads = (profiles.find(profile => String(profile.id) === String(activeProfile))?.sessions || [])
  .filter(session => session.navigation?.archivedAt)
  .sort((a, b) => b.navigation.archivedAt - a.navigation.archivedAt)

export const hasProfiles = profiles.length > 0
export const turns = activeSession ? activeSession.turns : []
export const sessionTitle = activeSession ? (activeSession.title || `Session ${activeSession.id}`) : (draftProject || draftWithoutProject ? 'New thread' : 'Harness')
export const sessionState = activeSession ? activeSession.state : 'idle'
export const initialSessionError = activeSession?.lastError || ''
export const initialWorktreeSetup = activeSession?.worktreeSetup === true
// Empty unless this session runs in a worktree of its own.
export const sessionBranch = activeSession ? (activeSession.branch || '') : ''
export const sessionDriver = activeSession ? (activeSession.driverKind || '') : ''
export const sessionProviderInstanceId = activeSession?.providerInstanceId ?? null
export const promptPlaceholder = 'Message the agent…'
export const activeSessionId = activeSession ? activeSession.id : 0
const providerNames = { claude: 'Claude Code', codex: 'Codex', opencode: 'OpenCode', cursor: 'Cursor', grok: 'Grok' }
export const providerDisplayName = kind => providerNames[kind] || kind
export const initialSessionModel = activeSession?.model || ''
export const activeCodex = Boolean(activeSessionId && sessionDriver === 'codex')
export const initialFork = activeSession?.fork || null
export const initialCodexSelection = activeCodex && activeSession.model
  ? { model: activeSession.model, ...activeSession.codexTurnOptions } : null
export const activeWorkspaceId = activeSession ? (activeSession.workspaceId || 0) : 0
export const activeScratchSession = activeSession?.scratch === true
export const hasWorkspaceFiles = Boolean((activeWorkspaceId && !activeScratchSession) || draftProject?.trusted)
const activeWorkspace = activeSession && !activeScratchSession
  ? profiles.flatMap(profile => profile.workspaces || []).find(workspace => workspace.id === activeWorkspaceId)
  : draftProject
export const workspaceName = activeWorkspace?.name
export const canExpandDiffContext = Boolean(activeWorkspace?.trusted && !activeScratchSession)
export const workspaceEditorAllowed = Boolean(canExpandDiffContext && $props.canLaunchWorkspaceEditor)
export const previewDiscoveryAllowed = Boolean(activeSession && $props.canLaunchWorkspaceEditor)
export const canCompose = Boolean(activeSession || draftProject?.trusted || draftWithoutProject)
export const profileProjects = Object.fromEntries(profiles.map(profile => {
  const projects = profile.workspaces || []
  return [String(profile.id), projects.find(workspace => workspace.trusted) || projects[0] || null]
}))
export const draftProjectChoices = profiles.find(profile => String(profile.id) === String(activeProfile))?.workspaces || []
// The last turn is the only one that can still change, so it is the only one
// that needs hydrating — everything above it is settled history.
export const settledTurns = turns.slice(0, Math.max(0, turns.length - 1))
export const liveTurn = turns.length > 0 ? turns[turns.length - 1] : null
export const initialHasResponse = Boolean(liveTurn?.response)
export const initialResponseTurn = liveTurn?.id || 0
export const initialHasTurns = Boolean(turns.length)
export const initialConversationRewind = activeSession?.conversationRewind ?? null
export const initialIsolatedRewindScope = activeSession?.isolatedRewindScope || ''
export const initialConversationRewindNotice = activeSession?.conversationRewindNotice || ''
export const initialRewoundPrompt = activeSession?.rewoundPrompt ?? null
export const initialRewindableTurns = turns.filter(turn => turn.canRewindConversation).map(turn => turn.id)
export const initialForkableTurns = turns.filter(turn => turn.forkable).map(turn => turn.id)
export const initialTurnDiffs = Object.fromEntries(turns.filter(turn => turn.reviewRepositories?.length).map(turn => [turn.id, turn.reviewRepositories]))
export const initialCompactedTurn = liveTurn?.contextCompacted ? liveTurn.id : 0
export const initialInterrupted = liveTurn?.status === 'interrupted'
export const initialSteerable = liveTurn?.steerable === true
export const initialInputActivity = liveTurn?.inputRequests || []
export const initialRewind = activeSession?.pendingRewind ?? 0
export const initialRewindNotice = activeSession?.rewindNotice || ''
export const initialRewindCheckpoints = Object.fromEntries(turns.filter(turn => turn.checkpointId).map(turn => [turn.id, {
  id: turn.checkpointId, resetsStaging: turn.checkpointResetsStaging,
}]))
</script>

{{--
  The shared browser module, fetched and compiled while the page paints rather
  than on the first dynamic import that needs it. Everything interactive here
  waits on it: the socket, the command sender, the transcript finder, and the
  keyboard registry that answers the window chords. Without the hint, a chord
  pressed in the first moments after a load found no registry and did nothing.
--}}
@if(codecUrl)
  <link rel="modulepreload" href="{{ codecUrl }}">
@endif
<div data-harness-shell :data-sidebar-collapsed="sidebarCollapsed()" class="flex overflow-hidden h-[100dvh] w-full text-neutral-900 dark:text-neutral-100">
  {{--
    `data-harness-sidebar`, not `data-stx-sidebar`: the latter is the Sidebar
    component's own marker, and putting it on a wrapper made two elements claim
    it. `tintTarget()` resolves `closest('[data-stx-sidebar]')`, so the space
    palette was being written to this wrapper instead of the pane — it reached
    the pane by inheritance and worked by luck.
  --}}
  <aside id="harness-sidebar" ref="sidebarBox" tabindex="-1" aria-label="Workspace navigation" class="shrink-0 border-black/5 border-r dark:border-white/5" data-harness-sidebar :data-open="sidebarOpen() ? 'true' : 'false'" :style="'--harness-sidebar-width: ' + sidebarWidth() + 'px'">
    <div data-navigation-chrome>
      <div data-brand-bar class="flex gap-2 items-center h-11 px-3">
        <a href="/" class="flex gap-2 items-center min-w-0 font-semibold text-sm">
          <span class="inline-block size-4 i-hugeicons-command-line" aria-hidden="true"></span>
          Harness
        </a>
        <button type="button" data-sidebar-close @click="toggleSidebar" aria-label="Close navigation" aria-controls="harness-sidebar" class="harness-icon-button">
          <span class="inline-block size-4 i-hugeicons-sidebar-left" aria-hidden="true"></span>
        </button>
      </div>
      @if(hasProfiles)
        <div class="flex gap-1 items-center px-2 pb-2">
          <button type="button" data-nav-search @click="openThreadSearch" aria-label="Search threads" title="Search threads" aria-haspopup="dialog" :aria-keyshortcuts="shortcutKeys('thread.search')" class="harness-nav-search">
            <span class="inline-block size-4 i-hugeicons-search-01" aria-hidden="true"></span>
            <span>Search</span>
          </button>
          <button type="button" @click="openProjectPicker" aria-label="Add project" title="Add project" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-folder-add" aria-hidden="true"></span>
          </button>
          <button type="button" @click="openDraft(visibleProfile())" aria-label="New thread" title="New thread" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-pencil-edit-02" aria-hidden="true"></span>
          </button>
        </div>
      @endif
    </div>
    <div data-navigation-content>
    <template ref="draftDiscardTemplate">
      <button type="button" data-draft-discard-row aria-label="Discard draft" title="Discard draft" class="harness-icon-button">
        <span class="size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
      </button>
    </template>
    @if(hasProfiles)
      <Sidebar
        :spaces="spaces"
        :space="activeProfile"
        placement="static"
        spacePersistKey="harness.profile"
        :showSpaceAdd="true"
      />
    @else
      <div class="flex flex-col gap-2 items-center justify-center px-6 h-full text-center">
        <p class="text-[13px] text-neutral-600 dark:text-neutral-300">No profiles yet</p>
        <button type="button" @click="openProfileModal" class="px-3 py-1 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15">Create profile</button>
      </div>
    @endif
    </div>
    <div data-navigation-footer>
      <button type="button" data-account-button data-nav-settings @click="openSettings" :title="settingsShortcutTitle()" aria-label="Settings" class="harness-nav-search">
        <span class="inline-block size-4 i-hugeicons-settings-02" aria-hidden="true"></span>
        <span>Settings</span>
      </button>
      <div data-navigation-undo :hidden="arrangementOpen()">
        @include('../partials/harness-thread-undo')
      </div>
    </div>
    <p role="status" :text="threadOrderStatus()" class="sr-only"></p>
  </aside>
  <button type="button" data-sidebar-scrim hidden :hidden="!sidebarOpen()" @click="closeSidebar" aria-label="Close navigation"></button>
  <div
    data-sidebar-resize
    role="separator"
    tabindex="0"
    aria-label="Resize workspace navigation"
    aria-controls="harness-sidebar"
    aria-orientation="vertical"
    aria-valuemin="192"
    aria-valuemax="416"
    aria-valuenow="250"
    :aria-valuenow="String(sidebarWidth())"
    @keydown="resizeSidebarByKey"
    @pointerdown="beginSidebarResize"
    @pointermove="moveSidebarResize"
    @pointerup="endSidebarResize"
    @pointercancel="cancelSidebarResize"
  ></div>

  <main data-workspace-layout data-details-open="true" :data-details-open="workspaceDetailsOpen()" :data-diff-open="diffOpen()" :data-files-open="workspaceFilesOpen()" :data-preview-open="browserPreviewOpen()" :inert="!desktopSidebar() && sidebarOpen()" class="flex-1 min-w-0">
    <header data-workspace-header class="flex relative gap-3 items-center shrink-0 px-4">
      <button type="button" data-sidebar-toggle class="harness-icon-button" ref="sidebarToggleBox" @click="toggleSidebar" aria-label="Open navigation" aria-controls="harness-sidebar" aria-expanded="false" :aria-expanded="sidebarOpen() ? 'true' : 'false'">
        <span class="inline-block size-4 i-hugeicons-sidebar-left" aria-hidden="true"></span>
      </button>
      <div data-workspace-heading class="min-w-0">
        @if(workspaceName)
          <span data-workspace-project class="flex gap-1.5 items-center min-w-0 text-xs text-neutral-600 dark:text-neutral-400" title="{{ workspaceName }}">
            <span class="inline-block shrink-0 size-4 i-hugeicons-folder-01" data-workspace-folder aria-hidden="true"></span>
            <span class="truncate">{{ workspaceName }}</span>
          </span>
          <span data-workspace-separator class="text-neutral-400" aria-hidden="true">/</span>
        @endif
        @if(activeSession)
          <button type="button" data-workspace-title data-thread-actions-trigger ref="threadActionsTriggerBox" @click="openThreadActions" aria-haspopup="dialog" aria-controls="harness-thread-actions" :aria-expanded="threadActionsOpen()" :title="currentThreadTitle()" class="flex gap-1 items-center min-w-0 font-medium text-start text-[13px] rounded-md">
            <span class="min-w-0 truncate" :text="currentThreadTitle()">{{ sessionTitle }}</span>
            <span class="shrink-0 inline-block size-3 i-hugeicons-arrow-down-01 text-neutral-500" aria-hidden="true"></span>
          </button>
        @else
          <span data-workspace-title class="min-w-0 font-medium text-[13px] truncate" title="{{ sessionTitle }}">{{ sessionTitle }}</span>
        @endif
      </div>
      @if(activeSession)
      <span
        data-session-state
        data-state="{{ sessionState }}"
        :data-state="uiState()"
        class="px-2 py-[2px] leading-[14px] text-[11px] whitespace-nowrap rounded-full opacity-70"
        :text="uiState() === 'awaiting-input' ? 'Question' : uiState() === 'awaiting-approval' ? 'Approval' : uiState()"
      >{{ sessionState === 'awaiting-input' ? 'Question' : sessionState === 'awaiting-approval' ? 'Approval' : sessionState }}</span>
      @endif
      {{-- Which agent answers in this session — the composer picker's ground truth. --}}
      @if(sessionDriver)
        <span data-session-driver :text="currentDriver()" class="px-[6px] py-[1px] leading-[15px] text-[11px] border border-black/10 rounded-[5px] dark:border-white/15 opacity-70">{{ sessionDriver }}</span>
      @endif
      {{--
        An isolated session edits its own checkout, not the workspace. Saying
        which branch makes that visible, and names the thing you merge.
      --}}
      @if(activeSession)
        <span
          data-workspace-branch
          @if(!sessionBranch)hidden@endif
          :hidden="!workspaceBranch()"
          :text="workspaceBranch()"
          :title="'This session runs in its own worktree on ' + workspaceBranch()"
          class="px-[6px] py-[1px] font-mono leading-[15px] text-[11px] truncate border border-black/10 rounded-[5px] dark:border-white/15 opacity-70"
          title="This session runs in its own worktree on {{ sessionBranch }}"
        >{{ sessionBranch }}</span>
      @endif
      <div data-header-actions>
        @if(hasProfiles)
          <button type="button" data-thread-search-toggle @click="openThreadSearch" aria-label="Search threads" title="Search threads" aria-haspopup="dialog" :aria-keyshortcuts="shortcutKeys('thread.search')" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-search-01" aria-hidden="true"></span>
          </button>
        @endif
        @if(activeSession && !activeScratchSession)
          <button type="button" data-header-pane @click="toggleDiff" aria-label="Show changes" title="Changes" aria-controls="harness-changes" :aria-expanded="diffOpen() ? 'true' : 'false'" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-file-02" aria-hidden="true"></span>
          </button>
        @endif
        @if(hasWorkspaceFiles)
          <button type="button" data-header-files ref="workspaceFilesToggle" @click="toggleWorkspaceFiles" aria-label="Workspace files" title="Files" aria-controls="harness-workspace-files" :aria-expanded="workspaceFilesOpen() ? 'true' : 'false'" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-folder-01" aria-hidden="true"></span>
          </button>
        @endif
        @if(workspaceEditorAllowed)
          <button type="button" data-header-editor ref="workspaceEditorHeader" @click="chooseWorkspaceEditor($event)" aria-label="Open workspace in editor" title="Open in editor" aria-haspopup="dialog" :aria-keyshortcuts="shortcutKeys('editor.open')" class="harness-icon-button">
            <span class="size-4 i-hugeicons-source-code" aria-hidden="true"></span>
          </button>
        @endif
        @if(activeWorkspaceId)
          @if(activeSession && workspaceEditorAllowed)
            <button type="button" data-header-pane data-header-project-scripts @click="openProjectScripts" aria-label="Project scripts" title="Project scripts" aria-haspopup="dialog" class="harness-icon-button">
              <span class="size-4 i-hugeicons-play" aria-hidden="true"></span>
            </button>
          @endif
          <button type="button" data-header-pane data-header-terminal ref="termHeaderToggle" @click="toggleTerminal" aria-label="Open terminal" :title="terminalShortcutTitle('terminal.toggle')" :aria-keyshortcuts="shortcutKeys('terminal.toggle')" aria-controls="harness-terminal" :aria-expanded="termOpen() ? 'true' : 'false'" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-command-line" aria-hidden="true"></span>
          </button>
        @endif
        @if(draftProject || activeSession || draftWithoutProject)
          <button type="button" data-header-preview ref="browserPreviewToggleBox" @click="toggleBrowserPreview" aria-label="Open workspace browser" title="Browser" aria-controls="harness-browser-preview" :aria-expanded="browserPreviewOpen() ? 'true' : 'false'" class="harness-icon-button">
            <span class="size-4 i-hugeicons-globe-02" aria-hidden="true"></span>
          </button>
          <button type="button" data-workspace-actions-toggle ref="workspaceActionsToggleBox" @click="toggleWorkspaceActions" aria-label="Workspace actions" title="Workspace tools" aria-controls="harness-workspace-actions" aria-expanded="false" :aria-expanded="(wideWorkspace() ? workspaceDetailsOpen() && !workspaceFilesOpen() && !diffOpen() && !browserPreviewOpen() : workspaceActionsOpen()) ? 'true' : 'false'" class="harness-icon-button">
            <span data-workspace-tools-icon hidden :hidden="!wideWorkspace()" class="size-4 i-hugeicons-sidebar-right" aria-hidden="true"></span>
            <span data-workspace-menu-icon :hidden="wideWorkspace()" class="size-4 i-hugeicons-more-horizontal" aria-hidden="true"></span>
          </button>
        @endif
        <button type="button" data-account-button data-header-settings :title="settingsShortcutTitle()" aria-label="Settings" @click="openSettings" class="harness-icon-button">
          <span class="inline-block size-4 i-hugeicons-settings-02" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <div data-compact-thread-undo :hidden="sidebarOpen() || arrangementOpen()">
      @include('../partials/harness-thread-undo')
    </div>
    <div data-workspace-content>
    <div data-workspace-lane @if(!activeSession)data-workspace-draft@endif :inert="workspaceActionsOpen()">
    {{--
      The transcript. Settled turns are plain server-rendered HTML and hydrate
      on `visible`, so scrolling back through a long session costs nothing until
      you actually scroll. The live tail hydrates eagerly — it is the only part
      the socket writes to.
    --}}
    <div data-transcript-viewport :style="transcriptFindOpen() ? '--harness-transcript-top: 56px' : ''" class="relative min-h-0 min-w-0 @if(activeSession)flex-1@endif">
    <div data-transcript ref="transcriptBox" @scroll="trackTranscriptPosition" @click="handleTranscriptControl" @keydown="handleTranscriptKeyboard" tabindex="0" role="region" aria-label="Conversation" class="overflow-y-auto min-w-0 @if(activeSession)h-full@endif">
      {{--
        A blank canvas says the app is broken; an empty state says what to do.
        Typing below is the fastest path, so it is the one named first.
      --}}
      @if(turns.length === 0)
        <div data-empty-state :hidden="liveTurns().length > 0" class="flex flex-col gap-2 items-center justify-center text-center @if(activeSession)h-full@endif">
          @if(activeSession)
            <p class="text-[15px] font-medium">Start the conversation</p>
          @elseif(draftWithoutProject)
            <h1 data-draft-title>What would you like to work on?</h1>
            <p class="max-w-[40ch] text-[13px] text-neutral-600 dark:text-neutral-300">Files stay in a scratch folder on this host.</p>
          @elseif(draftProject && draftProject.trusted)
            <h1 data-draft-title>What would you like to work on in {{ draftProject.name }}?</h1>
            <button type="button" @click="startWithoutProject" class="px-2 h-8 text-[13px] text-neutral-600 underline underline-offset-4 dark:text-neutral-300">Start without a project</button>
          @elseif(draftProject)
            <p class="text-[16px] font-semibold">Trust {{ draftProject.name }} to start</p>
            <p class="max-w-[34ch] text-[13px] text-neutral-600 dark:text-neutral-300">Trust lets agents access this folder when you start a session.</p>
            <button type="button" data-project-trust @click="trustProject" :disabled="projectBusy()" class="mt-1 px-3 h-9 text-[13px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-[8px]">Trust folder</button>
          @else
            <h1 class="text-[20px] font-semibold">Open a project</h1>
            <p class="max-w-[40ch] text-[13px] text-neutral-600 dark:text-neutral-300">Add a folder from the host to start working with an agent.</p>
            <button type="button" data-first-project @click="openProjectPicker" class="mt-2 px-4 h-9 text-[13px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-[8px]">Add project</button>
            <button type="button" data-start-without-project @click="startWithoutProject" class="px-3 h-9 text-[13px] underline underline-offset-4">Start without a project</button>
          @endif
        </div>
      @endif
      @foreach(settledTurns as turn)
        <article stx-hydrate="visible" class="mb-5" data-turn="{{ turn.id }}" id="turn-{{ turn.id }}">
          @if(turn.switchedProvider)<p data-provider-switch class="mb-3 text-center text-neutral-600 text-xs dark:text-neutral-300">Continued with {{ providerDisplayName(turn.switchedProvider) }}</p>@endif
          @if(turn.modelChange)<p data-model-change class="mb-3 text-center text-neutral-600 text-xs dark:text-neutral-300">Switched to {{ turn.modelChange }}</p>@endif
          @if(turn.freshContext)<p data-fresh-context class="mb-3 text-center text-neutral-600 text-xs dark:text-neutral-300">New session</p>@endif
          @if(!turn.automaticCompaction)<div class="sr-only">You</div>@endif
          @if(turn.automaticCompaction)<p data-automatic-compaction class="mb-1 text-end text-neutral-600 text-xs dark:text-neutral-300">Harness</p>@endif
          <div data-user-prompt class="mb-4 ms-auto px-3 py-2 max-w-[90%] w-fit rounded-xl whitespace-pre-wrap break-words text-sm leading-5">{{ turn.prompt }}</div>
          @if(turn.attachments.length)
            <ul aria-label="Message attachments" class="flex flex-wrap gap-2 justify-end mb-4">
              @foreach(turn.attachments as file)
                <li class="max-w-full min-w-0">
                  @if(file.image)
                    <button type="button" data-preview-sent-image="{{ file.id }}" @click="openSentImage" class="flex gap-2 items-center p-1.5 max-w-full text-[12px] border border-black/15 rounded-lg dark:border-white/20">
                      <img src="/composer-attachments/{{ file.id }}?session={{ activeSession.id }}&amp;preview=1" loading="lazy" width="32" height="32" alt="" class="object-cover shrink-0 size-8 rounded">
                      <span class="sr-only">Preview </span><span data-attachment-name class="truncate">{{ file.nameHtml }}</span>
                    </button>
                  @else
                  <a data-sent-attachment href="/composer-attachments/{{ file.id }}?session={{ activeSession.id }}" download class="flex items-center gap-2 px-2 min-h-8 text-[12px] border border-black/15 rounded-lg dark:border-white/20">
                    <span class="shrink-0 size-4 i-hugeicons-attachment-01" aria-hidden="true"></span><span class="truncate">{{ file.nameHtml }}</span>
                  </a>
                  @endif
                </li>
              @endforeach
            </ul>
          @endif
          @if(turn.canRewindConversation)
          <div hidden :hidden="!canEditEarlierPrompt({{ turn.id }})" class="mb-3 flex justify-end">
            <button type="button" data-edit-earlier-prompt @click="openRewindDialog({{ turn.id }}, $event)" :disabled="Boolean(conversationRewind()) || !sessionOnline()" class="flex gap-1.5 items-center px-2 min-h-8 text-neutral-600 text-xs hover:bg-black/5 rounded-md dark:text-neutral-300 dark:hover:bg-white/10">
              <span class="size-4 i-hugeicons-pencil-edit-01" aria-hidden="true"></span>Edit from here
            </button>
          </div>
          @endif
          @if(turn.contextCompacted)<p data-context-compacted class="mb-4 text-center text-neutral-600 text-xs dark:text-neutral-300">Context compacted</p>@endif
          @foreach(turn.steered as message)
            <div data-steered-message class="mb-3 ps-3 border-blue-500/40 border-s-2">
              <div class="mb-1 font-medium text-[12px] text-neutral-600 dark:text-neutral-400">You followed up</div>
              <div data-steering-text class="break-words text-[13px] whitespace-pre-wrap">{{ message.text }}</div>
            </div>
          @endforeach
          {{--
            What the agent ran, before what it said. These were in the log from
            the start and rendered nowhere, so the transcript showed a reply
            with no evidence behind it.
          --}}
          <div data-tools>
          @foreach(turn.toolCalls as call)
            <div class="flex gap-[6px] items-center mb-1 text-[12px]" data-tool-call="{{ call.callId }}" data-tool-state="{{ call.state }}">
              <span class="tool-dot" aria-hidden="true"></span>
              <span class="font-mono opacity-70">{{ call.name }}</span>
            </div>
          @endforeach
          </div>
          @foreach(turn.inputRequests as request)
            <div data-question-activity class="mb-2 text-[12px] text-neutral-600 dark:text-neutral-400">
              {{ request.outcome === 'answered' ? 'Question answered' : request.outcome === 'declined' ? 'Question declined' : 'Question interrupted' }}
              @foreach(request.attachments as file)
                <a class="block break-words underline" href="/s/{{ activeSession.id }}/question-attachments/{{ file.id }}" download>{!! file.nameHtml !!}</a>
              @endforeach
            </div>
          @endforeach
          @if(turn.response)<div class="mb-1 font-medium text-[12px] opacity-50">Agent</div>@endif
          <div class="transcript-markdown" data-response data-ssr-response="{{ turn.id }}"></div>
          @if(turn.status === 'interrupted')<p data-turn-interrupted class="mt-2 text-neutral-600 text-xs dark:text-neutral-300">Response interrupted</p>@endif
          @if(turn.reviewRepositories.length)
          <template :for="reviewTurn in [{{ turn.id }}]" :key="reviewTurn">
            @includeWhen(activeSession, '../partials/harness-turn-file-summary')
          </template>
          <button type="button" data-open-turn-diff aria-controls="harness-changes" :data-turn-file-review="turnDiffs()[{{ turn.id }}]?.length ? String({{ turn.id }}) : ''"
            :hidden="!canOpenTurnDiff({{ turn.id }})" :aria-expanded="diffOpen() && diffReviewMode() === 'turn' && diffTurn() === String({{ turn.id }}) ? 'true' : 'false'"
            @click="openTurnDiff({{ turn.id }}, $event)" class="harness-response-action">
            <span class="inline-block size-4 i-hugeicons-file-01" aria-hidden="true"></span><span>Open diff</span>
          </button>
          @endif
          @if(turn.status === 'complete' && turn.response)
            <button type="button" data-fork-response aria-label="Fork from this response" title="Fork from this response"
              @click="forkResponse({{ turn.id }})" :disabled="forkingResponseId() !== 0" @if(!turn.forkable || (initialFork && initialFork.state !== 'ready') || initialNavigation.archivedAt)hidden@endif :hidden="!canForkResponse({{ turn.id }})" class="harness-response-action"><span class="inline-block size-4 i-hugeicons-git-branch" aria-hidden="true"></span>
                <span>Fork</span>
            </button>
          @endif
          {{--
            Undo this turn. Only offered where a snapshot exists: a workspace
            that is not a repository has nothing to revert to, and a disabled
            button that never explains itself is worse than no button.
          --}}
          @if(turn.checkpointId)
            <button
              type="button"
              data-revert="{{ turn.checkpointId }}"
              class="mt-2 px-2 py-[2px] text-[11px] border border-black/10 rounded-[6px] dark:border-white/15 opacity-60 hover:opacity-100"
              :hidden="uiBusy()"
              :disabled="Boolean(revertingId()) || !sessionOnline()"
              :text="revertingId() === {{ turn.checkpointId }} ? 'Reverting…' : 'Revert this turn'"
              @click="revertTurn({{ turn.id }})"
            >Revert this turn</button>
          @endif
        </article>
        @if(initialFork && initialFork.sourceTurnId === turn.id)
          @include('../partials/harness-fork-lineage')
        @endif
      @endforeach

      @if(liveTurn)
        <article class="mb-5" data-turn="{{ liveTurn.id }}" id="turn-{{ liveTurn.id }}" data-live>
          @if(liveTurn.switchedProvider)<p data-provider-switch class="mb-3 text-center text-neutral-600 text-xs dark:text-neutral-300">Continued with {{ providerDisplayName(liveTurn.switchedProvider) }}</p>@endif
          @if(liveTurn.modelChange)<p data-model-change class="mb-3 text-center text-neutral-600 text-xs dark:text-neutral-300">Switched to {{ liveTurn.modelChange }}</p>@endif
          @if(liveTurn.freshContext)<p data-fresh-context class="mb-3 text-center text-neutral-600 text-xs dark:text-neutral-300">New session</p>@endif
          @if(!liveTurn.automaticCompaction)<div class="sr-only">You</div>@endif
          @if(liveTurn.automaticCompaction)<p data-automatic-compaction class="mb-1 text-end text-neutral-600 text-xs dark:text-neutral-300">Harness</p>@endif
          <div data-user-prompt class="mb-4 ms-auto px-3 py-2 max-w-[90%] w-fit rounded-xl whitespace-pre-wrap break-words text-sm leading-5">{{ liveTurn.prompt }}</div>
          @if(liveTurn.attachments.length)
            <ul aria-label="Message attachments" class="flex flex-wrap gap-2 justify-end mb-4">
              @foreach(liveTurn.attachments as file)
                <li class="max-w-full min-w-0">
                  @if(file.image)
                    <button type="button" data-preview-sent-image="{{ file.id }}" @click="openSentImage" class="flex gap-2 items-center p-1.5 max-w-full text-[12px] border border-black/15 rounded-lg dark:border-white/20">
                      <img src="/composer-attachments/{{ file.id }}?session={{ activeSession.id }}&amp;preview=1" loading="lazy" width="32" height="32" alt="" class="object-cover shrink-0 size-8 rounded">
                      <span class="sr-only">Preview </span><span data-attachment-name class="truncate">{{ file.nameHtml }}</span>
                    </button>
                  @else
                  <a data-sent-attachment href="/composer-attachments/{{ file.id }}?session={{ activeSession.id }}" download class="flex items-center gap-2 px-2 min-h-8 text-[12px] border border-black/15 rounded-lg dark:border-white/20">
                    <span class="shrink-0 size-4 i-hugeicons-attachment-01" aria-hidden="true"></span><span class="truncate">{{ file.nameHtml }}</span>
                  </a>
                  @endif
                </li>
              @endforeach
            </ul>
          @endif
          <div hidden :hidden="!canEditEarlierPrompt({{ liveTurn.id }})" class="mb-3 flex justify-end">
            <button type="button" data-edit-earlier-prompt @click="openRewindDialog({{ liveTurn.id }}, $event)" :disabled="Boolean(conversationRewind()) || !sessionOnline()" class="flex gap-1.5 items-center px-2 min-h-8 text-neutral-600 text-xs hover:bg-black/5 rounded-md dark:text-neutral-300 dark:hover:bg-white/10">
              <span class="size-4 i-hugeicons-pencil-edit-01" aria-hidden="true"></span>Edit from here
            </button>
          </div>
          <p data-context-compacted @if(!liveTurn.contextCompacted)hidden@endif :hidden="ssrCompactedTurn() !== {{ liveTurn.id }}" class="mb-4 text-center text-neutral-600 text-xs dark:text-neutral-300">Context compacted</p>
          <div data-steering-history>
            @foreach(liveTurn.steered as message)
              <div data-steered-message class="mb-3 ps-3 border-blue-500/40 border-s-2">
                <div class="mb-1 font-medium text-[12px] text-neutral-600 dark:text-neutral-400">You followed up</div>
                <div data-steering-text class="break-words text-[13px] whitespace-pre-wrap">{{ message.text }}</div>
              </div>
            @endforeach
          </div>
          <div data-tools>
          {{--
            The static state is the SSR truth; the binding overlays what
            finished after this page rendered. Tools finish out of order, so
            every row reads the result map by its own id.
          --}}
          @foreach(liveTurn.toolCalls as call)
            <div class="flex gap-[6px] items-center mb-1 text-[12px]" data-tool-call="{{ call.callId }}" data-tool-state="{{ call.state }}" :data-tool-state="toolResults()['{{ call.callId }}'] || '{{ call.state }}'">
              <span class="tool-dot" aria-hidden="true"></span>
              <span class="font-mono opacity-70">{{ call.name }}</span>
            </div>
          @endforeach
          {{-- Tools this turn starts after page load render here, after the server-drawn rows. --}}
          <template :for="call in ssrTools" :key="call.callId">
            <div class="flex gap-[6px] items-center mb-1 text-[12px]" :data-tool-call="call.callId" :data-tool-state="toolResults()[call.callId] || 'running'">
              <span class="tool-dot" aria-hidden="true"></span>
              <span class="font-mono opacity-70" :text="call.name"></span>
            </div>
          </template>
          </div>
          <template :for="request in ssrInputActivity()" :key="request.requestId">
            <div data-question-activity :data-question-request="request.requestId" class="mb-2 text-[12px] text-neutral-600 dark:text-neutral-400">
              <span :text="questionActivityLabel(request.outcome)"></span>
            </div>
          </template>
          <div @if(!liveTurn.response && sessionState !== 'running')hidden@endif
            :hidden="!ssrHasResponse() && (runningTurnId() !== initialResponseTurn || uiState() !== 'running' || waitingForProjectSetup())"
            class="mb-1 font-medium text-[12px] opacity-50">Agent</div>
          {{--
            A page can load mid-turn before any token exists; the dots hold
            that gap too, and the first streamed byte hides them.
          --}}
          @if(!liveTurn.response)
            <div data-thinking class="thinking-dots" @if(sessionState !== 'running')hidden@endif :hidden="ssrHasResponse() || uiState() !== 'running' || runningTurnId() !== initialResponseTurn || waitingForProjectSetup()" aria-label="Waiting for the agent"><span></span><span></span><span></span></div>
          @endif
          <div class="transcript-markdown" data-response data-live-response data-ssr-response="{{ liveTurn.id }}"></div>
          <p data-turn-interrupted @if(!initialInterrupted)hidden@endif :hidden="!ssrInterrupted()" class="mt-2 text-neutral-600 text-xs dark:text-neutral-300">Response interrupted</p>
          <template :for="reviewTurn in [{{ liveTurn.id }}]" :key="reviewTurn">
            @includeWhen(activeSession, '../partials/harness-turn-file-summary')
          </template>
          <button type="button" data-open-turn-diff aria-controls="harness-changes" :data-turn-file-review="turnDiffs()[{{ liveTurn.id }}]?.length ? String({{ liveTurn.id }}) : ''"
            @if(!liveTurn.reviewRepositories.length)hidden@endif :hidden="!canOpenTurnDiff({{ liveTurn.id }})" :aria-expanded="diffOpen() && diffReviewMode() === 'turn' && diffTurn() === String({{ liveTurn.id }}) ? 'true' : 'false'"
            @click="openTurnDiff({{ liveTurn.id }}, $event)" class="harness-response-action">
            <span class="inline-block size-4 i-hugeicons-file-01" aria-hidden="true"></span><span>Open diff</span>
          </button>
            <button type="button" data-fork-response aria-label="Fork from this response" title="Fork from this response"
              @click="forkResponse({{ liveTurn.id }})" :disabled="forkingResponseId() !== 0"
              @if(!liveTurn.forkable || (initialFork && initialFork.state !== 'ready') || initialNavigation.archivedAt)hidden@endif :hidden="!canForkResponse({{ liveTurn.id }})" class="harness-response-action"><span class="inline-block size-4 i-hugeicons-git-branch" aria-hidden="true"></span>
                <span>Fork</span>
            </button>
          {{--
            The newest turn is the one people most want to undo, and it was the
            only one without the button because it is not in `settledTurns`.
            Hidden while it is still running — the reducer refuses a revert
            mid-turn anyway, since restoring files under a working agent leaves
            it editing a tree that changed for reasons it cannot see.
          --}}
          @if(liveTurn.checkpointId)
            <button
              type="button"
              data-revert="{{ liveTurn.checkpointId }}"
              class="mt-2 px-2 py-[2px] text-[11px] border border-black/10 rounded-[6px] dark:border-white/15 opacity-60 hover:opacity-100"
              :hidden="uiBusy()"
              :disabled="Boolean(revertingId()) || !sessionOnline()"
              :text="revertingId() === {{ liveTurn.checkpointId }} ? 'Reverting…' : 'Revert this turn'"
              @click="revertTurn({{ liveTurn.id }})"
            >Revert this turn</button>
          @endif
        </article>
        @if(initialFork && initialFork.sourceTurnId === liveTurn.id)
          @include('../partials/harness-fork-lineage')
        @endif
      @endif

      {{--
        Turns started on this page. The island pushes into `liveTurns` and the
        runtime renders the rows — the keyed reuse means a streaming response
        updates its own article in place. Prompts and tool names stay plain text.
      --}}
      <template :for="turn in liveTurns" :key="turn.id">
        <article class="mb-5" :data-turn="turn.id" :id="'turn-' + turn.id">
          <p data-provider-switch hidden :hidden="!turn.providerSwitch" :text="turn.providerSwitch" class="mb-3 text-center text-neutral-600 text-xs dark:text-neutral-300"></p>
          <p data-model-change :hidden="!turn.modelChange" :text="turn.modelChange ? 'Switched to ' + turn.modelChange : ''" class="mb-3 text-center text-neutral-600 text-xs dark:text-neutral-300"></p>
          <p data-fresh-context hidden :hidden="!turn.freshContext" class="mb-3 text-center text-neutral-600 text-xs dark:text-neutral-300">New session</p>
          <div class="sr-only" :hidden="turn.automaticCompaction">You</div>
          <p data-automatic-compaction hidden :hidden="!turn.automaticCompaction" class="mb-1 text-end text-neutral-600 text-xs dark:text-neutral-300">Harness</p>
          <div data-user-prompt class="mb-4 ms-auto px-3 py-2 max-w-[90%] w-fit rounded-xl whitespace-pre-wrap break-words text-sm leading-5" :text="turn.prompt"></div>
          <ul :hidden="!turn.attachments?.length" aria-label="Message attachments" class="flex flex-wrap gap-2 justify-end mb-4">
            <template :for="file in turn.attachments ?? []" :key="file.id">
              <li class="max-w-full min-w-0">
                <button type="button" :data-preview-sent-image="file.id" :hidden="!file.image" @click="openSentImage" class="flex gap-2 items-center p-1.5 max-w-full text-[12px] border border-black/15 rounded-lg dark:border-white/20">
                  <img :src="file.image ? sentAttachmentUrl(file.id) + '&preview=1' : null" loading="lazy" width="32" height="32" alt="" class="object-cover shrink-0 size-8 rounded">
                  <span class="sr-only">Preview </span><span data-attachment-name class="truncate" :text="file.name"></span>
                </button>
                <a data-sent-attachment :hidden="file.image" :href="sentAttachmentUrl(file.id)" download class="flex items-center gap-2 px-2 min-h-8 text-[12px] border border-black/15 rounded-lg dark:border-white/20">
                  <span class="shrink-0 size-4 i-hugeicons-attachment-01" aria-hidden="true"></span><span class="truncate" :text="file.name"></span>
                </a>
              </li>
            </template>
          </ul>
          <div hidden :hidden="!canEditEarlierPrompt(turn.id)" class="mb-3 flex justify-end">
            <button type="button" data-edit-earlier-prompt @click="openRewindDialog(turn.id, $event)" :disabled="Boolean(conversationRewind()) || !sessionOnline()" class="flex gap-1.5 items-center px-2 min-h-8 text-neutral-600 text-xs hover:bg-black/5 rounded-md dark:text-neutral-300 dark:hover:bg-white/10">
              <span class="size-4 i-hugeicons-pencil-edit-01" aria-hidden="true"></span>Edit from here
            </button>
          </div>
          <p data-context-compacted hidden :hidden="!turn.contextCompacted" class="mb-4 text-center text-neutral-600 text-xs dark:text-neutral-300">Context compacted</p>
          <div data-steering-history></div>
          <div data-tools>
            <template :for="call in turn.tools" :key="call.callId">
              <div class="flex gap-[6px] items-center mb-1 text-[12px]" :data-tool-call="call.callId" :data-tool-state="toolResults()[call.callId] || 'running'">
                <span class="tool-dot" aria-hidden="true"></span>
                <span class="font-mono opacity-70" :text="call.name"></span>
              </div>
            </template>
          </div>
          <template :for="request in turn.inputRequests" :key="request.requestId">
            <div data-question-activity :data-question-request="request.requestId" class="mb-2 text-[12px] text-neutral-600 dark:text-neutral-400">
              <span :text="questionActivityLabel(request.outcome)"></span>
            </div>
          </template>
          <div :hidden="!turn.hasResponse && (runningTurnId() !== turn.id || uiState() !== 'running' || waitingForProjectSetup())"
            class="mb-1 font-medium text-[12px] opacity-50">Agent</div>
          {{-- Until the first token: dots, not a label over blank space. --}}
          <div data-thinking class="thinking-dots" :hidden="turn.hasResponse || uiState() !== 'running' || runningTurnId() !== turn.id || waitingForProjectSetup()" aria-label="Waiting for the agent"><span></span><span></span><span></span></div>
          <div class="transcript-markdown" data-response></div>
          <p data-turn-interrupted hidden :hidden="!turn.interrupted" class="mt-2 text-neutral-600 text-xs dark:text-neutral-300">Response interrupted</p>
          <button type="button" hidden :data-revert="rewindCheckpoints()[turn.id]?.id"
            :hidden="!rewindCheckpoints()[turn.id] || uiBusy()" :disabled="Boolean(revertingId()) || !sessionOnline()"
            class="harness-response-action" @click="revertTurn(turn.id)"
            :text="revertingId() && revertingId() === rewindCheckpoints()[turn.id]?.id ? 'Reverting…' : 'Revert this turn'">Revert this turn</button>
          <template :for="reviewTurn in [turn.id]" :key="reviewTurn">
            @includeWhen(activeSession, '../partials/harness-turn-file-summary')
          </template>
          <button type="button" data-open-turn-diff aria-controls="harness-changes" :data-turn-file-review="turnDiffs()[turn.id]?.length ? String(turn.id) : ''"
            hidden :hidden="!canOpenTurnDiff(turn.id)" :aria-expanded="diffOpen() && diffReviewMode() === 'turn' && diffTurn() === String(turn.id) ? 'true' : 'false'"
            @click="openTurnDiff(turn.id, $event)" class="harness-response-action">
            <span class="inline-block size-4 i-hugeicons-file-01" aria-hidden="true"></span><span>Open diff</span>
          </button>
            <button type="button" data-fork-response aria-label="Fork from this response" title="Fork from this response"
              @click="forkResponse(turn.id)" :disabled="forkingResponseId() !== 0"
              hidden :hidden="!canForkResponse(turn.id)" class="harness-response-action"><span class="inline-block size-4 i-hugeicons-git-branch" aria-hidden="true"></span>
                <span>Fork</span>
            </button>
        </article>
      </template>

      @if(activeSession)
        <template ref="steeringMessageBox">
          <div data-steered-message class="mb-3 ps-3 border-blue-500/40 border-s-2">
            <div class="mb-1 font-medium text-[12px] text-neutral-600 dark:text-neutral-400">You followed up</div>
            <div data-steering-text class="break-words text-[13px] whitespace-pre-wrap"></div>
          </div>
        </template>
      @endif
      @if(activeSession && workspaceEditorAllowed)
        <section data-project-setup-status hidden :hidden="!projectSetupStatus()" aria-label="Worktree setup" class="grid mb-4 p-3 text-neutral-700 text-sm dark:text-neutral-200 border border-black/10 rounded-md dark:border-white/15">
          <div class="flex flex-wrap gap-x-3 items-baseline justify-between min-w-0">
            <p class="break-words font-medium" :text="projectSetup()?.name"></p>
            <p role="status" class="text-neutral-600 text-xs dark:text-neutral-300" :text="projectSetupStatus()"></p>
          </div>
          <pre :hidden="!projectSetup()?.output" :text="projectSetup()?.output" class="overflow-hidden mt-2 p-2 break-words font-mono text-xs whitespace-pre-wrap bg-black/5 dark:bg-white/5 rounded"></pre>
          <div class="flex flex-wrap gap-x-3 items-center text-xs">
            <button type="button" :hidden="projectSetup()?.status === 'pending'" :disabled="!sessionOnline()" @click="viewProjectSetupTerminal" class="min-h-8 font-medium underline underline-offset-2">Open setup terminal</button>
            <button type="button" :disabled="!sessionOnline()" @click="openProjectScripts" class="min-h-8 font-medium underline underline-offset-2">Setup details</button>
          </div>
        </section>
        <section data-project-settlement-status hidden :hidden="!projectSettlementStatus()" aria-label="Settlement script" class="grid mb-4 p-3 text-neutral-700 text-sm dark:text-neutral-200 border border-black/10 rounded-md dark:border-white/15">
          <div class="flex flex-wrap gap-x-3 items-baseline justify-between min-w-0">
            <p class="break-words font-medium" :text="projectSettlement()?.name"></p>
            <p role="status" class="text-neutral-600 text-xs dark:text-neutral-300" :text="projectSettlementStatus()"></p>
          </div>
          <pre :hidden="!projectSettlement()?.output" :text="projectSettlement()?.output" class="overflow-hidden mt-2 p-2 break-words font-mono text-xs whitespace-pre-wrap bg-black/5 dark:bg-white/5 rounded"></pre>
          <div :hidden="!projectSettlementTerminalAvailable()" class="flex items-center text-xs">
            <button type="button" :disabled="!sessionOnline()" @click="viewProjectJobTerminal(projectSettlement())" class="min-h-11 font-medium underline underline-offset-2">Open settlement terminal</button>
          </div>
        </section>
      @endif
      @includeWhen(activeSession, '../partials/harness-follow-ups')
      @if(activeSession)
        <div data-thread-settled-note @if(!initialNavigation.settledAt || initialNavigation.archivedAt)hidden@endif :hidden="!threadNavigation().settledAt || !!threadNavigation().archivedAt" class="flex flex-wrap gap-x-3 items-center mb-3 text-neutral-600 text-sm dark:text-neutral-300">
          <span class="flex gap-1.5 items-center"><span class="size-4 i-hugeicons-checkmark-circle-02" aria-hidden="true"></span><span :text="threadNavigation().settledAutomatically ? 'Settled after inactivity' : 'Settled'">{{ initialNavigation.settledAutomatically ? 'Settled after inactivity' : 'Settled' }}</span></span>
          <button type="button" :disabled="threadActionBusy() || !sessionOnline()" @click="organizeThread('unsettle')" class="min-h-11 font-medium underline underline-offset-2">Un-settle</button>
        </div>
      @endif
    </div>
    @if(activeSession)
      @include('../partials/harness-transcript-find')
      <p class="sr-only" role="status" :text="transcriptAnnouncement()"></p>
    @endif
    </div>

    @if(activeSession)
      <button type="button" data-jump-to-latest @click="jumpToLatest" hidden :hidden="followingTranscript()" class="px-3 font-medium text-[12px] bg-white dark:bg-neutral-900 border border-black/15 rounded-full dark:border-white/20">Jump to latest</button>
      <div data-thread-archived @if(!initialNavigation.archivedAt)hidden@endif :hidden="!threadNavigation().archivedAt" class="mx-auto mb-3 px-3 py-2 flex gap-2 items-center text-sm border border-black/10 rounded-md dark:border-white/15">
        <span>Archived thread</span>
        <button type="button" @click="organizeThread('restore')" :disabled="threadActionBusy()" class="font-medium underline">Restore thread</button>
      </div>
    @endif

    @includeWhen(activeSession, '../partials/harness-approval-card')
    @includeWhen(activeSession, '../partials/harness-question-card')

    @if(activeSession)
      <p data-rewind-status role="status" @if(!initialRewind && !initialRewindNotice)hidden@endif :hidden="!revertingId() && !rewindNotice()" :text="revertingId() ? 'Restoring files…' : rewindNotice()" class="mb-2 mx-auto text-neutral-600 text-xs dark:text-neutral-300"></p>
      <div data-conversation-rewind hidden :hidden="!conversationRewind() && !conversationRewindNotice() && !restoredPromptError() && !canRestoreEarlierPrompt()" class="flex flex-wrap gap-2 items-center justify-center mb-2 text-neutral-600 text-xs dark:text-neutral-300">
        <p role="status" :text="conversationRewind()?.status === 'running' ? 'Rewinding conversation…' : conversationRewind()?.status === 'restoring-files' ? 'Restoring worktree files…' : conversationRewindNotice()"></p>
        <p role="alert" hidden :hidden="!restoredPromptError()" :text="restoredPromptError()"></p>
        <button type="button" data-check-conversation-rewind hidden :hidden="conversationRewind()?.status !== 'uncertain'" :disabled="!sessionOnline()" @click="submitConversationRewind(conversationRewind()?.turnId, false, true)" class="px-2 min-h-8 font-medium underline underline-offset-2">Check provider history</button>
        <button type="button" data-restore-earlier-prompt hidden :hidden="!canRestoreEarlierPrompt()" :disabled="startPending() || composerFilesPending()" @click="restoreEarlierPrompt" class="px-2 min-h-8 font-medium underline underline-offset-2">Restore earlier prompt</button>
      </div>
      <p data-worktree-setup role="status" @if(!initialWorktreeSetup || sessionState !== 'running')hidden@endif :hidden="!worktreeSetup() || !uiBusy()" class="mb-2 mx-auto text-neutral-600 text-xs dark:text-neutral-300">Preparing the project worktree</p>
      <p data-session-error role="alert" @if(!initialSessionError)hidden@endif :hidden="!sessionError() || projectSetupOwnsError()" :text="sessionError()" class="mx-auto mb-2 px-3 py-2 max-h-28 shrink-0 overflow-auto break-words text-sm text-red-700 border border-red-500/30 rounded-md dark:text-red-300">{{ initialSessionError }}</p>
    @endif

    @if(canCompose)
    <form data-composer :data-steer-ready="canSteer()" :data-session-online="sessionOnline()" @if(initialInputs.length || initialNavigation.archivedAt || (initialFork && initialFork.state !== 'ready'))hidden@endif :hidden="Boolean(inputRequest() || threadNavigation().archivedAt || forkStatus() !== 'ready')" @submit.prevent="sendPrompt()" @dragover="composerDragOver" @drop="composerFileActions()?.drop($event)" class="grid gap-2 items-end shrink-0">
      {{--
        Enter sends, Shift+Enter makes a newline — the convention every chat
        surface uses; the textarea would otherwise only ever insert newlines.
      --}}
      <div data-fresh-session-banner hidden :hidden="!freshSessionArmed()" class="flex flex-wrap gap-2 items-center justify-between px-2 py-1.5 text-[13px] bg-neutral-100 dark:bg-white/10 rounded-md">
        <p role="status">Your next message starts a fresh session</p>
        <button type="button" @click="keepCurrentProviderSession" class="px-2 min-h-8 font-medium hover:bg-black/5 dark:hover:bg-white/10 rounded-md">Keep current session</button>
      </div>
      <div data-clear-command-menu hidden :hidden="!offerClearCommand()" aria-label="Composer commands" role="group" class="px-1 py-1 text-[13px]">
        <button type="button" data-clear-command ref="clearCommandBox" @click="armFreshProviderSession" class="flex gap-2 items-center px-2 min-h-9 w-full text-start hover:bg-black/5 dark:hover:bg-white/10 rounded-md">
          <kbd class="font-medium font-mono">/clear</kbd>
          <span class="text-neutral-600 dark:text-neutral-300">Start a fresh session</span>
        </button>
      </div>
      @include('../partials/harness-composer-file-menu')
      @include('../partials/harness-composer-attachments')
      <textarea
        data-prompt
        @paste="composerFileActions()?.paste($event)"
        ref="promptBox"
        @keydown="promptKeydown"
        @input="promptEdited"
        @compositionstart="closeComposerFiles"
        @compositionend="updateComposerFiles"
        @blur="closeComposerFiles"
        aria-controls="composer-file-options"
        aria-autocomplete="list"
        :aria-activedescendant="(composerFileMenu()?.selected ?? -1) >= 0 ? 'composer-file-option-' + composerFileMenu().selected : null"
        :readonly="stashBusy()"
        @keyup="composerKeyup"
        @select="rememberPrompt"
        @click="composerCaretMoved"
        rows="2"
        :rows="Math.min(7, Math.max(2, composerText().split('\n').length + 1))"
        aria-label="Message"
        placeholder="{{ promptPlaceholder }}"
        :placeholder="composerPlaceholder()"
        class="px-1 py-1 min-h-[46px] max-h-[30dvh] min-w-0 text-sm bg-transparent outline-none resize-none"
      ></textarea>
      <p data-handoff-hint role="status" hidden :hidden="!pendingProviderSwitch()" :text="handoffHint()" class="text-neutral-600 text-xs dark:text-neutral-300"></p>
      <div data-composer-toolbar>
        <div class="flex gap-1 items-center shrink-0 me-auto">
          <button type="button" data-attach-composer @click="chooseComposerFilesDialog" :hidden="Boolean(editingFollowUp())" :disabled="!composerFileActions() || startPending()" aria-label="Attach files" title="Attach files" class="shrink-0 harness-icon-button">
            <span class="size-4 i-hugeicons-attachment-01" aria-hidden="true"></span>
          </button>
          <button type="button" data-open-stash ref="promptStashButton" @click="openPromptStash" :hidden="Boolean(editingFollowUp())" :disabled="!stashReady()" aria-haspopup="dialog" :aria-label="stashEntries().length ? 'Stashed prompts (' + stashEntries().length + ')' : 'Stashed prompts'" :aria-keyshortcuts="shortcutKeys('composer.stash')" title="Stashed prompts" class="shrink-0 harness-icon-button">
            <span class="size-4 i-hugeicons-bookmark-01" aria-hidden="true"></span>
          </button>
        </div>
        <div data-composer-provider-controls>
        @include('../partials/harness-model-picker')
        </div>
        <div data-composer-actions class="flex flex-wrap gap-2 justify-end">
          <button type="button" data-discard-composer hidden :hidden="!canDiscardComposer()" @click="discardCurrentDraft" aria-label="Discard draft" title="Discard draft" class="harness-icon-button">
            <span class="size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
          </button>
          <button type="button" data-idle-compaction hidden :hidden="!idleCompactionOffer()" @click="toggleIdleCompaction" :aria-pressed="compactNextPrompt()" :aria-label="idleCompactionLabel()" :title="idleCompactionLabel()" class="px-2 min-h-8 text-[12px] border border-black/10 rounded-full dark:border-white/20" :text="idleCompactionChip()"></button>
          <button type="submit" data-send data-primary-send="true" :data-primary-send="sendLabel() === 'Send'" :aria-label="compactNextPrompt() ? 'Compact and send' : sendLabel()" :hidden="!showSend()" :disabled="!hasComposerMessage() || composerFilesPending() || startPending() || conversationRewind() || sessionConnecting() || handoffBlocked() || (sendLabel() === 'Steer' && steeringPending())" class="h-8 text-[13px] rounded-full">
            <span class="size-4 i-hugeicons-arrow-up-02" data-send-icon aria-hidden="true"></span>
            <span data-send-text :text="sendLabel()">Send</span>
          </button>
          <span class="md:hidden" :hidden="!canSteerDraft() || !composerText().trim() || Boolean(editingFollowUp())">
            <button type="button" :disabled="startPending() || (oppositeFollowUp() === 'steer' && steeringPending())" :text="oppositeFollowUp() === 'steer' ? 'Steer' : 'Queue'" @click="sendPrompt(oppositeFollowUp())" class="px-3 h-[36px] text-[13px] border border-black/15 rounded-[8px] dark:border-white/20">Steer</button>
          </span>
          <button type="button" :hidden="!editingFollowUp()" @click="followUpActions()?.endEdit()" class="px-3 h-[36px] text-[13px] border border-black/15 rounded-[8px] dark:border-white/20">Cancel</button>
          <button type="button" data-resume-queue :hidden="!showResume()" :disabled="!sessionOnline() || queueActionPending()" @click="followUpActions()?.run('send')" class="px-4 h-8 text-[13px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-full">Resume</button>
          <button type="button" data-stop hidden :hidden="!uiBusy() || stopPressed()" :disabled="!sessionOnline()" @click="stopTurn" class="px-4 h-8 text-[13px] text-white bg-red-600 rounded-full hover:bg-red-700">Stop</button>
        </div>
      </div>
      <p data-prompt-stash-error role="alert" :hidden="stashOpen() || !stashError()" :text="stashError()" class="text-red-700 text-sm dark:text-red-300"></p>
    </form>
    @include('../partials/harness-prompt-stash')
    @endif
    @if(!activeSession && draftProjectChoices.length)
      <div data-draft-context>
        <label class="flex gap-2 items-center text-[12px] text-neutral-600 dark:text-neutral-300">
          <span class="inline-block shrink-0 size-4 i-hugeicons-folder-01" aria-hidden="true"></span>
          <span class="sr-only">Project</span>
          <select data-draft-project @change="chooseProject" class="px-2 h-8 max-w-[min(65vw,320px)] text-neutral-900 dark:text-neutral-100 bg-transparent rounded-md">
            <option value="none" @if(draftWithoutProject)selected@endif>No project</option>
            @foreach(draftProjectChoices as workspace)
              <option value="{{ workspace.id }}" @if(workspace.id === draftProject?.id)selected@endif>{{ workspace.name }}</option>
            @endforeach
          </select>
        </label>
        @if(draftProject?.trusted)
          @include('../partials/harness-composer-worktree')
        @endif
      </div>
    @endif
    @if(activeWorkspaceId)
    <section id="harness-terminal" data-terminal hidden :hidden="!termOpen()" :style="{ '--terminal-dock-height': terminalHeight() + 'dvh' }" aria-label="Terminal" class="terminal-panel">
      <div data-terminal-resize role="separator" tabindex="0" aria-label="Resize terminal dock" aria-orientation="horizontal" aria-controls="harness-terminal-output"
        aria-valuemin="22" aria-valuemax="58" :aria-valuenow="String(terminalHeight())" :aria-valuetext="terminalHeight() + '% of window'"
        @keydown="resizeTerminalByKey" @pointerdown="beginTerminalResize" @pointermove="moveTerminalResize" @pointerup="endTerminalResize" @pointercancel="cancelTerminalResize" @lostpointercapture="cancelTerminalResize"></div>
      <div data-terminal-toolbar>
        <div ref="terminalTabStrip" data-terminal-tabs role="tablist" aria-label="Terminal tabs" @keydown="terminalTabKeydown">
          <button :for="group in terminalGroups()" :key="group.key" type="button" role="tab" :id="'terminal-tab-' + group.key"
            :aria-selected="group.key === activeTerminalGroup() ? 'true' : 'false'" :tabindex="group.key === activeTerminalGroup() ? 0 : -1"
            aria-controls="harness-terminal-output" @click="selectTerminalGroup(group.key)" :text="group.label"></button>
        </div>
        <div class="flex items-center shrink-0">
          <span data-terminal-activity role="status" hidden :hidden="!terminalStatus()" :text="terminalStatus()" class="px-2 text-xs"></span>
          <button type="button" data-terminal-restart hidden :hidden="!canRestartTerminal()" :disabled="terminalBusy() || !sessionOnline()" @click="restartTerminal" aria-label="Restart terminal" title="Restart terminal" class="px-2 h-8 text-xs rounded-md">
            <span data-terminal-restart-icon class="size-4 i-hugeicons-refresh" aria-hidden="true"></span>
            <span data-terminal-restart-label>Restart terminal</span>
          </button>
          <button type="button" aria-label="New terminal" :title="terminalShortcutTitle('terminal.new')" :aria-keyshortcuts="shortcutKeys('terminal.new')" :disabled="terminalBusy() || !sessionOnline()" @click="addTerminalTab()" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-add-01" aria-hidden="true"></span>
          </button>
          <button type="button" data-terminal-split="columns" aria-label="Split terminal side by side" :title="terminalShortcutTitle('terminal.split')" :aria-keyshortcuts="shortcutKeys('terminal.split')" :disabled="!canSplitTerminal()" @click="addTerminalTab('columns')" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-layout-2-column" aria-hidden="true"></span>
          </button>
          <button type="button" data-terminal-split="rows" aria-label="Split terminal top and bottom" :title="terminalShortcutTitle('terminal.splitVertical')" :aria-keyshortcuts="shortcutKeys('terminal.splitVertical')" :disabled="!canSplitTerminal()" @click="addTerminalTab('rows')" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-layout-2-row" aria-hidden="true"></span>
          </button>
          <button type="button" aria-label="End terminal session" :title="terminalShortcutTitle('terminal.close')" :aria-keyshortcuts="shortcutKeys('terminal.close')" hidden :hidden="!activeTerminalTab()" :disabled="terminalBusy() || !sessionOnline()" @click="endTerminal" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-stop" aria-hidden="true"></span>
          </button>
          <button type="button" aria-label="Hide terminal dock" title="Hide terminal dock" @click="toggleTerminal" class="harness-icon-button">
            <span class="inline-block size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
          </button>
        </div>
      </div>
      <div data-terminal-pane-picker role="group" aria-label="Terminals in split" :hidden="visibleTerminalTabs().length < 2">
        <button :for="pane in visibleTerminalTabs()" :key="pane.key" type="button" :aria-pressed="pane.key === terminalTabs().activeKey ? 'true' : 'false'" @click="focusTerminalPane(pane.key)" :text="'Terminal ' + pane.number"></button>
      </div>
      <div id="harness-terminal-output" data-terminal-output ref="termSurface" role="tabpanel"
        :aria-labelledby="activeTerminalGroup() ? 'terminal-tab-' + activeTerminalGroup() : null" :data-direction="terminalDirection()">
        <div :for="pane in visibleTerminalTabs()" :key="pane.key" data-terminal-pane :data-active="pane.key === terminalTabs().activeKey ? 'true' : 'false'">
          <p data-terminal-error role="alert" hidden :hidden="!terminalStates()[pane.key]?.error" :text="terminalStates()[pane.key]?.error || ''" class="px-3 py-2 text-red-300 text-sm"></p>
          <div role="group" :data-terminal-host="pane.key" :aria-label="(terminalStates()[pane.key]?.shell || 'Terminal') + ' ' + pane.number + ' input and output'"
            @focus="focusTerminalInput(pane.key)" @blur="blurTerminalInput($event)" @keydown="termKeydown(pane, $event)" @paste="terminalController()?.paste(pane.key, $event)"
            @scroll="terminalController()?.track(pane.key, $event)" tabindex="0" class="terminal-host">
            <span data-term-metric aria-hidden="true" class="term-metric">0123456789</span>
            <div data-terminal-screen></div>
          </div>
        </div>
      </div>
    </section>
  @endif
    </div>
    @if(draftProject || activeSession || draftWithoutProject)
      <button type="button" data-workspace-actions-scrim hidden tabindex="-1" :hidden="!workspaceActionsOpen()" @click="closeWorkspaceActions" aria-label="Close workspace actions"></button>
      <aside data-workspace-rail aria-label="Workspace tools">
        <div id="harness-workspace-actions" data-workspace-actions :data-open="workspaceActionsOpen() ? 'true' : 'false'">
          @if(workspaceName || activeScratchSession || draftWithoutProject)
            <div data-workspace-context>
              <span class="inline-block size-4 i-hugeicons-folder-01" aria-hidden="true"></span>
              <span class="min-w-0 truncate" title="{{ workspaceName || 'No project' }}">{{ workspaceName || 'No project' }}</span>
            </div>
          @endif
        {{--
          Changes sit behind a toggle rather than always-on. Reading a repository
          costs a subprocess, and most page loads never look at the diff.
        --}}
        @if(activeSession && !activeSession.scratch)
        <button
          type="button"
          data-diff-toggle
          aria-controls="harness-changes"
          class="px-2 py-[3px] text-[12px] border border-black/10 rounded-[6px] dark:border-white/15"
          aria-expanded="false"
          :aria-expanded="diffOpen() ? 'true' : 'false'"
          @click="toggleDiff"
        ><span class="inline-block size-4 i-hugeicons-file-02" aria-hidden="true"></span><span>Changes</span></button>
        @endif
        @if(hasWorkspaceFiles)
          <button type="button" data-files-toggle @click="toggleWorkspaceFiles" aria-controls="harness-workspace-files" :aria-expanded="workspaceFilesOpen() ? 'true' : 'false'">
            <span class="inline-block size-4 i-hugeicons-folder-01" aria-hidden="true"></span><span>Files</span>
          </button>
        @endif
        @if(workspaceEditorAllowed)
          <button type="button" data-workspace-editor-menu @click="chooseWorkspaceEditor($event)" aria-haspopup="dialog" :aria-keyshortcuts="shortcutKeys('editor.open')">
            <span class="size-4 i-hugeicons-source-code" aria-hidden="true"></span><span>Open in editor</span>
          </button>
        @endif
        @if(activeWorkspaceId)
          @if(activeSession && workspaceEditorAllowed)
            <button type="button" data-project-scripts-toggle @click="openProjectScripts" aria-haspopup="dialog">
              <span class="size-4 i-hugeicons-play" aria-hidden="true"></span><span>Project scripts</span>
            </button>
          @endif
          <button type="button" data-terminal-toggle class="terminal-toggle" @click="toggleTerminal" aria-label="Toggle terminal" :title="terminalShortcutTitle('terminal.toggle')" :aria-keyshortcuts="shortcutKeys('terminal.toggle')" aria-controls="harness-terminal" aria-expanded="false" :aria-expanded="termOpen() ? 'true' : 'false'">
            <span class="inline-block size-4 i-hugeicons-command-line" aria-hidden="true"></span>
            <span>Terminal</span>
          </button>
        @endif
        <button type="button" data-preview-toggle @click="toggleBrowserPreview" aria-controls="harness-browser-preview" :aria-expanded="browserPreviewOpen() ? 'true' : 'false'">
          <span class="inline-block size-4 i-hugeicons-globe-02" aria-hidden="true"></span><span>Browser</span>
        </button>
        @if(activeScratchSession)
          <button type="button" data-promote-scratch @click="promoteScratchProject" :disabled="projectBusy()" class="px-2 h-8 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15">Turn into project</button>
        @endif
        @if(draftProject || activeSession || draftWithoutProject)
        <button type="button" data-project-add @click="openProjectPicker" class="flex gap-1.5 items-center shrink-0 px-2 h-8 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15" aria-label="Add project" title="Add project">
          <span class="inline-block size-4 i-hugeicons-folder-add" aria-hidden="true"></span>
          <span>Add project</span>
        </button>
        @endif
        @if(activeSession)
          <div data-context-window hidden :hidden="showContextWindow() !== true || !contextUsage()" class="grid gap-1 mt-1 mx-2 pb-2 pt-2 text-xs border-black/10 border-t dark:border-white/10">
            <div class="flex flex-wrap gap-x-2 items-baseline justify-between">
              <span class="font-medium text-neutral-600 dark:text-neutral-300">Context window</span>
              <span class="font-medium tabular-nums" :text="contextTokens()"></span>
            </div>
            <meter aria-label="Context window usage" :aria-valuetext="contextTokens()" hidden :hidden="!contextUsage()?.maxTokens" min="0" :max="contextUsage()?.maxTokens || 1" :low="(contextUsage()?.maxTokens || 1) * 0.8" :high="(contextUsage()?.maxTokens || 1) * 0.9" optimum="0" :value="Math.min(contextUsage()?.usedTokens || 0, contextUsage()?.maxTokens || 1)" class="block h-2 w-full"></meter>
          </div>
        @endif
      </div>
        @include('../partials/harness-workspace-diff')
        @if(hasWorkspaceFiles)
          @include('../partials/harness-workspace-files')
        @endif
        @include('../partials/harness-browser-preview')
      </aside>
    @endif
    </div>
  </main>

  @if(workspaceEditorAllowed)
    @include('../partials/harness-workspace-editor')
    @includeWhen(activeSession, '../partials/harness-project-scripts')
  @endif

  @if(activeSession)
    @include('../partials/harness-thread-actions')
    @include('../partials/harness-thread-arrangement')
    @include('../partials/harness-conversation-rewind')
  @endif

  @if(activeSessionId)
    @include('../partials/harness-sent-image')
  @endif

  <dialog data-thread-search ref="threadSearchDialogBox" aria-labelledby="thread-search-heading" @cancel="cancelThreadSearch" @click.self="closeThreadSearch" class="mb-auto mt-8 mx-auto p-0 md:mt-auto text-neutral-900 dark:text-neutral-100 bg-white dark:bg-neutral-900 border border-black/10 rounded-[12px] dark:border-white/15 shadow-xl">
    <div class="p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 id="thread-search-heading" class="font-semibold text-[14px]">Search threads</h2>
        <button type="button" @click="closeThreadSearch" aria-label="Close search" class="inline-flex items-center justify-center size-7 hover:bg-black/5 dark:hover:bg-white/10 rounded-[6px]">
          <span class="inline-block size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
        </button>
      </div>
      <input data-thread-search-input ref="threadSearchInputBox" type="search" maxlength="120" role="combobox" aria-label="Search thread titles and messages" aria-controls="thread-search-list" aria-autocomplete="list" aria-expanded="false" :aria-expanded="threadSearchResults().length ? 'true' : 'false'" :aria-activedescendant="selectedThreadSearchId()" @input="queueThreadSearch" @compositionend="queueThreadSearch" @keydown="threadSearchKeydown" autocomplete="off" placeholder="Search titles, projects, and messages" class="px-3 py-2 w-full text-[14px] bg-neutral-50 dark:bg-neutral-950 border border-black/15 rounded-[8px] dark:border-white/20" />
      <p role="status" :hidden="!threadSearchStatus()" :text="threadSearchStatus()" class="mt-2 text-[12px] text-neutral-600 dark:text-neutral-300"></p>
      <ul id="thread-search-list" data-thread-search-list ref="threadSearchListBox" role="listbox" aria-label="Matching threads" :hidden="!threadSearchResults().length" class="overflow-y-auto mt-2">
        <li :for="(result, index) in threadSearchResults()" :key="result.id" :id="'thread-search-result-' + result.id" data-thread-search-option role="option" :aria-selected="threadSearchIndex() === index ? 'true' : 'false'" @click="chooseThreadSearchResult(result)" class="px-3 py-2 rounded-[6px] cursor-pointer">
          <div class="flex gap-2 items-center justify-between">
            <span class="min-w-0 font-medium text-[13px] truncate" :text="result.title"></span>
            <span class="max-w-[40%] text-[11px] text-neutral-600 truncate dark:text-neutral-300" :text="result.project"></span>
          </div>
          <p :if="result.excerpt" class="mt-1 text-[12px] text-neutral-600 truncate dark:text-neutral-300" :text="result.excerpt"></p>
        </li>
      </ul>
    </div>
  </dialog>

  <dialog data-project-dialog ref="projectDialogBox" aria-labelledby="project-dialog-heading" class="m-auto p-0 text-neutral-900 dark:text-neutral-100 bg-white dark:bg-neutral-900 border border-black/10 rounded-[14px] dark:border-white/15 shadow-xl" @cancel="cancelProjectPicker">
    <form class="flex flex-col gap-4 p-5" @submit.prevent="registerProject">
      <div class="flex flex-col gap-1">
        <h2 id="project-dialog-heading" class="text-[17px] font-semibold">Add project</h2>
        <p class="text-[13px] text-neutral-600 dark:text-neutral-300">Enter the absolute path of a folder on the computer running Harness.</p>
      </div>
      <div class="flex flex-col gap-2">
        <label for="project-folder" class="text-[13px] font-medium">Folder path</label>
        <div class="flex gap-2">
          <input id="project-folder" data-project-path ref="projectPathBox" type="text" required autocomplete="off" spellcheck="false" :disabled="projectBusy()" class="px-3 py-2 w-full min-w-0 font-mono text-[13px] bg-neutral-50 dark:bg-neutral-950 border border-black/15 rounded-[8px] dark:border-white/20" />
          <button type="button" data-project-browse hidden :hidden="!hasFolderPicker()" :disabled="projectBusy()" @click="browseProject" class="px-3 text-[13px] border border-black/15 rounded-[8px] dark:border-white/20">Browse</button>
        </div>
      </div>
      <label class="flex gap-2 items-start text-[13px]">
        <input data-project-trust-checkbox ref="projectTrustBox" type="checkbox" :disabled="projectBusy()" class="mt-[3px] accent-neutral-900 dark:accent-neutral-100" />
        <span>Trust this folder for agent sessions</span>
      </label>
      <p data-project-error role="alert" :text="projectError()" :hidden="!projectError()" hidden class="text-[13px] text-red-700 dark:text-red-300"></p>
      <div class="flex gap-2 justify-end">
        <button type="button" :disabled="projectBusy()" @click="closeProjectPicker" class="px-3 h-9 text-[13px] border border-black/15 rounded-[8px] dark:border-white/20">Cancel</button>
        <button type="submit" data-project-submit :disabled="projectBusy()" :text="projectBusy() ? 'Adding…' : 'Add project'" class="px-3 h-9 text-[13px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-[8px]">Add project</button>
      </div>
    </form>
  </dialog>

  {{--
    The terminal (M6). Structure is server-rendered so the island only wires
    bytes and keys — no createElement, no injected styles (stx-standards §8,
    §11). Hidden until toggled; absent entirely when the session has no
    workspace, because a shell needs somewhere to open.
  --}}
  {{--
    Naming a new profile. Replaces window.prompt: the name arrives through a
    form the page owns, so it can be styled, cancelled and focused like
    everything else. Opened by the sidebar's spaceAdd event.
  --}}
  <div data-profile-modal hidden :hidden="!profileModalOpen()" @click.self="closeProfileModal" class="flex fixed inset-0 z-[70] items-center justify-center bg-black/40">
    <form @submit.prevent="createProfile" class="p-4 w-[320px] bg-white dark:bg-neutral-900 rounded-[10px] shadow-xl">
      <label class="block mb-2 font-medium text-[13px]" for="profile-name">Name this profile</label>
      <input
        id="profile-name"
        ref="profileNameBox"
        type="text"
        autocomplete="off"
        class="mb-3 px-3 py-2 w-full text-[13px] bg-white dark:bg-neutral-950 border border-black/10 outline-none rounded-[8px] dark:border-white/10"
      />
      <div class="flex gap-2 justify-end">
        <button type="button" @click="closeProfileModal" class="px-3 py-1 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15">Cancel</button>
        <button type="submit" class="px-3 py-1 text-[12px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-[6px]">Create</button>
      </div>
    </form>
  </div>

  {{--
    Settings. Opened by Cmd+, — as the app-menu item in the desktop window
    (craft forwards it as a `craft:settings` event) and as a page chord
    everywhere else.
  --}}
  <dialog data-settings-modal ref="settingsDialogBox" aria-labelledby="harness-settings-title" @click.self="closeSettings" @cancel="cancelSettings" class="m-auto p-0 text-neutral-900 dark:text-neutral-100 bg-white dark:bg-neutral-900 border border-black/10 dark:border-white/15 shadow-xl">
    <div data-settings-shell>
      <nav data-settings-navigation aria-label="Settings sections">
        @foreach(settingsSections as section)
          <button type="button" data-settings-target="{{ section.id }}" aria-label="{{ section.label }}" title="{{ section.label }}" :hidden="!settingsMatches('{{ section.id }}')" :aria-current="settingsSelection() === '{{ section.id }}' ? 'page' : null" @click="jumpToSettings('{{ section.id }}')">
            <span class="inline-block size-4 {{ section.icon }}" aria-hidden="true"></span>
            <span data-settings-tab-label>{{ section.label }}</span>
          </button>
        @endforeach
        <p data-settings-empty role="status" hidden :hidden="settingsResults().length > 0">No sections found</p>
      </nav>
      <header data-settings-header class="flex gap-2 items-center">
        <h2 id="harness-settings-title" class="text-sm text-neutral-600 dark:text-neutral-400">Settings</h2>
        <span aria-hidden="true" class="text-neutral-400">/</span>
        <span data-settings-breadcrumb class="flex-1 min-w-0 font-medium text-sm truncate" :text="settingsSelectionLabel()"></span>
        <input type="search" data-settings-search aria-label="Search settings sections" placeholder="Search sections" autocomplete="off" :value="settingsQuery()" @input="updateSettingsQuery" @keydown="openMatchingSettings" />
        <button type="button" @click="closeSettings" aria-label="Close settings" title="Close settings" class="harness-icon-button">
          <span class="inline-block size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
        </button>
      </header>
      <div data-settings-panel ref="settingsPanelBox">
      <section :hidden="settingsSelection() !== 'appearance'" data-settings-pane>
        <h3 data-settings-section="appearance" tabindex="-1">Appearance</h3>
        <AppearancePicker v-model:value="appearancePreference" label="Appearance" :options="[{ value: 'light', label: 'Light' }, { value: 'dark', label: 'Dark' }, { value: 'auto', label: 'System' }]" />
        <fieldset class="mt-5 p-0 border-0">
          <legend class="font-semibold text-[13px]">Thread details</legend>
          <label class="flex gap-2 items-center mt-1 min-h-11 text-[13px]">
            <input type="checkbox" :checked="showContextWindow() === true" @change="updateContextWindowPreference" class="accent-neutral-900 dark:accent-neutral-100" />
            Context window
          </label>
        </fieldset>
      </section>
      {{--
        Keyboard. One row per registered command, so the chords the window
        answers are visible and changeable in the same place rather than being
        learned from tooltips. Overrides are this browser's own, which is what
        keeps a loopback origin and a paired remote one independent.
      --}}
      <section :hidden="settingsSelection() !== 'keybindings'" data-settings-pane>
        <h3 data-settings-section="keybindings" tabindex="-1">Keyboard</h3>
        <p class="mb-3 text-[12px] text-neutral-600 dark:text-neutral-300">Shortcuts apply to this browser only. Choose Change, then press the new chord with at least one modifier. Esc keeps the current one.</p>
        <ul data-keybinding-list class="my-0 list-none">
          @foreach(keybindings as binding)
            <li data-keybinding-row="{{ binding.id }}" class="flex flex-wrap gap-3 items-center py-2 border-b border-black/5 dark:border-white/10">
              {{-- 12rem before the controls wrap: a phone gets two lines rather than a squeezed chord. --}}
              <span class="flex-1 min-w-[12rem]">
                <span class="block font-medium text-[13px]">{{ binding.label }}</span>
                <span class="block text-[12px] text-neutral-600 dark:text-neutral-300">{{ binding.description }}</span>
              </span>
              <kbd data-keybinding-chord :text="chordLabel('{{ binding.id }}')" class="shrink-0 px-[6px] py-[1px] font-mono leading-[18px] text-[12px] border border-black/10 rounded-[5px] dark:border-white/15 opacity-70">{{ binding.other }}</kbd>
              <button type="button" data-keybinding-record data-command="{{ binding.id }}" :aria-pressed="recordingKeybinding() === '{{ binding.id }}' ? 'true' : 'false'" @click="recordKeybinding('{{ binding.id }}')" :text="recordingKeybinding() === '{{ binding.id }}' ? 'Press keys…' : 'Change'" class="shrink-0 px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Change</button>
              <button type="button" data-keybinding-reset data-command="{{ binding.id }}" :disabled="!keybindingOverrides()['{{ binding.id }}']" @click="resetKeybinding('{{ binding.id }}')" class="shrink-0 px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15 disabled:opacity-40">Reset</button>
            </li>
          @endforeach
        </ul>
        <p data-keybinding-status role="status" aria-live="polite" class="mt-3 min-h-[1.25rem] text-[12px] text-neutral-600 dark:text-neutral-300" :text="keybindingStatus()"></p>
        <button type="button" data-keybinding-reset-all :disabled="!keybindingOverridden()" @click="resetAllKeybindings" class="px-3 py-1 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15 disabled:opacity-40">Reset all shortcuts</button>
      </section>
      <section :hidden="settingsSelection() !== 'general'" data-settings-pane>
      <h3 data-settings-section="general" tabindex="-1">General</h3>
      <div data-settings-fields>
        <div data-settings-field>
          <label for="settings-driver">Agent for new sessions</label>
          <select
            id="settings-driver"
            ref="settingsDriverBox"
            :value="settings().defaultDriver"
            @change="saveDriverChoice"
            class="px-2 text-[13px] bg-transparent border border-black/10 rounded-md dark:border-white/15"
          >
            <option value="claude">Claude Code</option>
            <option value="codex">Codex</option>
            <option value="opencode">OpenCode</option>
            <option value="cursor">Cursor</option>
            <option value="grok">Grok</option>
          </select>
        </div>
        <div data-settings-field>
          <label for="settings-follow-up">Follow-up behavior</label>
          <select id="settings-follow-up" :value="followUpPreference()" @change="setFollowUpPreference" class="px-2 text-[13px] bg-transparent border border-black/10 rounded-md dark:border-white/15">
            <option value="queue">Queue for the next turn</option>
            <option value="steer">Steer the active turn</option>
          </select>
        </div>
        <div data-settings-field>
          <label for="settings-terminal-shell">Terminal shell</label>
          <select id="settings-terminal-shell" :value="settings().terminalShell" @change="setTerminalShell" class="px-2 text-[13px] bg-transparent border border-black/10 rounded-md dark:border-white/15">
            <option value="system">System shell</option>
            <option value="den">Den</option>
          </select>
        </div>
      </div>
      <p class="mt-2 text-[12px] text-neutral-600 dark:text-neutral-300">New terminals use the selected shell. Den must be installed on this host.</p>
      <p data-host-settings-note class="mt-3 mb-2 text-[12px] text-neutral-600 dark:text-neutral-300">These apply to every client of this host. Appearance and keyboard shortcuts stay with this browser.</p>
      <p data-settings-error role="alert" :hidden="!settingsSaveError()" :text="settingsSaveError()" class="mb-2 text-[12px] text-red-700 dark:text-red-300"></p>
      </section>
      <section :hidden="settingsSelection() !== 'threads'" data-settings-pane>
        <h3 data-settings-section="threads" tabindex="-1">Threads</h3>
        <div data-settings-fields>
          <label data-settings-field for="settings-auto-settle" class="min-h-11 cursor-pointer">
            <span>Auto-settle inactive threads</span>
            <input id="settings-auto-settle" type="checkbox" :checked="settings().autoSettleAfterDays != null" @change="toggleAutoSettle">
          </label>
          <div data-settings-field :hidden="settings().autoSettleAfterDays == null">
            <label for="settings-auto-settle-days">Days before auto-settle</label>
            <input id="settings-auto-settle-days" type="number" min="1" max="90" step="any" required :value="settings().autoSettleAfterDays ?? 7" @change="changeAutoSettleDays" class="px-2 min-h-11 w-24 text-[13px] bg-transparent border border-black/10 rounded-md dark:border-white/15">
          </div>
        </div>
        <p class="mt-2 text-[12px] text-neutral-600 dark:text-neutral-300">The host settles idle threads even when the app is closed. Pinned and snoozed threads stay put. Choose Never in a thread’s actions to opt out.</p>
        <p role="alert" :hidden="!settingsSaveError()" :text="settingsSaveError()" class="mb-2 text-[12px] text-red-700 dark:text-red-300"></p>
      </section>
      <section :hidden="settingsSelection() !== 'providers'" data-settings-pane>
      <h3 data-settings-section="providers" tabindex="-1">Providers</h3>
      {{--
        One row per agent CLI, filled by the same `/drivers` probe that
        annotates the pickers. "Log in" runs the CLI's own login flow in the
        workspace terminal. Managed ChatGPT plan accounts are listed below.
      --}}
      <ul class="mb-3" data-agent-list>
        <li data-agent-row="claude" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">Claude Code</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="claude" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
        <li data-agent-row="codex" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">Codex</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="codex" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
        <li data-agent-row="opencode" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">OpenCode</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="opencode" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
        <li data-agent-row="cursor" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">Cursor</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="cursor" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
        <li data-agent-row="grok" class="flex gap-2 items-center py-1 text-[13px]">
          <span class="flex-1 truncate">Grok</span>
          <span data-agent-state class="text-[11px] opacity-60">checking…</span>
          <button type="button" data-agent-login data-kind="grok" @click="loginAgent" hidden class="px-2 py-0.5 text-[11px] border border-black/10 rounded-[6px] dark:border-white/15">Log in</button>
        </li>
      </ul>
      <ul :if="providerAccounts().length" class="mb-3" aria-label="Project provider accounts">
        <li :for="account in providerAccounts()" :key="account.id" class="py-1 text-[13px]">
          <details :if="account.kind === 'claude' && account.status !== 'deleted'" :data-claude-account="account.id" class="border-b border-black/10 dark:border-white/10">
            <summary class="py-2 font-medium cursor-pointer">
              <span class="inline-flex gap-2 justify-between w-[calc(100%-1.25rem)] align-middle">
                <span class="min-w-0 truncate" :text="account.name"></span>
                <span class="shrink-0 text-neutral-600 text-xs dark:text-neutral-300" :text="account.stateText"></span>
              </span>
            </summary>
            <p :if="!canEditProviderAccounts()" class="mt-1 text-neutral-600 text-xs dark:text-neutral-300">Change these settings on the Harness host.</p>
            <fieldset :disabled="!canEditProviderAccounts()" class="pb-3 min-w-0 border-0">
              <label class="grid gap-1 mt-2">
                <span class="font-medium">Compact idle threads</span>
                <select data-claude-account-idle data-compaction-field="idle" :data-provider-instance="account.id" :value="accountCompaction()[account.id]?.idleCompaction ?? ''" @change="changeAccountCompaction" class="px-2 max-w-64 min-h-9 w-full text-[13px] bg-white dark:bg-neutral-900 border border-black/10 rounded-md dark:border-white/20">
                  <option value="">Use host setting</option>
                  <option value="whenReturning">When you return</option>
                  <option value="beforeCacheExpires">Before the cache expires (beta)</option>
                  <option value="off">Never</option>
                </select>
              </label>
              <label class="grid gap-1 mt-3">
                <span class="font-medium">Auto-compact after</span>
                <input data-claude-account-window data-compaction-field="window" :data-provider-instance="account.id" type="number" min="100000" max="1000000" step="1" inputmode="numeric"
                  placeholder="Use host setting" :disabled="accountCompaction()[account.id]?.autoCompactAfter === 'default'"
                  :value="typeof accountCompaction()[account.id]?.autoCompactAfter === 'number' ? accountCompaction()[account.id].autoCompactAfter : ''"
                  @change="changeAccountCompaction" class="px-2 max-w-64 min-h-9 w-full text-[13px] bg-white dark:bg-neutral-900 border border-black/10 rounded-md dark:border-white/20" />
                <span class="text-neutral-600 text-xs dark:text-neutral-300">Enter 100,000 to 1,000,000 tokens. Leave blank to inherit.</span>
              </label>
              <label class="flex gap-2 items-center mt-2 min-h-9">
                <input data-claude-account-default data-compaction-field="default" :data-provider-instance="account.id" type="checkbox" :checked="accountCompaction()[account.id]?.autoCompactAfter === 'default'" @change="changeAccountCompaction" />
                Use Claude Code’s default threshold
              </label>
              <p role="alert" :if="accountCompactionError()?.id === account.id" :text="accountCompactionError()?.message" class="mt-1 text-red-700 text-xs dark:text-red-300"></p>
            </fieldset>
          </details>
          <div :if="account.kind !== 'claude' || account.status === 'deleted'" class="flex gap-2 items-center">
            <span class="flex-1 truncate" :text="account.name"></span>
            <span class="text-[11px] opacity-60" :text="account.stateText"></span>
          </div>
        </li>
      </ul>
      <details data-host-compaction-settings class="mt-4 pt-3 border-black/10 border-t dark:border-white/10">
        <summary class="font-semibold text-[13px] cursor-pointer">Advanced</summary>
        <label for="settings-claude-idle-compaction" class="block mt-3 font-medium text-[13px]">Compact idle threads</label>
        <p id="settings-claude-idle-help" class="mt-1 text-neutral-600 text-xs dark:text-neutral-300">Applies to Claude Code conversations with at least 200,000 tokens.</p>
        <select id="settings-claude-idle-compaction" aria-describedby="settings-claude-idle-help" :value="settings().claudeIdleCompaction ?? 'whenReturning'" @change="changeClaudeIdleCompaction" class="mt-2 px-2 max-w-full min-h-9 text-[13px] bg-white dark:bg-neutral-900 border border-black/10 rounded-md dark:border-white/20">
          <option value="whenReturning">When you return</option>
          <option value="beforeCacheExpires">Before the cache expires (beta)</option>
          <option value="off">Never</option>
        </select>
        <label for="settings-claude-auto-compact" class="block mt-3 font-medium text-[13px]">Auto-compact after</label>
        <p id="settings-claude-window-help" class="mt-1 text-neutral-600 text-xs dark:text-neutral-300">Set 100,000 to 1,000,000 tokens, or leave blank to use Claude Code’s default.</p>
        <input id="settings-claude-auto-compact" type="number" min="100000" max="1000000" step="1" inputmode="numeric" aria-describedby="settings-claude-window-help" :value="settings().claudeAutoCompactAfter ?? ''" @change="changeClaudeAutoCompactAfter" class="mt-2 px-2 max-w-full min-h-9 text-[13px] bg-white dark:bg-neutral-900 border border-black/10 rounded-md dark:border-white/20" />
        <p data-provider-settings-error role="alert" hidden :hidden="!settingsSaveError()" :text="settingsSaveError()" class="mt-1 text-red-700 text-xs dark:text-red-300"></p>
      </details>

      </section>
      <section :hidden="settingsSelection() !== 'access'" data-settings-pane>
      <h3 data-settings-section="access" tabindex="-1">Access</h3>
      @if(devices.length)
        <ul class="mb-2">
          @foreach(devices as device)
            <li class="flex gap-2 items-center py-1 text-[13px]">
              <span class="flex-1 truncate">{{ device.name }}</span>
              <button type="button" data-revoke-device data-device-id="{{ device.id }}" @click="revokeDevice" class="px-2 py-0.5 text-[11px] text-red-600 border border-red-600/30 rounded-[6px] dark:text-red-400 dark:border-red-400/30">Revoke</button>
            </li>
          @endforeach
        </ul>
      @else
        <p class="mb-2 text-[12px] opacity-60">No devices are paired.</p>
      @endif
      @if(remoteEnabled)
        <div class="flex gap-2 items-center mb-3">
          <button type="button" data-pair-device @click="startPairing" class="px-3 py-1 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15">Pair a device…</button>
          {{-- The minted code, shown beside the button. Five minutes, once. --}}
          <code data-pair-code :text="pairCode()" class="text-[13px] tracking-widest"></code>
        </div>
      @else
        <p class="mb-3 text-[12px] opacity-60">Pairing needs the server started with <code>--remote</code>.</p>
      @endif

      </section>
      <section :hidden="settingsSelection() !== 'archived'" data-settings-pane>
      <h3 data-settings-section="archived" tabindex="-1">Archived threads</h3>
      @if(archivedThreads.length)
        <ul data-archived-threads class="my-0 list-none">
          @foreach(archivedThreads as archived)
            <li class="flex gap-3 items-center mb-2 text-[13px]" data-archived-thread="{{ archived.id }}">
              <a href="/s/{{ archived.id }}" class="flex-1 min-w-0 truncate">{{ archived.title }}</a>
              <button type="button" @click="organizeThread('restore', {}, {{ archived.id }})" :disabled="threadActionBusy()" class="font-medium underline">Restore</button>
            </li>
          @endforeach
        </ul>
      @else
        <p class="mb-3 text-[12px] text-neutral-600 dark:text-neutral-300">No archived threads in this profile.</p>
      @endif
      </section>
      </div>
    </div>
  </dialog>


</div>


<script client>
  // Native diagnostics, in a script of their own. The main island below uses
  // signals, which makes stx defer it to the mount queue — after the Sidebar
  // component's own mount. This block must run before that, so it stays
  // signal-free and executes at document position.
  //
  // Count native-switcher creations before stx's sidebar controller runs.
  // `<SidebarSpaces>` calls `createSpacesSidebar` itself on mount, so the only
  // way to know the native rail actually bound — rather than merely being
  // *reachable* — is to watch the call.
  try {
    const nativeUI = window.craft?.nativeUI
    if (nativeUI && typeof nativeUI.createSpacesSidebar === 'function') {
      const original = nativeUI.createSpacesSidebar.bind(nativeUI)
      window.__harnessSpacesCalls = 0
      nativeUI.createSpacesSidebar = (options) => {
        window.__harnessSpacesCalls++
        window.__harnessSpacesArg = options
        return original(options)
      }
    }
  }
  catch {}

  // Report what native surfaces this window actually has. In a browser every
  // flag is false and nothing else changes; in a Craft window it tells us
  // whether the host's injection and gesture bridge are really there.
  function reportNativeProbe(payload) {
    navigator.sendBeacon('/native-probe', new Blob([JSON.stringify(payload)], { type: 'application/json' }))
  }

  try {
    const craft = window.craft
    reportNativeProbe({
      seen: true,
      craft: Boolean(craft),
      gestures: typeof craft?.gestures?.onSwipe === 'function',
      nativeUI: Boolean(craft?.nativeUI),
      spacesSidebar: typeof craft?.nativeUI?.createSpacesSidebar === 'function',
      nativeSidebarFlag: Boolean(window.__craftNativeSidebar),
      userAgent: navigator.userAgent.slice(0, 60),
    })
  }
  catch {}

  // Second pass, once the sidebar controller has mounted: did it bind?
  // A raw setTimeout on purpose: useTimeout would make this script
  // signal-bearing, stx would defer it to the mount queue, and the patch
  // above would install after the Sidebar's mount — too late to count.
  setTimeout(() => {
    reportNativeProbe({
      seen: true,
      phase: 'mounted',
      craft: Boolean(window.craft),
      gestures: typeof window.craft?.gestures?.onSwipe === 'function',
      spacesSidebar: typeof window.craft?.nativeUI?.createSpacesSidebar === 'function',
      spacesBound: window.__harnessSpacesCalls ?? 0,
      spacesCount: window.__harnessSpacesArg?.spaces?.length ?? 0,
      activeSpace: window.__harnessSpacesArg?.activeSpace ?? null,
    })
  }, 2500)
</script>

<script client>
  // The live island. Everything above this is static HTML; this wires the
  // socket to the one turn that can still change.
  //
  // A `client` script, not a raw module: server exports arrive through the
  // server -> client bridge (activeSessionId, serverUrl, codecUrl, sinceSeq,
  // spaceTints, activeWorkspaceId, sessionState are seeded as locals — no
  // data-* plumbing), and stx's signals and composables are auto-imported.
  // Because it declares signals, stx wraps it in `window.stx.mount(...)` and
  // returns its top-level declarations as the scope the template bindings
  // (`:for`, `:text`, `:data-*` in the markup above) resolve against.

  // What can change after load, as signals; the template renders them.
  // Turns started on this page. The server-rendered live turn is not here —
  // its new tool calls stream into `ssrTools`.
  const liveTurns = state([])
  const ssrHasResponse = state(initialHasResponse)
  const ssrCompactedTurn = state(initialCompactedTurn)
  const ssrInterrupted = state(initialInterrupted)
  const followingTranscript = state(true)
  const transcriptAnnouncement = state('')
  const responseByTurn = new Map()
  const changedResponses = new Set()
  let transcriptControl
  let transcriptMenuKeyboard
  let transcriptFrame = 0
  const ssrTools = state([])
  // callId -> 'ok' | 'failed'. One map for every row — server-rendered rows
  // read it through their own `:data-tool-state` binding, loop rows through
  // theirs — because tools finish out of order and a row is found by id.
  const toolResults = state({})
  const draftWorktreeOptions = state(null)
  const draftWorktreeLoad = state('')
  const draftIsolated = state(false)
  const draftRepositoryKeys = state([])
  const draftBaseBranch = state('')
  const worktreePreferences = useLocalStorage('harness.worktreePreferences', {})
  const diffStatus = state('Loading…')
  const diffFiles = state([])
  const diffPatch = state('')
  const diffTruncated = derived(() => /\n\n… truncated at \d+KB\n$/u.test(diffPatch()))
  const diffHunks = state(new Map())
  const diffFileLimits = state(new Map())
  const diffLayout = useLocalStorage('harness.diffLayout', 'stacked')
  const diffWrap = useLocalStorage('harness.diffWrap', true)
  const diffRefresh = state(0)
  const diffReviewMode = state('session')
  const diffRepository = state('')
  const diffRepositories = state([])
  const diffProjectRoot = state(false)
  const diffBaseRef = state('')
  const diffCommit = state('')
  const diffTurn = state('')
  const diffReviewOptions = state(null)
  const diffReviewError = state('')
  const diffLineSelection = state(null)
  const diffLineNotice = state('')
  const diffLineReveal = state(null)
  const diffContexts = state(new Map())
  const diffContextRequests = new Map()
  const reviewOptionsLoader = state(null)
  const diffPageSize = 200
  let diffTools = null
  let diffComparisonTarget
  let pendingDiffLineLink = null
  let pendingTurnFile = null
  const diffDisplayFiles = derived(() => {
    const hunks = diffHunks()
    const limits = diffFileLimits()
    const split = diffLayout() === 'split'
    const reveal = diffLineReveal()
    return diffFiles().map(file => {
      const limit = limits.get(file.path) || 0
      const fileHunks = hunks.get(file.path)
      const context = limit && matchingDiffContext(file.path, fileHunks)
      let view = null
      if (limit && fileHunks) view = reveal?.path === file.path
        ? diffTools.workspaceDiffLinkedRows(fileHunks, split, limit, reveal, diffPageSize, context?.value)
        : diffTools.workspaceDiffRows(fileHunks, split, limit, context?.value)
      return { ...file, open: limit > 0, rows: view?.rows ?? [], more: view?.more ?? false, earlier: view?.earlier ?? false, contextError: context?.error }
    })
  })
  const changesWatcher = state(null)
  const changesVisibility = useDocumentVisibility()

  const sessionId = Number(activeSessionId) || 0
  const workspaceBranch = state(sessionBranch)
  const worktreeSetup = state(initialWorktreeSetup)
  const forkingResponseId = state(0)
  const forkableTurns = state(initialForkableTurns)
  const turnDiffs = state(initialTurnDiffs)
  const turnFiles = state({})
  let turnFilesObserver = null
  const forkStatus = state(initialFork?.state || 'ready')
  const forkError = state(initialFork?.error || '')
  const forkStatusText = derived(() => forkStatus() === 'pending' ? 'Creating fork…'
    : forkStatus() === 'failed' ? forkError() : 'Forked conversation')
  function canForkResponse(turnId) {
    return forkableTurns().includes(turnId) && forkStatus() === 'ready' && !threadNavigation().archivedAt
  }
  async function forkResponse(turnId) {
    if (!canForkResponse(turnId) || forkingResponseId()) return
    forkingResponseId.set(turnId)
    const commandId = newCommandId()
    try {
      await sendCommand({ type: 'session.fork', sessionId, turnId }, commandId)
      navigate(`/s/${derivedSessionId(commandId)}`)
    }
    catch (error) {
      stxAlert(error.message || 'Could not fork this response.')
    }
    finally {
      forkingResponseId.set(0)
    }
  }
  const promptScope = sessionId ? `session:${sessionId}`
    : draftProject ? `project:${draftProject.id}` : 'projectless'
  const storedFreshSession = useLocalStorage(`harness.fresh-session:${activeProfile || 0}:${promptScope}`, '')
  const freshSessionArmed = derived(() => Boolean(sessionId && typeof storedFreshSession() === 'string' && storedFreshSession()))
  const clearCommandBox = useRef('clearCommandBox')
  const offerClearCommand = derived(() => {
    const text = composerText().trim().toLowerCase()
    return Boolean(sessionId && runningTurnId() > 0 && !editingFollowUp()
      && text.startsWith('/') && '/clear'.startsWith(text))
  })
  const promptDraftKey = `harness.composer.v1:${activeProfile || 0}:${promptScope}`
  const composerDraft = useLocalStorage(promptDraftKey, null, {
    listenToStorageChanges: false,
  })
  const sentImageDialog = useRef('sentImageDialog')
  const sentImage = state(null)
  const sentImageStatus = state('loading')
  let sentImageTrigger = null

  const composerFilePopup = useRef('composerFilePopup')
  const composerFileMenu = state(null)
  let fileMentionPicker
  onDestroy(() => fileMentionPicker?.close())
  const promptStashDialog = useRef('promptStashDialog')
  const promptStashButton = useRef('promptStashButton')
  const stashEntries = state([])
  const stashReady = state(false)
  const stashOpen = state(false)
  const stashBusy = state(false)
  const stashError = state('')
  let promptStash
  let stashCloseToEditor = false
  let replaceUploadKey

  const composerFileInput = useRef('composerFileInput')
  const composerUploadSources = new Map()
  const composerFileActions = state(null)
  let composerFileStatus
  const composerFiles = derived(() => Array.isArray(composerDraft()?.files) ? composerDraft().files : [])
  const composerFilesError = state('')
  const composerFilesPending = derived(() => !editingFollowUp() && composerFiles().some(file => file.status !== 'ready'))
  const hasComposerMessage = derived(() => Boolean(composerText().trim() || (editingFollowUp() ? editingFollowUp()?.attachments?.length : composerFiles().length)))
  const uploadScope = promptScope === 'projectless' ? `scratch:${Number(activeProfile) || 0}` : promptScope
  const pendingFirstPrompt = useSessionStorage('harness.pendingPrompt.v2', null)
  const followUps = state(initialFollowUps)
  const steeringMessage = useRef('steeringMessageBox')
  // Host settings, seeded from the render and kept here so a change shows at
  // once rather than after the round trip. They are not in `localStorage`:
  // the phone and the laptop pointed at one host must agree about which agent
  // a new thread starts with, and the browser store cannot give them that.
  const settings = state({ ...hostSettings })
  const settingsSaveError = state('')
  const accountCompaction = state(initialAccountCompaction)
  const accountCompactionError = state(null)
  const canEditProviderAccounts = state(false)
  const followUpPreference = derived(() => settings().followUpBehavior)
  const oppositeFollowUp = derived(() => followUpPreference() === 'steer' ? 'queue' : 'steer')
  const steeringPending = derived(() => followUps().entries.some(entry => entry.steering))
  const localFollowUps = useLocalStorage(`harness.follow-ups.v1:${activeProfile || 0}:${promptScope}`, [], { listenToStorageChanges: false })
  const sessionOnline = state(false)
  const sessionConnecting = state(Boolean(sessionId && serverUrl && codecUrl))
  const outboxSending = state('')
  const followUpActions = state(null)
  const queueActionPending = state(false)
  const editingFollowUp = state(null)
  const composerText = state('')
  const composerPlaceholder = derived(() => editingFollowUp() ? 'Edit queued message' : promptPlaceholder)
  const visibleFollowUps = derived(() => {
    const committed = followUps().entries
    return [...committed, ...(Array.isArray(localFollowUps()) ? localFollowUps() : [])
      .filter(entry => !committed.some(item => item.id === entry.id))
      .map(entry => ({ ...entry, local: true }))]
  })

  // The session's own state string, not a boolean: a turn blocked on an
  // approval is still in flight, and collapsing that to "not running" once
  // made a session waiting on *you* look idle. Seeded from the server render;
  // the chip, Send/Stop and the revert buttons all bind to it.
  const uiState = state(sessionState || 'idle')
  const sessionError = state(initialSessionError)
  const runningTurnId = state(initialResponseTurn)
  const steerableTurn = state(initialSteerable ? initialResponseTurn : 0)
  const canSteer = derived(() => sessionOnline() && uiState() === 'running' && steerableTurn() !== 0 && steerableTurn() === runningTurnId())
  const currentThreadTitle = state(sessionTitle)
  const threadNavigation = state(initialNavigation)
  const threadActionsOpen = state(false)
  const threadActionForm = state('')
  const threadSnoozePresets = state([])
  const threadSnoozeMode = state('date')
  const threadActionBusy = state(false)
  const threadActionError = state('')
  const threadUndo = useSessionStorage('harness.thread-undo.v2', null, { listenToStorageChanges: false })
  const draftUndoKey = 'harness.draft-undo.v2'
  const draftUndo = useSessionStorage(draftUndoKey, [], { listenToStorageChanges: false })
  const threadUndoBatch = useSessionStorage('harness.thread-undo-batch.v1', '', { listenToStorageChanges: false })
  const draftDiscardTemplate = useRef('draftDiscardTemplate')
  const draftDiscardReady = state(false)
  let composerDraftTools
  let composerRecall
  let sidebarDrafts
  let sidebarHasDraft
  effect(() => {
    const hasDraft = Boolean(composerDraft()?.text || composerFiles().length)
    if (sidebarHasDraft === hasDraft) return
    sidebarHasDraft = hasDraft
    void nextTick(() => sidebarDrafts?.update())
  })
  const threadUndoTab = useSessionStorage('harness.thread-undo-tab.v1', '', { listenToStorageChanges: false })
  const threadUndoBusy = state(false)
  const threadUndoShortcutClaimed = state(true)
  const visibleUndo = derived(() => {
    const draft = draftUndo().at(-1)
    const thread = threadUndo()
    const threadStarted = thread?.offeredAt ?? (thread?.expiresAt || 0) - 5000
    return draft?.offeredAt >= threadStarted ? draft : thread
  })
  const threadUndoMessage = derived(() => {
    const offer = visibleUndo()
    if (!offer) return ''
    if (offer.action === 'discarded') return offer.entries.length === 1 ? 'Draft discarded' : `${offer.entries.length} drafts discarded`
    return offer.count > 1 ? `${offer.count} threads ${offer.action}` : `Thread ${offer.action}`
  })
  function expireUndoNotices() {
    const thread = threadUndo()
    if (thread && (!Number.isFinite(thread.expiresAt) || thread.expiresAt <= Date.now())) threadUndo.set(null)
    const drafts = draftUndo()
    const live = drafts.filter(draft => {
      if (Number.isFinite(draft.expiresAt) && draft.expiresAt > Date.now()) return true
      for (const entry of draft.entries) composerDraftTools?.expireComposerDraft(localStorage, entry)
      return false
    })
    if (live.length !== drafts.length) draftUndo.set(live)
  }
  const threadUndoTimer = useInterval(expireUndoNotices, 100)
  effect(() => {
    if (threadUndo() || draftUndo().length) threadUndoTimer.resume()
    else threadUndoTimer.pause()
  })
  const threadTitleDraft = state('')
  const threadActionsDialog = useRef('threadActionsDialogBox')
  const threadActionsTrigger = useRef('threadActionsTriggerBox')
  const threadSnoozeTrigger = useRef('threadSnoozeTriggerBox')
  const threadSnoozePanel = useRef('threadSnoozePanelBox')
  const threadWakeTime = useRef('threadWakeTimeBox')
  const threadWakeDuration = useRef('threadWakeDurationBox')
  const threadTitleEdit = useRef('threadTitleEditBox')
  const threadArrangement = useRef('threadArrangementBox')
  const arrangementOpen = state(false)
  const arrangementLayout = state(null)
  const arrangementExpanded = state([])
  const arrangementChoice = state(null)
  const arrangementBusy = state(false)
  const arrangementStatus = state('')
  const arrangementError = state('')
  let cancelArrangementDrag = () => {}

  function arrangementReady() {
    return Boolean(sessionOnline() && arrangementLayout() && !arrangementBusy())
  }

  const arrangementSections = derived(() => {
    const layout = arrangementLayout() || []
    let showedActive = false
    return layout.flatMap((section) => {
      const kind = section.id.split('-')[0]
      if (kind === 'working' || (kind === 'snoozed' && !section.rows.length)) return []
      const active = kind === 'project' || kind === 'projectless'
      if (kind === 'projectless' && !layout.some(group => group.rows.some(row => row.activeSection === section.id))) return []
      const startsActive = active && !showedActive
      if (active) showedActive = true
      return [{ ...section, active, kind, startsActive, parked: kind === 'settled' || kind === 'snoozed' }]
    })
  })

  function openThreadArrangement() {
    const dialog = threadArrangement.current
    if (!dialog || dialog.open) return
    closeThreadActions()
    arrangementLayout.set(null)
    arrangementExpanded.set([])
    arrangementChoice.set(null)
    arrangementError.set('')
    arrangementStatus.set('')
    arrangementOpen.set(true)
    dialog.showModal()
    watchSidebarOrder()
  }

  function closeThreadArrangement(event) {
    event?.preventDefault()
    threadArrangement.current?.close()
  }

  function finishThreadArrangement() {
    cancelArrangementDrag()
    arrangementOpen.set(false)
    arrangementLayout.set(null)
    watchSidebarOrder()
    threadActionsTrigger.current?.focus()
  }

  function arrangementSectionOpen(id) {
    return arrangementExpanded().includes(id)
  }

  function toggleArrangementSection(id) {
    arrangementExpanded.update(open => open.includes(id) ? open.filter(value => value !== id) : [...open, id])
  }

  function toggleArrangementChoice(id) {
    arrangementChoice.set(arrangementChoice() === id ? null : id)
  }

  function arrangementOptions(section, row) {
    const options = []
    if (section.active || section.kind === 'pinned') {
      const destination = section.active ? 'active' : 'pinned'
      const index = section.rows.findIndex(item => item.id === row.id)
      const before = section.rows[index - 1]
      const after = section.rows[index + 1]
      if (before) options.push({ label: 'Move up', intent: { destination, anchor: { sessionId: before.id, placement: 'before' } } })
      if (after) options.push({ label: 'Move down', intent: { destination, anchor: { sessionId: after.id, placement: 'after' } } })
    }
    if (section.kind !== 'pinned' && row.canPin) options.push({ label: 'Pin', intent: { destination: 'pinned' } })
    if (!section.active && row.canActivate) options.push({ label: section.kind === 'pinned' ? 'Unpin' : section.kind === 'snoozed' ? 'Wake' : 'Un-settle', intent: { destination: 'active' } })
    if (section.kind !== 'settled' && row.canSettle) options.push({ label: 'Settle', intent: { destination: 'settled' } })
    return options
  }

  async function saveArrangement(id, intent, restoreFocus = false) {
    if (!arrangementReady()) return
    arrangementBusy.set(true)
    arrangementError.set('')
    arrangementStatus.set('')
    try {
      await sendThreadOrganization({ sessionId: id, action: 'drop', ...intent })
      arrangementChoice.set(null)
      arrangementStatus.set('Thread position saved.')
    }
    catch (error) { arrangementError.set(error.message) }
    finally {
      arrangementBusy.set(false)
      if (restoreFocus) void nextTick(() => requestAnimationFrame(() => {
        const dialog = threadArrangement.current
        if (!dialog?.open) return
        const grip = dialog.querySelector(`[data-arrangement-row][data-item-id="${id}"] [data-arrangement-grip]`)
        if (grip && !grip.closest('[hidden]')) grip.focus({ preventScroll: true })
        else dialog.querySelector('[data-arrangement-section][data-section-id^="settled-"] button[data-arrangement-header]')?.focus({ preventScroll: true })
      }))
    }
  }

  function positionThreadActions() {
    const trigger = threadActionsTrigger.current
    const dialog = threadActionsDialog.current
    if (!trigger || !dialog?.open) return
    const anchor = trigger.getBoundingClientRect()
    const viewport = dialog.ownerDocument.documentElement.clientWidth
    const width = dialog.getBoundingClientRect().width
    dialog.style.setProperty('--thread-menu-top', anchor.bottom + 5 + 'px')
    dialog.style.setProperty('--thread-menu-left', Math.max(8, Math.min(anchor.left, viewport - width - 8)) + 'px')
    positionThreadSnooze()
  }

  function positionThreadSnooze() {
    const dialog = threadActionsDialog.current
    const trigger = threadSnoozeTrigger.current
    const panel = threadSnoozePanel.current
    if (!dialog?.open || !trigger || !panel) return
    const viewport = dialog.ownerDocument.documentElement
    const left = dialog.getBoundingClientRect().right - 1
    const beside = viewport.clientWidth >= 768 && viewport.clientWidth - left >= 208
    dialog.dataset.snoozeSide = String(beside)
    if (beside) {
      const top = Math.max(8, Math.min(trigger.getBoundingClientRect().top, viewport.clientHeight - panel.scrollHeight - 10))
      dialog.style.setProperty('--thread-snooze-top', top + 'px')
      dialog.style.setProperty('--thread-snooze-left', left + 'px')
    }
  }

  function openThreadActions() {
    const dialog = threadActionsDialog.current
    if (!dialog || dialog.open) return
    threadTitleDraft.set(currentThreadTitle())
    threadActionError.set('')
    threadActionForm.set('')
    dialog.showModal()
    threadActionsOpen.set(true)
    positionThreadActions()
  }

  function closeThreadActions(event) {
    event?.preventDefault()
    threadActionsDialog.current?.close()
    threadActionsOpen.set(false)
    threadActionsTrigger.current?.focus()
  }

  function openThreadActionForm(form) {
    if (threadActionForm() === form) {
      threadActionForm.set('')
      return
    }
    threadActionError.set('')
    threadActionForm.set(form)
    if (form === 'rename') void nextTick(() => threadTitleEdit.current?.select())
    if (form === 'snooze' || form === 'custom-snooze') void nextTick(positionThreadSnooze)
    if (form === 'snooze' && codecUrl) {
      void import(codecUrl).then(({ threadSnoozeChoices }) => {
        if (threadActionForm() !== 'snooze') return
        threadSnoozePresets.set(threadSnoozeChoices(new Date()))
        void nextTick(positionThreadSnooze)
      }).catch(() => {})
    }
  }

  useEventListener('resize', positionThreadActions)

  function threadUndoScope() {
    if (!threadUndoTab()) threadUndoTab.set(crypto.randomUUID?.() ?? newCommandId().replaceAll('_', '-'))
    return threadUndoTab()
  }

  function storeThreadUndo(offer) {
    const previous = threadUndo()
    threadUndo.set(offer ? {
      ...offer, expiresAt: Date.now() + offer.remainingMs,
      offeredAt: typeof offer.ageMs === 'number' ? Date.now() - offer.ageMs
        : offer.sourceCommandId === previous?.sourceCommandId ? previous.offeredAt : Date.now(),
    } : null)
  }

  async function sendThreadOrganization(command) {
    const commandId = newCommandId()
    const undoBatch = threadUndoBatch()
    const { threadUndo: offer } = await sendCommand({
      ...command, type: 'session.organize', undoScope: threadUndoScope(), ...(undoBatch && { undoBatch }),
    }, commandId)
    if (offer && offer.sourceCommandId !== threadUndo()?.sourceCommandId) threadUndoShortcutClaimed.set(true)
    storeThreadUndo(offer)
    if (offer?.sourceCommandId === commandId && draftUndo().length) {
      expireUndoNotices()
      const expiresAt = Date.now() + offer.remainingMs
      draftUndo.update(groups => groups.map(group => ({ ...group, expiresAt })))
    }
  }

  async function undoThreadAction() {
    expireUndoNotices()
    const offer = visibleUndo()
    if (!offer || threadUndoBusy()) return
    if (offer.action === 'discarded') {
      restoreDiscardedDrafts(offer)
      return
    }
    threadUndoBusy.set(true)
    const arranged = threadArrangement.current?.open
    try {
      const { threadUndo: nextOffer, undoResult } = await sendCommand({
        type: 'session.organize', sessionId: offer.sessionId, action: 'undo',
        sourceCommandId: offer.sourceCommandId, undoScope: threadUndoScope(),
      })
      if (!threadUndo() || threadUndo()?.sourceCommandId === offer.sourceCommandId) storeThreadUndo(nextOffer)
      if (undoResult?.skipped) {
        const message = undoResult.restored
          ? `Restored ${undoResult.restored}. ${undoResult.skipped} could no longer be undone.`
          : 'This action can no longer be undone.'
        if (arranged) arrangementError.set(message)
        else stxAlert(message)
        if (!undoResult.restored) return
      }
      if (offer.action === 'archived' && undoResult?.sessionId) navigate(`/s/${undoResult.sessionId}`)
      else if (arranged) {
        arrangementStatus.set(undoResult?.restored > 1 ? `${undoResult.restored} thread positions restored.` : 'Thread position restored.')
        threadArrangement.current?.querySelector('[data-arrangement-done]')?.focus()
      }
      else refresh()
    }
    catch (error) {
      if (threadUndo()?.sourceCommandId === offer.sourceCommandId) threadUndo.set(null)
      if (arranged) arrangementError.set(error.message)
      else stxAlert(error.message)
    }
    finally {
      threadUndoBusy.set(false)
    }
  }

  async function organizeThread(action, fields = {}, target = sessionId) {
    if (!target || threadActionBusy()) return
    threadActionBusy.set(true)
    threadActionError.set('')
    try {
      await sendThreadOrganization({ sessionId: target, action, ...fields })
      if (threadActionsDialog.current?.open) closeThreadActions()
      if (action === 'auto-settle') {
        threadActionBusy.set(false)
        return
      }
      if (action === 'archive' && target === sessionId) {
        if (activeScratchSession) startWithoutProject()
        else navigate(`/?workspace=${activeWorkspaceId}`)
      }
      else refresh()
    }
    catch (error) {
      if (threadActionsDialog.current?.open) threadActionError.set(error.message)
      else stxAlert(error.message)
      threadActionBusy.set(false)
    }
  }

  function renameThread() {
    void organizeThread('rename', { title: threadTitleDraft() })
  }

  async function snoozeFromPreset(choice) {
    if (!codecUrl) return
    const { chosenSnoozeTime } = await import(codecUrl)
    const until = chosenSnoozeTime(choice, Date.now())
    if (!until) {
      threadActionError.set('That wake time has passed. Choose another time.')
      return
    }
    void organizeThread('snooze', { until })
  }

  function snoozeThread() {
    const mode = threadSnoozeMode()
    const duration = Number(threadWakeDuration.current?.value)
    const units = { minutes: 60_000, hours: 3_600_000, days: 86_400_000 }
    const now = Date.now()
    const until = mode === 'date'
      ? Date.parse(threadWakeTime.current?.value ?? '')
      : Number.isSafeInteger(duration) && duration > 0 ? now + duration * units[mode] : NaN
    if (!Number.isFinite(until) || until <= now) {
      threadActionError.set('Choose a wake time in the future.')
      return
    }
    void organizeThread('snooze', { until })
  }

  const uiBusy = derived(() => uiState() === 'running' || uiState() === 'awaiting-approval' || uiState() === 'awaiting-input')
  const showResume = derived(() => Boolean(sessionId && !uiBusy() && followUps().held && followUps().entries.length && !steeringPending() && followUps().entries[0]?.steeringIssue !== 'uncertain' && !hasComposerMessage() && !editingFollowUp()))
  const showSend = derived(() => !showResume() && Boolean(!uiBusy() || hasComposerMessage() || editingFollowUp()))
  const sendLabel = derived(() => {
    if (editingFollowUp()) return 'Save edit'
    if (pendingProviderSwitch()) return 'Send'
    if (canSteerDraft() && followUpPreference() === 'steer') return 'Steer'
    return sessionId && (uiBusy() || !sessionOnline() || (freshSessionArmed() && followUps().entries.length)) ? 'Queue' : 'Send'
  })
  function showQueueSend(entry) {
    return !entry.local && !entry.steering && entry.steeringIssue !== 'uncertain'
      && editingFollowUp()?.id !== entry.id && (!uiBusy() || (!entry.freshContext && !entry.attachments?.length && entry.text.trim() !== '/compact' && canSteer() && matchesActiveCodexSelection(entry.codexSelection)))
  }
  function sendQueuedFollowUp(id) {
    if (canSteer()) return followUpActions()?.steerQueued(id, runningTurnId())
    return followUpActions()?.run('send', id)
  }
  function setFollowUpPreference(event) {
    void updateSettings({ followUpBehavior: event.target.value === 'steer' ? 'steer' : 'queue' })
  }

  /**
   * Write host settings, optimistically.
   *
   * The select already shows the new value, so the state moves first and is
   * put back if the host refuses. Leaving the control ahead of the host would
   * have the next reload silently undo the change.
   */
  function applyAccountCompaction(id, changes) {
    const previous = accountCompaction()
    const account = previous[id]
    if (Object.entries(changes).every(([key, value]) => (account?.[key] ?? null) === value)) return
    accountCompaction.set({ ...previous, [id]: { ...account, ...changes } })
  }

  async function changeAccountCompaction(event) {
    const input = event.currentTarget
    const id = Number(input.dataset.providerInstance)
    const field = input.dataset.compactionField
    const key = field === 'idle' ? 'idleCompaction' : 'autoCompactAfter'
    const previous = accountCompaction()[id]?.[key] ?? null
    accountCompactionError.set(null)
    if (field === 'window' && !input.validity.valid) {
      accountCompactionError.set({ id, message: 'Enter a whole number from 100,000 to 1,000,000.' })
      return
    }
    const value = field === 'idle' ? input.value || null
      : field === 'default' ? (input.checked ? 'default' : null)
        : (input.value === '' ? null : Number(input.value))
    const changes = { [key]: value }
    // Reflect the field before its acknowledgement can redraw adjacent inputs.
    applyAccountCompaction(id, changes)
    try {
      await sendCommand({ type: 'profile.claude-compaction.update', profileId: providerProfileId, providerInstanceId: id, changes })
    }
    catch (error) {
      accountCompactionError.set({ id, message: error.message || 'Could not save this account setting.' })
      if ((accountCompaction()[id]?.[key] ?? null) === value) applyAccountCompaction(id, { [key]: previous })
    }
  }

  function changeClaudeIdleCompaction(event) {
    void updateSettings({ claudeIdleCompaction: event.currentTarget.value })
  }

  function changeClaudeAutoCompactAfter(event) {
    const input = event.currentTarget
    if (!input.validity.valid) {
      settingsSaveError.set('Enter a whole number from 100,000 to 1,000,000.')
      return
    }
    settingsSaveError.set('')
    void updateSettings({ claudeAutoCompactAfter: input.value === '' ? null : Number(input.value) })
  }

  function toggleAutoSettle(event) {
    void updateSettings({ autoSettleAfterDays: event.currentTarget.checked ? 7 : null })
  }

  function changeAutoSettleDays(event) {
    const input = event.currentTarget
    if (!input.validity.valid) {
      settingsSaveError.set('Enter a number from 1 to 90 days.')
      return
    }
    void updateSettings({ autoSettleAfterDays: Number(input.value) })
  }

  async function updateSettings(changes) {
    const previous = settings()
    if (Object.entries(changes).every(([key, value]) => previous[key] === value)) return
    settings.set({ ...previous, ...changes })
    settingsSaveError.set('')
    try {
      await sendCommand({ type: 'settings.update', changes })
    }
    catch (error) {
      settings.set(previous)
      settingsSaveError.set(error.message || 'Could not save that setting.')
    }
  }
  // Stop hides the moment it is clicked, before the log settles the turn.
