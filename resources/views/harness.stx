  const cloneSubmitting = state(false)
  const cloneCancelling = state(false)
  const pendingProjectClone = useLocalStorage('harness.projectClone.v1', null)
  const cloneBusy = derived(() => Boolean(pendingProjectClone()?.input?.id) || cloneSubmitting() || ['cloning', 'publishing'].includes(cloneReceipt()?.phase))
  const cloneStatusText = derived(() => {
    if (cloneCancelling()) return 'Stopping clone…'
    if (cloneReceipt()?.phase === 'cloning') return cloneReceipt().progress || 'Connecting to the repository…'
    if (cloneReceipt()?.phase === 'publishing') return 'Adding the cloned project…'
    if (cloneReceipt()?.phase === 'cancelled') return 'Clone stopped.'
    if (cloneReceipt()?.phase === 'done') return 'Repository cloned.'
