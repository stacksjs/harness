  const termOpen = useLocalStorage(`harness.terminal-open:${sessionId}`, false, { listenToStorageChanges: false })
  const legacyTerminalSession = useLocalStorage(`harness.terminal-session:${sessionId}`, null, { listenToStorageChanges: false })
  const terminalDock = useLocalStorage(`harness.terminal-tabs:${sessionId}`, null, { listenToStorageChanges: false })
  const projectScriptsDialog = useRef('projectScriptsDialog')
  const projectScriptName = useRef('projectScriptName')
  const projectScripts = state({ scripts: [], imports: [], importError: '' })
  const projectScriptsError = state('')
  const projectScriptsLoading = state(false)
  const projectScriptsBusy = state(false)
  const projectScriptDraft = state(null)
  const projectSetup = state(null)
  const projectSetupStatus = derived(() => {
    const setup = projectSetup()
    if (!setup) return ''
    if (setup.status === 'pending') return 'Worktree setup will run with the next message.'
    if (setup.status === 'running') return 'Running worktree setup…'
    if (setup.status === 'failed') return `Worktree setup exited with code ${setup.exitCode}.`
    if (setup.status === 'interrupted') return 'Worktree setup was interrupted.'
    return ''
  })
  const projectSetupNeedsAttention = derived(() => ['failed', 'interrupted'].includes(projectSetup()?.status))
  const waitingForProjectSetup = derived(() => projectSetup()?.blocking && ['pending', 'running'].includes(projectSetup()?.status))
  const projectSetupOwnsError = derived(() => projectSetupNeedsAttention() && sessionError().startsWith(projectSetupStatus()))
  let projectSetupPoll
  let projectSetupRequest
  let projectSetupPreview = false
  const projectSettlement = state(null)
  const projectSettlementStatus = derived(() => {
    const job = projectSettlement()
    if (!job) return ''
    if (job.status === 'pending') return 'Waiting to start settlement script…'
    if (job.status === 'running') return 'Running settlement script…'
    if (job.status === 'failed') return `Settlement script exited with code ${job.exitCode}.`
    if (job.status === 'interrupted') return 'Settlement script was interrupted.'
    if (job.status === 'skipped') return 'Settlement script skipped. The worktree or saved script changed.'
    return ''
  })
  const projectSettlementTerminalAvailable = derived(() => ['running', 'failed', 'interrupted'].includes(projectSettlement()?.status))
  let projectSettlementPoll
  let projectSettlementRequest
  let projectScriptsTrigger = null
  let projectScriptsRead = 0
  const terminalTabs = derived(() => {
    const dock = terminalDock()
    if (Array.isArray(dock?.tabs)) return dock
    const legacy = legacyTerminalSession()
    return legacy?.key ? { tabs: [{ ...legacy, number: 1 }], activeKey: legacy.key } : { tabs: [], activeKey: '' }
  })
  const activeTerminalTab = derived(() => terminalTabs().tabs.find(tab => tab.key === terminalTabs().activeKey))
  const activeTerminalGroup = derived(() => activeTerminalTab()?.group || activeTerminalTab()?.key || '')
  const terminalGroups = derived(() => {
    const groups = new Map()
    for (const tab of terminalTabs().tabs) {
      const key = tab.group || tab.key
      const members = groups.get(key) || []
      members.push(tab)
      groups.set(key, members)
    }
    return Array.from(groups, ([key, members]) => ({ key, label: members.length === 1 ? members[0].name || 'Terminal ' + members[0].number : 'Terminals ' + members.map(tab => tab.number).join(' + ') }))
  })
  const visibleTerminalTabs = derived(() => terminalTabs().tabs.filter(tab => (tab.group || tab.key) === activeTerminalGroup()))
  const terminalDirection = derived(() => terminalTabs().directions?.[activeTerminalGroup()] === 'rows' ? 'rows' : 'columns')
  const storedTerminalHeight = useLocalStorage(`harness.terminal-height:${sessionId}`, 31, { listenToStorageChanges: false })
  const terminalHeight = state(boundedTerminalHeight(storedTerminalHeight()))
  let terminalDrag = null
  const startPending = state(false)
  const projectBusy = state(false)
