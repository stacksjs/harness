<script server>
export const profiles = $props.profiles
export const profile = $props.profile
export const repositories = $props.repositories
export const repositoryOptions = $props.repositoryOptions
export const repository = $props.repository
export const scope = $props.scope
export const rows = $props.rows
export const failures = $props.failures
export const partial = $props.partial
export const selected = $props.selected
export const error = $props.error
export const hasDetail = Boolean(selected || error)
export const backHref = $props.backHref
export const listHref = $props.listHref
export const retryHref = $props.retryHref
export const datePurpose = $props.datePurpose
export const previousHref = $props.previousHref
export const nextHref = $props.nextHref
export const draftHref = $props.draftHref
export const linkedThreads = $props.linkedThreads
export const threadChoices = $props.threadChoices
export const pullRequests = $props.pullRequests
export const issueThreadAction = $props.issueThreadAction
export const olderCommentsHref = $props.olderCommentsHref
export const newerCommentsHref = $props.newerCommentsHref
export const savedViewScope = $props.savedViewScope
export const savedViewDetail = $props.savedViewDetail
export const listSelectionFields = $props.listSelectionFields
export const hasIncludedRepositories = $props.hasIncludedRepositories
export const filterCount = $props.filterCount
export const projectFilters = $props.projectFilters
export const hiddenProjectIds = projectFilters.filter(item => item.hidden).map(item => item.id)
export const repositoryFilters = $props.repositoryFilters
export const labelOptions = $props.labelOptions
export const assigneeOptions = $props.assigneeOptions
export const findLabel = $props.findLabel
export const labelFound = $props.labelFound
export const lookupLimited = $props.lookupLimited
export const findAssignee = $props.findAssignee
export const assigneeChoices = $props.assigneeChoices
export const canEditMetadata = $props.canEditMetadata
export const issueStatus = $props.issueStatus
export const canChangeIssueStatus = $props.canChangeIssueStatus
export const forgejoStatusMenu = $props.forgejoStatusMenu
export const statusEditor = $props.statusEditor
export const statusDraft = $props.statusDraft
export const statusMessage = $props.statusMessage
export const statusUnavailable = $props.statusUnavailable
export const statusHref = $props.statusHref
export const metadataEditor = $props.metadataEditor
export const metadataDraft = $props.metadataDraft
export const metadataMessage = $props.metadataMessage
export const metadataUnavailable = $props.metadataUnavailable
export const metadataHref = $props.metadataHref
export const metadataLabelsHref = $props.metadataLabelsHref
export const metadataAssigneesHref = $props.metadataAssigneesHref
export const metadataAction = $props.metadataAction
export const commentAction = $props.commentAction
export const commentText = $props.commentText
export const commentScope = $props.commentScope
export const commentIntent = $props.commentIntent
export const commentPending = $props.commentPending
export const commentBlocked = $props.commentBlocked
export const commentMessage = $props.commentMessage
export const canEditText = $props.canEditText
export const textDraft = $props.textDraft
export const textPreview = $props.textPreview
export const textPending = $props.textPending
export const textConflict = $props.textConflict
export const textLocked = $props.textLocked
export const textLimit = $props.textLimit
export const textTitle = $props.textTitle
export const currentText = $props.currentText
export const currentVersion = $props.currentVersion
export const textMessage = $props.textMessage
export const textForge = $props.textForge
export const textMessageField = $props.textMessageField
export const textAction = $props.textAction
export const titleEditHref = $props.titleEditHref
export const bodyEditHref = $props.bodyEditHref
export const activityRows = $props.activityRows
export const issueReactions = $props.issueReactions
export const reactionMessage = $props.reactionMessage
export const reactionComment = $props.reactionComment
export const reactionDraft = $props.reactionDraft
export const reactionAction = $props.reactionAction
export const olderActivityHref = $props.olderActivityHref
export const newerActivityHref = $props.newerActivityHref
export const states = [{ value: 'open', name: 'Open' }, { value: 'closed', name: 'Closed' }, { value: 'all', name: 'All states' }]
</script>
<script client>
import { initialSavedViews, issueViews, savedViewsMenu } from '../client/saved-views'

const issueScope = @json(savedViewScope)
const projectNames = new Map(@json(projectFilters.map(item => [item.id, (item.name + ' ' + item.path).toLowerCase()])))
const hiddenProjects = state(@json(hiddenProjectIds))
const projectSearch = state('')
const projectVisibility = derived(() => hiddenProjects().length ? hiddenProjects().length + ' hidden' : 'All shown')
const matchingProjects = derived(() => {
  const search = projectSearch().trim().toLowerCase()
  return new Set([...projectNames].filter(([, name]) => name.includes(search)).map(([id]) => id))
})
const issueFilters = useRef('issueFilters')
const issueFilterTrigger = useRef('issueFilterTrigger')
const issueStatusMenu = useRef('issueStatusMenu')
const savedViewTitle = 'issue view'
const savedViewMenuRef = useRef('savedViewMenuRef')
const savedViewTrigger = useRef('savedViewTrigger')
const savedViewDialog = useRef('savedViewDialog')
const savedViewNameInput = useRef('savedViewNameInput')
const savedViewState = state(initialSavedViews())
const listViews = savedViewsMenu({
  kind: issueViews,
  scope: () => issueScope,
  detail: @json(savedViewDetail),
  profiles: @json(profiles.map(item => String(item.id))),
  repositories: @json(repositories.map(item => item.toLowerCase())),
  elements: () => ({ menu: savedViewMenuRef.current, trigger: savedViewTrigger.current,
    dialog: savedViewDialog.current, nameInput: savedViewNameInput.current }),
  publish: value => savedViewState.set(value),
  nextTick,
  closeSibling: () => { if (issueFilters.current) issueFilters.current.open = false },
})

onMount(listViews.mount)
onMount(() => {
  issueFilters.current?.querySelector('[data-issue-filter-result]')?.scrollIntoView({ block: 'nearest' })
})
useEventListener('storage', listViews.storageChanged)
useEventListener('pageshow', listViews.refresh)
useEventListener('pointerdown', event => {
  listViews.dismissOutside(event)
  const filters = issueFilters.current
  if (filters?.open && !filters.contains(event.target)) filters.open = false
  const status = issueStatusMenu.current
  if (status?.open && !status.contains(event.target)) status.open = false
})

function closeIssueDisclosure(event) {
  const details = event.currentTarget
  if (event.key !== 'Escape' || !details?.open || event.defaultPrevented || event.isComposing) return
  event.preventDefault()
  event.stopPropagation()
  details.open = false
  details.querySelector('summary')?.focus()
}

function issueStatusKeys(event) {
  if (event.key === 'Escape') return closeIssueDisclosure(event)
  if ((event.key !== 'ArrowDown' && event.key !== 'ArrowUp') || event.defaultPrevented || event.isComposing) return
  const menu = event.currentTarget
  event.preventDefault()
  menu.open = true
  menu.querySelector('button')?.focus()
}

function issueTextShortcut(event) {
  if (event.defaultPrevented || event.isComposing || event.keyCode === 229 || event.repeat) return
  if (event.key === 'Escape') {
    const cancel = event.currentTarget.querySelector('[data-issue-text-cancel]')
    if (cancel) {
      event.preventDefault()
      cancel.click()
    }
  }
  if (event.key !== 'Enter' || !(event.metaKey || event.ctrlKey) || event.shiftKey || event.altKey) return
  const save = event.currentTarget.querySelector('[data-issue-text-save]')
  if (!save) return
  event.preventDefault()
  event.currentTarget.requestSubmit(save)
}

function submitIssueCommentShortcut(event) {
  if (event.key !== 'Enter' || !(event.metaKey || event.ctrlKey) || event.shiftKey
    || event.altKey || event.isComposing || event.keyCode === 229 || event.repeat || event.target.readOnly
    || !event.target.value.trim()) return
  event.preventDefault()
  event.target.form?.requestSubmit()
}
function changeProjectVisibility(event) {
  const id = Number(event.target.value)
  const next = new Set(hiddenProjects())
  if (event.target.checked) next.add(id)
  else next.delete(id)
  hiddenProjects.set([...next])
}

function submitIssueLookup(event, action) {
  if (event.key !== 'Enter' || event.isComposing) return
  const form = event.target.form
  const submitter = form?.elements.namedItem(action)
  if (!submitter) return
  event.preventDefault()
  form.requestSubmit(submitter)
}

function closeIssueFilters(event) {
  if (event.key !== 'Escape' || !issueFilters.current?.open || event.defaultPrevented || event.isComposing) return
  event.preventDefault()
  event.stopPropagation()
  issueFilters.current.open = false
  issueFilterTrigger.current?.focus()
}
</script>
<main data-harness-shell data-issue-workspace class="text-neutral-900 dark:text-neutral-100">
  <header data-issue-header>
    <a href="{{ backHref }}" data-issue-back>
      <span class="inline-block size-4 i-hugeicons-arrow-left-01" aria-hidden="true"></span>Workspace
    </a>
    <h1>Issues</h1>
  </header>
  <div data-issue-columns data-detail="{{ hasDetail }}">
    <section data-issue-list aria-label="GitHub issues">
      <form action="/issues" method="get" data-issue-filters aria-label="Issue filters">
        @foreach(listSelectionFields as field)
          <input type="hidden" name="{{ field[0] }}" value="{{ field[1] }}">
        @endforeach
        <div data-issue-search>
          <label for="issue-search" class="sr-only">Search issues</label>
          <span class="i-hugeicons-search-01" aria-hidden="true"></span>
          <input id="issue-search" type="search" name="q" maxlength="160" value="{{ scope.search }}" placeholder="Search issues" enterkeyhint="search">
          <button type="submit" data-issue-button aria-label="Search">
            <span class="inline-block size-4 i-hugeicons-arrow-right-01" aria-hidden="true"></span>
          </button>
        </div>
        <div data-issue-filter-toolbar>
          <label data-issue-sort>
            <span id="issue-order-label" class="sr-only">Order</span>
            <select name="sort" aria-labelledby="issue-order-label" @change="$event.target.form?.requestSubmit()">
              <option value="updated" @if(scope.sort === 'updated')selected@endif>Updated</option>
              <option value="created" @if(scope.sort === 'created')selected@endif>Newest</option>
            </select>
          </label>
          <details data-issue-filter-menu ref="issueFilters" @if(findLabel || findAssignee)open@endif @keydown="closeIssueFilters">
            <summary data-issue-button ref="issueFilterTrigger" @click="listViews.closeMenu(false)">
              <span class="inline-block size-4 i-hugeicons-filter" aria-hidden="true"></span>
              Filters
              @if(filterCount)<span data-pr-filter-count>{{ filterCount }}</span>@endif
            </summary>
            <div data-issue-filter-fields>
              <div data-issue-filter-body>
                <label>
                  <span id="issue-filter-profile">Profile</span>
                  <select name="profile" aria-labelledby="issue-filter-profile">
                    @if(!profiles.length)<option value="0">No profiles</option>@endif
                    @foreach(profiles as item)
                      <option value="{{ item.id }}" @if(item.id === profile)selected@endif>{{ item.name }}</option>
                    @endforeach
                  </select>
                </label>
                <label>
                  <span id="issue-filter-repository">Repository</span>
                  <select name="repository" aria-labelledby="issue-filter-repository">
                    <option value="">All repositories</option>
                    @foreach(repositoryOptions as item)
                      <option value="{{ item.key }}" @if(item.key === repository)selected@endif>{{ item.label }}</option>
                    @endforeach
                  </select>
                </label>
                <label>
                  <span id="issue-filter-state">Status</span>
                  <select name="state" aria-labelledby="issue-filter-state">
                    @foreach(states as item)
                      <option value="{{ item.value }}" @if(item.value === scope.state)selected@endif>{{ item.name }}</option>
                    @endforeach
                  </select>
                </label>
                <label>
                  <span id="issue-filter-involvement">Involvement</span>
                  <select name="involvement" aria-labelledby="issue-filter-involvement">
                    <option value="">Everyone</option>
                    <option value="assigned" @if(scope.involvement === 'assigned')selected@endif>Assigned to me</option>
                    <option value="authored" @if(scope.involvement === 'authored')selected@endif>Opened by me</option>
                    <option value="mentioned" @if(scope.involvement === 'mentioned')selected@endif>Mentioning me</option>
                  </select>
                </label>
                @if(projectFilters.length)
                  <details data-issue-project-filter>
                    <summary>
                      <span>Projects</span>
                      <span :text="projectVisibility()">@if(hiddenProjectIds.length){{ hiddenProjectIds.length }} hidden@else All shown@endif</span>
                    </summary>
                    <div data-issue-project-actions>
                      @if(projectFilters.length > 8)
                        <label for="issue-project-search" class="sr-only">Search projects</label>
                        <input id="issue-project-search" type="search" placeholder="Search projects"
                          @input="projectSearch.set($event.target.value)" @keydown="$event.key === 'Enter' && !$event.isComposing && $event.preventDefault()">
                      @endif
                      <button type="button" data-issue-button :disabled="!hiddenProjects().length" @click="hiddenProjects.set([])">Show all</button>
                      <button type="button" data-issue-button :disabled="hiddenProjects().length === projectNames.size"
                        @click="hiddenProjects.set([...projectNames.keys()])">Hide all</button>
                    </div>
                    <div data-issue-filter-choices role="group" aria-label="Project visibility">
                      @foreach(projectFilters as item)
                        <label :hidden="!matchingProjects().has({{ item.id }})">
                          <input type="checkbox" name="hideProject" value="{{ item.id }}" @if(item.hidden)checked@endif
                            :checked="hiddenProjects().includes({{ item.id }})" @change="changeProjectVisibility">
                          <span>Hide {{ item.name }}@if(item.path) <small>{{ item.path }}</small>@endif</span>
                        </label>
                      @endforeach
                      <p data-issue-filter-feedback hidden :hidden="matchingProjects().size > 0">No matching projects.</p>
                    </div>
                  </details>
                @endif
                <fieldset @if(findAssignee)data-issue-filter-result@endif>
                  <legend>Assignee</legend>
                  <input type="hidden" name="shownAssignee" value="{{ scope.assignee }}">
                  <div data-issue-label-search>
                    <label for="issue-assignee" class="sr-only">Assignee username</label>
                    <input id="issue-assignee" list="issue-assignees" name="assignee" maxlength="256" value="{{ scope.assignee }}"
                      placeholder="Anyone" autocomplete="off" autocapitalize="none" spellcheck="false"
                      @keydown="submitIssueLookup($event, 'findAssignees')">
                    <button type="submit" data-issue-button name="findAssignees" value="1">Find people</button>
                  </div>
                  @if(findAssignee)
                    @if(!assigneeChoices.length)<p role="status" data-issue-filter-feedback>No matching people.</p>@endif
                    @if(lookupLimited)<p role="status" data-issue-filter-feedback>Some people are unavailable.</p>@endif
                    <div data-issue-filter-choices aria-label="Issue assignee choices">
                      @foreach(assigneeChoices as person)
                        <button type="submit" data-issue-button name="pickAssignee" value="{{ person.value }}">
                          {{ person.value }}@if(person.description) <span>{{ person.description }}</span>@endif
                        </button>
                      @endforeach
                    </div>
                  @endif
                  <datalist id="issue-assignees">
                    <option value="@me">Me</option>
                    @foreach(assigneeOptions as name)<option value="{{ name }}"></option>@endforeach
                  </datalist>
                </fieldset>
                <fieldset @if(findLabel)data-issue-filter-result@endif>
                  <legend>Labels</legend>
                  <div data-issue-label-search>
                    <label for="issue-label-search" class="sr-only">Find labels</label>
                    <input id="issue-label-search" type="search" name="findLabel" value="{{ findLabel }}" maxlength="100" placeholder="Find labels"
                      @keydown="submitIssueLookup($event, 'findLabels')">
                    <button type="submit" data-issue-button name="findLabels" value="1">Find labels</button>
                  </div>
                  @if(findLabel)
                    <p role="status" data-issue-filter-feedback>
                      @if(labelFound){{ labelFound }} found@else No matching labels. @endif
                      @if(lookupLimited)Some label results are unavailable.@endif
                    </p>
                  @endif
                  @if(labelOptions.length)
                    <div data-issue-filter-choices aria-label="Issue label choices">
                      @foreach(labelOptions as item)
                        <label><input type="checkbox" name="label" value="{{ item.name }}" @if(item.checked)checked@endif>{{ item.name }}</label>
                      @endforeach
                    </div>
                  @endif
                </fieldset>
                @if(repositoryFilters.length > 1)
                  <fieldset>
                    <legend>Hide repositories</legend>
                    <div data-issue-filter-choices>
                      @foreach(repositoryFilters as item)
                        <label><input type="checkbox" name="hideRepository" value="{{ item.key }}" @if(item.hidden)checked@endif>{{ item.name }}</label>
                      @endforeach
                    </div>
                  </fieldset>
                @endif
              </div>
              <div data-issue-filter-actions><button type="submit" data-issue-button>Apply filters</button></div>
            </div>
          </details>
          @include('../partials/harness-saved-views', { savedViewSurface: 'issue', savedViewLabel: 'Saved issue views' })
        </div>
      </form>
      @include('../partials/harness-saved-view-dialog')
      @if(failures.length || partial)
        <div data-issue-notice role="status">
          @if(partial)<p>Some issue results are beyond the search limit.</p>@endif
          @foreach(failures as failure)
            <p><strong>{{ failure.repository }}</strong> {{ failure.reason }}</p>
          @endforeach
          <a href="{{ retryHref }}" data-issue-button>Retry</a>
        </div>
      @endif
      @if(!repositories.length)
        <p data-issue-empty>Trust a project with a GitHub, GitLab, or Forgejo remote to browse its issues.</p>
      @elseif(!hasIncludedRepositories)
        <p data-issue-empty>Show at least one project or repository in Filters.</p>
      @elseif(rows.length)
        <ul data-issue-rows aria-label="Issue results">
          @foreach(rows as row)
            <li>
              <a data-issue-row href="{{ row.href }}" @if(row.current)aria-current="true"@endif>
                <span data-issue-state="{{ row.state }}">@if(row.state === 'open')Open@else Closed@endif</span>
                <span data-issue-row-name>
                  <strong>{{ row.title }}</strong>
                  <span>{{ row.repository }} #{{ row.number }}@if(row.tracker !== 'github') · {{ row.sourceLabel }}@endif@if(row.author) · {{ row.author }}@endif</span>
                </span>
                @if(row.dateLabel)<span data-issue-date aria-label="{{ datePurpose }} {{ row.dateLabel }}">{{ row.dateLabel }}</span>@endif
              </a>
            </li>
          @endforeach
        </ul>
      @else
        @if(!failures.length)<p data-issue-empty>No issues match these filters.</p>@endif
      @endif
      @if(previousHref || nextHref)
        <nav data-issue-pages aria-label="Issue pages">
          @if(previousHref)<a data-issue-button href="{{ previousHref }}">Previous page</a>@endif
          <span>Page {{ scope.page }}</span>
          @if(nextHref)<a data-issue-button href="{{ nextHref }}">Next page</a>@endif
        </nav>
      @endif
    </section>
    @if(hasDetail)
      <section data-issue-detail aria-labelledby="issue-title">
        <a data-issue-back href="{{ listHref }}">
          <span class="inline-block size-4 i-hugeicons-arrow-left-01" aria-hidden="true"></span>Back to issues
        </a>
        @if(selected)
          <header data-issue-detail-heading>
            <p>{{ selected.repository }} #{{ selected.number }}@if(selected.tracker !== 'github') · {{ selected.sourceLabel }}@endif</p>
            <div data-issue-field-header>
              <h2 id="issue-title" tabindex="-1">{{ selected.title }}</h2>
              @if(canEditText && !textDraft)
                <a href="{{ titleEditHref }}" data-issue-button aria-label="Edit title">Edit title</a>
              @endif
            </div>
            @if(textDraft?.field === 'title')
              @include('../partials/harness-issue-text-editor')
            @elseif(textMessage && !textDraft && textMessageField === 'title')
              <p role="status" data-issue-metadata-message>{{ textMessage }}</p>
            @endif
            <div data-issue-meta>
              @if(forgejoStatusMenu)
                <details data-issue-status-menu ref="issueStatusMenu" @keydown="issueStatusKeys">
                  <summary data-issue-status-control data-issue-button aria-label="Change issue status, {{ issueStatus }}">
                    <span data-issue-state="{{ selected.state }}">{{ issueStatus }}</span>
                    <span class="inline-block size-4 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
                  </summary>
                  <form method="post" action="{{ metadataAction }}#issue-status" aria-label="New issue status">
                    <input type="hidden" name="kind" value="{{ forgejoStatusMenu.kind }}">
                    <input type="hidden" name="scope" value="{{ forgejoStatusMenu.scope }}">
                    <input type="hidden" name="revision" value="{{ forgejoStatusMenu.revision }}">
                    <input type="hidden" name="intent" value="{{ forgejoStatusMenu.intent }}">
                    @foreach(forgejoStatusMenu.options as option)
                      <button type="submit" name="choice" value="{{ option.key }}" data-issue-button>
                        <span data-issue-state="{{ option.key }}">{{ option.name }}</span>
                      </button>
                    @endforeach
                  </form>
                </details>
              @elseif(canChangeIssueStatus && !statusEditor && !statusDraft)
                <a href="{{ statusHref }}#issue-title" data-issue-status-control data-issue-button aria-label="Change issue status, {{ issueStatus }}">
                  <span data-issue-state="{{ selected.state }}">{{ issueStatus }}</span>
                  <span class="inline-block size-4 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
                </a>
              @else
                <span data-issue-state="{{ selected.state }}">{{ issueStatus }}</span>
              @endif
              @if(selected.author)<span>{{ selected.author }}</span>@endif
              @if(selected.dateLabel)<span>{{ selected.dateLabel }}</span>@endif
            </div>
          </header>
          <div id="issue-status">
            @include('../partials/harness-issue-status-editor')
          </div>
          <div data-issue-actions>
            <a data-issue-button data-issue-primary href="{{ draftHref }}">Open as draft</a>
            <a data-issue-button href="{{ selected.url }}" rel="noreferrer" target="_blank">View on {{ textForge }}</a>
          </div>
          <section id="issue-metadata" aria-label="Issue labels and assignees">
            <dl data-issue-metadata>
              <div>
                <dt>Labels</dt>
                <dd>
                  @if(selected.labels.length)
                    @foreach(selected.labels as label)<span data-issue-label>{{ label.name }}</span>@endforeach
                  @else
                    <span>None</span>
                  @endif
                  @if(canEditMetadata && !metadataEditor && !metadataDraft)
                    <a href="{{ metadataLabelsHref }}#issue-metadata" data-issue-button>Change labels</a>
                  @endif
                </dd>
              </div>
              <div>
                <dt>Assignees</dt>
                <dd>
                  @if(selected.assignees.length)
                    @foreach(selected.assignees as assignee)<span>{{ assignee }}</span>@endforeach
                  @else
                    <span>None</span>
                  @endif
                  @if(canEditMetadata && !metadataEditor && !metadataDraft)
                    <a href="{{ metadataAssigneesHref }}#issue-metadata" data-issue-button>Change assignees</a>
                  @endif
                </dd>
              </div>
            </dl>
            @include('../partials/harness-issue-metadata-editor')
          </section>
          <section aria-labelledby="issue-description" data-issue-description>
            <div data-issue-field-header>
              <h3 id="issue-description" tabindex="-1">Description</h3>
              @if(canEditText && !textDraft)
                <a href="{{ bodyEditHref }}" data-issue-button aria-label="Edit description">Edit description</a>
              @endif
            </div>
            @if(textDraft?.field === 'body')
              @include('../partials/harness-issue-text-editor')
            @else
              @if(textMessage && !textDraft && textMessageField === 'body')
                <p role="status" data-issue-metadata-message>{{ textMessage }}</p>
              @endif
              <div data-issue-markdown="description" class="transcript-markdown">@if(!selected.description)No description.@endif</div>
            @endif
            @if(reactionMessage && !reactionComment)
              @include('../partials/harness-issue-reaction-result')
            @endif
            @if(issueReactions)
              @include('../partials/harness-issue-reactions', { bar: issueReactions, barLabel: 'Issue reactions' })
            @endif
          </section>
          @if(linkedThreads.length || threadChoices.length || pullRequests.length)
            <section data-issue-relations aria-labelledby="issue-threads">
              <h3 id="issue-threads">Linked threads</h3>
              @if(linkedThreads.length)
                <ul data-issue-thread-list>
                  @foreach(linkedThreads as thread)
                    <li>
                      <a href="/s/{{ thread.id }}">{{ thread.title }}</a>
                      <form action="{{ issueThreadAction }}" method="post">
                        <input type="hidden" name="thread" value="{{ thread.id }}">
                        <button type="submit" name="action" value="unlink" data-issue-button aria-label="Unlink {{ thread.title }}">Unlink</button>
                      </form>
                    </li>
                  @endforeach
                </ul>
              @else
                <p>No linked threads.</p>
              @endif
              @if(threadChoices.length)
                <details>
                  <summary data-issue-button>Link an existing thread</summary>
                  <form data-issue-thread-picker action="{{ issueThreadAction }}" method="post">
                    <div>
                      <label for="issue-thread-select">Thread</label>
                      <select id="issue-thread-select" name="thread" required>
                        <option value="" selected disabled>Choose a thread</option>
                        @foreach(threadChoices as thread)
                          <option value="{{ thread.id }}">{{ thread.title }}</option>
                        @endforeach
                      </select>
                    </div>
                    <button type="submit" name="action" value="link" data-issue-button>Link thread</button>
                  </form>
                </details>
              @endif
              @if(pullRequests.length)
                <h4>@if(selected.tracker === 'gitlab')Related changes@else Pull requests@endif</h4>
                <ul data-issue-thread-list>
                  @foreach(pullRequests as pull)
                    <li><a href="{{ pull.href }}" @if(selected.tracker === 'gitlab' && pull.href.startsWith('https://'))target="_blank" rel="noreferrer"@endif>{{ pull.label }}</a></li>
                  @endforeach
                </ul>
              @endif
            </section>
          @endif
          <section data-issue-comments aria-labelledby="issue-comments">
            <h3 id="issue-comments" tabindex="-1">Activity@if(selected.commentTotal) ({{ selected.commentTotal }})@endif</h3>
            @if(olderActivityHref || olderCommentsHref)
              <nav data-issue-pages aria-label="Earlier activity">
                @if(olderActivityHref)<a data-issue-button href="{{ olderActivityHref }}">Older activity</a>@endif
                @if(olderCommentsHref)<a data-issue-button href="{{ olderCommentsHref }}">Older comments</a>@endif
              </nav>
            @endif
            @if(reactionMessage && reactionComment)
              @include('../partials/harness-issue-reaction-result')
            @endif
            @if(selected.activityDegraded && selected.activityAvailable)
              @if(selected.tracker === 'forgejo')
                <p role="status">Some Forgejo activity could not load. Refresh to try again.</p>
              @else
                <p role="status">GitHub could only load comments. Refresh for issue events.</p>
              @endif
            @endif
            @if(!selected.activityAvailable)
              <p role="status">{{ textForge }} could not load activity. Refresh to try again.</p>
            @elseif(!activityRows.length)
              <p>No activity on this page.</p>
            @else
              @foreach(activityRows as item)
                @if(item.kind === 'comment')
                  <article id="issue-comment-{{ item.id }}" tabindex="-1">
                    <header>
                      <strong>{{ item.author || textForge + ' user' }}</strong>
                      <a href="{{ item.url }}" target="_blank" rel="noreferrer" aria-label="View comment {{ item.id }} on {{ textForge }}">{{ item.dateLabel || 'View on ' + textForge }}</a>
                    </header>
                    <div data-issue-markdown="{{ item.id }}" class="transcript-markdown"></div>
                    @if(item.reactions)
                      @include('../partials/harness-issue-reactions', { bar: item.reactions, barLabel: 'Comment ' + item.id + ' reactions' })
                    @endif
                  </article>
                @else
                  <div data-issue-event>
                    @if(item.author)<strong>{{ item.author }}</strong>@endif
                    <span>{{ item.label }}</span>
                    @if(item.href)
                      <a href="{{ item.href }}" @if(item.external)target="_blank" rel="noreferrer"@endif>{{ item.linkLabel }}</a>
                    @endif
                    <span>{{ item.dateLabel }}</span>
                  </div>
                @endif
              @endforeach
            @endif
            @if(newerActivityHref || newerCommentsHref)
              <nav data-issue-pages aria-label="Later activity">
                @if(newerActivityHref)<a data-issue-button href="{{ newerActivityHref }}">Newer activity</a>@endif
                @if(newerCommentsHref)<a data-issue-button href="{{ newerCommentsHref }}">Newer comments</a>@endif
              </nav>
            @endif
          </section>
          @include('../partials/harness-issue-comment-composer')
        @else
          <h2 id="issue-title">Issue unavailable</h2>
          <p role="status">{{ error }}</p>
          @if(commentText)@include('../partials/harness-issue-comment-composer')@endif
          @if(textDraft)@include('../partials/harness-issue-text-editor')@endif
        @endif
      </section>
    @endif
  </div>
</main>
