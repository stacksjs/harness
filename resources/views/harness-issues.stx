<script server>
export const profiles = $props.profiles
export const profile = $props.profile
export const repositories = $props.repositories
export const repository = $props.repository
export const scope = $props.scope
export const rows = $props.rows
export const failures = $props.failures
export const partial = $props.partial
export const selected = $props.selected
export const error = $props.error
export const hasDetail = Boolean(selected || error)
export const backHref = $props.backHref
export const listHref = $props.listHref
export const retryHref = $props.retryHref
export const datePurpose = $props.datePurpose
export const previousHref = $props.previousHref
export const nextHref = $props.nextHref
export const draftHref = $props.draftHref
export const olderCommentsHref = $props.olderCommentsHref
export const newerCommentsHref = $props.newerCommentsHref
export const states = [{ value: 'open', name: 'Open' }, { value: 'closed', name: 'Closed' }, { value: 'all', name: 'All states' }]
</script>
<main data-harness-shell data-issue-workspace class="text-neutral-900 dark:text-neutral-100">
  <header data-issue-header>
    <a href="{{ backHref }}" data-issue-back>
      <span class="inline-block size-4 i-hugeicons-arrow-left-01" aria-hidden="true"></span>Workspace
    </a>
    <h1>Issues</h1>
  </header>
  <div data-issue-columns data-detail="{{ hasDetail }}">
    <section data-issue-list aria-label="GitHub issues">
      <form action="/issues" method="get" data-issue-filters aria-label="Issue filters">
        <label data-issue-search>
          <span>Search issues</span>
          <input type="search" name="q" maxlength="160" value="{{ scope.search }}" placeholder="Search titles and descriptions" enterkeyhint="search">
        </label>
        <div data-issue-filter-fields>
          <label>
            <span>Profile</span>
            <select name="profile">
              @if(!profiles.length)<option value="0">No profiles</option>@endif
              @foreach(profiles as item)
                <option value="{{ item.id }}" @if(item.id === profile)selected@endif>{{ item.name }}</option>
              @endforeach
            </select>
          </label>
          <label>
            <span>Repository</span>
            <select name="repository">
              <option value="">All repositories</option>
              @foreach(repositories as item)
                <option value="{{ item }}" @if(item === repository)selected@endif>{{ item }}</option>
              @endforeach
            </select>
          </label>
          <label>
            <span>Status</span>
            <select name="state">
              @foreach(states as item)
                <option value="{{ item.value }}" @if(item.value === scope.state)selected@endif>{{ item.name }}</option>
              @endforeach
            </select>
          </label>
          <label>
            <span>Order</span>
            <select name="sort">
              <option value="updated" @if(scope.sort === 'updated')selected@endif>Recently updated</option>
              <option value="created" @if(scope.sort === 'created')selected@endif>Newest</option>
            </select>
          </label>
        </div>
        <button type="submit" data-issue-button>Apply filters</button>
      </form>
      @if(failures.length || partial)
        <div data-issue-notice role="status">
          @if(partial)<p>GitHub limited results for this search.</p>@endif
          @foreach(failures as failure)
            <p><strong>{{ failure.repository }}</strong> {{ failure.reason }}</p>
          @endforeach
          <a href="{{ retryHref }}" data-issue-button>Retry</a>
        </div>
      @endif
      @if(!repositories.length)
        <p data-issue-empty>Trust a project with a GitHub remote to browse its issues.</p>
      @elseif(rows.length)
        <ul data-issue-rows aria-label="Issue results">
          @foreach(rows as row)
            <li>
              <a data-issue-row href="{{ row.href }}" @if(row.current)aria-current="true"@endif>
                <span data-issue-state="{{ row.state }}">@if(row.state === 'open')Open@else Closed@endif</span>
                <span data-issue-row-name>
                  <strong>{{ row.title }}</strong>
                  <span>{{ row.repository }} #{{ row.number }}@if(row.author) · {{ row.author }}@endif</span>
                </span>
                @if(row.dateLabel)<span data-issue-date aria-label="{{ datePurpose }} {{ row.dateLabel }}">{{ row.dateLabel }}</span>@endif
              </a>
            </li>
          @endforeach
        </ul>
      @else
        @if(!failures.length)<p data-issue-empty>No issues match these filters.</p>@endif
      @endif
      @if(previousHref || nextHref)
        <nav data-issue-pages aria-label="Issue pages">
          @if(previousHref)<a data-issue-button href="{{ previousHref }}">Previous page</a>@endif
          <span>Page {{ scope.page }}</span>
          @if(nextHref)<a data-issue-button href="{{ nextHref }}">Next page</a>@endif
        </nav>
      @endif
    </section>
    @if(hasDetail)
      <section data-issue-detail aria-labelledby="issue-title">
        <a data-issue-back href="{{ listHref }}">
          <span class="inline-block size-4 i-hugeicons-arrow-left-01" aria-hidden="true"></span>Back to issues
        </a>
        @if(selected)
          <header data-issue-detail-heading>
            <p>{{ selected.repository }} #{{ selected.number }}</p>
            <h2 id="issue-title">{{ selected.title }}</h2>
            <div data-issue-meta>
              <span data-issue-state="{{ selected.state }}">@if(selected.state === 'open')Open@else Closed@endif</span>
              @if(selected.author)<span>{{ selected.author }}</span>@endif
              @if(selected.dateLabel)<span>{{ selected.dateLabel }}</span>@endif
            </div>
          </header>
          <div data-issue-actions>
            <a data-issue-button data-issue-primary href="{{ draftHref }}">Open as draft</a>
            <a data-issue-button href="{{ selected.url }}" rel="noreferrer" target="_blank">View on GitHub</a>
          </div>
          @if(selected.labels.length || selected.assignees.length)
            <dl data-issue-metadata>
              @if(selected.labels.length)
                <div><dt>Labels</dt><dd>@foreach(selected.labels as label)<span data-issue-label>{{ label.name }}</span>@endforeach</dd></div>
              @endif
              @if(selected.assignees.length)
                <div><dt>Assignees</dt><dd>@foreach(selected.assignees as assignee)<span>{{ assignee }}</span>@endforeach</dd></div>
              @endif
            </dl>
          @endif
          <div data-issue-markdown="description" class="transcript-markdown">@if(!selected.description)No description.@endif</div>
          <section data-issue-comments aria-labelledby="issue-comments">
            <h3 id="issue-comments">Comments</h3>
            @if(!selected.commentsAvailable)
              <p role="status">GitHub could not load comments. Refresh to try again.</p>
            @elseif(!selected.comments.length)
              <p>No comments on this page.</p>
            @else
              @foreach(selected.comments as comment)
                <article>
                  <header><strong>{{ comment.author || 'GitHub user' }}</strong><span>{{ comment.dateLabel }}</span></header>
                  <div data-issue-markdown="{{ comment.id }}" class="transcript-markdown"></div>
                </article>
              @endforeach
            @endif
            @if(olderCommentsHref || newerCommentsHref)
              <nav data-issue-pages aria-label="Comment pages">
                @if(olderCommentsHref)<a data-issue-button href="{{ olderCommentsHref }}">Older comments</a>@endif
                @if(newerCommentsHref)<a data-issue-button href="{{ newerCommentsHref }}">Newer comments</a>@endif
              </nav>
            @endif
          </section>
        @else
          <h2 id="issue-title">Issue unavailable</h2>
          <p role="status">{{ error }}</p>
        @endif
      </section>
    @endif
  </div>
</main>
