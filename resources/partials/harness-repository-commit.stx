<dialog data-repository-commit-dialog ref="repositoryCommitDialogBox" aria-labelledby="harness-repository-commit-title"
  @cancel.prevent="closeRepositoryCommit" @click.self="closeRepositoryCommit">
  <form data-share-dialog-body @submit.prevent="submitRepositoryCommit()">
    <h2 id="harness-repository-commit-title" :text="repositoryCommitStaged() ? 'Commit staged changes' : 'Commit changes'">Commit staged changes</h2>
    <p :hidden="!repositoryCommitPreview()?.branch" :text="'Branch ' + repositoryCommitPreview()?.branch"></p>
    <p hidden :hidden="repositoryCommitStaged()" class="text-neutral-600 dark:text-neutral-300">This commits the current working contents of the selected files.</p>
    <p role="status" :hidden="!repositoryCommitLoading()" :text="repositoryCommitStaged() ? 'Reading the staged changes…' : 'Reading the working-tree changes…'"></p>
    <p role="alert" :hidden="!repositoryCommitError()" :text="repositoryCommitError()"></p>
    <div :hidden="!repositoryCommitFileCount()" class="grid gap-1 min-w-0">
      <div class="flex flex-wrap gap-2 items-center justify-between">
        <div class="flex gap-2 items-center">
          <input type="checkbox" ref="repositoryCommitAllFilesBox" :aria-label="repositoryCommitStaged() ? 'Include all staged files' : 'Include all changed files'" :hidden="!repositoryCommitEditing()"
            :disabled="repositoryCommitBusy() || repositoryCommitLoading()" :checked="repositoryCommitIncludedCount() === repositoryCommitFileCount()"
            @change="chooseAllRepositoryCommitFiles" class="shrink-0 size-4">
          <p class="font-medium" aria-live="polite" :text="repositoryCommitIncludedCount() + ' of ' + repositoryCommitFileCount() + (repositoryCommitStaged() ? ' staged files included' : ' changed files included')"></p>
        </div>
        <button type="button" :aria-expanded="String(repositoryCommitEditing())" aria-controls="harness-repository-commit-files"
          :disabled="repositoryCommitBusy() || repositoryCommitLoading()" @click="repositoryCommitEditing.update(editing => !editing)"
          :text="repositoryCommitEditing() ? 'Done' : 'Edit files'" class="min-h-8 underline underline-offset-2">Edit files</button>
      </div>
      <ul id="harness-repository-commit-files" :aria-label="repositoryCommitStaged() ? 'Staged files' : 'Changed files'" class="overflow-y-auto max-h-[27dvh] list-none border border-[var(--workspace-line)] rounded-md">
        <template :for="file in repositoryCommitVisibleFiles()" :key="file.key">
          <li class="flex gap-2 items-center px-2 min-w-0">
            <label class="flex flex-1 gap-2 items-center min-h-8 min-w-0" :class="repositoryCommitEditing() ? 'cursor-pointer' : ''">
              <input type="checkbox" :hidden="!repositoryCommitEditing()" :aria-label="'Include ' + file.path"
                :disabled="repositoryCommitBusy() || repositoryCommitLoading()" :checked="!repositoryCommitExcluded().has(file.index)"
                @change="chooseRepositoryCommitFile(file.index, $event)" class="shrink-0 size-4">
              <span class="min-w-0 break-all font-mono text-xs" :text="file.path"></span>
            </label>
            <span :hidden="!repositoryCommitExcluded().has(file.index)" class="shrink-0 text-neutral-600 text-xs dark:text-neutral-300">Excluded</span>
            <span data-staged-file-totals :hidden="!file.stats || repositoryCommitExcluded().has(file.index)" class="flex gap-1 shrink-0 font-mono tabular-nums text-xs">
              <span class="text-emerald-700 dark:text-emerald-300" :text="'+' + (file.stats?.insertions || 0)"></span>
              <span class="text-red-700 dark:text-red-300" :text="'−' + (file.stats?.deletions || 0)"></span>
            </span>
          </li>
        </template>
      </ul>
      <button type="button" :hidden="repositoryCommitFileCount() <= repositoryCommitLimit()"
        @click="repositoryCommitLimit.update(limit => limit + 40)" class="min-h-8 text-start underline">Show more files</button>
      <p data-staged-selected-totals :hidden="!repositoryCommitPreview()?.fileStats.length" class="flex gap-2 justify-end font-mono tabular-nums text-xs">
        <span class="font-sans text-neutral-600 dark:text-neutral-300">Selected lines</span>
        <span class="text-emerald-700 dark:text-emerald-300" :text="'+' + repositoryCommitTotals().insertions"></span>
        <span class="text-red-700 dark:text-red-300" :text="'−' + repositoryCommitTotals().deletions"></span>
      </p>
    </div>
    <label for="harness-repository-commit-message" class="font-medium"
      :text="repositoryCommitPreview()?.generation ? 'Commit message (optional)' : 'Commit message'">Commit message</label>
    <textarea id="harness-repository-commit-message" rows="3" maxlength="4096" autofocus
      :placeholder="repositoryCommitPreview()?.generation ? 'Leave blank to generate from the included files' : ''"
      :value="repositoryCommitMessage()" :disabled="repositoryCommitBusy()" @input="repositoryCommitMessage.set($event.target.value)"></textarea>
    <div data-share-dialog-actions class="flex-wrap">
      <button type="button" @click="closeRepositoryCommit" :disabled="repositoryCommitBusy()">Cancel</button>
      <button type="button" @click="loadRepositoryCommit" :hidden="!repositoryCommitError() || repositoryCommitGenerationFailed()" :disabled="repositoryCommitBusy() || repositoryCommitLoading()"
        :text="repositoryCommitStaged() ? 'Refresh staged files' : 'Refresh changed files'">Refresh staged files</button>
      <button type="button" hidden :hidden="repositoryCommitStaged() || !repositoryCommitPreview()?.canCreateBranch"
        @click="submitRepositoryCommit(true)" :disabled="!repositoryCommitCanSubmit()"
        :text="repositoryCommitBusy() && repositoryCommitNewBranch() ? repositoryCommitPendingLabel() : 'Commit on new branch'">Commit on new branch</button>
      <button type="submit" data-share-primary :disabled="!repositoryCommitCanSubmit()"
        :text="repositoryCommitBusy() && !repositoryCommitNewBranch() ? repositoryCommitPendingLabel() : 'Commit'">Commit</button>
    </div>
  </form>
</dialog>
