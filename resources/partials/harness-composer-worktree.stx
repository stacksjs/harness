<details data-draft-worktree @toggle="loadDraftWorktreeOptions" class="text-xs">
  <summary class="px-1 py-1.5 w-fit rounded-md cursor-pointer">
    <span :text="draftIsolated() ? 'New worktree' : 'Current folder'">Current folder</span>
  </summary>
  <div class="grid gap-2">
    <label class="flex flex-wrap gap-2 items-center">
      <span>Run in</span>
      <select aria-label="Run in" :value="draftIsolated() ? 'worktree' : 'project'" @change="changeDraftWorktreeMode" class="px-2 min-h-9 dark:bg-neutral-900 border border-black/15 rounded-md dark:border-white/20">
        <option value="project">Current folder</option>
        <template :if="draftWorktreeOptions()?.canStartWorktree">
          <option value="worktree">New worktree</option>
        </template>
      </select>
    </label>
    <p role="status" hidden :hidden="!draftWorktreeLoad()" :text="draftWorktreeLoad()" class="text-neutral-600 dark:text-neutral-300"></p>
    <div hidden :hidden="!draftIsolated()" class="grid gap-2">
      <label class="flex flex-wrap gap-2 items-center">
        <span>Base branch</span>
        <input type="text" autocomplete="off" placeholder="Default branch" maxlength="255" aria-label="Base branch"
          :value="draftBaseBranch()" @input="editDraftBaseBranch" class="px-2 min-h-9 min-w-0 dark:bg-neutral-900 border border-black/15 rounded-md dark:border-white/20">
      </label>
      <fieldset hidden :hidden="!draftWorktreeOptions()?.repositories.length" class="min-w-0">
        <legend class="mb-1">Repositories</legend>
        <div class="overflow-auto max-h-36">
          <template :for="repo in draftWorktreeOptions()?.repositories || []" :key="repo.key">
            <label class="flex gap-2 items-center min-h-9">
              <input type="checkbox" class="shrink-0" :checked="draftRepositoryKeys().includes(repo.key)" @change="selectDraftRepository(repo.key, $event)">
              <span class="truncate" :title="repo.key" :text="repo.label"></span>
            </label>
          </template>
        </div>
      </fieldset>
    </div>
  </div>
</details>
