<section data-follow-ups aria-labelledby="follow-ups-heading"
  @if(!initialFollowUps.entries.length)hidden@endif :hidden="!visibleFollowUps().length"
  class="flex relative flex-col gap-1.5 mx-auto pb-3 pt-1 max-w-[788px] w-full">
  <div class="flex flex-wrap gap-2 items-center justify-between min-w-0">
    <h2 id="follow-ups-heading" class="font-medium text-[12px]">Queued messages</h2>
    <span :hidden="!followUps().held || !followUps().entries.length" class="text-[12px] text-neutral-600 dark:text-neutral-300">Held</span>
  </div>
  <span aria-live="polite" class="sr-only" :text="visibleFollowUps().length + ' queued'"></span>
  <ol class="flex flex-col gap-1.5">
    <template :for="entry in visibleFollowUps()" :key="entry.id">
      <li data-follow-up :data-follow-up-id="entry.id"
        :data-editing="editingFollowUp()?.id === entry.id"
        :class="editingFollowUp()?.id === entry.id ? 'bg-blue-500/5 dark:bg-blue-500/10' : ''"
        class="flex flex-wrap gap-1.5 items-center justify-between px-2.5 py-1.5 min-w-0 text-[12px] border border-black/15 border-dashed rounded-lg dark:border-white/20">
        <p class="overflow-y-auto max-h-20 min-w-0 break-words whitespace-pre-wrap" :text="entry.text"></p>
        <div class="flex flex-wrap gap-1 items-center">
          <span :hidden="editingFollowUp()?.id !== entry.id" class="text-neutral-600 dark:text-neutral-300">Editing in composer</span>
          <span :hidden="!entry.local" class="text-neutral-600 dark:text-neutral-300" :text="entry.local ? (entry.error || 'Waiting to sync') : ''"></span>
          <button type="button" :hidden="!entry.local || !entry.error" :disabled="!!outboxSending()" @click="followUpActions()?.flush(true)" class="px-2 min-h-8 font-medium hover:bg-black/5 dark:hover:bg-white/10 rounded-md">Retry</button>
          <button type="button" :hidden="!entry.local || (entry.attempted && !entry.error)" :disabled="outboxSending() === entry.id" @click="followUpActions()?.removeLocal(entry.id)" aria-label="Remove unsynced message" title="Remove unsynced message" class="inline-flex items-center justify-center size-8 hover:bg-black/5 dark:hover:bg-white/10 rounded-md">
            <span class="size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
          </button>
          <button type="button" :hidden="entry.local || uiBusy() || editingFollowUp()?.id === entry.id" :disabled="!sessionOnline() || queueActionPending()" @click="followUpActions()?.run('send', entry.id)" class="px-2 min-h-8 font-medium hover:bg-black/5 dark:hover:bg-white/10 rounded-md">Send now</button>
          <button type="button" :hidden="entry.local || editingFollowUp()?.id === entry.id" :disabled="!sessionOnline() || queueActionPending()" @click="followUpActions()?.beginEdit(entry)" aria-label="Edit queued message" title="Edit queued message" class="inline-flex items-center justify-center size-8 hover:bg-black/5 dark:hover:bg-white/10 rounded-md">
            <span class="size-4 i-hugeicons-pencil-edit-02" aria-hidden="true"></span>
          </button>
          <button type="button" :hidden="entry.local || editingFollowUp()?.id === entry.id" :disabled="!sessionOnline() || queueActionPending() || followUps().entries[0]?.id === entry.id" @click="followUpActions()?.run('move', entry.id, 'up')" aria-label="Move queued message up" title="Move queued message up" class="inline-flex items-center justify-center size-8 hover:bg-black/5 dark:hover:bg-white/10 rounded-md disabled:opacity-40">
            <span class="size-4 i-hugeicons-arrow-up-01" aria-hidden="true"></span>
          </button>
          <button type="button" :hidden="entry.local || editingFollowUp()?.id === entry.id" :disabled="!sessionOnline() || queueActionPending() || followUps().entries.at(-1)?.id === entry.id" @click="followUpActions()?.run('move', entry.id, 'down')" aria-label="Move queued message down" title="Move queued message down" class="inline-flex items-center justify-center size-8 hover:bg-black/5 dark:hover:bg-white/10 rounded-md disabled:opacity-40">
            <span class="size-4 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
          </button>
          <button type="button" :hidden="entry.local || editingFollowUp()?.id === entry.id" :disabled="!sessionOnline() || queueActionPending()" @click="followUpActions()?.run('remove', entry.id)" aria-label="Remove queued message" title="Remove queued message" class="inline-flex items-center justify-center size-8 hover:bg-black/5 dark:hover:bg-white/10 rounded-md">
            <span class="size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
          </button>
        </div>
      </li>
    </template>
  </ol>
</section>
