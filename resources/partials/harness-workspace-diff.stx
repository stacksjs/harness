<section id="harness-changes" ref="changesPane" aria-labelledby="harness-changes-title" data-diff hidden :hidden="!diffOpen()" :data-diff-layout="diffLayout() === 'split' ? 'split' : 'stacked'" :data-diff-wrap="diffWrap()">
  <header data-diff-header class="flex flex-wrap gap-1.5 items-center">
    <h2 id="harness-changes-title" class="mr-auto font-semibold text-[13px]">Changes</h2>
    <div data-diff-layout-controls role="group" aria-label="Diff layout">
      <button type="button" @click="changeDiffLayout('stacked')" :aria-pressed="diffLayout() === 'split' ? 'false' : 'true'">Stacked</button>
      <button type="button" @click="changeDiffLayout('split')" :aria-pressed="diffLayout() === 'split' ? 'true' : 'false'">Split</button>
    </div>
    <button type="button" data-diff-wrap-control @click="toggleDiffWrap" :aria-pressed="diffWrap() ? 'true' : 'false'" aria-label="Wrap diff lines" title="Wrap lines">Wrap</button>
    <button type="button" @click="refreshWorkspaceDiff" aria-label="Refresh changes" title="Refresh changes" class="harness-icon-button">
      <span class="inline-block size-4 i-hugeicons-refresh" aria-hidden="true"></span>
    </button>
    <button type="button" ref="diffCloseBox" @click="toggleDiff" aria-label="Close changes" title="Close changes" class="harness-icon-button">
      <span class="inline-block size-4 i-hugeicons-cancel-01" aria-hidden="true"></span>
    </button>
  </header>
  <div data-diff-comparison hidden :hidden="!diffReviewOptions()?.isRepository && !diffRepositories().length">
    <label hidden :hidden="!diffRepositories().length">
      <span>Repository</span>
      <select aria-label="Git repository" :value="diffRepository()" @change="changeDiffRepository">
        <template :if="diffProjectRoot()">
          <option value="">Project root</option>
        </template>
        <template :for="repo in diffRepositories()" :key="repo.key">
          <option :value="repo.key" :text="repo.label"></option>
        </template>
      </select>
    </label>
    <label hidden :hidden="!diffReviewOptions()?.isRepository">
      <span>Compare</span>
      <select aria-label="Git comparison" :value="diffReviewMode()" @change="changeDiffReviewMode">
        <template :if="!diffRepository()">
          <option value="session">Session changes</option>
        </template>
        <option value="uncommitted">Uncommitted</option>
        <option value="branch">Branch changes</option>
        <option value="commit">Commit</option>
        <template :if="!diffRepository() || diffReviewOptions()?.turns.length || diffReviewMode() === 'turn'">
          <option value="turn">Turn</option>
        </template>
      </select>
    </label>
    <label hidden :hidden="diffReviewMode() !== 'branch'">
      <span>Base</span>
      <select aria-label="Base branch" :value="diffBaseRef()" @change="changeDiffBase">
        <option value="">Automatic</option>
        <template :for="branch in diffReviewOptions()?.branches || []" :key="branch.ref">
          <option :value="branch.ref" :text="branch.label"></option>
        </template>
      </select>
    </label>
    <label hidden :hidden="diffReviewMode() !== 'commit'">
      <span>Commit</span>
      <select aria-label="Branch commit" :value="diffCommit()" :disabled="!diffCommit() && !diffReviewOptions()?.commits.length" @change="changeDiffCommit">
        <option value="">Latest commit</option>
        <template :if="diffCommit() && !diffReviewOptions()?.commits.some(commit => commit.sha === diffCommit())">
          <option :value="diffCommit()" :text="diffCommit().slice(0, 7)"></option>
        </template>
        <template :for="commit in diffReviewOptions()?.commits || []" :key="commit.sha">
          <option :value="commit.sha" :text="commit.sha.slice(0, 7) + ' ' + commit.subject"></option>
        </template>
      </select>
    </label>
    <label hidden :hidden="diffReviewMode() !== 'turn'">
      <span>Turn</span>
      <select aria-label="Recorded turn" :value="diffTurn()" :disabled="!diffReviewOptions()?.turns.length" @change="changeDiffTurn">
        <option value="">Latest recorded turn</option>
        <template :for="turn in diffReviewOptions()?.turns.slice().reverse() || []" :key="turn.id">
          <option :value="String(turn.id)" :selected="String(turn.id) === diffTurn()" :text="'Turn ' + turn.number"></option>
        </template>
      </select>
    </label>
  </div>
  <section data-diff-git-status hidden :hidden="!diffGitStatus()" aria-label="Repository status"
    class="flex flex-wrap gap-x-3 gap-y-1 items-baseline px-3 py-1.5 min-w-0 text-neutral-600 text-xs dark:text-neutral-300">
    <span class="max-w-full font-mono truncate" :text="diffStatusBranch()" :title="diffStatusBranch()"></span>
    <span :hidden="!diffStatusTracking()" :text="diffStatusTracking()"></span>
    <span role="status" :text="diffStatusChanges()"></span>
    @if(workspaceEditorAllowed)
      <div data-repository-actions aria-label="Git actions" role="group" class="flex flex-wrap gap-x-3 ms-auto">
        <button type="button" data-repository-commit-open aria-haspopup="dialog" :hidden="!diffGitStatus()?.staged || !diffGitStatus()?.branch || Boolean(diffGitStatus()?.conflicted)"
          :disabled="uiBusy() || Boolean(threadNavigation().archivedAt)" @click="openRepositoryCommit" class="min-h-10 font-medium underline underline-offset-2">Commit staged</button>
        <button type="button" aria-haspopup="dialog" :hidden="!diffGitStatus()?.upstream || !diffGitStatus()?.branch"
          :disabled="uiBusy() || Boolean(threadNavigation().archivedAt)" @click="openRepositorySync('pull', $event)" class="min-h-10 font-medium underline underline-offset-2">Pull</button>
        <button type="button" aria-haspopup="dialog" :hidden="!diffGitStatus()?.branch || !diffGitStatus()?.head"
          :disabled="uiBusy() || Boolean(threadNavigation().archivedAt)" @click="openRepositorySync('push', $event)" class="min-h-10 font-medium underline underline-offset-2">Push</button>
        <button type="button" data-repository-pull-request-open aria-haspopup="dialog" :hidden="!diffGitStatus()?.branch || !diffGitStatus()?.head"
          :disabled="uiBusy() || Boolean(threadNavigation().archivedAt)" @click="openRepositoryPullRequest" class="min-h-10 font-medium underline underline-offset-2">Create pull request</button>
      </div>
    @endif
  </section>
  <p role="status" data-repository-commit-result hidden :hidden="!repositoryCommitResult()" :text="repositoryCommitResult()" class="px-3 py-1 text-xs"></p>
  <p role="status" data-repository-sync-result hidden :hidden="!repositorySyncResult() || repositorySyncResult()?.repository !== diffRepository()"
    :text="repositorySyncResult()?.message" class="px-3 py-1 text-xs"></p>
  <div class="flex flex-wrap gap-x-2 items-baseline px-3 py-1 text-xs"
    :hidden="!selectedRepositoryPullRequest() && repositoryPullRequestResult()?.repository !== diffRepository()">
    <p role="status" :hidden="repositoryPullRequestResult()?.repository !== diffRepository()" :text="repositoryPullRequestResult()?.message"></p>
    <a data-repository-pull-request-link target="_blank" rel="noopener noreferrer" class="content-center min-h-8 underline underline-offset-2"
      :href="repositoryPullRequestResult()?.repository === diffRepository() ? repositoryPullRequestResult().url : pullRequestLink(selectedRepositoryPullRequest())"
      :text="'GitHub #' + (repositoryPullRequestResult()?.repository === diffRepository() ? repositoryPullRequestResult().number : selectedRepositoryPullRequest()?.number)"></a>
    @if(workspaceEditorAllowed)
      <button type="button" data-pull-request-checks-toggle :hidden="!selectedRepositoryPullRequest()" aria-controls="harness-pull-request-checks"
        :aria-expanded="repositoryChecksOpen() ? 'true' : 'false'" @click="toggleRepositoryChecks" class="min-h-9 font-medium underline underline-offset-2">Checks</button>
      <span data-pull-request-checks-summary :hidden="!repositoryChecksSummary()" :text="repositoryChecksSummary()"></span>
    @endif
  </div>
  <div data-diff-body>
    @includeWhen(workspaceEditorAllowed, '../partials/harness-pull-request-checks')
    <div data-diff-overview>
      <p data-diff-status role="status" :text="diffStatus()">Loading…</p>
      <button type="button" hidden :hidden="!diffFiles().length" :aria-disabled="diffFileLimits().size ? 'false' : 'true'" @click="collapseDiffFiles">Collapse all</button>
    </div>
    <p data-diff-empty-patch role="status" hidden :hidden="!diffReviewError()" :text="diffReviewError()"></p>
    <div data-diff-patch>
      <p data-diff-empty-patch hidden :hidden="!diffTruncated()">This patch was truncated because it is too large.</p>
      <ul data-diff-files class="list-none">
        <template :for="file in diffDisplayFiles()" :key="file.path">
          <li :data-diff-file="file.path">
            <div data-diff-file-heading>
            <button type="button" data-diff-file-toggle :aria-expanded="file.open ? 'true' : 'false'" :title="file.path" @click="toggleDiffFile(file)">
              <span class="shrink-0 size-4" :class="file.open ? 'i-hugeicons-arrow-down-01' : 'i-hugeicons-arrow-right-01'" aria-hidden="true"></span>
              <span data-diff-file-kind :data-status="file.status" :text="file.status"></span>
              <span class="min-w-0 font-mono truncate" :text="file.path"></span>
              <span class="shrink-0 ml-auto font-mono text-[11px]" :text="file.status === 'untracked' ? '' : '+' + file.insertions + ' −' + file.deletions"></span>
            </button>
            @if(workspaceEditorAllowed)
              <button type="button" data-diff-file-editor :hidden="file.status === 'deleted'" class="harness-icon-button" :aria-label="'Open ' + file.path + ' in editor'" title="Open working file in editor" aria-haspopup="dialog" @click="chooseWorkspaceEditor($event, diffWorkingFile(file.path))">
                <span class="size-4 i-hugeicons-source-code" aria-hidden="true"></span>
              </button>
            @endif
            </div>
            <template :if="file.open">
              <div data-diff-file-content>
                <p data-diff-empty-patch :hidden="file.rows.length > 0" :text="file.status === 'untracked' ? 'Untracked file' : 'No text patch available.'"></p>
                <p data-diff-empty-patch role="status" :hidden="!file.contextError" :text="file.contextError"></p>
                <button type="button" data-diff-more :hidden="!file.contextError" @click="loadDiffContext(file.path, true)">Retry context</button>
                <button type="button" data-diff-more :hidden="!file.earlier" @click="diffLineReveal.set(null)">Show from beginning</button>
                <div data-diff-lines role="region" :aria-label="'Patch for ' + file.path" :data-diff-path="file.path" tabindex="0" :hidden="!file.rows.length" @keydown="navigateDiffLines">
                  <div data-diff-grid>
                    <div data-diff-side-headings hidden :hidden="diffLayout() !== 'split'"><span>Before</span><span>After</span></div>
                    <template :for="row in file.rows" :key="row.key">
                      <template :if="row.gap">
                        <div data-diff-gap>
                          <button type="button" :hidden="!row.gap?.above" aria-label="Show unchanged lines above" title="Show unchanged lines above" @click="expandDiffContext(file.path, row.gap, 'above', $event)">
                            <span class="size-3.5 i-hugeicons-arrow-up-01" aria-hidden="true"></span>
                          </button>
                          <button type="button" :hidden="!row.gap?.below" aria-label="Show unchanged lines below" title="Show unchanged lines below" @click="expandDiffContext(file.path, row.gap, 'below', $event)">
                            <span class="size-3.5 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
                          </button>
                          <button type="button" :aria-label="'Show all ' + row.gap?.count + ' unchanged lines'" :text="row.gap?.count + (row.gap?.count === 1 ? ' unchanged line' : ' unchanged lines')" @click="expandDiffContext(file.path, row.gap, 'all', $event)"></button>
                        </div>
                      </template>
                      <div data-diff-hunk :hidden="!row.header" :text="row.header || ''"></div>
                      <div data-diff-row :hidden="Boolean(row.header || row.gap)">
                        <template :for="(cell, side) in row.cells">
                          <div data-diff-cell :data-kind="cell?.kind || 'empty'">
                            <button type="button" data-diff-line-number data-diff-side="before" tabindex="-1"
                              :hidden="diffLayout() === 'split'" :disabled="cell?.before == null" :aria-hidden="cell?.before == null"
                              :data-diff-number="cell?.before" :aria-label="'Before line ' + cell?.before"
                              :aria-pressed="isDiffLineSelected(file.path, 'before', cell?.before) ? 'true' : 'false'"
                              :text="cell?.before ?? ''" @click="selectDiffLine(file.path, 'before', cell.before)"></button>
                            <button type="button" data-diff-line-number :data-diff-side="diffGutterSide(side)" tabindex="-1"
                              :disabled="cell?.[diffGutterSide(side)] == null" :aria-hidden="cell?.[diffGutterSide(side)] == null"
                              :data-diff-number="cell?.[diffGutterSide(side)]" :aria-label="(diffGutterSide(side) === 'before' ? 'Before line ' : 'After line ') + cell?.[diffGutterSide(side)]"
                              :aria-pressed="isDiffLineSelected(file.path, diffGutterSide(side), cell?.[diffGutterSide(side)]) ? 'true' : 'false'"
                              :text="cell?.[diffGutterSide(side)] ?? ''" @click="selectDiffLine(file.path, diffGutterSide(side), cell[diffGutterSide(side)])"></button>
                            <span data-diff-mark aria-hidden="true" :text="cell?.kind === 'addition' ? '+' : cell?.kind === 'deletion' ? '−' : ''"></span>
                            <div data-diff-line-content>
                              <span class="sr-only" :text="diffLineLabel(cell, side)"></span>
                              <code :text="cell?.text ?? ''"></code>
                              <span data-diff-newline-note :hidden="!cell?.newlineNote" :text="cell?.newlineNote ?? ''"></span>
                            </div>
                          </div>
                        </template>
                      </div>
                    </template>
                  </div>
                </div>
                <button type="button" data-diff-more :hidden="!file.more" @click="showMoreDiffRows(file.path)">Show more lines</button>
              </div>
            </template>
          </li>
        </template>
      </ul>
      <details data-diff-raw hidden :hidden="!diffPatch()">
        <summary>Raw patch</summary>
        <pre :text="diffPatch()"></pre>
      </details>
    </div>
  </div>
  <footer data-diff-line-actions hidden :hidden="!diffLineSelection() && !diffLineNotice()">
    <div class="flex-1 min-w-0">
      <p hidden :hidden="!diffLineSelection()" class="truncate" :title="diffLineSelection()?.path" :text="(diffLineSelection()?.side === 'before' ? 'Before' : 'After') + ' line ' + diffLineSelection()?.line + ' · ' + diffLineSelection()?.path"></p>
      <p role="status" hidden :hidden="!diffLineNotice()" :text="diffLineNotice()"></p>
    </div>
    <button type="button" :hidden="!diffLineSelection()" @click="copyDiffLineLink">Copy line link</button>
    @if(workspaceEditorAllowed)
      <button type="button" :hidden="!canOpenDiffLineInEditor()" @click="chooseDiffEditor($event)" aria-haspopup="dialog">Open line in editor</button>
    @endif
  </footer>
</section>
