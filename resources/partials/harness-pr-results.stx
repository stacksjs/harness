<div data-pr-results-fragment>
  @if(incompleteSearch)
    <p role="status" data-pr-filter-feedback>GitHub returned partial results. Refresh to retry the search.</p>
  @endif
  @if(cappedSearch)
    <p role="status" data-pr-filter-feedback>GitHub search shows up to 1,000 results per repository. Narrow your filters for more specific matches.</p>
  @endif
  @if(failures.length)
    <details data-pr-list-problems>
      <summary>Some repositories could not be loaded</summary>
      @foreach(failures as failure)
        <p>{{ failure.repository }}. {{ failure.reason }}</p>
      @endforeach
    </details>
  @endif
  @if(detailsUnavailable)
    <p role="status" data-pr-filter-feedback>Some pull request details are unavailable.</p>
  @endif
  @if(groups.length)
    @foreach(groups as group)
      @if(group.label)
        <h3 id="pr-group-{{ group.key }}" data-pr-group-heading>{{ group.label }} <span>{{ group.entries.length }}</span></h3>
      @endif
      <ul data-pr-list data-pr-group="{{ group.key }}" @if(group.label) aria-labelledby="pr-group-{{ group.key }}" @else aria-label="Pull requests" @endif>
        @foreach(group.entries as pull)
          <li>
            <a href="{{ pull.href }}" data-pr-row @if(pull.selected) aria-current="page"@endif>
              <span class="inline-block size-4 i-hugeicons-git-pull-request" data-pr-state="{{ pull.status }}" aria-hidden="true"></span>
              <span data-pr-row-copy>
                <strong data-pr-row-title title="{{ pull.title }}"><span data-pr-number>#{{ pull.number }}</span> {{ pull.title }}</strong>
                <span data-pr-row-meta>
                  @if(pull.author)<span data-pr-row-author title="{{ pull.author }}">{{ pull.author }}</span>@endif
                  <span data-pr-row-repository title="{{ pull.repository }}">{{ pull.repository }}</span>
                  @if(pull.firstLabel)
                    <span data-pr-row-label @if(pull.firstLabel.color) style="--pr-label-color: {{ pull.firstLabel.color }}" @endif title="{{ pull.firstLabel.name }}">
                      <span>{{ pull.firstLabel.name }}</span>
                    </span>
                    @if(pull.moreLabels)
                      <span data-pr-row-more-labels title="{{ pull.remainingLabels }}">
                        <span aria-hidden="true">+{{ pull.moreLabels }}</span>
                        <span class="sr-only">More labels include {{ pull.remainingLabels }}</span>
                      </span>
                    @endif
                  @endif
                </span>
                @if(pull.checks || pull.reviewDecision || pull.conflicts || pull.isPrivate)
                  <span data-pr-row-signals>
                    @if(pull.isPrivate)<span data-pr-row-signal title="Private repository">Private</span>@endif
                    @if(pull.checks)<span data-pr-row-signal data-pr-checks="{{ pull.checks }}">{{ pull.checks }} checks</span>@endif
                    @if(pull.reviewDecision)<span data-pr-row-signal>{{ pull.reviewDecision }}</span>@endif
                    @if(pull.conflicts)<span data-pr-row-signal data-pr-conflicts>Merge conflicts</span>@endif
                  </span>
                @endif
              </span>
              <span data-pr-row-status>
                {{ pull.status }}
                @if(pull.updated)
                  <time datetime="{{ pull.updated }}">{{ pull.updatedLabel }}</time>
                @endif
                @if(pull.additions != null && pull.deletions != null)
                  <span data-pr-row-diff>
                    <span aria-label="{{ pull.additions }} additions" data-pr-additions>+{{ pull.additions }}</span>
                    <span aria-label="{{ pull.deletions }} deletions" data-pr-deletions>−{{ pull.deletions }}</span>
                  </span>
                @endif
              </span>
            </a>
          </li>
        @endforeach
      </ul>
    @endforeach
  @elseif(!repositories.length)
    <p data-pr-empty>Add a trusted project with a GitHub remote to see its pull requests here.</p>
  @elseif(!failures.length)
    <p data-pr-empty>No pull requests match these filters.</p>
  @endif
  @if(pageBack || pageNext)
    <nav data-pr-pagination aria-label="Pull request pages">
      @if(pageBack)<a href="{{ pageBack }}">Previous page</a>@endif
      <span>Page {{ page }}</span>
      @if(pageNext)<a href="{{ pageNext }}">Next page</a>@endif
    </nav>
  @endif
</div>
