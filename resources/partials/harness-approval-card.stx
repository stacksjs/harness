<div
  data-approval
  @if(!pendingApproval)hidden@endif
  :hidden="!approvalId()"
  class="shrink-0 p-3 bg-amber-500/10 border border-amber-500/30 rounded-[10px]"
>
  <div @if(pendingApproval?.connector)hidden@endif :hidden="Boolean(connectorApproval())">
    <div class="mb-2 font-medium text-[12px]">
      <span data-approval-tool :text="approvalTool()">{{ pendingApproval ? pendingApproval.toolName : '' }}</span> wants to run.
    </div>
    <div class="flex gap-2">
      <button type="button" data-approve @click="approveTool" :disabled="!!pendingApprovalId()" class="px-3 py-1 text-[12px] text-white dark:text-neutral-900 bg-neutral-900 dark:bg-white rounded-[6px] disabled:opacity-50">Allow</button>
      <button type="button" data-deny @click="denyTool" :disabled="!!pendingApprovalId()" class="px-3 py-1 text-[12px] border border-black/10 rounded-[6px] dark:border-white/15 disabled:opacity-50">Deny</button>
    </div>
  </div>
  @includeWhen(activeSession, '../partials/harness-connector-consent')
</div>
