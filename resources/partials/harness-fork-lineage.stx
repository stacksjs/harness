<div data-fork-banner class="flex flex-wrap gap-2 items-center mb-5 mx-auto px-2 py-2 text-xs">
  <span role="status" :text="forkStatusText()">{{ initialFork.state === 'pending' ? 'Creating fork…' : initialFork.state === 'failed' ? initialFork.error : 'Forked conversation' }}</span>
  <a data-fork-source href="/s/{{ initialFork.sourceSessionId }}#turn-{{ initialFork.sourceTurnId }}" class="underline underline-offset-4">Source response</a>
</div>
